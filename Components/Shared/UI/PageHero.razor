<section class="of-page-hero @Class">
    <div class="of-page-hero__content">
        @if (!string.IsNullOrWhiteSpace(Eyebrow))
        {
            <div class="of-eyebrow">@Eyebrow</div>
        }

        <div class="of-page-hero__title-row">
            <div>
                <h1>@Title</h1>

                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p>@Subtitle</p>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(BadgeText))
            {
                <span class="of-badge @BadgeClass">@BadgeText</span>
            }
        </div>

        @if (ChildContent is not null)
        {
            <div class="of-page-hero__extra">
                @ChildContent
            </div>
        }
    </div>

    @if (Actions is not null)
    {
        <div class="of-page-hero__actions">
            @Actions
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Eyebrow { get; set; }
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string BadgeClass { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}