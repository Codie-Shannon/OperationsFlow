<section class="of-activity-history @Class">
    <header class="of-activity-history__header">
        <div>
            <h2>@Title</h2>

            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p>@Subtitle</p>
            }
        </div>

        @if (Actions is not null)
        {
            <div class="of-activity-history__actions">
                @Actions
            </div>
        }
    </header>

    <div class="of-activity-history__body">
        @if (IsEmpty)
        {
            <EmptyState Title="@EmptyTitle"
                        Message="@EmptyMessage"
                        Icon="🕒" />
        }
        else if (ChildContent is not null)
        {
            @ChildContent
        }
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "Activity History";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool IsEmpty { get; set; }
    [Parameter] public string EmptyTitle { get; set; } = "No activity history yet";
    [Parameter] public string EmptyMessage { get; set; } = "Activity events for this record will appear here.";
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}