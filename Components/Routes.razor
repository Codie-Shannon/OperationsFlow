@using OperationsFlow.Components.Auth
@using OperationsFlow.Components.Layout

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <LocalRouteGuard RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <div class="p-4">
                <div class="of-badge of-badge-warning">Not found</div>
                <h1 class="mt-3">Page not found</h1>
                <p class="of-muted-text">
                    The requested OperationsFlow page could not be found.
                </p>
                <a class="of-btn of-btn-primary" href="/dashboard">Go to dashboard</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>