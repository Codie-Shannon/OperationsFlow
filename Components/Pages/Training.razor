@page "/training"

@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models

@inject OperationsFlowDbContext Db

<PageTitle>Training Compliance - OperationsFlow</PageTitle>

<div class="page-shell module-page training-page">
    <section class="module-header">
        <div>
            <p class="eyebrow dark">Compliance</p>
            <h1>Training Compliance</h1>
            <p>
                Track staff training records, required training, expiry dates, expired training,
                upcoming renewals, and corrective action follow-up.
            </p>
        </div>

        <div class="module-header-stat">
            <span>Compliance Rate</span>
            <strong>@ComplianceRate.ToString("0.0")%</strong>
        </div>
    </section>

    <section class="page-purpose-note">
        <strong>Purpose:</strong> use this page to review training compliance and turn expired or expiring
        training records into owned corrective actions. Training actions are pre-filled with source context
        so the follow-up remains traceable.
    </section>

    <section class="module-summary-grid">
        <article class="module-summary-card info-card">
            <span>Total Records</span>
            <strong>@TotalCount</strong>
            <small>All staff training records</small>
        </article>

        <article class="module-summary-card danger-card">
            <span>Expired</span>
            <strong>@ExpiredCount</strong>
            <small>Training currently expired</small>
        </article>

        <article class="module-summary-card warning-card">
            <span>Expiring Soon</span>
            <strong>@ExpiringSoonCount</strong>
            <small>Needs renewal soon</small>
        </article>

        <article class="module-summary-card success-card">
            <span>Required Current</span>
            <strong>@RequiredCurrentCount</strong>
            <small>Required records still compliant</small>
        </article>

        <article class="module-summary-card">
            <span>Actionable</span>
            <strong>@ActionableTrainingCount</strong>
            <small>Expired or expiring required records</small>
        </article>
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Training Follow-Up Focus</h2>
                    <p>Recommended review order for training compliance.</p>
                </div>
            </div>

            <ol class="review-list">
                <li>Review expired required training first.</li>
                <li>Check training expiring within the next 30 days.</li>
                <li>Create corrective actions for training that needs booking, renewal, or confirmation.</li>
                <li>Confirm owner, priority, due date, and source context before saving the corrective action.</li>
                <li>Use Workload, Reminders, Reports, Data Quality, and Activity Log to track follow-up.</li>
            </ol>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Training → Corrective Action Link</h2>
                    <p>What the Action button does.</p>
                </div>
            </div>

            <div class="review-note-grid">
                <div class="review-note-card">
                    <span>SOURCE</span>
                    <strong>Training Compliance</strong>
                    <p>The corrective action source is set to Training Compliance.</p>
                </div>

                <div class="review-note-card">
                    <span>CONTEXT</span>
                    <strong>Training details included</strong>
                    <p>Staff, training name, status, dates, required flag, and notes are copied into the action.</p>
                </div>

                <div class="review-note-card">
                    <span>RETURN</span>
                    <strong>Back to Training</strong>
                    <p>After saving, the workflow returns to this page.</p>
                </div>

                <div class="review-note-card">
                    <span>TRACEABILITY</span>
                    <strong>Activity logged</strong>
                    <p>The created corrective action is logged as source-linked follow-up work.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="module-toolbar">
        <input class="search-input"
               placeholder="Search staff, training, site, department, status, or notes..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="filter-select" @bind="statusFilter">
            <option value="">All Statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>

        <select class="filter-select" @bind="departmentFilter">
            <option value="">All Departments</option>
            @foreach (var department in DepartmentOptions)
            {
                <option value="@department">@department</option>
            }
        </select>

        <select class="filter-select" @bind="requirementFilter">
            <option value="">All Records</option>
            <option value="Required">Required Only</option>
            <option value="Optional">Optional Only</option>
        </select>
    </section>

    <section class="table-card">
        <div class="table-card-header">
            <div>
                <h2>Training Records</h2>
                <p>Showing @FilteredTrainingRecords.Count() of @TotalCount training record(s).</p>
            </div>

            <div class="activity-count-card">
                <span>Actionable</span>
                <strong>@FilteredTrainingRecords.Count(IsActionableTraining)</strong>
            </div>
        </div>

        @if (trainingRecords == null)
        {
            <div class="empty-state">Loading training records...</div>
        }
        else if (!FilteredTrainingRecords.Any())
        {
            <div class="empty-state">
                <strong>No training records match the current filters.</strong>
                <p>Clear the search or filters to show more training compliance records.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table training-table">
                    <thead>
                        <tr>
                            <th>Staff</th>
                            <th>Training</th>
                            <th>Site</th>
                            <th>Department</th>
                            <th>Status</th>
                            <th>Completed</th>
                            <th>Expiry</th>
                            <th>Required</th>
                            <th>Flag</th>
                            <th>Follow-Up</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredTrainingRecords)
                        {
                            <tr>
                                <td class="strong-cell">@item.StaffName</td>
                                <td>@item.TrainingName</td>
                                <td>@item.Site</td>
                                <td>@item.Department</td>
                                <td>
                                    <span class="@GetStatusClass(item.Status)">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.CompletedDate.ToString("dd MMM yyyy")</td>
                                <td>@item.ExpiryDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.IsRequired)
                                    {
                                        <span class="badge badge-info">Required</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-muted">Optional</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsExpired)
                                    {
                                        <span class="badge badge-danger">Expired</span>
                                    }
                                    else if (item.IsExpiringSoon)
                                    {
                                        <span class="badge badge-warning">Expiring Soon</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">Current</span>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-small btn-primary" href="@BuildCorrectiveActionUrlFromTraining(item)">
                                        Create Action
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Priority Training Follow-Ups</h2>
                    <p>Expired or expiring training records that should be checked first.</p>
                </div>

                <span class="badge badge-warning">@PriorityTrainingRecords.Count items</span>
            </div>

            @if (!PriorityTrainingRecords.Any())
            {
                <div class="empty-state">
                    <strong>No priority training follow-ups.</strong>
                    <p>There are currently no expired or expiring-soon training flags.</p>
                </div>
            }
            else
            {
                <div class="issue-card-list">
                    @foreach (var item in PriorityTrainingRecords.Take(6))
                    {
                        <article class="issue-card">
                            <div>
                                <strong>@item.StaffName — @item.TrainingName</strong>
                                <p>@item.Department • @item.Site</p>
                                <small>
                                    Status @item.Status • Expires @item.ExpiryDate.ToString("dd MMM yyyy")
                                </small>
                            </div>

                            <div class="issue-card-actions">
                                @if (item.IsExpired)
                                {
                                    <span class="badge badge-danger">Expired</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Expiring Soon</span>
                                }

                                @if (item.IsRequired)
                                {
                                    <span class="badge badge-info">Required</span>
                                }

                                <a class="btn btn-small btn-primary" href="@BuildCorrectiveActionUrlFromTraining(item)">
                                    Create Action
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Training Compliance Notes</h2>
                    <p>How training records should be reviewed.</p>
                </div>
            </div>

            <div class="review-note-grid">
                <div class="review-note-card">
                    <span>REQUIRED</span>
                    <strong>Prioritise required records</strong>
                    <p>Required expired records should be actioned before optional training.</p>
                </div>

                <div class="review-note-card">
                    <span>OWNER</span>
                    <strong>Staff member is owner</strong>
                    <p>Corrective actions assign the staff member by default for follow-up visibility.</p>
                </div>

                <div class="review-note-card">
                    <span>DUE DATE</span>
                    <strong>Expiry drives reminder</strong>
                    <p>Expired and expiring records appear in Reminders and Data Quality.</p>
                </div>

                <div class="review-note-card">
                    <span>PRODUCTION GAP</span>
                    <strong>Training provider link</strong>
                    <p>A production version could store certificates, provider details, and renewal bookings.</p>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private List<TrainingRecord>? trainingRecords;

    private string searchText = "";
    private string statusFilter = "";
    private string departmentFilter = "";
    private string requirementFilter = "";

    private IEnumerable<TrainingRecord> FilteredTrainingRecords
    {
        get
        {
            if (trainingRecords == null)
            {
                return Enumerable.Empty<TrainingRecord>();
            }

            var query = trainingRecords.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.StaffName, searchText) ||
                    Contains(x.TrainingName, searchText) ||
                    Contains(x.Site, searchText) ||
                    Contains(x.Department, searchText) ||
                    Contains(x.Status, searchText) ||
                    Contains(x.Notes, searchText));
            }

            if (!string.IsNullOrWhiteSpace(statusFilter))
            {
                query = query.Where(x =>
                    string.Equals(x.Status, statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(departmentFilter))
            {
                query = query.Where(x =>
                    string.Equals(x.Department, departmentFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (requirementFilter == "Required")
            {
                query = query.Where(x => x.IsRequired);
            }
            else if (requirementFilter == "Optional")
            {
                query = query.Where(x => !x.IsRequired);
            }

            return query
                .OrderByDescending(x => x.IsExpired)
                .ThenByDescending(x => x.IsExpiringSoon)
                .ThenBy(x => x.ExpiryDate)
                .ThenBy(x => x.StaffName)
                .ToList();
        }
    }

    private int TotalCount => trainingRecords?.Count ?? 0;

    private int ExpiredCount => trainingRecords?.Count(x => x.IsExpired) ?? 0;

    private int ExpiringSoonCount => trainingRecords?.Count(x => x.IsExpiringSoon) ?? 0;

    private int RequiredCurrentCount =>
        trainingRecords?.Count(x => x.IsRequired && !x.IsExpired) ?? 0;

    private int ActionableTrainingCount =>
        trainingRecords?.Count(IsActionableTraining) ?? 0;

    private decimal ComplianceRate
    {
        get
        {
            if (trainingRecords == null)
            {
                return 0;
            }

            var required = trainingRecords
                .Where(x => x.IsRequired)
                .ToList();

            if (!required.Any())
            {
                return 0;
            }

            var compliant = required.Count(x => !x.IsExpired);
            return (decimal)compliant / required.Count * 100;
        }
    }

    private List<TrainingRecord> PriorityTrainingRecords =>
        trainingRecords?
            .Where(IsActionableTraining)
            .OrderByDescending(x => x.IsExpired)
            .ThenByDescending(x => x.IsRequired)
            .ThenBy(x => x.ExpiryDate)
            .ThenBy(x => x.StaffName)
            .ToList() ?? new List<TrainingRecord>();

    private List<string> StatusOptions =>
        trainingRecords?
            .Select(x => x.Status)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> DepartmentOptions =>
        trainingRecords?
            .Select(x => x.Department)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    protected override async Task OnInitializedAsync()
    {
        trainingRecords = await Db.TrainingRecords
            .AsNoTracking()
            .ToListAsync();
    }

    private static string BuildCorrectiveActionUrlFromTraining(TrainingRecord item)
    {
        var priority = item.IsExpired
            ? "High"
            : item.IsExpiringSoon
                ? "Medium"
                : "Low";

        var title = $"Resolve training issue: {item.StaffName} - {item.TrainingName}";

        var notes =
            "Created from Training Compliance issue." + Environment.NewLine +
            "Confirm retraining requirement, assign follow-up owner, and update compliance status." + Environment.NewLine +
            Environment.NewLine +
            $"Staff: {item.StaffName}" + Environment.NewLine +
            $"Training: {item.TrainingName}" + Environment.NewLine +
            $"Site: {item.Site}" + Environment.NewLine +
            $"Department: {item.Department}" + Environment.NewLine +
            $"Status: {item.Status}" + Environment.NewLine +
            $"Completed Date: {item.CompletedDate:dd MMM yyyy}" + Environment.NewLine +
            $"Expiry Date: {item.ExpiryDate:dd MMM yyyy}" + Environment.NewLine +
            $"Required: {(item.IsRequired ? "Yes" : "No")}" + Environment.NewLine +
            $"Notes: {DisplayText(item.Notes)}" + Environment.NewLine +
            $"Training Flag: {(item.IsExpired ? "Expired" : item.IsExpiringSoon ? "Expiring soon" : "Current")}" + Environment.NewLine +
            Environment.NewLine +
            "Suggested follow-up: confirm retraining is required, book or assign the training action, then update the training record once compliance is restored.";

        return "/corrective-actions/create" +
            $"?source={Uri.EscapeDataString("Training Compliance")}" +
            $"&title={Uri.EscapeDataString(title)}" +
            $"&site={Uri.EscapeDataString(item.Site)}" +
            $"&department={Uri.EscapeDataString(item.Department)}" +
            $"&owner={Uri.EscapeDataString(item.StaffName)}" +
            $"&priority={Uri.EscapeDataString(priority)}" +
            $"&actionType={Uri.EscapeDataString("Training")}" +
            $"&notes={Uri.EscapeDataString(notes)}" +
            $"&returnUrl={Uri.EscapeDataString("/training")}";
    }

    private static bool IsActionableTraining(TrainingRecord item)
    {
        return item.IsExpired || item.IsExpiringSoon;
    }

    private static bool Contains(string? source, string search)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return false;
        }

        return source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "current" => "badge badge-success",
            "valid" => "badge badge-success",
            "expired" => "badge badge-danger",
            "not started" => "badge badge-warning",
            "in progress" => "badge badge-info",
            _ => "badge badge-muted"
        };
    }
}