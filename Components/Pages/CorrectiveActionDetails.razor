@page "/corrective-actions/details/{Id:int}"
@page "/corrective-actions/view/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db
@inject NavigationManager Navigation

<PageTitle>Corrective Action Details - OperationsFlow</PageTitle>

@if (isLoading)
{
    <PageHero
        Eyebrow="Operations"
        Title="Loading Corrective Action"
        Subtitle="Loading the selected corrective action record."
        BadgeText="Loading"
        BadgeClass="of-badge-info" />

    <InfoPanel Title="Loading" Subtitle="Retrieving corrective action details from the local SQLite database.">
        <p class="of-muted-text">Loading corrective action...</p>
    </InfoPanel>
}
else if (correctiveAction == null)
{
    <PageHero
        Eyebrow="Operations"
        Title="Corrective Action Not Found"
        Subtitle="The requested corrective action could not be found."
        BadgeText="Missing"
        BadgeClass="of-badge-danger">
        <Actions>
            <a class="of-btn of-btn-primary" href="/corrective-actions">Back to Actions</a>
        </Actions>
    </PageHero>

    <EmptyState
        Title="Corrective action could not be found"
        Message="The record may have been removed, or the link may be using an invalid ID."
        Icon="⚠️"
        ActionText="Back to Actions"
        ActionHref="/corrective-actions" />
}
else
{
    <PageHero
        Eyebrow="Operations"
        Title="@correctiveAction.Title"
        Subtitle="@($"Source: {DisplayText(correctiveAction.Source)}")"
        BadgeText="@DisplayText(correctiveAction.Status)"
        BadgeClass="@GetStatusBadgeClass(correctiveAction.Status)">
        <Actions>
            <a class="of-btn of-btn-secondary" href="/corrective-actions">Back to Actions</a>
            <a class="of-btn of-btn-primary" href="@BuildEditUrl()">Edit Action</a>
        </Actions>
    </PageHero>

    <MetricGrid>
        <MetricCard
            Title="Priority"
            Value="@DisplayText(correctiveAction.Priority)"
            Detail="@DisplayText(correctiveAction.ActionType)"
            Icon="⚡"
            Tone="@GetPriorityTone(correctiveAction.Priority)" />

        <MetricCard
            Title="Due Date"
            Value="@correctiveAction.DueDate.ToString("dd MMM")"
            Detail="@correctiveAction.DueDate.ToString("yyyy")"
            Icon="📅"
            Tone="info" />

        <MetricCard
            Title="Flag"
            Value="@GetFlagText()"
            Detail="@GetFlagDetail()"
            Icon="@GetFlagIcon()"
            Tone="@GetFlagTone()" />

        <MetricCard
            Title="Owner"
            Value="@DisplayText(correctiveAction.Owner)"
            Detail="@DisplayText(correctiveAction.Department)"
            Icon="👤" />
    </MetricGrid>

    <InfoPanel Title="Corrective Action Details" Subtitle="Core record information used by workload, reminders, reports, and activity history.">
        <ChildContent>
            <div class="of-detail-grid">
                <div class="of-detail-item">
                    <span>Title</span>
                    <strong>@correctiveAction.Title</strong>
                </div>

                <div class="of-detail-item">
                    <span>Source</span>
                    <strong>@DisplayText(correctiveAction.Source)</strong>
                </div>

                <div class="of-detail-item">
                    <span>Site</span>
                    <strong>@DisplayText(correctiveAction.Site)</strong>
                </div>

                <div class="of-detail-item">
                    <span>Department</span>
                    <strong>@DisplayText(correctiveAction.Department)</strong>
                </div>

                <div class="of-detail-item">
                    <span>Owner</span>
                    <strong>@DisplayText(correctiveAction.Owner)</strong>
                </div>

                <div class="of-detail-item">
                    <span>Action Type</span>
                    <strong>@DisplayText(correctiveAction.ActionType)</strong>
                </div>

                <div class="of-detail-item">
                    <span>Priority</span>
                    <strong>
                        <span class="@GetPriorityClass(correctiveAction.Priority)">
                            @DisplayText(correctiveAction.Priority)
                        </span>
                    </strong>
                </div>

                <div class="of-detail-item">
                    <span>Status</span>
                    <strong>
                        <span class="@GetStatusClass(correctiveAction.Status)">
                            @DisplayText(correctiveAction.Status)
                        </span>
                    </strong>
                </div>

                <div class="of-detail-item">
                    <span>Due Date</span>
                    <strong>@correctiveAction.DueDate.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="of-detail-item">
                    <span>Completed Date</span>
                    <strong>
                        @(correctiveAction.CompletedDate.HasValue
                            ? correctiveAction.CompletedDate.Value.ToString("dd MMM yyyy")
                            : "Not completed")
                    </strong>
                </div>
            </div>
        </ChildContent>
    </InfoPanel>

    <InfoPanel Title="Notes" Subtitle="Recorded context, follow-up detail, source context, closure evidence, or review notes.">
        <ChildContent>
            <p class="of-notes-box">@DisplayText(correctiveAction.Notes)</p>
        </ChildContent>
    </InfoPanel>

    <ActivityHistoryPanel Title="Activity History"
                          Subtitle="Record-level traceability for this corrective action."
                          IsEmpty="@(!HasActivityHistory)"
                          EmptyTitle="No activity history yet"
                          EmptyMessage="Create, edit, or review this corrective action to generate activity history.">
        <ChildContent>
            @if (HasActivityHistory)
            {
                <table class="of-activity-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>Description</th>
                            <th>Created By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in activityHistory)
                        {
                            <tr>
                                <td>@activity.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <span class="@GetActivityBadgeClass(activity.ActionType)">
                                        @activity.ActionType
                                    </span>
                                </td>
                                <td>@activity.Description</td>
                                <td>@activity.CreatedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </ActivityHistoryPanel>

    <ActionStrip
        Title="Next Actions"
        Description="Return to the action register or update this corrective action.">
        <button type="button" class="of-btn of-btn-secondary" @onclick="BackToActions">Back to Actions</button>
        <button type="button" class="of-btn of-btn-primary" @onclick="GoToEdit">Edit Action</button>
    </ActionStrip>
}

@code {
    [Parameter] public int Id { get; set; }

    private CorrectiveAction? correctiveAction;
    private List<ActivityLog> activityHistory = new();
    private bool isLoading = true;
    private bool HasActivityHistory => activityHistory.Any();

    protected override async Task OnInitializedAsync()
    {
        correctiveAction = await Db.CorrectiveActions
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (correctiveAction != null)
        {
            await LoadActivityHistory();
        }

        isLoading = false;
    }

    private async Task LoadActivityHistory()
    {
        activityHistory = await Db.ActivityLogs
            .AsNoTracking()
            .Where(x => x.ModuleName == "Corrective Actions" && x.RecordId == Id)
            .OrderByDescending(x => x.CreatedDate)
            .ToListAsync();
    }

    private string BuildEditUrl()
    {
        return $"/corrective-actions/edit/{Id}?returnUrl={Uri.EscapeDataString($"/corrective-actions/details/{Id}")}";
    }

    private void GoToEdit()
    {
        Navigation.NavigateTo(BuildEditUrl());
    }

    private void BackToActions()
    {
        Navigation.NavigateTo("/corrective-actions");
    }

    private string GetFlagText()
    {
        if (correctiveAction == null)
        {
            return "Unknown";
        }

        if (correctiveAction.IsOverdue)
        {
            return "Overdue";
        }

        if (IsCompletedStatus(correctiveAction.Status) || correctiveAction.CompletedDate.HasValue)
        {
            return "Completed";
        }

        return "On Track";
    }

    private string GetFlagDetail()
    {
        if (correctiveAction == null)
        {
            return "";
        }

        if (correctiveAction.IsOverdue)
        {
            return "Past due and not completed";
        }

        if (IsCompletedStatus(correctiveAction.Status) || correctiveAction.CompletedDate.HasValue)
        {
            return "Completion evidence recorded";
        }

        return "No overdue flag";
    }

    private string GetFlagIcon()
    {
        if (correctiveAction == null)
        {
            return "ℹ️";
        }

        if (correctiveAction.IsOverdue)
        {
            return "🚨";
        }

        if (IsCompletedStatus(correctiveAction.Status) || correctiveAction.CompletedDate.HasValue)
        {
            return "✅";
        }

        return "🟢";
    }

    private string GetFlagTone()
    {
        if (correctiveAction == null)
        {
            return "default";
        }

        if (correctiveAction.IsOverdue)
        {
            return "danger";
        }

        if (IsCompletedStatus(correctiveAction.Status) || correctiveAction.CompletedDate.HasValue)
        {
            return "success";
        }

        return "success";
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static bool IsCompletedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetPriorityTone(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "danger",
            "high" => "warning",
            "medium" => "info",
            "low" => "default",
            _ => "default"
        };
    }

    private static string GetStatusBadgeClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "of-badge-success",
            "closed" => "of-badge-success",
            "in progress" => "of-badge-info",
            "open" => "of-badge-warning",
            "new" => "of-badge-warning",
            _ => "of-badge-info"
        };
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "in progress" => "badge badge-info",
            "open" => "badge badge-warning",
            "new" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static string GetActivityBadgeClass(string? actionType)
    {
        return actionType?.ToLowerInvariant() switch
        {
            "created" => "badge badge-success",
            "updated" => "badge badge-info",
            "reviewed" => "badge badge-secondary",
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "deleted" => "badge badge-danger",
            _ => "badge badge-secondary"
        };
    }
}