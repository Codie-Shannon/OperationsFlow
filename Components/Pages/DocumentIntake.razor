@page "/document-intake"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake
@inject OperationsFlowDbContext Db

<PageTitle>Document Intake - OperationsFlow</PageTitle>

<PageHero Eyebrow="Admin Workflow"
          Title="Document Intake"
          Subtitle="Track incoming emails, PDFs, forms, supplier documents, job paperwork, and admin processing through review, entry, and completion."
          BadgeText="@($"{NeedsReviewCount} need review")"
          BadgeClass="of-badge-warning">
    <Actions>
        <a class="of-btn of-btn-primary" href="/document-intake/create">+ New Intake</a>
        <a class="of-btn of-btn-secondary" href="/workload">Workload</a>
        <a class="of-btn of-btn-secondary" href="/reminders">Reminders</a>
        <a class="of-btn of-btn-secondary" href="/reports">Reports</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="📥">
    <p>
        Document Intake captures admin/document processing work before it disappears into email,
        folders, paper piles, or someone’s memory. Intake records feed workload, reminders,
        reports, data quality checks, and activity history.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Total Intake"
                Value="@TotalCount.ToString()"
                Detail="All incoming document records"
                Icon="📋" />

    <MetricCard Title="Needs Review"
                Value="@NeedsReviewCount.ToString()"
                Detail="Awaiting manual check"
                Icon="🔎"
                Tone="warning" />

    <MetricCard Title="Overdue"
                Value="@OverdueCount.ToString()"
                Detail="Past due and not completed"
                Icon="🚨"
                Tone="danger" />

    <MetricCard Title="Due Soon"
                Value="@DueSoonCount.ToString()"
                Detail="Due within the next 7 days"
                Icon="📅"
                Tone="info" />

    <MetricCard Title="Completed"
                Value="@CompletedCount.ToString()"
                Detail="Processed or rejected records"
                Icon="✅"
                Tone="success" />
</MetricGrid>

<FilterBar Title="Filter Document Intake">
    <ChildContent>
        <input class="of-input"
               placeholder="Search document intake..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="of-select" @bind="statusFilter">
            <option value="">All Statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>

        <select class="of-select" @bind="sourceTypeFilter">
            <option value="">All Sources</option>
            @foreach (var sourceType in SourceTypeOptions)
            {
                <option value="@sourceType">@sourceType</option>
            }
        </select>

        <select class="of-select" @bind="targetSystemFilter">
            <option value="">All Target Systems</option>
            @foreach (var targetSystem in TargetSystemOptions)
            {
                <option value="@targetSystem">@targetSystem</option>
            }
        </select>

        <select class="of-select" @bind="priorityFilter">
            <option value="">All Priorities</option>
            @foreach (var priority in PriorityOptions)
            {
                <option value="@priority">@priority</option>
            }
        </select>
    </ChildContent>

    <Actions>
        <a class="of-btn of-btn-secondary" href="/data-quality">Data Quality</a>
        <a class="of-btn of-btn-secondary" href="/activity-log">Activity Log</a>
    </Actions>
</FilterBar>

@if (documentIntakeItems == null)
{
    <InfoPanel Title="Loading Document Intake" Subtitle="Loading document intake records from the local SQLite database.">
        <p class="of-muted-text">Loading document intake...</p>
    </InfoPanel>
}
else
{
    <TableCard Title="Document Intake Register"
               Subtitle="Search, filter, open, and edit incoming document/admin workflow records."
               IsEmpty="@(!FilteredItems.Any())"
               EmptyTitle="No intake records found"
               EmptyMessage="No intake records match the current search or filter selection.">
        <table>
            <thead>
                <tr>
                    <th>Document</th>
                    <th>Received From</th>
                    <th>Source Type</th>
                    <th>Document Type</th>
                    <th>Assigned To</th>
                    <th>Target System</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Due Date</th>
                    <th>Flag</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredItems)
                {
                    <tr>
                        <td><strong>@item.DocumentName</strong></td>
                        <td>@DisplayText(item.ReceivedFrom)</td>
                        <td>@DisplayText(item.SourceType)</td>
                        <td>@DisplayText(item.DocumentType)</td>
                        <td>@DisplayText(item.AssignedTo)</td>
                        <td>@DisplayText(item.TargetSystem)</td>
                        <td>
                            <span class="@GetPriorityClass(item.Priority)">
                                @DisplayText(item.Priority)
                            </span>
                        </td>
                        <td>
                            <span class="@GetStatusClass(item.Status)">
                                @DisplayText(item.Status)
                            </span>
                        </td>
                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.IsOverdue)
                            {
                                <span class="of-badge of-badge-danger">Overdue</span>
                            }
                            else if (item.NeedsReview)
                            {
                                <span class="of-badge of-badge-warning">Needs Review</span>
                            }
                            else if (item.IsDueSoon)
                            {
                                <span class="of-badge of-badge-info">Due Soon</span>
                            }
                            else if (item.IsCompleted)
                            {
                                <span class="of-badge of-badge-success">Complete</span>
                            }
                            else
                            {
                                <span class="of-badge of-badge-success">On Track</span>
                            }
                        </td>
                        <td>
                            <div class="of-row-actions">
                                <a class="of-card-link" href="@($"/document-intake/edit/{item.Id}?returnUrl={Uri.EscapeDataString("/document-intake")}")">Open / Edit</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </TableCard>
}

<InfoPanel Title="Document Intake Workflow" Subtitle="This module proves admin/document work can be tracked like operational workflow.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Received</strong>
                <span>Incoming documents are captured with source, sender, date, and document type.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Assigned</strong>
                <span>Each record has an owner so workload and reminders stay visible.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Processed</strong>
                <span>Status shows whether the record is saved, checked, entered, completed, or rejected.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Traceable</strong>
                <span>Created, updated, and reviewed events are recorded in the Activity Log.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Review Notes" Icon="💡" Tone="info">
    <ul>
        <li>Needs Review, overdue, and due-soon intake items should appear in Reminders.</li>
        <li>Assigned intake records should contribute to owner workload.</li>
        <li>Completed or rejected records should have a completed date.</li>
        <li>Creating or editing an intake item should generate activity history.</li>
        <li>This prototype tracks document workflow metadata; actual file upload/storage is a later stage.</li>
    </ul>
</GuidanceNote>

@code {
    private List<DocumentIntakeModel>? documentIntakeItems;

    private string searchText = "";
    private string statusFilter = "";
    private string sourceTypeFilter = "";
    private string targetSystemFilter = "";
    private string priorityFilter = "";

    private IEnumerable<DocumentIntakeModel> FilteredItems
    {
        get
        {
            if (documentIntakeItems == null)
            {
                return Enumerable.Empty<DocumentIntakeModel>();
            }

            var query = documentIntakeItems.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.DocumentName, searchText) ||
                    Contains(x.ReceivedFrom, searchText) ||
                    Contains(x.SourceType, searchText) ||
                    Contains(x.DocumentType, searchText) ||
                    Contains(x.AssignedTo, searchText) ||
                    Contains(x.TargetSystem, searchText) ||
                    Contains(x.Status, searchText) ||
                    Contains(x.Priority, searchText) ||
                    Contains(x.Notes, searchText));
            }

            if (!string.IsNullOrWhiteSpace(statusFilter))
            {
                query = query.Where(x => string.Equals(x.Status, statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(sourceTypeFilter))
            {
                query = query.Where(x => string.Equals(x.SourceType, sourceTypeFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(targetSystemFilter))
            {
                query = query.Where(x => string.Equals(x.TargetSystem, targetSystemFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(priorityFilter))
            {
                query = query.Where(x => string.Equals(x.Priority, priorityFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x => x.IsOverdue)
                .ThenByDescending(x => x.NeedsReview)
                .ThenBy(x => x.DueDate)
                .ThenBy(x => x.DocumentName)
                .ToList();
        }
    }

    private int TotalCount => documentIntakeItems?.Count ?? 0;
    private int NeedsReviewCount => documentIntakeItems?.Count(x => x.NeedsReview) ?? 0;
    private int OverdueCount => documentIntakeItems?.Count(x => x.IsOverdue) ?? 0;
    private int DueSoonCount => documentIntakeItems?.Count(x => x.IsDueSoon) ?? 0;
    private int CompletedCount => documentIntakeItems?.Count(x => x.IsCompleted) ?? 0;

    private List<string> StatusOptions =>
        documentIntakeItems?
            .Select(x => x.Status)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> SourceTypeOptions =>
        documentIntakeItems?
            .Select(x => x.SourceType)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> TargetSystemOptions =>
        documentIntakeItems?
            .Select(x => x.TargetSystem)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> PriorityOptions =>
        documentIntakeItems?
            .Select(x => x.Priority)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    protected override async Task OnInitializedAsync()
    {
        documentIntakeItems = await Db.DocumentIntakeItems
            .AsNoTracking()
            .ToListAsync();
    }

    private static bool Contains(string? source, string search)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "rejected" => "badge badge-danger",
            "entered" => "badge badge-info",
            "data checked" => "badge badge-info",
            "needs review" => "badge badge-warning",
            "saved" => "badge badge-muted",
            "received" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }
}