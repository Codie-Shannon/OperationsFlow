@page "/document-intake"

@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake

@inject OperationsFlowDbContext Db
@inject DocumentAttachmentService AttachmentService
@inject LocalCurrentUserService CurrentUserService

<PageTitle>Document Intake - OperationsFlow</PageTitle>

<PageHero Title="Document Intake"
          Eyebrow="Admin Workflow"
          Subtitle="Capture incoming document workflow items, track ownership, and connect intake records to local evidence files before Week 4 SharePoint storage is connected."
          BadgeText="@($"{ActionableCount} needs attention")"
          BadgeClass="badge badge-warning">
    <Actions>
        @if (CurrentUserService.CanEditWorkflow)
        {
            <a class="btn btn-primary" href="/document-intake/create">+ New Intake</a>
        }
        <a class="btn btn-secondary" href="/document-library">Document Library</a>
        <a class="btn btn-secondary" href="/workload">Workload</a>
        <a class="btn btn-secondary" href="/reminders">Reminders</a>
        <a class="btn btn-secondary" href="/reports">Reports</a>
    </Actions>
</PageHero>

<PurposeNote Icon="📥">
    Document Intake captures admin/document processing work before it disappears into email, folders, paper piles, or someone’s memory.
    Intake records now connect to local file evidence so documents can be opened, reviewed, attached, and traced through the Document Library.
</PurposeNote>

<div class="of-metric-grid">
    <MetricCard Title="Total Intake"
                Value="@TotalCount.ToString()"
                Detail="Incoming document workflow records"
                Icon="📥"
                Tone="default" />

    <MetricCard Title="Needs Review"
                Value="@NeedsReviewCount.ToString()"
                Detail="Records waiting for manual review"
                Icon="🔎"
                Tone="warning" />

    <MetricCard Title="Overdue"
                Value="@OverdueCount.ToString()"
                Detail="Due date has passed"
                Icon="🚨"
                Tone="danger" />

    <MetricCard Title="Due Soon"
                Value="@DueSoonCount.ToString()"
                Detail="Due within the next 7 days"
                Icon="📅"
                Tone="warning" />

    <MetricCard Title="Completed"
                Value="@CompletedCount.ToString()"
                Detail="Completed or rejected records"
                Icon="✅"
                Tone="success" />

    <MetricCard Title="Attached Files"
                Value="@TotalAttachmentCount.ToString()"
                Detail="Files linked to intake records"
                Icon="📎"
                Tone="info" />
</div>

<InfoPanel Title="Intake → Document Library Workflow"
           Subtitle="What this page now proves.">
    <ChildContent>
        <div class="of-card-grid">
            <div class="of-mini-card">
                <h3>Capture</h3>
                <p>Incoming document work is tracked with owner, source, target system, status, priority, due date, and notes.</p>
            </div>

            <div class="of-mini-card">
                <h3>Open</h3>
                <p>Each intake row opens a detail page where the exact record can be reviewed before work is completed.</p>
            </div>

            <div class="of-mini-card">
                <h3>Attach</h3>
                <p>Files can be uploaded directly against an intake record using the shared RecordAttachments component.</p>
            </div>

            <div class="of-mini-card">
                <h3>Trace</h3>
                <p>Uploaded files appear in Document Library and Activity Log so document work has evidence.</p>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<FilterBar Title="Filter Document Intake">
    <ChildContent>
        <input class="form-control"
               placeholder="Search intake records..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="form-control" @bind="statusFilter">
            <option value="">All Statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>

        <select class="form-control" @bind="sourceTypeFilter">
            <option value="">All Sources</option>
            @foreach (var sourceType in SourceTypeOptions)
            {
                <option value="@sourceType">@sourceType</option>
            }
        </select>

        <select class="form-control" @bind="targetSystemFilter">
            <option value="">All Target Systems</option>
            @foreach (var targetSystem in TargetSystemOptions)
            {
                <option value="@targetSystem">@targetSystem</option>
            }
        </select>

        <select class="form-control" @bind="priorityFilter">
            <option value="">All Priorities</option>
            @foreach (var priority in PriorityOptions)
            {
                <option value="@priority">@priority</option>
            }
        </select>
    </ChildContent>

    <Actions>
        <a class="btn btn-secondary" href="/data-quality">Data Quality</a>
        <a class="btn btn-secondary" href="/activity-log">Activity Log</a>
    </Actions>
</FilterBar>

<TableCard Title="Document Intake Register"
           Subtitle="@($"Showing {FilteredItems.Count()} of {TotalCount} intake record(s). {ActionableCount} currently need attention.")"
           IsEmpty="@(documentIntakeItems is not null && !FilteredItems.Any())"
           EmptyTitle="No intake records found"
           EmptyMessage="Adjust the current filters or add a new intake record.">
    <ChildContent>
        @if (documentIntakeItems == null)
        {
            <EmptyState Icon="⏳"
                        Title="Loading document intake..."
                        Message="Incoming document workflow records are loading." />
        }
        else
        {
            <div class="table-responsive">
                <table class="of-table">
                    <thead>
                        <tr>
                            <th>Document</th>
                            <th>Received From</th>
                            <th>Source</th>
                            <th>Type</th>
                            <th>Assigned To</th>
                            <th>Target System</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Files</th>
                            <th>Flag</th>
                            <th>Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredItems)
                        {
                            <tr>
                                <td>
                                    <strong>@item.DocumentName</strong>

                                    @if (!string.IsNullOrWhiteSpace(item.Notes))
                                    {
                                        <div class="helper-text">@item.Notes</div>
                                    }
                                </td>
                                <td>@DisplayText(item.ReceivedFrom)</td>
                                <td>@DisplayText(item.SourceType)</td>
                                <td>@DisplayText(item.DocumentType)</td>
                                <td>@DisplayText(item.AssignedTo)</td>
                                <td>@DisplayText(item.TargetSystem)</td>
                                <td>
                                    <span class="@GetPriorityClass(item.Priority)">
                                        @DisplayText(item.Priority)
                                    </span>
                                </td>
                                <td>
                                    <span class="@GetStatusClass(item.Status)">
                                        @DisplayText(item.Status)
                                    </span>
                                </td>
                                <td>
                                    @item.DueDate.ToString("dd MMM yyyy")

                                    @if (item.IsOverdue)
                                    {
                                        <div class="helper-text">@DaysPastDue(item.DueDate) day(s) overdue</div>
                                    }
                                    else if (item.IsDueSoon)
                                    {
                                        <div class="helper-text">Due in @DaysUntilDue(item.DueDate) day(s)</div>
                                    }
                                </td>
                                <td>
                                    <span class="@GetFileCountClass(item.Id)">
                                        @GetAttachmentCount(item.Id) file(s)
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsOverdue)
                                    {
                                        <span class="badge badge-danger">Overdue</span>
                                    }
                                    else if (item.NeedsReview)
                                    {
                                        <span class="badge badge-warning">Needs Review</span>
                                    }
                                    else if (item.IsDueSoon)
                                    {
                                        <span class="badge badge-info">Due Soon</span>
                                    }
                                    else if (item.IsCompleted)
                                    {
                                        <span class="badge badge-success">Complete</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-muted">On Track</span>
                                    }
                                </td>
                                <td>
                                    <a class="link-action" href="@($"/document-intake/details/{item.Id}")">Open</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </ChildContent>
</TableCard>

<InfoPanel Title="Document Intake Notes"
           Subtitle="How this module should be reviewed.">
    <ChildContent>
        <ul>
            <li>Open overdue and needs-review records first.</li>
            <li>Use the file count to confirm whether evidence has already been attached.</li>
            <li>Incoming documents should be attached to the intake record before being completed or rejected.</li>
            <li>Attached files should also appear in Document Library for cross-module review.</li>
            <li>Week 4 can swap the local provider to SharePoint without changing the intake workflow shape.</li>
        </ul>
    </ChildContent>
</InfoPanel>

@code {
    private List<DocumentIntakeModel>? documentIntakeItems;
    private Dictionary<int, int> attachmentCounts = new();

    private string searchText = "";
    private string statusFilter = "";
    private string sourceTypeFilter = "";
    private string targetSystemFilter = "";
    private string priorityFilter = "";

    private IEnumerable<DocumentIntakeModel> FilteredItems
    {
        get
        {
            if (documentIntakeItems == null)
            {
                return Enumerable.Empty<DocumentIntakeModel>();
            }

            var query = documentIntakeItems.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.DocumentName, searchText) ||
                    Contains(x.ReceivedFrom, searchText) ||
                    Contains(x.SourceType, searchText) ||
                    Contains(x.DocumentType, searchText) ||
                    Contains(x.AssignedTo, searchText) ||
                    Contains(x.TargetSystem, searchText) ||
                    Contains(x.Status, searchText) ||
                    Contains(x.Priority, searchText) ||
                    Contains(x.Notes, searchText));
            }

            if (!string.IsNullOrWhiteSpace(statusFilter))
            {
                query = query.Where(x => string.Equals(x.Status, statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(sourceTypeFilter))
            {
                query = query.Where(x => string.Equals(x.SourceType, sourceTypeFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(targetSystemFilter))
            {
                query = query.Where(x => string.Equals(x.TargetSystem, targetSystemFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(priorityFilter))
            {
                query = query.Where(x => string.Equals(x.Priority, priorityFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x => x.IsOverdue)
                .ThenByDescending(x => x.NeedsReview)
                .ThenByDescending(x => x.IsDueSoon)
                .ThenBy(x => x.DueDate)
                .ThenBy(x => x.DocumentName)
                .ToList();
        }
    }

    private int TotalCount => documentIntakeItems?.Count ?? 0;
    private int NeedsReviewCount => documentIntakeItems?.Count(x => x.NeedsReview) ?? 0;
    private int OverdueCount => documentIntakeItems?.Count(x => x.IsOverdue) ?? 0;
    private int DueSoonCount => documentIntakeItems?.Count(x => x.IsDueSoon) ?? 0;
    private int CompletedCount => documentIntakeItems?.Count(x => x.IsCompleted) ?? 0;
    private int ActionableCount => documentIntakeItems?.Count(x => x.IsOverdue || x.NeedsReview || x.IsDueSoon) ?? 0;
    private int TotalAttachmentCount => attachmentCounts.Values.Sum();

    private List<string> StatusOptions =>
        documentIntakeItems?
            .Select(x => x.Status)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> SourceTypeOptions =>
        documentIntakeItems?
            .Select(x => x.SourceType)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> TargetSystemOptions =>
        documentIntakeItems?
            .Select(x => x.TargetSystem)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> PriorityOptions =>
        documentIntakeItems?
            .Select(x => x.Priority)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    protected override async Task OnInitializedAsync()
    {
        documentIntakeItems = await Db.DocumentIntakeItems
            .AsNoTracking()
            .ToListAsync();

        await LoadAttachmentCountsAsync();
    }

    private async Task LoadAttachmentCountsAsync()
    {
        var attachments = await AttachmentService.GetAllActiveAsync();

        attachmentCounts = attachments
            .Where(x =>
                string.Equals(x.ModuleName, "Document Intake", StringComparison.OrdinalIgnoreCase) &&
                x.RecordId.HasValue)
            .GroupBy(x => x.RecordId!.Value)
            .ToDictionary(x => x.Key, x => x.Count());
    }

    private int GetAttachmentCount(int documentIntakeId)
    {
        return attachmentCounts.TryGetValue(documentIntakeId, out var count)
            ? count
            : 0;
    }

    private string GetFileCountClass(int documentIntakeId)
    {
        return GetAttachmentCount(documentIntakeId) > 0
            ? "badge badge-success"
            : "badge badge-muted";
    }

    private static int DaysPastDue(DateTime dueDate)
    {
        return Math.Max(0, (DateTime.Today - dueDate.Date).Days);
    }

    private static int DaysUntilDue(DateTime dueDate)
    {
        return Math.Max(0, (dueDate.Date - DateTime.Today).Days);
    }

    private static bool Contains(string? source, string search)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "rejected" => "badge badge-danger",
            "entered" => "badge badge-info",
            "data checked" => "badge badge-info",
            "needs review" => "badge badge-warning",
            "saved" => "badge badge-muted",
            "received" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }
}
