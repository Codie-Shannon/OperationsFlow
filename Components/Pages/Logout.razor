@page "/logout"
@rendermode InteractiveServer

@using OperationsFlow.Services
@inject LocalAuthService LocalAuthService
@inject LocalSessionStorageService LocalSessionStorageService
@inject NavigationManager Navigation

<PageTitle>Logout - OperationsFlow</PageTitle>

<PageHero Eyebrow="OPERATIONSFLOW / LOCAL LOGIN"
          Title="Logout"
          Subtitle="Signing out of the local SQL-backed Week 3 demo session."
          BadgeText="Local Auth"
          BadgeClass="of-badge of-badge-muted">
    <Actions>
        <a class="of-btn of-btn-primary" href="/login">Back to login</a>
    </Actions>
</PageHero>

<GuidanceNote Title="Signing out" Icon="🚪" Tone="info">
    <p>
        Clearing your local OperationsFlow session...
    </p>
</GuidanceNote>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        LocalAuthService.Logout();
        await LocalSessionStorageService.ClearSignedInUserIdAsync();
        await LocalSessionStorageService.ClearLegacyLocalStorageAsync();

        Navigation.NavigateTo("/login", replace: true);
    }
}