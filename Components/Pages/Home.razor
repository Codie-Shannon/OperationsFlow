@page "/dashboard"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@inject DashboardService DashboardService
@inject OperationsFlowDbContext Db

<PageTitle>OperationsFlow Dashboard</PageTitle>

@if (summary == null)
{
    <EmptyState Title="Loading dashboard" Message="Loading OperationsFlow dashboard data..." Icon="⏳" />
}
else
{
    <PageHero Eyebrow="Business Operations Prototype" Title="OperationsFlow Dashboard" Subtitle="Live overview of work orders, corrective actions, document control, risk register items, training compliance, document intake, and recent system activity." BadgeText="SQLite demo data live" BadgeClass="of-badge-success">
        <Actions><a class="of-btn of-btn-primary" href="/reviewer-checklist">Reviewer Checklist</a><a class="of-btn of-btn-secondary" href="/reports">Reports</a><a class="of-btn of-btn-secondary" href="/portfolio-hub">Portfolio Hub</a></Actions>
    </PageHero>

    <PurposeNote Title="Purpose" Icon="📊"><p>The dashboard gives the reviewer a fast read on operational work, overdue follow-up, compliance pressure, document intake, and system traceability.</p></PurposeNote>

    <MetricGrid>
        <MetricCard Title="Open Work Orders" Value="@summary.OpenWorkOrders.ToString()" Detail="@($"{summary.OverdueWorkOrders} overdue")" Icon="📋" Tone="warning" />
        <MetricCard Title="Overdue Actions" Value="@summary.OverdueCorrectiveActions.ToString()" Detail="@($"{summary.OpenCorrectiveActions} open actions")" Icon="✅" Tone="danger" />
        <MetricCard Title="Documents Due Soon" Value="@summary.DocumentsDueSoon.ToString()" Detail="@($"{summary.OverdueDocumentReviews} overdue reviews")" Icon="📄" Tone="info" />
        <MetricCard Title="High / Critical Risks" Value="@summary.HighOrCriticalRisks.ToString()" Detail="@($"{summary.TotalRisks} total risks")" Icon="⚠️" Tone="warning" />
        <MetricCard Title="Expired Training" Value="@summary.ExpiredTrainingRecords.ToString()" Detail="@($"{summary.TrainingExpiringSoon} expiring soon")" Icon="🎓" Tone="danger" />
        <MetricCard Title="Training Compliance" Value="@($"{summary.TrainingComplianceRate:0.0}%")" Detail="@($"{summary.TotalTrainingRecords} training records")" Icon="📈" Tone="success" />
        <MetricCard Title="Document Intake" Value="@summary.OpenDocumentIntakeItems.ToString()" Detail="@($"{summary.OverdueDocumentIntakeItems} overdue")" Icon="📥" Tone="info" />
    </MetricGrid>

    <InfoPanel Title="Core Workflow Modules" Subtitle="Open the main record groups from the dashboard."><ChildContent><div class="of-review-proof-grid"><a class="of-review-proof-card of-click-card" href="/work-orders"><strong>Work Orders</strong><span>Total @summary.TotalWorkOrders • Open @summary.OpenWorkOrders • Overdue @summary.OverdueWorkOrders</span></a><a class="of-review-proof-card of-click-card" href="/corrective-actions"><strong>Corrective Actions</strong><span>Total @summary.TotalCorrectiveActions • Open @summary.OpenCorrectiveActions • Overdue @summary.OverdueCorrectiveActions</span></a><a class="of-review-proof-card of-click-card" href="/documents"><strong>Document Control</strong><span>Total @summary.TotalDocuments • Due Soon @summary.DocumentsDueSoon • Overdue @summary.OverdueDocumentReviews</span></a><a class="of-review-proof-card of-click-card" href="/document-intake"><strong>Document Intake</strong><span>Total @summary.TotalDocumentIntakeItems • Needs Review @summary.DocumentIntakeNeedsReview • Overdue @summary.OverdueDocumentIntakeItems</span></a></div></ChildContent></InfoPanel>

    <InfoPanel Title="Compliance / Management Views" Subtitle="Use these pages for review, reporting, follow-up, and evidence."><ChildContent><div class="of-review-proof-grid"><a class="of-review-proof-card of-click-card" href="/risk-register"><strong>Risk Register</strong><span>Total @summary.TotalRisks • High/Critical @summary.HighOrCriticalRisks</span></a><a class="of-review-proof-card of-click-card" href="/training"><strong>Training</strong><span>Expired @summary.ExpiredTrainingRecords • Expiring @summary.TrainingExpiringSoon</span></a><a class="of-review-proof-card of-click-card" href="/reminders"><strong>Reminders</strong><span>Daily review view for overdue and due-soon work.</span></a><a class="of-review-proof-card of-click-card" href="/workload"><strong>Workload</strong><span>Owner pressure and assigned follow-up work.</span></a></div></ChildContent></InfoPanel>

    <TableCard Title="Recent Activity" Subtitle="Latest work order creation, edit, review, and workflow events." IsEmpty="@(recentActivities == null || !recentActivities.Any())" EmptyTitle="No activity yet" EmptyMessage="Create or edit records to generate activity history.">
        <Actions><a class="of-btn of-btn-secondary" href="/activity-log">View Full Log</a></Actions>
        <ChildContent><table><thead><tr><th>Date</th><th>Record</th><th>Description</th><th>Module</th><th>Action</th><th>By</th></tr></thead><tbody>@foreach(var item in recentActivities ?? new List<ActivityLog>()){<tr><td>@item.CreatedDate.ToString("dd MMM yyyy HH:mm")</td><td><strong>@item.RecordReference</strong></td><td>@item.Description</td><td>@item.ModuleName</td><td><span class="@GetActionClass(item.ActionType)">@item.ActionType</span></td><td>@item.CreatedBy</td></tr>}</tbody></table></ChildContent>
    </TableCard>

    <GuidanceNote Title="Review Notes" Icon="💡" Tone="info"><ul><li>Start here when reviewing the prototype.</li><li>Use the dashboard to jump into record pages, management pages, and evidence pages.</li><li>This is local SQLite demo data; Microsoft 365 sync is a later implementation stage.</li></ul></GuidanceNote>
}

@code { private DashboardSummary? summary; private List<ActivityLog>? recentActivities; protected override async Task OnInitializedAsync(){ summary=await DashboardService.GetDashboardSummaryAsync(); recentActivities=await Db.ActivityLogs.AsNoTracking().OrderByDescending(x=>x.CreatedDate).Take(8).ToListAsync(); } private static string GetActionClass(string? actionType)=>actionType?.ToLowerInvariant() switch {"created"=>"badge badge-success","updated"=>"badge badge-info","reviewed"=>"badge badge-muted","deleted"=>"badge badge-danger",_=>"badge badge-warning"}; }
