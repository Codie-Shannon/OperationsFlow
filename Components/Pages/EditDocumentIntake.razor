@page "/document-intake/edit/{Id:int}"
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake
@inject OperationsFlowDbContext Db
@inject ActivityLogService ActivityLogService
@inject NavigationManager Navigation

<PageTitle>Edit Document Intake - OperationsFlow</PageTitle>

<PageHero Eyebrow="Admin Workflow"
          Title="Edit Document Intake"
          Subtitle="Update document intake status, assigned person, target system, due date, completion state, and processing notes."
          BadgeText="@DisplayReference"
          BadgeClass="of-badge-info">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/document-intake">Back to Intake</a>
        <a class="of-btn of-btn-secondary" href="/workload">Workload</a>
        <a class="of-btn of-btn-secondary" href="/reminders">Reminders</a>
    </Actions>
</PageHero>

@if (isLoading)
{
    <InfoPanel Title="Loading Document Intake" Subtitle="Retrieving the selected document intake record.">
        <p class="of-muted-text">Loading document intake...</p>
    </InfoPanel>
}
else if (documentIntake == null)
{
    <EmptyState Title="Document intake record could not be found"
                Message="The record may have been removed, or the link may be using an invalid ID."
                Icon="⚠️"
                ActionText="Back to Intake"
                ActionHref="/document-intake" />
}
else
{
    <PurposeNote Title="Purpose" Icon="✏️">
        <p>
            Use this page to keep document processing ownership, target system, status,
            due date, completion state, and notes current. Changes feed Workload,
            Reminders, Reports, Data Quality, and Activity Log.
        </p>
    </PurposeNote>

    <MetricGrid>
        <MetricCard Title="Status"
                    Value="@DisplayText(documentIntake.Status)"
                    Detail="Update as processing moves forward"
                    Icon="🔄"
                    Tone="@GetStatusTone(documentIntake.Status)" />

        <MetricCard Title="Priority"
                    Value="@DisplayText(documentIntake.Priority)"
                    Detail="@DisplayText(documentIntake.DocumentType)"
                    Icon="⚡"
                    Tone="@GetPriorityTone(documentIntake.Priority)" />

        <MetricCard Title="Assigned To"
                    Value="@DisplayText(documentIntake.AssignedTo)"
                    Detail="@DisplayText(documentIntake.TargetSystem)"
                    Icon="👤" />

        <MetricCard Title="Due Date"
                    Value="@documentIntake.DueDate.ToString("dd MMM")"
                    Detail="@documentIntake.DueDate.ToString("yyyy")"
                    Icon="📅"
                    Tone="info" />
    </MetricGrid>

    <GuidanceNote Title="Before Saving" Icon="💡" Tone="info">
        <ul>
            <li>Confirm the assigned person still owns the next processing step.</li>
            <li>Update the target system if the destination has changed.</li>
            <li>Use completion date only when the item is completed or rejected.</li>
            <li>Add notes explaining what has been checked, entered, blocked, completed, or rejected.</li>
            <li>Completed or rejected records should have enough notes to explain the outcome.</li>
        </ul>
    </GuidanceNote>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <GuidanceNote Title="Save blocked" Icon="⚠️" Tone="danger">
            <p>@errorMessage</p>
        </GuidanceNote>
    }

    <InfoPanel Title="Edit Document Intake" Subtitle="Update the fields below and save the changes.">
        <ChildContent>
            <EditForm Model="documentIntake" OnSubmit="SaveDocumentIntake">
                <div class="of-form-grid">
                    <div class="of-form-field of-form-field--wide">
                        <label for="documentName">Document Name</label>
                        <InputText id="documentName" class="of-input" @bind-Value="documentIntake.DocumentName" />
                    </div>

                    <div class="of-form-field">
                        <label for="receivedDate">Received Date</label>
                        <InputDate id="receivedDate" class="of-input" @bind-Value="documentIntake.ReceivedDate" />
                    </div>

                    <div class="of-form-field">
                        <label for="receivedFrom">Received From</label>
                        <InputText id="receivedFrom" class="of-input" @bind-Value="documentIntake.ReceivedFrom" />
                    </div>

                    <div class="of-form-field">
                        <label for="sourceType">Source Type</label>
                        <InputSelect id="sourceType" class="of-select" @bind-Value="documentIntake.SourceType">
                            @foreach (var sourceType in SourceTypeOptions)
                            {
                                <option value="@sourceType">@sourceType</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="documentType">Document Type</label>
                        <InputSelect id="documentType" class="of-select" @bind-Value="documentIntake.DocumentType">
                            @foreach (var documentType in DocumentTypeOptions)
                            {
                                <option value="@documentType">@documentType</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="assignedTo">Assigned To</label>
                        <InputText id="assignedTo" class="of-input" @bind-Value="documentIntake.AssignedTo" />
                    </div>

                    <div class="of-form-field">
                        <label for="targetSystem">Target System</label>
                        <InputSelect id="targetSystem" class="of-select" @bind-Value="documentIntake.TargetSystem">
                            @foreach (var targetSystem in TargetSystemOptions)
                            {
                                <option value="@targetSystem">@targetSystem</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="priority">Priority</label>
                        <InputSelect id="priority" class="of-select" @bind-Value="documentIntake.Priority">
                            @foreach (var priority in PriorityOptions)
                            {
                                <option value="@priority">@priority</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="status">Status</label>
                        <InputSelect id="status" class="of-select" @bind-Value="documentIntake.Status">
                            @foreach (var status in StatusOptions)
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="dueDate">Due Date</label>
                        <InputDate id="dueDate" class="of-input" @bind-Value="documentIntake.DueDate" />
                    </div>

                    <div class="of-form-field">
                        <label for="completedDate">Completed Date</label>
                        <InputDate id="completedDate" class="of-input" @bind-Value="documentIntake.CompletedDate" />
                    </div>

                    <div class="of-form-field of-form-field--full">
                        <label for="notes">Notes</label>
                        <InputTextArea id="notes" class="of-textarea" @bind-Value="documentIntake.Notes" />
                    </div>
                </div>

                <div class="of-form-actions">
                    <button type="button" class="of-btn of-btn-secondary" @onclick="BackToReturnPage">Cancel</button>
                    <button type="submit" class="of-btn of-btn-primary">Save Changes</button>
                </div>
            </EditForm>
        </ChildContent>
    </InfoPanel>

    <ActivityHistoryPanel Title="Activity History"
                          Subtitle="Record-level traceability for this document intake item."
                          IsEmpty="@(!HasActivityHistory)"
                          EmptyTitle="No activity history yet"
                          EmptyMessage="Save this document intake record to create a reviewed or updated activity event.">
        <ChildContent>
            @if (HasActivityHistory)
            {
                <table class="of-activity-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>Description</th>
                            <th>Created By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in activityHistory)
                        {
                            <tr>
                                <td>@activity.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <span class="@GetActivityBadgeClass(activity.ActionType)">
                                        @activity.ActionType
                                    </span>
                                </td>
                                <td>@activity.Description</td>
                                <td>@activity.CreatedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </ActivityHistoryPanel>
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private DocumentIntakeModel? documentIntake;
    private List<ActivityLog> activityHistory = new();
    private bool isLoading = true;
    private string errorMessage = "";

    private string originalDocumentName = "";
    private string originalReceivedFrom = "";
    private string originalSourceType = "";
    private string originalDocumentType = "";
    private string originalAssignedTo = "";
    private string originalTargetSystem = "";
    private string originalStatus = "";
    private string originalPriority = "";
    private DateTime originalReceivedDate;
    private DateTime originalDueDate;
    private DateTime? originalCompletedDate;
    private string originalNotes = "";

    private bool HasActivityHistory => activityHistory.Any();

    private string DisplayReference => documentIntake == null ? "DI" : $"DI-{documentIntake.Id}";

    private readonly List<string> SourceTypeOptions = new()
    {
        "Email",
        "PDF",
        "Scanned Document",
        "Supplier Document",
        "Customer Request",
        "Internal Form"
    };

    private readonly List<string> DocumentTypeOptions = new()
    {
        "Supplier Invoice",
        "Supplier Statement",
        "Purchase Order",
        "Quote Request",
        "Delivery Docket",
        "Compliance Document",
        "Incident Evidence",
        "Specification",
        "Training Certificate",
        "Job Paperwork"
    };

    private readonly List<string> TargetSystemOptions = new()
    {
        "SharePoint",
        "Xero",
        "Cin7",
        "WorkflowMax",
        "Email Folder",
        "Internal System"
    };

    private readonly List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private readonly List<string> StatusOptions = new()
    {
        "Received",
        "Saved",
        "Needs Review",
        "Data Checked",
        "Entered",
        "Completed",
        "Rejected"
    };

    protected override async Task OnInitializedAsync()
    {
        documentIntake = await Db.DocumentIntakeItems
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (documentIntake != null)
        {
            CaptureOriginalValues();
            await LoadActivityHistory();
        }

        isLoading = false;
    }

    private async Task SaveDocumentIntake()
    {
        errorMessage = "";

        if (documentIntake == null)
        {
            errorMessage = "Document intake record could not be saved because it was not loaded.";
            return;
        }

        if (string.IsNullOrWhiteSpace(documentIntake.DocumentName))
        {
            errorMessage = "Please enter a document name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(documentIntake.ReceivedFrom))
        {
            errorMessage = "Please enter who the document was received from.";
            return;
        }

        if (string.IsNullOrWhiteSpace(documentIntake.AssignedTo))
        {
            errorMessage = "Please enter who this document is assigned to.";
            return;
        }

        if (documentIntake.DueDate.Date < documentIntake.ReceivedDate.Date)
        {
            errorMessage = "Due date cannot be before received date.";
            return;
        }

        if (IsCompletedStatus(documentIntake.Status) && documentIntake.CompletedDate == null)
        {
            documentIntake.CompletedDate = DateTime.Today;
        }

        if (!IsCompletedStatus(documentIntake.Status))
        {
            documentIntake.CompletedDate = null;
        }

        if (string.IsNullOrWhiteSpace(documentIntake.Notes))
        {
            documentIntake.Notes = BuildDefaultNotes();
        }

        var changeDescriptions = BuildChangeDescriptions();

        await Db.SaveChangesAsync();

        if (changeDescriptions.Any())
        {
            await ActivityLogService.LogAsync(
                moduleName: "Document Intake",
                recordId: documentIntake.Id,
                recordReference: $"DI-{documentIntake.Id}",
                actionType: GetSaveActionType(changeDescriptions),
                description: $"Updated document intake DI-{documentIntake.Id}: {string.Join("; ", changeDescriptions)}.");
        }
        else
        {
            await ActivityLogService.LogAsync(
                moduleName: "Document Intake",
                recordId: documentIntake.Id,
                recordReference: $"DI-{documentIntake.Id}",
                actionType: "Reviewed",
                description: $"Reviewed document intake DI-{documentIntake.Id} with no tracked field changes.");
        }

        CaptureOriginalValues();
        await LoadActivityHistory();
        BackToReturnPage();
    }

    private async Task LoadActivityHistory()
    {
        if (documentIntake == null)
        {
            activityHistory = new List<ActivityLog>();
            return;
        }

        activityHistory = await Db.ActivityLogs
            .AsNoTracking()
            .Where(x => x.ModuleName == "Document Intake" && x.RecordId == documentIntake.Id)
            .OrderByDescending(x => x.CreatedDate)
            .ToListAsync();
    }

    private List<string> BuildChangeDescriptions()
    {
        var changes = new List<string>();

        if (documentIntake == null)
        {
            return changes;
        }

        if (!string.Equals(originalDocumentName, documentIntake.DocumentName, StringComparison.Ordinal))
        {
            changes.Add($"document name changed from '{originalDocumentName}' to '{documentIntake.DocumentName}'");
        }

        if (originalReceivedDate.Date != documentIntake.ReceivedDate.Date)
        {
            changes.Add($"received date changed from {originalReceivedDate:dd MMM yyyy} to {documentIntake.ReceivedDate:dd MMM yyyy}");
        }

        if (!string.Equals(originalReceivedFrom, documentIntake.ReceivedFrom, StringComparison.Ordinal))
        {
            changes.Add($"received from changed from '{originalReceivedFrom}' to '{documentIntake.ReceivedFrom}'");
        }

        if (!string.Equals(originalSourceType, documentIntake.SourceType, StringComparison.Ordinal))
        {
            changes.Add($"source type changed from '{originalSourceType}' to '{documentIntake.SourceType}'");
        }

        if (!string.Equals(originalDocumentType, documentIntake.DocumentType, StringComparison.Ordinal))
        {
            changes.Add($"document type changed from '{originalDocumentType}' to '{documentIntake.DocumentType}'");
        }

        if (!string.Equals(originalAssignedTo, documentIntake.AssignedTo, StringComparison.Ordinal))
        {
            changes.Add($"assigned to changed from '{originalAssignedTo}' to '{documentIntake.AssignedTo}'");
        }

        if (!string.Equals(originalTargetSystem, documentIntake.TargetSystem, StringComparison.Ordinal))
        {
            changes.Add($"target system changed from '{originalTargetSystem}' to '{documentIntake.TargetSystem}'");
        }

        if (!string.Equals(originalStatus, documentIntake.Status, StringComparison.Ordinal))
        {
            changes.Add($"status changed from '{originalStatus}' to '{documentIntake.Status}'");
        }

        if (!string.Equals(originalPriority, documentIntake.Priority, StringComparison.Ordinal))
        {
            changes.Add($"priority changed from '{originalPriority}' to '{documentIntake.Priority}'");
        }

        if (originalDueDate.Date != documentIntake.DueDate.Date)
        {
            changes.Add($"due date changed from {originalDueDate:dd MMM yyyy} to {documentIntake.DueDate:dd MMM yyyy}");
        }

        if (originalCompletedDate?.Date != documentIntake.CompletedDate?.Date)
        {
            var oldDate = originalCompletedDate.HasValue ? originalCompletedDate.Value.ToString("dd MMM yyyy") : "not completed";
            var newDate = documentIntake.CompletedDate.HasValue ? documentIntake.CompletedDate.Value.ToString("dd MMM yyyy") : "not completed";
            changes.Add($"completed date changed from {oldDate} to {newDate}");
        }

        if (!string.Equals(originalNotes?.Trim(), documentIntake.Notes?.Trim(), StringComparison.Ordinal))
        {
            changes.Add("notes updated");
        }

        return changes;
    }

    private string BuildDefaultNotes()
    {
        if (documentIntake == null)
        {
            return "";
        }

        return "Document intake record reviewed."
            + Environment.NewLine + $"Source type: {documentIntake.SourceType}"
            + Environment.NewLine + $"Document type: {documentIntake.DocumentType}"
            + Environment.NewLine + $"Received from: {documentIntake.ReceivedFrom}"
            + Environment.NewLine + $"Target system: {documentIntake.TargetSystem}"
            + Environment.NewLine + "Next step: review, save, enter, complete, or reject the document.";
    }

    private void CaptureOriginalValues()
    {
        if (documentIntake == null)
        {
            return;
        }

        originalDocumentName = documentIntake.DocumentName;
        originalReceivedDate = documentIntake.ReceivedDate;
        originalReceivedFrom = documentIntake.ReceivedFrom;
        originalSourceType = documentIntake.SourceType;
        originalDocumentType = documentIntake.DocumentType;
        originalAssignedTo = documentIntake.AssignedTo;
        originalTargetSystem = documentIntake.TargetSystem;
        originalStatus = documentIntake.Status;
        originalPriority = documentIntake.Priority;
        originalDueDate = documentIntake.DueDate;
        originalCompletedDate = documentIntake.CompletedDate;
        originalNotes = documentIntake.Notes ?? "";
    }

    private static string GetSaveActionType(List<string> changes)
    {
        var statusChange = changes.FirstOrDefault(x =>
            x.StartsWith("status changed", StringComparison.OrdinalIgnoreCase));

        if (statusChange != null &&
            statusChange.Contains("Rejected", StringComparison.OrdinalIgnoreCase))
        {
            return "Rejected";
        }

        if (statusChange != null &&
            statusChange.Contains("Completed", StringComparison.OrdinalIgnoreCase))
        {
            return "Completed";
        }

        return "Updated";
    }

    private void BackToReturnPage()
    {
        const string fallbackUrl = "/document-intake";

        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        if (!ReturnUrl.StartsWith("/"))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        Navigation.NavigateTo(ReturnUrl);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static bool IsCompletedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetStatusTone(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "success",
            "rejected" => "danger",
            "entered" => "info",
            "data checked" => "info",
            "needs review" => "warning",
            "saved" => "default",
            "received" => "default",
            _ => "default"
        };
    }

    private static string GetPriorityTone(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "danger",
            "high" => "warning",
            "medium" => "info",
            "low" => "default",
            _ => "default"
        };
    }

    private static string GetActivityBadgeClass(string? actionType)
    {
        return actionType?.ToLowerInvariant() switch
        {
            "created" => "badge badge-success",
            "updated" => "badge badge-info",
            "reviewed" => "badge badge-secondary",
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "rejected" => "badge badge-danger",
            "deleted" => "badge badge-danger",
            _ => "badge badge-secondary"
        };
    }
}