@page "/safety-meeting-pack"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db

<PageTitle>Safety Meeting Pack - OperationsFlow</PageTitle>

<div class="operations-dashboard">
    <PageIntro Eyebrow="Safety / Compliance"
               Title="Safety Meeting Pack"
               Subtitle="A meeting-ready summary of open corrective actions, overdue follow-ups, high/critical risks, training issues, document reviews, and recent safety activity.">
        <a class="btn btn-secondary" href="compliance-dashboard">Safety Overview</a>
        <a class="btn btn-secondary" href="compliance-calendar">Compliance Calendar</a>
        <a class="btn btn-secondary" href="reports">Reports</a>
        <a class="btn btn-primary" href="activity-log">Activity Log</a>
    </PageIntro>

    <div class="page-purpose-note">
        <strong>Purpose:</strong> use this page to prepare safety/compliance meeting discussion points, confirm follow-up owners, and identify the records that need review before exporting reports.
    </div>

    <section class="kpi-grid">
        <div class="kpi-card">
            <span class="kpi-label">Attention Items</span>
            <strong>@AttentionItems</strong>
            <span class="kpi-note">Items to review in the meeting</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Open Actions</span>
            <strong>@OpenCorrectiveActions.Count</strong>
            <span class="kpi-note">@OverdueCorrectiveActions.Count overdue</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">High / Critical Risks</span>
            <strong>@HighCriticalRisks.Count</strong>
            <span class="kpi-note">@OverdueRiskReviews.Count overdue reviews</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Training Issues</span>
            <strong>@TrainingIssues.Count</strong>
            <span class="kpi-note">@ExpiredTraining.Count expired</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Document Reviews</span>
            <strong>@DocumentReviewIssues.Count</strong>
            <span class="kpi-note">@OverdueDocumentReviews.Count overdue</span>
        </div>
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Suggested Meeting Flow</h2>
                    <p>Use this order for a quick safety/compliance review.</p>
                </div>
            </div>

            <ol class="action-list">
                <li>Review overdue corrective actions and confirm current progress.</li>
                <li>Review high/critical risks and confirm controls are still valid.</li>
                <li>Confirm expired or expiring training records have follow-up owners.</li>
                <li>Review overdue or due-soon document reviews.</li>
                <li>Assign follow-up owners and due dates for anything not already owned.</li>
                <li>Use reports/CSV exports for meeting notes or management reporting.</li>
                <li>Check Activity Log for traceability after updates are made.</li>
            </ol>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Recommended Follow-Up Actions</h2>
                    <p>Practical next actions based on the current data.</p>
                </div>
            </div>

            <ul class="action-list">
                @if (OverdueCorrectiveActions.Any())
                {
                    <li>Review @OverdueCorrectiveActions.Count overdue corrective action(s) and update owner/status.</li>
                }

                @if (OverdueRiskReviews.Any())
                {
                    <li>Review @OverdueRiskReviews.Count overdue risk review(s) and confirm controls.</li>
                }

                @if (ExpiredTraining.Any())
                {
                    <li>Confirm retraining requirements for @ExpiredTraining.Count expired training record(s).</li>
                }

                @if (OverdueDocumentReviews.Any())
                {
                    <li>Review @OverdueDocumentReviews.Count overdue controlled document(s).</li>
                }

                @if (!OverdueCorrectiveActions.Any()
                    && !OverdueRiskReviews.Any()
                    && !ExpiredTraining.Any()
                    && !OverdueDocumentReviews.Any())
                {
                    <li>No urgent overdue compliance items found. Review due-soon items and upcoming work.</li>
                }
            </ul>
        </div>
    </section>

    <section class="summary-grid">
        <div class="report-card">
            <div class="panel-header">
                <div>
                    <h2>Overdue Corrective Actions</h2>
                    <p>Actions that should be discussed first.</p>
                </div>
                <a class="btn btn-secondary" href="corrective-actions">View Actions</a>
            </div>

            @if (!OverdueCorrectiveActions.Any())
            {
                <p class="empty-state">No overdue corrective actions found.</p>
            }
            else
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Owner</th>
                            <th>Priority</th>
                            <th>Due Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in OverdueCorrectiveActions)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Title</strong>
                                    <span class="muted-text">@SafeText(item.Source, "Manual / Internal")</span>
                                </td>
                                <td>@SafeText(item.Owner, "Unassigned")</td>
                                <td><span class="@GetPriorityClass(item.Priority)">@SafeText(item.Priority, "Unknown")</span></td>
                                <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="report-card">
            <div class="panel-header">
                <div>
                    <h2>High / Critical Risks</h2>
                    <p>Risk items requiring review or discussion.</p>
                </div>
                <a class="btn btn-secondary" href="risk-register">View Risk Register</a>
            </div>

            @if (!HighCriticalRisks.Any())
            {
                <p class="empty-state">No high or critical risks currently need attention.</p>
            }
            else
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Risk</th>
                            <th>Owner</th>
                            <th>Level</th>
                            <th>Review Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in HighCriticalRisks)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Title</strong>
                                    <span class="muted-text">@SafeText(item.Hazard, "No hazard notes")</span>
                                </td>
                                <td>@SafeText(item.Owner, "Unassigned")</td>
                                <td><span class="@GetRiskLevelClass(item.RiskLevel)">@item.RiskLevel</span></td>
                                <td>
                                    @item.ReviewDate.ToString("dd MMM yyyy")
                                    @if (item.IsReviewOverdue)
                                    {
                                        <span class="badge badge-danger">Overdue</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    <section class="summary-grid">
        <div class="report-card">
            <div class="panel-header">
                <div>
                    <h2>Expired / Expiring Training</h2>
                    <p>Training records needing confirmation or retraining follow-up.</p>
                </div>
                <a class="btn btn-secondary" href="training">View Training</a>
            </div>

            @if (!TrainingIssues.Any())
            {
                <p class="empty-state">No expired or expiring training records found.</p>
            }
            else
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Training</th>
                            <th>Person</th>
                            <th>Department</th>
                            <th>Expiry</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in TrainingIssues)
                        {
                            <tr>
                                <td>
                                    <strong>@item.TrainingName</strong>
                                    <span class="muted-text">@SafeText(item.Status, "No status")</span>
                                </td>
                                <td>@SafeText(item.StaffName, "Unknown")</td>
                                <td>@SafeText(item.Department, "Unknown")</td>
                                <td>
                                    @item.ExpiryDate.ToString("dd MMM yyyy")
                                    @if (item.IsExpired)
                                    {
                                        <span class="badge badge-danger">Expired</span>
                                    }
                                    else if (item.IsExpiringSoon)
                                    {
                                        <span class="badge badge-warning">Expiring Soon</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="report-card">
            <div class="panel-header">
                <div>
                    <h2>Document Review Issues</h2>
                    <p>Controlled documents overdue or due soon for review.</p>
                </div>
                <a class="btn btn-secondary" href="documents">View Documents</a>
            </div>

            @if (!DocumentReviewIssues.Any())
            {
                <p class="empty-state">No document reviews currently require attention.</p>
            }
            else
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Document</th>
                            <th>Owner</th>
                            <th>Review Date</th>
                            <th>Flag</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in DocumentReviewIssues)
                        {
                            <tr>
                                <td>
                                    <strong>@item.Title</strong>
                                    <span class="muted-text">@SafeText(item.Department, "Unknown department")</span>
                                </td>
                                <td>@SafeText(item.Owner, "Unassigned")</td>
                                <td>@item.NextReviewDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.IsReviewOverdue)
                                    {
                                        <span class="badge badge-danger">Overdue</span>
                                    }
                                    else if (item.IsDueSoon)
                                    {
                                        <span class="badge badge-warning">Due Soon</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success">Current</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    <section class="report-card">
        <div class="panel-header">
            <div>
                <h2>Recent Safety / Compliance Activity</h2>
                <p>Latest activity from corrective actions, risks, training, documents, and compliance work.</p>
            </div>
            <a class="btn btn-secondary" href="activity-log">View Activity Log</a>
        </div>

        @if (!RecentComplianceActivity.Any())
        {
            <p class="empty-state">No recent safety/compliance activity found.</p>
        }
        else
        {
            <div class="activity-list">
                @foreach (var item in RecentComplianceActivity)
                {
                    <div class="activity-list-item">
                        <div class="activity-date">
                            @item.CreatedDate.ToString("dd MMM yyyy")
                        </div>

                        <div class="activity-main">
                            <div class="activity-meta">
                                <span class="badge badge-info">@item.ModuleName</span>
                                <span class="badge badge-muted">@item.ActionType</span>
                            </div>

                            <div class="activity-description">
                                @CleanActivityDescription(item)
                            </div>
                        </div>

                        <div class="activity-by">
                            @SafeText(item.CreatedBy, "Demo User")
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

@code {
    private List<CorrectiveAction> correctiveActions = new();
    private List<RiskItem> risks = new();
    private List<TrainingRecord> trainingRecords = new();
    private List<DocumentRecord> documents = new();
    private List<ActivityLog> activityLogs = new();

    private List<CorrectiveAction> OpenCorrectiveActions =>
        correctiveActions
            .Where(x => !IsClosedStatus(x.Status))
            .OrderBy(x => x.DueDate)
            .ThenBy(x => x.Title)
            .ToList();

    private List<CorrectiveAction> OverdueCorrectiveActions =>
        correctiveActions
            .Where(x => x.IsOverdue)
            .OrderBy(x => x.DueDate)
            .ThenBy(x => x.Title)
            .ToList();

    private List<RiskItem> HighCriticalRisks =>
        risks
            .Where(x => x.RiskLevel == "High" || x.RiskLevel == "Critical")
            .OrderBy(x => GetRiskSortOrder(x.RiskLevel))
            .ThenBy(x => x.ReviewDate)
            .ThenBy(x => x.Title)
            .ToList();

    private List<RiskItem> OverdueRiskReviews =>
        risks
            .Where(x => x.IsReviewOverdue)
            .OrderBy(x => x.ReviewDate)
            .ThenBy(x => x.Title)
            .ToList();

    private List<TrainingRecord> ExpiredTraining =>
        trainingRecords
            .Where(x => x.IsRequired && x.IsExpired)
            .OrderBy(x => x.ExpiryDate)
            .ThenBy(x => x.StaffName)
            .ToList();

    private List<TrainingRecord> ExpiringTraining =>
        trainingRecords
            .Where(x => x.IsRequired && x.IsExpiringSoon && !x.IsExpired)
            .OrderBy(x => x.ExpiryDate)
            .ThenBy(x => x.StaffName)
            .ToList();

    private List<TrainingRecord> TrainingIssues =>
        trainingRecords
            .Where(x => x.IsRequired && (x.IsExpired || x.IsExpiringSoon))
            .OrderByDescending(x => x.IsExpired)
            .ThenBy(x => x.ExpiryDate)
            .ThenBy(x => x.StaffName)
            .ToList();

    private List<DocumentRecord> OverdueDocumentReviews =>
        documents
            .Where(x => x.IsReviewOverdue)
            .OrderBy(x => x.NextReviewDate)
            .ThenBy(x => x.Title)
            .ToList();

    private List<DocumentRecord> DueSoonDocumentReviews =>
        documents
            .Where(x => x.IsDueSoon && !x.IsReviewOverdue)
            .OrderBy(x => x.NextReviewDate)
            .ThenBy(x => x.Title)
            .ToList();

    private List<DocumentRecord> DocumentReviewIssues =>
        documents
            .Where(x => x.IsReviewOverdue || x.IsDueSoon)
            .OrderByDescending(x => x.IsReviewOverdue)
            .ThenBy(x => x.NextReviewDate)
            .ThenBy(x => x.Title)
            .ToList();

    private List<ActivityLog> RecentComplianceActivity =>
        activityLogs
            .Where(x =>
                x.ModuleName.Contains("Corrective", StringComparison.OrdinalIgnoreCase)
                || x.ModuleName.Contains("Risk", StringComparison.OrdinalIgnoreCase)
                || x.ModuleName.Contains("Training", StringComparison.OrdinalIgnoreCase)
                || x.ModuleName.Contains("Document", StringComparison.OrdinalIgnoreCase)
                || x.ModuleName.Contains("Compliance", StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(x => x.CreatedDate)
            .Take(10)
            .ToList();

    private int AttentionItems =>
        OverdueCorrectiveActions.Count
        + HighCriticalRisks.Count
        + ExpiredTraining.Count
        + ExpiringTraining.Count
        + OverdueDocumentReviews.Count
        + DueSoonDocumentReviews.Count;

    protected override async Task OnInitializedAsync()
    {
        correctiveActions = await Db.CorrectiveActions
            .AsNoTracking()
            .ToListAsync();

        risks = await Db.RiskItems
            .AsNoTracking()
            .ToListAsync();

        trainingRecords = await Db.TrainingRecords
            .AsNoTracking()
            .ToListAsync();

        documents = await Db.DocumentRecords
            .AsNoTracking()
            .ToListAsync();

        activityLogs = await Db.ActivityLogs
            .AsNoTracking()
            .ToListAsync();
    }

    private static bool IsClosedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase);
    }

    private static string SafeText(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string CleanActivityDescription(ActivityLog item)
    {
        var description = SafeText(item.Description, "No description recorded.");

        if (!string.IsNullOrWhiteSpace(item.ActionType)
            && description.StartsWith(item.ActionType, StringComparison.OrdinalIgnoreCase))
        {
            description = description[item.ActionType.Length..].TrimStart();
        }

        return description;
    }

    private static int GetRiskSortOrder(string? level)
    {
        return level?.ToLower() switch
        {
            "critical" => 1,
            "high" => 2,
            "medium" => 3,
            "low" => 4,
            _ => 99
        };
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLower() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetRiskLevelClass(string? level)
    {
        return level?.ToLower() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }
}