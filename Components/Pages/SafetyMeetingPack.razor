@page "/safety-meeting-pack"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db

<PageTitle>Safety Meeting Pack - OperationsFlow</PageTitle>
<PageHero Eyebrow="Meeting Pack" Title="Safety Meeting Pack" Subtitle="Safety/compliance meeting discussion points, follow-up owners, overdue work, risks, training issues, document reviews, and recent activity." BadgeText="@($"{AttentionItems} items")" BadgeClass="@(AttentionItems > 0 ? "of-badge-warning" : "of-badge-success")"><Actions><a class="of-btn of-btn-secondary" href="/compliance-dashboard">Safety Overview</a><a class="of-btn of-btn-secondary" href="/compliance-calendar">Calendar</a><a class="of-btn of-btn-secondary" href="/reports">Reports</a><a class="of-btn of-btn-secondary" href="/activity-log">Activity Log</a></Actions></PageHero>
<PurposeNote Title="Purpose" Icon="🗂️"><p>Use this page to prepare safety/compliance meeting discussion points, confirm follow-up owners, and identify records that need review before exporting reports.</p></PurposeNote>
<MetricGrid><MetricCard Title="Attention Items" Value="@AttentionItems.ToString()" Detail="Items to review" Icon="🚨" Tone="warning"/><MetricCard Title="Open Actions" Value="@OpenCorrectiveActions.Count.ToString()" Detail="@($"{OverdueCorrectiveActions.Count} overdue")" Icon="✅" Tone="danger"/><MetricCard Title="High / Critical Risks" Value="@HighCriticalRisks.Count.ToString()" Detail="@($"{OverdueRiskReviews.Count} overdue reviews")" Icon="⚠️" Tone="warning"/><MetricCard Title="Training Issues" Value="@TrainingIssues.Count.ToString()" Detail="@($"{ExpiredTraining.Count} expired")" Icon="🎓" Tone="info"/><MetricCard Title="Document Reviews" Value="@DocumentReviewIssues.Count.ToString()" Detail="@($"{OverdueDocumentReviews.Count} overdue")" Icon="📄" Tone="info"/></MetricGrid>
<InfoPanel Title="Suggested Meeting Flow" Subtitle="Use this order for a quick safety/compliance review."><ChildContent><ol class="of-review-steps"><li>Review overdue corrective actions and confirm current progress.</li><li>Review high/critical risks and confirm controls are still valid.</li><li>Confirm expired or expiring training records have follow-up owners.</li><li>Review overdue or due-soon document reviews.</li><li>Assign follow-up owners and due dates for anything not already owned.</li><li>Check Activity Log for traceability after updates are made.</li></ol></ChildContent></InfoPanel>
<InfoPanel Title="Recommended Follow-Up Actions" Subtitle="Practical next actions based on current data."><ChildContent><ul>@if(OverdueCorrectiveActions.Any()){<li>Review @OverdueCorrectiveActions.Count overdue corrective action(s) and update owner/status.</li>}@if(OverdueRiskReviews.Any()){<li>Review @OverdueRiskReviews.Count overdue risk review(s) and confirm controls.</li>}@if(ExpiredTraining.Any()){<li>Confirm retraining requirements for @ExpiredTraining.Count expired training record(s).</li>}@if(OverdueDocumentReviews.Any()){<li>Review @OverdueDocumentReviews.Count overdue controlled document(s).</li>}@if(!OverdueCorrectiveActions.Any()&&!OverdueRiskReviews.Any()&&!ExpiredTraining.Any()&&!OverdueDocumentReviews.Any()){<li>No urgent overdue compliance items found. Review due-soon items and upcoming work.</li>}</ul></ChildContent></InfoPanel>
<div class="of-two-column-grid"><TableCard Title="Overdue Corrective Actions" Subtitle="Actions that should be discussed first." IsEmpty="@(!OverdueCorrectiveActions.Any())" EmptyTitle="No overdue corrective actions" EmptyMessage="No overdue corrective actions found."><Actions><a class="of-btn of-btn-secondary" href="/corrective-actions">View Actions</a></Actions><ChildContent><table><thead><tr><th>Action</th><th>Owner</th><th>Priority</th><th>Due</th></tr></thead><tbody>@foreach(var item in OverdueCorrectiveActions){<tr><td><strong>@item.Title</strong><div class="of-muted-text">@SafeText(item.Source,"Manual / Internal")</div></td><td>@SafeText(item.Owner,"Unassigned")</td><td><span class="@GetPriorityClass(item.Priority)">@SafeText(item.Priority,"Unknown")</span></td><td>@item.DueDate.ToString("dd MMM yyyy")</td></tr>}</tbody></table></ChildContent></TableCard><TableCard Title="High / Critical Risks" Subtitle="Risk items requiring review or discussion." IsEmpty="@(!HighCriticalRisks.Any())" EmptyTitle="No high or critical risks" EmptyMessage="No high or critical risks currently need attention."><Actions><a class="of-btn of-btn-secondary" href="/risk-register">View Risk Register</a></Actions><ChildContent><table><thead><tr><th>Risk</th><th>Owner</th><th>Level</th><th>Review</th></tr></thead><tbody>@foreach(var item in HighCriticalRisks){<tr><td><strong>@item.Title</strong><div class="of-muted-text">@SafeText(item.Hazard,"No hazard notes")</div></td><td>@SafeText(item.Owner,"Unassigned")</td><td><span class="@GetRiskLevelClass(item.RiskLevel)">@item.RiskLevel</span></td><td>@item.ReviewDate.ToString("dd MMM yyyy")</td></tr>}</tbody></table></ChildContent></TableCard></div>
<div class="of-two-column-grid"><TableCard Title="Expired / Expiring Training" Subtitle="Training records needing confirmation or retraining follow-up." IsEmpty="@(!TrainingIssues.Any())" EmptyTitle="No training issues" EmptyMessage="No expired or expiring training records found."><Actions><a class="of-btn of-btn-secondary" href="/training">View Training</a></Actions><ChildContent><table><thead><tr><th>Training</th><th>Person</th><th>Department</th><th>Expiry</th></tr></thead><tbody>@foreach(var item in TrainingIssues){<tr><td><strong>@item.TrainingName</strong><div class="of-muted-text">@SafeText(item.Status,"No status")</div></td><td>@SafeText(item.StaffName,"Unknown")</td><td>@SafeText(item.Department,"Unknown")</td><td>@item.ExpiryDate.ToString("dd MMM yyyy")</td></tr>}</tbody></table></ChildContent></TableCard><TableCard Title="Document Review Issues" Subtitle="Controlled documents overdue or due soon for review." IsEmpty="@(!DocumentReviewIssues.Any())" EmptyTitle="No document review issues" EmptyMessage="No document reviews currently require attention."><Actions><a class="of-btn of-btn-secondary" href="/documents">View Documents</a></Actions><ChildContent><table><thead><tr><th>Document</th><th>Owner</th><th>Review Date</th><th>Flag</th></tr></thead><tbody>@foreach(var item in DocumentReviewIssues){<tr><td><strong>@item.Title</strong><div class="of-muted-text">@SafeText(item.Department,"Unknown")</div></td><td>@SafeText(item.Owner,"Unassigned")</td><td>@item.NextReviewDate.ToString("dd MMM yyyy")</td><td>@if(item.IsReviewOverdue){<span class="badge badge-danger">Overdue</span>}else{<span class="badge badge-warning">Due Soon</span>}</td></tr>}</tbody></table></ChildContent></TableCard></div>
<TableCard Title="Recent Safety / Compliance Activity" Subtitle="Latest activity from corrective actions, risks, training, documents, and compliance work." IsEmpty="@(!RecentComplianceActivity.Any())" EmptyTitle="No recent safety/compliance activity" EmptyMessage="No recent safety/compliance activity found."><Actions><a class="of-btn of-btn-secondary" href="/activity-log">View Activity Log</a></Actions><ChildContent><table><thead><tr><th>Date</th><th>Module</th><th>Action</th><th>Description</th><th>By</th></tr></thead><tbody>@foreach(var item in RecentComplianceActivity){<tr><td>@item.CreatedDate.ToString("dd MMM yyyy")</td><td>@item.ModuleName</td><td><span class="badge badge-info">@item.ActionType</span></td><td>@CleanActivityDescription(item)</td><td>@SafeText(item.CreatedBy,"Demo User")</td></tr>}</tbody></table></ChildContent></TableCard>
<GuidanceNote Title="Review Notes" Icon="💡" Tone="info"><ul><li>Use this as the meeting pack before updating records.</li><li>After updating items, check Activity Log for traceability.</li><li>This is local SQLite demo data; production packs could export to PDF or Power BI.</li></ul></GuidanceNote>
@code { private List<CorrectiveAction> correctiveActions=new(); private List<RiskItem> risks=new(); private List<TrainingRecord> trainingRecords=new(); private List<DocumentRecord> documents=new(); private List<ActivityLog> activityLogs=new(); private List<CorrectiveAction> OpenCorrectiveActions=>correctiveActions.Where(x=>!IsClosedStatus(x.Status)).OrderBy(x=>x.DueDate).ToList(); private List<CorrectiveAction> OverdueCorrectiveActions=>correctiveActions.Where(x=>x.IsOverdue).OrderBy(x=>x.DueDate).ToList(); private List<RiskItem> HighCriticalRisks=>risks.Where(x=>x.RiskLevel=="High"||x.RiskLevel=="Critical").OrderBy(x=>GetRiskSortOrder(x.RiskLevel)).ThenBy(x=>x.ReviewDate).ToList(); private List<RiskItem> OverdueRiskReviews=>risks.Where(x=>x.IsReviewOverdue).OrderBy(x=>x.ReviewDate).ToList(); private List<TrainingRecord> ExpiredTraining=>trainingRecords.Where(x=>x.IsRequired&&x.IsExpired).OrderBy(x=>x.ExpiryDate).ToList(); private List<TrainingRecord> ExpiringTraining=>trainingRecords.Where(x=>x.IsRequired&&x.IsExpiringSoon&&!x.IsExpired).OrderBy(x=>x.ExpiryDate).ToList(); private List<TrainingRecord> TrainingIssues=>trainingRecords.Where(x=>x.IsRequired&&(x.IsExpired||x.IsExpiringSoon)).OrderByDescending(x=>x.IsExpired).ThenBy(x=>x.ExpiryDate).ToList(); private List<DocumentRecord> OverdueDocumentReviews=>documents.Where(x=>x.IsReviewOverdue).OrderBy(x=>x.NextReviewDate).ToList(); private List<DocumentRecord> DueSoonDocumentReviews=>documents.Where(x=>x.IsDueSoon&&!x.IsReviewOverdue).OrderBy(x=>x.NextReviewDate).ToList(); private List<DocumentRecord> DocumentReviewIssues=>documents.Where(x=>x.IsReviewOverdue||x.IsDueSoon).OrderByDescending(x=>x.IsReviewOverdue).ThenBy(x=>x.NextReviewDate).ToList(); private List<ActivityLog> RecentComplianceActivity=>activityLogs.Where(x=>(x.ModuleName??"").Contains("Corrective",StringComparison.OrdinalIgnoreCase)||(x.ModuleName??"").Contains("Risk",StringComparison.OrdinalIgnoreCase)||(x.ModuleName??"").Contains("Training",StringComparison.OrdinalIgnoreCase)||(x.ModuleName??"").Contains("Document",StringComparison.OrdinalIgnoreCase)||(x.ModuleName??"").Contains("Compliance",StringComparison.OrdinalIgnoreCase)).OrderByDescending(x=>x.CreatedDate).Take(10).ToList(); private int AttentionItems=>OverdueCorrectiveActions.Count+HighCriticalRisks.Count+ExpiredTraining.Count+ExpiringTraining.Count+OverdueDocumentReviews.Count+DueSoonDocumentReviews.Count; protected override async Task OnInitializedAsync(){correctiveActions=await Db.CorrectiveActions.AsNoTracking().ToListAsync();risks=await Db.RiskItems.AsNoTracking().ToListAsync();trainingRecords=await Db.TrainingRecords.AsNoTracking().ToListAsync();documents=await Db.DocumentRecords.AsNoTracking().ToListAsync();activityLogs=await Db.ActivityLogs.AsNoTracking().ToListAsync();} private static bool IsClosedStatus(string? status)=>string.Equals(status,"Completed",StringComparison.OrdinalIgnoreCase)||string.Equals(status,"Closed",StringComparison.OrdinalIgnoreCase)||string.Equals(status,"Rejected",StringComparison.OrdinalIgnoreCase); private static string SafeText(string? value,string fallback)=>string.IsNullOrWhiteSpace(value)?fallback:value; private static string CleanActivityDescription(ActivityLog item)=>SafeText(item.Description,"No description recorded."); private static int GetRiskSortOrder(string? level)=>level?.ToLowerInvariant() switch{"critical"=>1,"high"=>2,"medium"=>3,"low"=>4,_=>99}; private static string GetPriorityClass(string? priority)=>priority?.ToLowerInvariant() switch{"critical"=>"badge badge-danger","high"=>"badge badge-warning","medium"=>"badge badge-info","low"=>"badge badge-muted",_=>"badge badge-muted"}; private static string GetRiskLevelClass(string? level)=>level?.ToLowerInvariant() switch{"critical"=>"badge badge-danger","high"=>"badge badge-warning","medium"=>"badge badge-info","low"=>"badge badge-muted",_=>"badge badge-muted"}; }
