@page "/work-orders/create"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@inject OperationsFlowDbContext Db
@inject ActivityLogService ActivityLogService
@inject NavigationManager Navigation

<PageTitle>Create Work Order - OperationsFlow</PageTitle>

<PageHero Eyebrow="Operations"
          Title="Create Work Order"
          Subtitle="Add a new operational work request with owner, site, department, type, priority, status, due date, and notes."
          BadgeText="New Record"
          BadgeClass="of-badge-info">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/work-orders">Back to Work Orders</a>
        <a class="of-btn of-btn-secondary" href="/workload">Workload</a>
        <a class="of-btn of-btn-secondary" href="/reminders">Reminders</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="🛠️">
    <p>
        Use this page to capture operational follow-up work before it gets lost in messages,
        verbal requests, paper notes, or workshop/admin handovers. Once saved, the work order
        appears in Work Orders, Workload, Reminders, Reports, Data Quality, and Activity Log.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Record Type"
                Value="WO"
                Detail="Operational work request"
                Icon="📋" />

    <MetricCard Title="Default Status"
                Value="@workOrder.Status"
                Detail="New records start as open work"
                Icon="🟡"
                Tone="warning" />

    <MetricCard Title="Default Priority"
                Value="@workOrder.Priority"
                Detail="Adjust if the task is urgent"
                Icon="⚡"
                Tone="info" />

    <MetricCard Title="Due Date"
                Value="@workOrder.DueDate.ToString("dd MMM")"
                Detail="@workOrder.DueDate.ToString("yyyy")"
                Icon="📅"
                Tone="success" />
</MetricGrid>

<InfoPanel Title="Work Order Workflow" Subtitle="What this record is expected to track.">
    <ChildContent>
        <div class="of-two-column-grid">
            <GuidanceNote Title="Record should answer" Icon="✅" Tone="success">
                <ul>
                    <li>What operational task or issue needs follow-up?</li>
                    <li>Where is the work located?</li>
                    <li>Which department or area owns the work?</li>
                    <li>Who is responsible for progressing it?</li>
                    <li>Whether it is open, in progress, completed, or closed.</li>
                </ul>
            </GuidanceNote>

            <GuidanceNote Title="Before saving" Icon="💡" Tone="info">
                <ul>
                    <li>Use a clear title that describes the actual work.</li>
                    <li>Assign one owner so workload and reminders stay accurate.</li>
                    <li>Select the right site, department, and work type.</li>
                    <li>Use a realistic due date so overdue work is visible.</li>
                    <li>Add notes explaining the current state or next step.</li>
                </ul>
            </GuidanceNote>
        </div>
    </ChildContent>
</InfoPanel>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <GuidanceNote Title="Save blocked" Icon="⚠️" Tone="danger">
        <p>@errorMessage</p>
    </GuidanceNote>
}

<InfoPanel Title="New Work Order" Subtitle="Complete the fields below and save the record.">
    <ChildContent>
        <EditForm Model="workOrder" OnSubmit="SaveWorkOrder">
            <div class="of-form-grid">
                <div class="of-form-field">
                    <label for="workOrderNumber">Work Order Number</label>
                    <InputText id="workOrderNumber" class="of-input" @bind-Value="workOrder.WorkOrderNumber" />
                </div>

                <div class="of-form-field of-form-field--wide">
                    <label for="title">Title</label>
                    <InputText id="title" class="of-input" @bind-Value="workOrder.Title" />
                </div>

                <div class="of-form-field">
                    <label for="site">Site</label>
                    <InputSelect id="site" class="of-select" @bind-Value="workOrder.Site">
                        @foreach (var site in SiteOptions)
                        {
                            <option value="@site">@site</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="department">Department</label>
                    <InputSelect id="department" class="of-select" @bind-Value="workOrder.Department">
                        @foreach (var department in DepartmentOptions)
                        {
                            <option value="@department">@department</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="owner">Owner</label>
                    <InputText id="owner" class="of-input" @bind-Value="workOrder.Owner" />
                </div>

                <div class="of-form-field">
                    <label for="type">Type</label>
                    <InputSelect id="type" class="of-select" @bind-Value="workOrder.Type">
                        @foreach (var type in TypeOptions)
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="priority">Priority</label>
                    <InputSelect id="priority" class="of-select" @bind-Value="workOrder.Priority">
                        @foreach (var priority in PriorityOptions)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="status">Status</label>
                    <InputSelect id="status" class="of-select" @bind-Value="workOrder.Status">
                        @foreach (var status in StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="createdDate">Created Date</label>
                    <InputDate id="createdDate" class="of-input" @bind-Value="workOrder.CreatedDate" />
                </div>

                <div class="of-form-field">
                    <label for="dueDate">Due Date</label>
                    <InputDate id="dueDate" class="of-input" @bind-Value="workOrder.DueDate" />
                </div>

                <div class="of-form-field of-form-field--full">
                    <label for="notes">Notes</label>
                    <InputTextArea id="notes" class="of-textarea" @bind-Value="workOrder.Notes" />
                </div>
            </div>

            <div class="of-form-actions">
                <button type="button" class="of-btn of-btn-secondary" @onclick="Cancel">Cancel</button>
                <button type="submit" class="of-btn of-btn-primary">Save Work Order</button>
            </div>
        </EditForm>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="After Saving" Subtitle="This work order becomes part of the wider workflow.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Work Orders</strong>
                <span>The saved record can be searched, filtered, edited, and opened from details.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Workload</strong>
                <span>The assigned owner appears in workload pressure and due-date visibility.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Reminders</strong>
                <span>Past-due work orders appear in Reminder Centre and follow-up views.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Traceability</strong>
                <span>The Activity Log records that this work order was created.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Prototype Boundary" Icon="🧱" Tone="warning">
    <ul>
        <li>This page tracks work order workflow metadata.</li>
        <li>It does not currently handle attachments, job costing, or inventory reservations.</li>
        <li>It does not currently sync to WorkflowMax, Xero, Cin7, Outlook, or Teams.</li>
        <li>A production version would add permissions, audit rules, attachments, integrations, and approval rules.</li>
    </ul>
</GuidanceNote>

@code {
    private WorkOrder workOrder = new();
    private string errorMessage = "";

    private readonly List<string> SiteOptions = new()
    {
        "Main Workshop",
        "Yard",
        "Admin Office",
        "Warehouse",
        "Dispatch Bay"
    };

    private readonly List<string> DepartmentOptions = new()
    {
        "Operations",
        "Health & Safety",
        "Admin",
        "Maintenance",
        "Warehouse",
        "Dispatch",
        "Quality"
    };

    private readonly List<string> TypeOptions = new()
    {
        "Maintenance",
        "Repair",
        "Supply",
        "Admin",
        "Compliance",
        "Inspection",
        "Preventative Maintenance",
        "Site Improvement",
        "IT Support"
    };

    private readonly List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private readonly List<string> StatusOptions = new()
    {
        "Open",
        "In Progress",
        "Completed",
        "Closed"
    };

    protected override async Task OnInitializedAsync()
    {
        workOrder = new WorkOrder
        {
            WorkOrderNumber = await GenerateNextWorkOrderNumber(),
            Title = "",
            Site = "Main Workshop",
            Department = "Operations",
            Owner = "",
            Type = "Maintenance",
            Priority = "Medium",
            Status = "Open",
            CreatedDate = DateTime.Today,
            DueDate = DateTime.Today.AddDays(7),
            Notes = ""
        };
    }

    private async Task<string> GenerateNextWorkOrderNumber()
    {
        var existingWorkOrders = await Db.WorkOrders
            .AsNoTracking()
            .ToListAsync();

        if (!existingWorkOrders.Any())
        {
            return "WO-1001";
        }

        var highestNumber = existingWorkOrders
            .Select(x => ExtractWorkOrderNumber(x.WorkOrderNumber))
            .DefaultIfEmpty(1000)
            .Max();

        return $"WO-{highestNumber + 1}";
    }

    private static int ExtractWorkOrderNumber(string? workOrderNumber)
    {
        if (string.IsNullOrWhiteSpace(workOrderNumber))
        {
            return 1000;
        }

        var cleaned = workOrderNumber
            .Replace("WO-", "", StringComparison.OrdinalIgnoreCase)
            .Trim();

        return int.TryParse(cleaned, out var number) ? number : 1000;
    }

    private async Task SaveWorkOrder()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(workOrder.WorkOrderNumber))
        {
            errorMessage = "Please enter a work order number.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.Title))
        {
            errorMessage = "Please enter a title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.Owner))
        {
            errorMessage = "Please enter an owner.";
            return;
        }

        if (workOrder.DueDate.Date < workOrder.CreatedDate.Date)
        {
            errorMessage = "Due date cannot be before created date.";
            return;
        }

        var duplicateNumberExists = await Db.WorkOrders
            .AnyAsync(x => x.WorkOrderNumber == workOrder.WorkOrderNumber);

        if (duplicateNumberExists)
        {
            errorMessage = "A work order with this number already exists.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.Notes))
        {
            workOrder.Notes = BuildDefaultNotes();
        }

        Db.WorkOrders.Add(workOrder);
        await Db.SaveChangesAsync();

        await ActivityLogService.LogAsync(
            moduleName: "Work Orders",
            recordId: workOrder.Id,
            recordReference: workOrder.WorkOrderNumber,
            actionType: "Created",
            description: BuildCreatedDescription());

        Navigation.NavigateTo("/work-orders");
    }

    private string BuildCreatedDescription()
    {
        return $"Created work order {workOrder.WorkOrderNumber}: {workOrder.Title}. Assigned to {workOrder.Owner}, priority {workOrder.Priority}, status {workOrder.Status}.";
    }

    private string BuildDefaultNotes()
    {
        return "Initial work order created."
            + Environment.NewLine + $"Site: {workOrder.Site}"
            + Environment.NewLine + $"Department: {workOrder.Department}"
            + Environment.NewLine + $"Type: {workOrder.Type}"
            + Environment.NewLine + $"Owner: {workOrder.Owner}"
            + Environment.NewLine + "Next step: review, progress, complete, or close the work order.";
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/work-orders");
    }
}