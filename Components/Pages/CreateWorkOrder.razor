@page "/work-orders/create"

@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services

@inject OperationsFlowDbContext Db
@inject ActivityLogService ActivityLogService
@inject NavigationManager Navigation

<PageTitle>Create Work Order - OperationsFlow</PageTitle>

<div class="page-shell module-page work-order-create-page">
    <section class="module-header">
        <div>
            <p class="eyebrow dark">Operations</p>
            <h1>Create Work Order</h1>
            <p>
                Add a new operational work request with owner, site, department, type,
                priority, status, due date, and notes.
            </p>
        </div>

        <div class="module-header-stat">
            <span>New Record</span>
            <strong>WO</strong>
        </div>
    </section>

    <section class="page-purpose-note">
        <strong>Purpose:</strong> use this page to capture operational follow-up work before it gets lost in
        messages, verbal requests, paper notes, or workshop/admin handovers. Once saved, the work order appears
        in Work Orders, Workload, Reminders, Reports, Data Quality, and Activity Log.
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Work Order Workflow</h2>
                    <p>What this record is expected to track.</p>
                </div>
            </div>

            <ul class="review-list">
                <li>What operational task or issue needs follow-up.</li>
                <li>Where the work is located.</li>
                <li>Which department or area owns the work.</li>
                <li>Who is responsible for progressing it.</li>
                <li>Whether it is open, in progress, completed, or closed.</li>
            </ul>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Before Saving</h2>
                    <p>Use this quick check to keep work orders useful later.</p>
                </div>
            </div>

            <ul class="review-list">
                <li>Use a clear title that describes the actual work.</li>
                <li>Assign one owner so workload and reminders stay accurate.</li>
                <li>Select the right site, department, and work type.</li>
                <li>Use a realistic due date so overdue work is visible.</li>
                <li>Add notes explaining the current state or next step.</li>
            </ul>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <section class="table-card work-order-create-card">
        <div class="form-grid">
            <div class="form-field">
                <label>Work Order Number</label>
                <input class="form-control" @bind="workOrder.WorkOrderNumber" />

                <FormFieldGuide Title="Work order number guidance"
                                Text="The system suggests the next WO number. Keep the number unique so reports, activity history, and links stay clear." />
            </div>

            <div class="form-field full-width">
                <label>Title</label>
                <input class="form-control" @bind="workOrder.Title" />

                <FormFieldGuide Title="Title guidance"
                                Text="Use a short clear title that explains the work, such as repair roller door sensor, check spill kit contents, or investigate dispatch scanner issue." />
            </div>

            <div class="form-field">
                <label>Site</label>
                <select class="form-select" @bind="workOrder.Site">
                    @foreach (var site in SiteOptions)
                    {
                        <option value="@site">@site</option>
                    }
                </select>
            </div>

            <div class="form-field">
                <label>Department</label>
                <select class="form-select" @bind="workOrder.Department">
                    @foreach (var department in DepartmentOptions)
                    {
                        <option value="@department">@department</option>
                    }
                </select>
            </div>

            <div class="form-field">
                <label>Owner</label>
                <input class="form-control" @bind="workOrder.Owner" />

                <FormFieldGuide Title="Owner guidance"
                                Text="Assign one clear owner so this work order appears correctly in workload, reminders, reports, and data quality checks." />
            </div>

            <div class="form-field">
                <label>Type</label>
                <select class="form-select" @bind="workOrder.Type">
                    @foreach (var type in TypeOptions)
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            <div class="form-field">
                <label>Priority</label>
                <select class="form-select" @bind="workOrder.Priority">
                    @foreach (var priority in PriorityOptions)
                    {
                        <option value="@priority">@priority</option>
                    }
                </select>
            </div>

            <div class="form-field">
                <label>Status</label>
                <select class="form-select" @bind="workOrder.Status">
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
        </div>

        <StatusFlowGuide Title="Work order status flow"
                         Description="Use statuses consistently so operational work can be tracked through open, active, completed, and closed states."
                         Steps="WorkOrderStatusSteps" />

        <div class="form-grid form-grid-spaced">
            <div class="form-field">
                <label>Created Date</label>
                <input class="form-control" type="date" @bind="workOrder.CreatedDate" />
            </div>

            <div class="form-field">
                <label>Due Date</label>
                <input class="form-control" type="date" @bind="workOrder.DueDate" />

                <FormFieldGuide Title="Due date guidance"
                                Text="Use the next realistic follow-up date. Overdue work orders appear in Workload, Reminders, Reports, Data Quality, and management review pages." />
            </div>

            <div class="form-field full-width">
                <label>Notes</label>
                <textarea class="form-control" rows="8" @bind="workOrder.Notes"></textarea>

                <div class="guidance-card">
                    <div>
                        <strong>Work order note guidance</strong>
                        <p>
                            Good work order notes should explain the current work state,
                            not just repeat the title.
                        </p>

                        <ul>
                            @foreach (var item in WorkOrderNoteGuideItems)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <section class="summary-grid">
            <div class="summary-panel">
                <div class="panel-header">
                    <div>
                        <h2>After Saving</h2>
                        <p>This work order becomes part of the wider workflow.</p>
                    </div>
                </div>

                <div class="review-note-grid">
                    <div class="review-note-card">
                        <span>WORK ORDERS</span>
                        <strong>Appears in list</strong>
                        <p>The saved record can be searched, filtered, edited, and opened from details.</p>
                    </div>

                    <div class="review-note-card">
                        <span>WORKLOAD</span>
                        <strong>Assigned owner appears</strong>
                        <p>The owner receives workload pressure and due-date visibility.</p>
                    </div>

                    <div class="review-note-card">
                        <span>REMINDERS</span>
                        <strong>Overdue work surfaces</strong>
                        <p>Past-due work orders appear in Reminder Centre and follow-up views.</p>
                    </div>

                    <div class="review-note-card">
                        <span>TRACEABILITY</span>
                        <strong>Created event logged</strong>
                        <p>The Activity Log records that this work order was created.</p>
                    </div>
                </div>
            </div>

            <div class="summary-panel">
                <div class="panel-header">
                    <div>
                        <h2>Prototype Boundary</h2>
                        <p>What this page does and does not do yet.</p>
                    </div>
                </div>

                <ul class="review-list">
                    <li>This page tracks work order workflow metadata.</li>
                    <li>It does not currently handle attachments, job costing, or inventory reservations.</li>
                    <li>It does not currently sync to WorkflowMax, Xero, Cin7, Outlook, or Teams.</li>
                    <li>A production version would add permissions, audit rules, attachments, integrations, and approval rules.</li>
                </ul>
            </div>
        </section>

        <div class="form-actions">
            <button class="btn btn-secondary" type="button" @onclick="Cancel">
                Cancel
            </button>

            <button class="btn btn-primary" type="button" @onclick="SaveWorkOrder">
                Save Work Order
            </button>
        </div>
    </section>
</div>

@code {
    private WorkOrder workOrder = new();
    private string errorMessage = "";

    private List<string> SiteOptions = new()
    {
        "Main Workshop",
        "Yard",
        "Admin Office",
        "Warehouse",
        "Dispatch Bay"
    };

    private List<string> DepartmentOptions = new()
    {
        "Operations",
        "Health & Safety",
        "Admin",
        "Maintenance",
        "Warehouse",
        "Dispatch",
        "Quality"
    };

    private List<string> TypeOptions = new()
    {
        "Maintenance",
        "Repair",
        "Supply",
        "Admin",
        "Compliance",
        "Inspection",
        "Preventative Maintenance",
        "Site Improvement",
        "IT Support"
    };

    private List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private List<string> StatusOptions = new()
    {
        "Open",
        "In Progress",
        "Completed",
        "Closed"
    };

    private static readonly IReadOnlyList<string> WorkOrderNoteGuideItems = new[]
    {
        "What issue, request, or task created this work order?",
        "Where is the work located?",
        "What has already been checked or completed?",
        "What is still blocking completion?",
        "If completed or closed, what confirms the outcome?"
    };

    private static readonly IReadOnlyList<StatusFlowGuide.StatusFlowStep> WorkOrderStatusSteps = new[]
    {
        new StatusFlowGuide.StatusFlowStep("Open", "Work has been raised but has not started yet.", "badge badge-warning"),
        new StatusFlowGuide.StatusFlowStep("In Progress", "Owner is actively working through the task.", "badge badge-info"),
        new StatusFlowGuide.StatusFlowStep("Completed", "Work is finished and ready for review or closure.", "badge badge-success"),
        new StatusFlowGuide.StatusFlowStep("Closed", "Final review is complete and no further follow-up is needed.", "badge badge-success")
    };

    protected override async Task OnInitializedAsync()
    {
        workOrder = new WorkOrder
        {
            WorkOrderNumber = await GenerateNextWorkOrderNumber(),
            Title = "",
            Site = "Main Workshop",
            Department = "Operations",
            Owner = "",
            Type = "Maintenance",
            Priority = "Medium",
            Status = "Open",
            CreatedDate = DateTime.Today,
            DueDate = DateTime.Today.AddDays(7),
            Notes = ""
        };
    }

    private async Task<string> GenerateNextWorkOrderNumber()
    {
        var existingWorkOrders = await Db.WorkOrders
            .AsNoTracking()
            .ToListAsync();

        if (!existingWorkOrders.Any())
        {
            return "WO-1001";
        }

        var highestNumber = existingWorkOrders
            .Select(x => ExtractWorkOrderNumber(x.WorkOrderNumber))
            .DefaultIfEmpty(1000)
            .Max();

        return $"WO-{highestNumber + 1}";
    }

    private static int ExtractWorkOrderNumber(string? workOrderNumber)
    {
        if (string.IsNullOrWhiteSpace(workOrderNumber))
        {
            return 1000;
        }

        var cleaned = workOrderNumber
            .Replace("WO-", "", StringComparison.OrdinalIgnoreCase)
            .Trim();

        if (int.TryParse(cleaned, out var number))
        {
            return number;
        }

        return 1000;
    }

    private async Task SaveWorkOrder()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(workOrder.Title))
        {
            errorMessage = "Please enter a title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.Owner))
        {
            errorMessage = "Please enter an owner.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.WorkOrderNumber))
        {
            errorMessage = "Please enter a work order number.";
            return;
        }

        if (workOrder.DueDate < workOrder.CreatedDate)
        {
            errorMessage = "Due date cannot be before created date.";
            return;
        }

        var duplicateNumberExists = await Db.WorkOrders
            .AnyAsync(x => x.WorkOrderNumber == workOrder.WorkOrderNumber);

        if (duplicateNumberExists)
        {
            errorMessage = "A work order with this number already exists.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.Notes))
        {
            workOrder.Notes = BuildDefaultNotes();
        }

        Db.WorkOrders.Add(workOrder);
        await Db.SaveChangesAsync();

        await ActivityLogService.LogAsync(
            moduleName: "Work Orders",
            recordId: workOrder.Id,
            recordReference: workOrder.WorkOrderNumber,
            actionType: "Created",
            description: BuildCreatedDescription()
        );

        Navigation.NavigateTo("/work-orders");
    }

    private string BuildCreatedDescription()
    {
        return $"Created work order {workOrder.WorkOrderNumber}: {workOrder.Title}. Assigned to {workOrder.Owner}, priority {workOrder.Priority}, status {workOrder.Status}.";
    }

    private string BuildDefaultNotes()
    {
        return "Initial work order created." + Environment.NewLine
            + $"Site: {workOrder.Site}" + Environment.NewLine
            + $"Department: {workOrder.Department}" + Environment.NewLine
            + $"Type: {workOrder.Type}" + Environment.NewLine
            + $"Owner: {workOrder.Owner}" + Environment.NewLine
            + "Next step: review, progress, complete, or close the work order.";
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/work-orders");
    }
}