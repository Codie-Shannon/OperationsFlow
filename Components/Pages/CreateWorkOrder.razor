@page "/work-orders/create"
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db
@inject NavigationManager Navigation

<PageTitle>Create Work Order - OperationsFlow</PageTitle>

<div class="page-shell module-page">

    <section class="module-header">
        <div>
            <p class="eyebrow dark">Operations</p>
            <h1>Create Work Order</h1>
            <p>
                Add a new operational work request with owner, site, department,
                priority, status, due date, and notes.
            </p>
        </div>

        <div class="module-header-stat">
            <span>New Record</span>
            <strong>WO</strong>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <section class="alert-card danger-alert">
            @errorMessage
        </section>
    }

    <section class="form-card">
        <EditForm Model="workOrder" OnValidSubmit="SaveWorkOrder">
            <DataAnnotationsValidator />

            <div class="form-grid">

                <div class="form-field">
                    <label>Work Order Number</label>
                    <InputText class="form-input" @bind-Value="workOrder.WorkOrderNumber" />
                </div>

                <div class="form-field">
                    <label>Title</label>
                    <InputText class="form-input" @bind-Value="workOrder.Title" />
                </div>

                <div class="form-field">
                    <label>Site</label>
                    <InputSelect class="form-input" @bind-Value="workOrder.Site">
                        @foreach (var site in SiteOptions)
                        {
                            <option value="@site">@site</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Department</label>
                    <InputSelect class="form-input" @bind-Value="workOrder.Department">
                        @foreach (var department in DepartmentOptions)
                        {
                            <option value="@department">@department</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Owner</label>
                    <InputText class="form-input" @bind-Value="workOrder.Owner" />
                </div>

                <div class="form-field">
                    <label>Type</label>
                    <InputSelect class="form-input" @bind-Value="workOrder.Type">
                        @foreach (var type in TypeOptions)
                        {
                            <option value="@type">@type</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Priority</label>
                    <InputSelect class="form-input" @bind-Value="workOrder.Priority">
                        @foreach (var priority in PriorityOptions)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Status</label>
                    <InputSelect class="form-input" @bind-Value="workOrder.Status">
                        @foreach (var status in StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Created Date</label>
                    <InputDate class="form-input" @bind-Value="workOrder.CreatedDate" />
                </div>

                <div class="form-field">
                    <label>Due Date</label>
                    <InputDate class="form-input" @bind-Value="workOrder.DueDate" />
                </div>

                <div class="form-field form-field-full">
                    <label>Notes</label>
                    <InputTextArea class="form-input form-textarea" @bind-Value="workOrder.Notes" />
                </div>

            </div>

            <div class="form-actions">
                <button type="button" class="secondary-button" @onclick="Cancel">
                    Cancel
                </button>

                <button type="submit" class="primary-button">
                    Save Work Order
                </button>
            </div>
        </EditForm>
    </section>

</div>

@code {
    private WorkOrder workOrder = new WorkOrder();
    private string errorMessage = "";

    private List<string> SiteOptions = new()
    {
        "Main Workshop",
        "Yard",
        "Admin Office",
        "Warehouse",
        "Dispatch Bay"
    };

    private List<string> DepartmentOptions = new()
    {
        "Operations",
        "Health & Safety",
        "Admin",
        "Maintenance",
        "Warehouse",
        "Dispatch",
        "Quality"
    };

    private List<string> TypeOptions = new()
    {
        "Maintenance",
        "Repair",
        "Supply",
        "Admin",
        "Compliance",
        "Inspection",
        "Preventative Maintenance",
        "Site Improvement",
        "IT Support"
    };

    private List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private List<string> StatusOptions = new()
    {
        "Open",
        "In Progress",
        "Completed",
        "Closed"
    };

    protected override async Task OnInitializedAsync()
    {
        workOrder = new WorkOrder
        {
            WorkOrderNumber = await GenerateNextWorkOrderNumber(),
            Title = "",
            Site = "Main Workshop",
            Department = "Operations",
            Owner = "",
            Type = "Maintenance",
            Priority = "Medium",
            Status = "Open",
            CreatedDate = DateTime.Today,
            DueDate = DateTime.Today.AddDays(7),
            Notes = ""
        };
    }

    private async Task<string> GenerateNextWorkOrderNumber()
    {
        var existingWorkOrders = await Task.FromResult(Db.WorkOrders.ToList());

        if (!existingWorkOrders.Any())
        {
            return "WO-1001";
        }

        var highestNumber = existingWorkOrders
            .Select(x => ExtractWorkOrderNumber(x.WorkOrderNumber))
            .DefaultIfEmpty(1000)
            .Max();

        return $"WO-{highestNumber + 1}";
    }

    private static int ExtractWorkOrderNumber(string? workOrderNumber)
    {
        if (string.IsNullOrWhiteSpace(workOrderNumber))
        {
            return 1000;
        }

        var cleaned = workOrderNumber
            .Replace("WO-", "", StringComparison.OrdinalIgnoreCase)
            .Trim();

        if (int.TryParse(cleaned, out var number))
        {
            return number;
        }

        return 1000;
    }

    private async Task SaveWorkOrder()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(workOrder.Title))
        {
            errorMessage = "Please enter a title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.Owner))
        {
            errorMessage = "Please enter an owner.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.WorkOrderNumber))
        {
            errorMessage = "Please enter a work order number.";
            return;
        }

        if (workOrder.DueDate < workOrder.CreatedDate)
        {
            errorMessage = "Due date cannot be before created date.";
            return;
        }

        var duplicateNumberExists = Db.WorkOrders
            .Any(x => x.WorkOrderNumber == workOrder.WorkOrderNumber);

        if (duplicateNumberExists)
        {
            errorMessage = "A work order with this number already exists.";
            return;
        }

        Db.WorkOrders.Add(workOrder);
        await Db.SaveChangesAsync();

        Navigation.NavigateTo("/work-orders");
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/work-orders");
    }
}