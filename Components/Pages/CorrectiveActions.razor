@page "/corrective-actions"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@inject OperationsFlowDbContext Db
@inject DocumentAttachmentService AttachmentService
@inject LocalCurrentUserService CurrentUserService

<PageTitle>Corrective Actions - OperationsFlow</PageTitle>

<PageHero Eyebrow="Operations"
          Title="Corrective Actions"
          Subtitle="Track actions created from incidents, audits, inspections, risk reviews, training gaps, document reviews, improvement work, and compliance follow-ups."
          BadgeText="@($"{OpenCount} open")"
          BadgeClass="of-badge-warning">
    <Actions>
        @if (CurrentUserService.CanEditWorkflow)
        {
            <a class="of-btn of-btn-primary" href="/corrective-actions/create">+ New Corrective Action</a>
        }
        <a class="of-btn of-btn-secondary" href="/risk-register">Risk Register</a>
        <a class="of-btn of-btn-secondary" href="/training">Training</a>
        <a class="of-btn of-btn-secondary" href="/documents">Documents</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="✅">
    <p>
        Corrective Actions turn issues into owned follow-up work. They connect operational problems,
        risk findings, training gaps, document review issues, and compliance follow-ups into one action
        register that can be reviewed through workload, reminders, reports, data quality, and activity evidence.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Total Actions"
                Value="@TotalCount.ToString()"
                Detail="All corrective and improvement actions"
                Icon="📋" />

    <MetricCard Title="Open"
                Value="@OpenCount.ToString()"
                Detail="Still active or in progress"
                Icon="🟡"
                Tone="warning" />

    <MetricCard Title="Overdue"
                Value="@OverdueCount.ToString()"
                Detail="Past due and not completed"
                Icon="🚨"
                Tone="danger" />

    <MetricCard Title="Completed"
                Value="@CompletedCount.ToString()"
                Detail="Completed or closed actions"
                Icon="✅"
                Tone="success" />

    <MetricCard Title="Sources"
                Value="@SourceCount.ToString()"
                Detail="Unique issue/action sources"
                Icon="🔗"
                Tone="info" />
</MetricGrid>

<FilterBar Title="Filter Corrective Actions">
    <ChildContent>
        <input class="of-input"
               placeholder="Search corrective actions..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="of-select" @bind="statusFilter">
            <option value="">All Statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>

        <select class="of-select" @bind="priorityFilter">
            <option value="">All Priorities</option>
            @foreach (var priority in PriorityOptions)
            {
                <option value="@priority">@priority</option>
            }
        </select>

        <select class="of-select" @bind="sourceFilter">
            <option value="">All Sources</option>
            @foreach (var source in SourceOptions)
            {
                <option value="@source">@source</option>
            }
        </select>
    </ChildContent>

    <Actions>
        <a class="of-btn of-btn-secondary" href="/workload">Workload</a>
        <a class="of-btn of-btn-secondary" href="/reminders">Reminders</a>
        <a class="of-btn of-btn-secondary" href="/reports">Reports</a>
    </Actions>
</FilterBar>

@if (correctiveActions == null)
{
    <InfoPanel Title="Loading Corrective Actions" Subtitle="Loading action records from the local SQLite database.">
        <p class="of-muted-text">Loading corrective actions...</p>
    </InfoPanel>
}
else
{
    <TableCard Title="Corrective Action Register"
               Subtitle="Search, filter, open, and update corrective/improvement actions."
               IsEmpty="@(!FilteredCorrectiveActions.Any())"
               EmptyTitle="No corrective actions found"
               EmptyMessage="No corrective actions match the current search or filter selection.">
        <table>
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Source</th>
                    <th>Site</th>
                    <th>Department</th>
                    <th>Owner</th>
                    <th>Action Type</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Due Date</th>
                    <th>Completed</th>
                    <th>Files</th>
                    <th>Flag</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredCorrectiveActions)
                {
                    <tr>
                        <td><strong>@item.Title</strong></td>
                        <td>@DisplayText(item.Source)</td>
                        <td>@DisplayText(item.Site)</td>
                        <td>@DisplayText(item.Department)</td>
                        <td>@DisplayText(item.Owner)</td>
                        <td>@DisplayText(item.ActionType)</td>
                        <td>
                            <span class="@GetPriorityClass(item.Priority)">
                                @DisplayText(item.Priority)
                            </span>
                        </td>
                        <td>
                            <span class="@GetStatusClass(item.Status)">
                                @DisplayText(item.Status)
                            </span>
                        </td>
                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.CompletedDate.HasValue)
                            {
                                @item.CompletedDate.Value.ToString("dd MMM yyyy")
                            }
                            else
                            {
                                <span class="of-muted-text">Not completed</span>
                            }
                        </td>
                        <td>
                            <span class="@GetFileCountClass(item.Id)">
                                @GetAttachmentCount(item.Id) file(s)
                            </span>
                        </td>
                        <td>
                            @if (item.IsOverdue)
                            {
                                <span class="of-badge of-badge-danger">Overdue</span>
                            }
                            else if (item.CompletedDate.HasValue || IsCompletedStatus(item.Status))
                            {
                                <span class="of-badge of-badge-success">Completed</span>
                            }
                            else
                            {
                                <span class="of-badge of-badge-success">On Track</span>
                            }
                        </td>
                        <td>
                            <div class="of-row-actions">
                                <a class="of-card-link" href="@($"/corrective-actions/details/{item.Id}")">View</a>
                                @if (CurrentUserService.CanEditWorkflow)
                                {
                                    <a class="of-card-link" href="@($"/corrective-actions/edit/{item.Id}?returnUrl={Uri.EscapeDataString("/corrective-actions")}")">Edit</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </TableCard>
}

<InfoPanel Title="Source-Linked Follow-Up" Subtitle="Corrective actions are designed to be created from several workflow areas.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Risk Register</strong>
                <span>Risk items can create corrective actions with source context prefilled.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Training</strong>
                <span>Expired or expiring training records can become owned follow-up actions.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Documents</strong>
                <span>Document reviews can create actions for overdue or required updates.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Reports</strong>
                <span>Actions feed reporting, reminders, workload, and management visibility.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Review Notes" Icon="💡" Tone="info">
    <ul>
        <li>Open actions should appear in Workload and Reminders.</li>
        <li>Overdue actions should be visible in follow-up views and management reports.</li>
        <li>Risk Register, Training, and Documents should be able to create prefilled corrective actions.</li>
        <li>Creating or editing a corrective action should generate activity history.</li>
        <li>This is still local SQLite demo data; Microsoft 365 sync is a later implementation stage.</li>
    </ul>
</GuidanceNote>

@code {
    private List<CorrectiveAction>? correctiveActions;
    private Dictionary<int, int> attachmentCounts = new();

    private string searchText = "";
    private string statusFilter = "";
    private string priorityFilter = "";
    private string sourceFilter = "";

    private IEnumerable<CorrectiveAction> FilteredCorrectiveActions
    {
        get
        {
            if (correctiveActions == null)
            {
                return Enumerable.Empty<CorrectiveAction>();
            }

            var query = correctiveActions.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.Title, searchText) ||
                    Contains(x.Source, searchText) ||
                    Contains(x.Site, searchText) ||
                    Contains(x.Department, searchText) ||
                    Contains(x.Owner, searchText) ||
                    Contains(x.ActionType, searchText) ||
                    Contains(x.Priority, searchText) ||
                    Contains(x.Status, searchText) ||
                    Contains(x.Notes, searchText));
            }

            if (!string.IsNullOrWhiteSpace(statusFilter))
            {
                query = query.Where(x => string.Equals(x.Status, statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(priorityFilter))
            {
                query = query.Where(x => string.Equals(x.Priority, priorityFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(sourceFilter))
            {
                query = query.Where(x => string.Equals(x.Source, sourceFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x => x.IsOverdue)
                .ThenBy(x => x.CompletedDate.HasValue)
                .ThenBy(x => x.DueDate)
                .ThenBy(x => x.Priority)
                .ToList();
        }
    }

    private int TotalCount => correctiveActions?.Count ?? 0;

    private int OpenCount =>
        correctiveActions?.Count(x =>
            !IsCompletedStatus(x.Status) &&
            !x.CompletedDate.HasValue) ?? 0;

    private int OverdueCount => correctiveActions?.Count(x => x.IsOverdue) ?? 0;

    private int CompletedCount =>
        correctiveActions?.Count(x =>
            IsCompletedStatus(x.Status) ||
            x.CompletedDate.HasValue) ?? 0;

    private int SourceCount =>
        correctiveActions?
            .Select(x => x.Source)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count() ?? 0;

    private List<string> StatusOptions =>
        correctiveActions?
            .Select(x => x.Status)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> PriorityOptions =>
        correctiveActions?
            .Select(x => x.Priority)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> SourceOptions =>
        correctiveActions?
            .Select(x => x.Source)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    protected override async Task OnInitializedAsync()
    {
        correctiveActions = await Db.CorrectiveActions
            .AsNoTracking()
            .ToListAsync();

        await LoadAttachmentCountsAsync();
    }

    private static bool Contains(string? source, string search)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return false;
        }

        return source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static bool IsCompletedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "in progress" => "badge badge-info",
            "open" => "badge badge-warning",
            "new" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private async Task LoadAttachmentCountsAsync()
    {
        var attachments = await AttachmentService.GetAllActiveAsync();

        attachmentCounts = attachments
            .Where(x =>
                string.Equals(x.ModuleName, "Corrective Actions", StringComparison.OrdinalIgnoreCase) &&
                x.RecordId.HasValue)
            .GroupBy(x => x.RecordId!.Value)
            .ToDictionary(x => x.Key, x => x.Count());
    }

    private int GetAttachmentCount(int correctiveActionId)
    {
        return attachmentCounts.TryGetValue(correctiveActionId, out var count)
            ? count
            : 0;
    }

    private string GetFileCountClass(int correctiveActionId)
    {
        return GetAttachmentCount(correctiveActionId) > 0
            ? "badge badge-success"
            : "badge badge-muted";
    }
}
