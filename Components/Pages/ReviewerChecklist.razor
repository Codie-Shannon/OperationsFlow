    private record ChecklistSection(
        string Number,
        string Category,
        string Title,
        string Description,
        string Url,
        string LinkText,
        IReadOnlyList<ChecklistItem> Items
    );

    private record ChecklistItem(
        string Task,
        string ExpectedEvidence
    );

    private record EvidenceItem(
        string Area,
        string Page,
        string BadgeClass,
        string Demonstrates,
        string Question
    );

    private record ReviewOutcome(
        string Label,
        string Title,
        string Description
    );
}