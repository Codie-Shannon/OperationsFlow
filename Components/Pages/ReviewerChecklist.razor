@page "/reviewer-checklist"

<PageTitle>Reviewer Checklist - OperationsFlow</PageTitle>

<PageHero Eyebrow="System Review"
          Title="Reviewer Checklist"
          Subtitle="A guided checklist for reviewing the OperationsFlow portfolio prototype, Week 1 review package, and Week 2 workflow MVP."
          BadgeText="Week 2 Review Ready"
          BadgeClass="of-badge-success">
    <Actions>
        <a class="of-btn of-btn-primary" href="/">Open Dashboard</a>
        <a class="of-btn of-btn-secondary" href="/portfolio-hub">Portfolio Hub</a>
        <a class="of-btn of-btn-secondary" href="/demo-guide">Demo Guide</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="✅">
    <p>
        Use this page to review what OperationsFlow proves. The checklist covers dashboard visibility,
        create/edit workflows, source-linked corrective actions, record history, workload, reminders,
        reports, data quality, CSV exports, documentation, and prototype boundaries.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Review Areas"
                Value="12"
                Detail="Workflow, management, evidence, boundaries, and next-stage planning"
                Icon="📋" />

    <MetricCard Title="Workflow Pages"
                Value="6"
                Detail="Work orders, actions, intake, risk, documents, and training"
                Icon="🧩"
                Tone="info" />

    <MetricCard Title="Traceability"
                Value="Yes"
                Detail="Activity history and global activity log"
                Icon="🕒"
                Tone="success" />

    <MetricCard Title="Exports"
                Value="7+"
                Detail="CSV package plus export README and manifest"
                Icon="⬇️"
                Tone="warning" />

    <MetricCard Title="Boundary"
                Value="Demo"
                Detail="Local SQLite prototype, not production deployment"
                Icon="🧱"
                Tone="danger" />
</MetricGrid>

<InfoPanel Title="Recommended Review Path" Subtitle="Use this order when reviewing the app for the first time.">
    <ol class="of-review-steps">
        <li>Start on Dashboard to understand the system overview.</li>
        <li>Open Work Orders and review create, edit, details, and history.</li>
        <li>Open Corrective Actions and test source-linked follow-up workflows.</li>
        <li>Open Document Intake and review admin/document workflow tracking.</li>
        <li>Open Risk Register, Training, and Documents to test Create Action links.</li>
        <li>Open Workload and Reminders to confirm follow-up visibility.</li>
        <li>Open Data Quality and Reports to confirm management review visibility.</li>
        <li>Open Activity Log to confirm record-level traceability.</li>
        <li>Open CSV exports to confirm external review package support.</li>
        <li>Read technical and prototype notes before judging production boundaries.</li>
    </ol>
</InfoPanel>

<InfoPanel Title="What Week 2 Proves" Subtitle="The workflow MVP is no longer just reporting.">
    <div class="of-review-proof-grid">
        <div class="of-review-proof-card">
            <strong>CREATE</strong>
            <span>New workflow records can be created for Work Orders, Corrective Actions, and Document Intake.</span>
        </div>

        <div class="of-review-proof-card">
            <strong>EDIT</strong>
            <span>Existing records can be updated and reviewed.</span>
        </div>

        <div class="of-review-proof-card">
            <strong>LINKED</strong>
            <span>Risk, training, and document issues can create prefilled corrective actions.</span>
        </div>

        <div class="of-review-proof-card">
            <strong>TRACEABLE</strong>
            <span>Created, updated, and reviewed events are visible in record pages and Activity Log.</span>
        </div>
    </div>

    <div class="of-link-row">
        <a class="of-btn of-btn-primary" href="/">Open Dashboard</a>
        <a class="of-btn of-btn-secondary" href="/work-orders">Review Work Orders</a>
        <a class="of-btn of-btn-secondary" href="/corrective-actions">Review Actions</a>
        <a class="of-btn of-btn-secondary" href="/reports">Open Reports</a>
    </div>
</InfoPanel>

