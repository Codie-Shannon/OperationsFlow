@page "/reviewer-checklist"

<PageTitle>Reviewer Checklist - OperationsFlow</PageTitle>

<PageHero Eyebrow="Portfolio Review"
          Title="Reviewer Checklist"
          Subtitle="Use this checklist to review what OperationsFlow proves: workflow capture, ownership, evidence, reporting, data quality, traceability, and the Week 3 production foundation."
          BadgeText="Week 3 Ready"
          BadgeClass="of-badge-success">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/dashboard">Open Dashboard</a>
        <a class="of-btn of-btn-secondary" href="/portfolio-hub">Portfolio Hub</a>
        <a class="of-btn of-btn-secondary" href="/demo-guide">Demo Guide</a>
        <a class="of-btn of-btn-secondary" href="/business-value">Business Value</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="✅">
    <p>
        Use this page to review the prototype as a business-system portfolio piece. The checklist covers
        dashboard visibility, workflow registers, create/edit/details pages, document intake, evidence uploads,
        local document library storage, activity traceability, reports, data quality, CSV exports, and Week 4
        Microsoft 365 production direction.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Workflow Capture"
                Value="3"
                Detail="Work Orders, Corrective Actions, Document Intake"
                Icon="📋"
                Tone="info" />

    <MetricCard Title="Evidence Layer"
                Value="Live"
                Detail="Record attachments and Document Library"
                Icon="📎"
                Tone="success" />

    <MetricCard Title="Traceability"
                Value="Active"
                Detail="Activity Log and record history"
                Icon="🧾"
                Tone="success" />

    <MetricCard Title="Management Review"
                Value="Ready"
                Detail="Reports, Data Quality, Workload, Reminders"
                Icon="📊"
                Tone="warning" />
</MetricGrid>

<InfoPanel Title="Recommended Review Route" Subtitle="Fastest path for someone reviewing the project.">
    <ChildContent>
        <ol>
            <li>Start on Dashboard to understand the system overview.</li>
            <li>Open Work Orders and review list, file counts, details, attachments, and activity history.</li>
            <li>Open Corrective Actions and test source-linked follow-up workflows plus attachments.</li>
            <li>Open Document Intake and review list-to-details workflow, file count, and attached source documents.</li>
            <li>Open Document Library to confirm files from Work Orders, Corrective Actions, and Document Intake appear together.</li>
            <li>Open Data Quality to confirm missing evidence checks and issue links.</li>
            <li>Open Reports to confirm management-level evidence coverage and missing evidence reporting.</li>
            <li>Open Activity Log to confirm upload, delete, create, update, and review traceability.</li>
            <li>Open CSV exports to confirm external review package support.</li>
            <li>Read prototype boundaries before judging production readiness.</li>
        </ol>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Core Proof Points" Subtitle="What the app now demonstrates.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Capture</strong>
                <span>Work Orders, Corrective Actions, and Document Intake capture scattered follow-up work before it disappears.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Own</strong>
                <span>Records carry owner, status, due date, priority, notes, and module-specific context.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Attach</strong>
                <span>Files can be uploaded directly to key workflow records and shown through Document Library.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Trace</strong>
                <span>Activity Log and record history show what changed, who did it, and when it happened.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Review</strong>
                <span>Reports and Data Quality convert operational records into management review tasks.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Prepare</strong>
                <span>Week 3 local storage and abstraction prepare the project for Week 4 SharePoint/Microsoft 365 implementation.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

