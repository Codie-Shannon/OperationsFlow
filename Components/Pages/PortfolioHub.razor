@page "/portfolio-hub"

<PageTitle>Portfolio Hub - OperationsFlow</PageTitle>

<div class="operations-dashboard portfolio-hub-page">
    <PageIntro Eyebrow="Start Here"
               Title="Portfolio Hub"
               Subtitle="A clean starting point for reviewing OperationsFlow as a business workflow, safety/compliance, admin process, reporting, and .NET portfolio project.">
        <a class="btn btn-secondary" href="reviewer-checklist">Reviewer Checklist</a>
        <a class="btn btn-secondary" href="demo-guide">Demo Guide</a>
        <a class="btn btn-primary" href="business-value">Business Value</a>
    </PageIntro>

    <div class="page-purpose-note">
        <strong>Purpose:</strong> use this page as the reviewer landing page. It gives a quick overview of what to open first, what the project proves, and which pages explain business value, prototype scope, implementation planning, and technical review.
    </div>

    <section class="kpi-grid">
        <div class="kpi-card">
            <span class="kpi-label">Review Type</span>
            <strong>Portfolio</strong>
            <span class="kpi-note">Business systems project</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Best First Page</span>
            <strong>Checklist</strong>
            <span class="kpi-note">Guided review path</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Main Proof</span>
            <strong>Workflow</strong>
            <span class="kpi-note">Connected follow-up system</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Stack</span>
            <strong>.NET</strong>
            <span class="kpi-note">Blazor / EF Core / SQLite</span>
        </div>
    </section>

    <section class="summary-grid portfolio-hub-intro-grid">
        <div class="summary-panel portfolio-hub-primary-panel">
            <div class="panel-header">
                <div>
                    <h2>Recommended Review Path</h2>
                    <p>The fastest way to understand the project.</p>
                </div>
            </div>

            <ol class="demo-step-list portfolio-review-path">
                <li>
                    <strong>Start with Reviewer Checklist</strong>
                    <span>Use the checklist to verify business value, workflow connection, record editing, reporting, data quality, and production thinking.</span>
                </li>

                <li>
                    <strong>Open Demo Guide</strong>
                    <span>Follow the business, admin/document, or technical demo path depending on the reviewer.</span>
                </li>

                <li>
                    <strong>Open Business Value</strong>
                    <span>Review the business problem, value created, before/after shift, and management case.</span>
                </li>

                <li>
                    <strong>Open Prototype Scope</strong>
                    <span>Confirm what the project is, what it proves, what is prototype-only, and what production would require.</span>
                </li>

                <li>
                    <strong>Open Implementation Plan</strong>
                    <span>Review how this could move from a local portfolio prototype to a real production business system.</span>
                </li>
            </ol>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>One-Minute Summary</h2>
                    <p>What a reviewer should understand quickly.</p>
                </div>
            </div>

            <div class="portfolio-summary-highlight">
                <span>OperationsFlow</span>
                <strong>Connected business follow-up workflow</strong>
                <p>
                    OperationsFlow demonstrates how work orders, corrective actions, risk review,
                    training compliance, document control, document intake, workload, reminders,
                    reports, activity history, and data quality can be connected into one reviewable
                    workflow system.
                </p>
            </div>

            <ul class="action-list">
                <li>It is more than a dashboard because records can be created, edited, reviewed, reported on, and traced.</li>
                <li>It shows business value through reduced missed follow-up and clearer ownership.</li>
                <li>It includes reviewer-ready pages that explain scope, value, rollout, and production requirements.</li>
            </ul>
        </div>
    </section>

    <section class="portfolio-hub-card-grid">
        @foreach (var card in HubCards)
        {
            <a class="portfolio-hub-card" href="@card.Url">
                <div class="portfolio-hub-card-header">
                    <span>@card.Number</span>
                    <div>
                        <p class="eyebrow">@card.Category</p>
                        <h2>@card.Title</h2>
                    </div>
                </div>

                <p>@card.Description</p>

                <ul>
                    @foreach (var item in card.Items)
                    {
                        <li>@item</li>
                    }
                </ul>

                <strong class="portfolio-card-action">@card.ActionText</strong>
            </a>
        }
    </section>

    <section class="report-card">
        <div class="panel-header">
            <div>
                <h2>Reviewer Page Map</h2>
                <p>Use this table to choose which page to open depending on what the reviewer cares about.</p>
            </div>
        </div>

        <table class="report-table portfolio-page-map-table">
            <thead>
                <tr>
                    <th>Reviewer Goal</th>
                    <th>Best Page</th>
                    <th>What It Shows</th>
                    <th>Best Question</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in PageMap)
                {
                    <tr>
                        <td><strong>@item.Goal</strong></td>
                        <td><span class="@item.BadgeClass">@item.Page</span></td>
                        <td>@item.Shows</td>
                        <td>@item.Question</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>What This Portfolio Piece Demonstrates</h2>
                    <p>The strongest evidence to look for during review.</p>
                </div>
            </div>

            <div class="portfolio-proof-grid">
                @foreach (var proof in ProofItems)
                {
                    <article>
                        <span>@proof.Label</span>
                        <strong>@proof.Title</strong>
                        <p>@proof.Description</p>
                    </article>
                }
            </div>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Useful Review Links</h2>
                    <p>Quick links to the most important live workflow pages.</p>
                </div>
            </div>

            <div class="portfolio-link-list">
                @foreach (var link in WorkflowLinks)
                {
                    <a href="@link.Url">
                        <span>@link.Label</span>
                        <strong>@link.Title</strong>
                        <p>@link.Description</p>
                    </a>
                }
            </div>
        </div>
    </section>

    <section class="report-card portfolio-final-summary-card">
        <div class="panel-header">
            <div>
                <h2>Portfolio Summary</h2>
                <p>A short summary for Vanessa, employers, or technical reviewers.</p>
            </div>
        </div>

        <div class="portfolio-final-summary">
            <p>
                OperationsFlow is a .NET/Blazor business workflow prototype focused on operational follow-up,
                safety/compliance review, admin/document workflow, reporting, and management visibility.
                It demonstrates practical business-systems development: connected records, editable workflows,
                owner accountability, due-date planning, activity traceability, reporting views, data quality checks,
                and production-aware implementation planning.
            </p>

            <p>
                The project is intentionally presented with reviewer support pages: Portfolio Hub, Reviewer Checklist,
                Demo Guide, Business Value, Prototype Scope, and Implementation Plan. These pages make the project easier
                to assess because they explain what the system does, why it matters, what is working now, what is prototype-only,
                and what would be needed to make it production-ready.
            </p>
        </div>
    </section>
</div>

