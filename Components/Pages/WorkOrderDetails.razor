@page "/work-orders/details/{Id:int}"
@page "/work-orders/view/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db
@inject NavigationManager Navigation

<PageTitle>Work Order Details - OperationsFlow</PageTitle>

<div class="page-shell module-page">

    @if (isLoading)
    {
        <section class="form-card">
            <div class="empty-state">Loading work order...</div>
        </section>
    }
    else if (workOrder == null)
    {
        <section class="module-header">
            <div>
                <p class="eyebrow dark">Operations</p>
                <h1>Work Order Not Found</h1>
                <p>The requested work order could not be found.</p>
            </div>
        </section>

        <div class="form-actions">
            <button type="button" class="secondary-button" @onclick="BackToWorkOrders">
                Back to Work Orders
            </button>
        </div>
    }
    else
    {
        <section class="module-header">
            <div>
                <p class="eyebrow dark">Operations</p>
                <h1>@workOrder.WorkOrderNumber</h1>
                <p>@workOrder.Title</p>
            </div>

            <div class="module-header-actions">
                <div class="module-header-stat">
                    <span>Status</span>
                    <strong>@workOrder.Status</strong>
                </div>

                <a class="primary-link-button"
                   href="@BuildEditUrl()">
                    Edit Work Order
                </a>
            </div>
        </section>

        <section class="module-summary-grid">
            <article class="module-summary-card info-card">
                <span>Priority</span>
                <strong>@workOrder.Priority</strong>
                <small>@workOrder.Type</small>
            </article>

            <article class="module-summary-card warning-card">
                <span>Due Date</span>
                <strong>@workOrder.DueDate.ToString("dd MMM")</strong>
                <small>@workOrder.DueDate.ToString("yyyy")</small>
            </article>

            <article class="module-summary-card @(workOrder.IsOverdue ? "danger-card" : "success-card")">
                <span>Flag</span>
                <strong>@(workOrder.IsOverdue ? "Overdue" : "On Track")</strong>
                <small>@(workOrder.IsOverdue ? "Past due and not closed" : "No overdue flag")</small>
            </article>

            <article class="module-summary-card success-card">
                <span>Owner</span>
                <strong>@workOrder.Owner</strong>
                <small>@workOrder.Department</small>
            </article>
        </section>

        <section class="form-card">
            <div class="details-grid">
                <div class="details-field">
                    <span>Work Order Number</span>
                    <strong>@workOrder.WorkOrderNumber</strong>
                </div>

                <div class="details-field">
                    <span>Title</span>
                    <strong>@workOrder.Title</strong>
                </div>

                <div class="details-field">
                    <span>Site</span>
                    <strong>@workOrder.Site</strong>
                </div>

                <div class="details-field">
                    <span>Department</span>
                    <strong>@workOrder.Department</strong>
                </div>

                <div class="details-field">
                    <span>Owner</span>
                    <strong>@workOrder.Owner</strong>
                </div>

                <div class="details-field">
                    <span>Type</span>
                    <strong>@workOrder.Type</strong>
                </div>

                <div class="details-field">
                    <span>Priority</span>
                    <strong>
                        <span class="@GetPriorityClass(workOrder.Priority)">
                            @workOrder.Priority
                        </span>
                    </strong>
                </div>

                <div class="details-field">
                    <span>Status</span>
                    <strong>
                        <span class="@GetStatusClass(workOrder.Status)">
                            @workOrder.Status
                        </span>
                    </strong>
                </div>

                <div class="details-field">
                    <span>Created Date</span>
                    <strong>@workOrder.CreatedDate.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="details-field">
                    <span>Due Date</span>
                    <strong>@workOrder.DueDate.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="details-field details-field-full">
                    <span>Notes</span>
                    <p>@DisplayText(workOrder.Notes)</p>
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="secondary-button" @onclick="BackToWorkOrders">
                    Back to Work Orders
                </button>

                <button type="button" class="primary-button" @onclick="GoToEdit">
                    Edit Work Order
                </button>
            </div>
        </section>

        <ActivityHistoryPanel ModuleName="Work Orders"
                              RecordId="@workOrder.Id"
                              Title="Work Order Activity History" />
    }

</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private WorkOrder? workOrder;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        workOrder = await Db.WorkOrders
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == Id);

        isLoading = false;
    }

    private string BuildEditUrl()
    {
        return $"/work-orders/edit/{Id}?returnUrl={Uri.EscapeDataString($"/work-orders/details/{Id}")}";
    }

    private void GoToEdit()
    {
        Navigation.NavigateTo(BuildEditUrl());
    }

    private void BackToWorkOrders()
    {
        Navigation.NavigateTo("/work-orders");
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value)
            ? "No notes recorded."
            : value;
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLower() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLower() switch
        {
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "in progress" => "badge badge-info",
            "open" => "badge badge-warning",
            "new" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }
}