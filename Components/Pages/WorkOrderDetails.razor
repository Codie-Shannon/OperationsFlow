@page "/work-orders/details/{Id:int}"
@page "/work-orders/view/{Id:int}"
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db
@inject NavigationManager Navigation

<PageTitle>Work Order Details - OperationsFlow</PageTitle>

@if (isLoading)
{
    <PageHero
        Eyebrow="Operations"
        Title="Loading Work Order"
        Subtitle="Loading the selected work order record."
        BadgeText="Loading"
        BadgeClass="of-badge-info" />

    <InfoPanel Title="Loading" Subtitle="Retrieving work order details from the local SQLite database.">
        <p class="of-muted-text">Loading work order...</p>
    </InfoPanel>
}
else if (workOrder == null)
{
    <PageHero
        Eyebrow="Operations"
        Title="Work Order Not Found"
        Subtitle="The requested work order could not be found."
        BadgeText="Missing"
        BadgeClass="of-badge-danger">
        <Actions>
            <a class="of-btn of-btn-primary" href="/work-orders">Back to Work Orders</a>
        </Actions>
    </PageHero>

    <EmptyState
        Title="Work order could not be found"
        Message="The record may have been removed, or the link may be using an invalid ID."
        Icon="⚠️"
        ActionText="Back to Work Orders"
        ActionHref="/work-orders" />
}
else
{
    <PageHero
        Eyebrow="Operations"
        Title="@workOrder.WorkOrderNumber"
        Subtitle="@workOrder.Title"
        BadgeText="@workOrder.Status"
        BadgeClass="@GetStatusBadgeClass(workOrder.Status)">
        <Actions>
            <a class="of-btn of-btn-secondary" href="/work-orders">Back to Work Orders</a>
            <a class="of-btn of-btn-primary" href="@BuildEditUrl()">Edit Work Order</a>
        </Actions>
    </PageHero>

    <MetricGrid>
        <MetricCard
            Title="Priority"
            Value="@workOrder.Priority"
            Detail="@workOrder.Type"
            Icon="⚡"
            Tone="@GetPriorityTone(workOrder.Priority)" />

        <MetricCard
            Title="Due Date"
            Value="@workOrder.DueDate.ToString("dd MMM")"
            Detail="@workOrder.DueDate.ToString("yyyy")"
            Icon="📅"
            Tone="info" />

        <MetricCard
            Title="Flag"
            Value="@(workOrder.IsOverdue ? "Overdue" : "On Track")"
            Detail="@(workOrder.IsOverdue ? "Past due and not closed" : "No overdue flag")"
            Icon="@(workOrder.IsOverdue ? "🚨" : "✅")"
            Tone="@(workOrder.IsOverdue ? "danger" : "success")" />

        <MetricCard
            Title="Owner"
            Value="@DisplayText(workOrder.Owner)"
            Detail="@workOrder.Department"
            Icon="👤" />
    </MetricGrid>

    <InfoPanel Title="Work Order Details" Subtitle="Core record information used by workload, reminders, reports, and activity history.">
        <ChildContent>
            <div class="of-detail-grid">
                <div class="of-detail-item">
                    <span>Work Order Number</span>
                    <strong>@workOrder.WorkOrderNumber</strong>
                </div>

                <div class="of-detail-item">
                    <span>Title</span>
                    <strong>@workOrder.Title</strong>
                </div>

                <div class="of-detail-item">
                    <span>Site</span>
                    <strong>@workOrder.Site</strong>
                </div>

                <div class="of-detail-item">
                    <span>Department</span>
                    <strong>@workOrder.Department</strong>
                </div>

                <div class="of-detail-item">
                    <span>Owner</span>
                    <strong>@DisplayText(workOrder.Owner)</strong>
                </div>

                <div class="of-detail-item">
                    <span>Type</span>
                    <strong>@workOrder.Type</strong>
                </div>

                <div class="of-detail-item">
                    <span>Priority</span>
                    <strong>
                        <span class="@GetPriorityClass(workOrder.Priority)">
                            @workOrder.Priority
                        </span>
                    </strong>
                </div>

                <div class="of-detail-item">
                    <span>Status</span>
                    <strong>
                        <span class="@GetStatusClass(workOrder.Status)">
                            @workOrder.Status
                        </span>
                    </strong>
                </div>

                <div class="of-detail-item">
                    <span>Created Date</span>
                    <strong>@workOrder.CreatedDate.ToString("dd MMM yyyy")</strong>
                </div>

                <div class="of-detail-item">
                    <span>Due Date</span>
                    <strong>@workOrder.DueDate.ToString("dd MMM yyyy")</strong>
                </div>
            </div>
        </ChildContent>
    </InfoPanel>

    <InfoPanel Title="Notes" Subtitle="Recorded context, follow-up details, or operational notes for this work order.">
        <ChildContent>
            <p class="of-notes-box">@DisplayText(workOrder.Notes)</p>
        </ChildContent>
    </InfoPanel>

    <OperationsFlow.Components.Shared.Ui.ActivityHistoryPanel
        Title="Activity History"
        Subtitle="Record-level traceability for this work order."
        IsEmpty="@(activityHistory.Count == 0)"
        EmptyTitle="No activity history yet"
        EmptyMessage="Create, edit, or review this work order to generate activity history.">
        <ChildContent>
            <table class="of-activity-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Action</th>
                        <th>Description</th>
                        <th>Created By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var activity in activityHistory)
                    {
                        <tr>
                            <td>@activity.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                <span class="@GetActivityBadgeClass(activity.ActionType)">
                                    @activity.ActionType
                                </span>
                            </td>
                            <td>@activity.Description</td>
                            <td>@activity.CreatedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </ChildContent>
    </OperationsFlow.Components.Shared.Ui.ActivityHistoryPanel>

    <ActionStrip
        Title="Next Actions"
        Description="Return to the register or update this work order.">
        <button type="button" class="of-btn of-btn-secondary" @onclick="BackToWorkOrders">Back to Work Orders</button>
        <button type="button" class="of-btn of-btn-primary" @onclick="GoToEdit">Edit Work Order</button>
    </ActionStrip>
}

@code {
    [Parameter] public int Id { get; set; }

    private WorkOrder? workOrder;
    private List<ActivityLog> activityHistory = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        workOrder = await Db.WorkOrders
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (workOrder != null)
        {
            await LoadActivityHistory();
        }

        isLoading = false;
    }

    private async Task LoadActivityHistory()
    {
        activityHistory = await Db.ActivityLogs
            .AsNoTracking()
            .Where(x => x.ModuleName == "Work Orders" && x.RecordId == Id)
            .OrderByDescending(x => x.CreatedDate)
            .ToListAsync();
    }

    private string BuildEditUrl()
    {
        return $"/work-orders/edit/{Id}?returnUrl={Uri.EscapeDataString($"/work-orders/details/{Id}")}";
    }

    private void GoToEdit()
    {
        Navigation.NavigateTo(BuildEditUrl());
    }

    private void BackToWorkOrders()
    {
        Navigation.NavigateTo("/work-orders");
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static string GetPriorityTone(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "danger",
            "high" => "warning",
            "medium" => "info",
            "low" => "default",
            _ => "default"
        };
    }

    private static string GetStatusBadgeClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "of-badge-success",
            "closed" => "of-badge-success",
            "in progress" => "of-badge-info",
            "open" => "of-badge-warning",
            "new" => "of-badge-warning",
            _ => "of-badge-info"
        };
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "in progress" => "badge badge-info",
            "open" => "badge badge-warning",
            "new" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static string GetActivityBadgeClass(string? actionType)
    {
        return actionType?.ToLowerInvariant() switch
        {
            "created" => "badge badge-success",
            "updated" => "badge badge-info",
            "reviewed" => "badge badge-secondary",
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "deleted" => "badge badge-danger",
            _ => "badge badge-secondary"
        };
    }
}