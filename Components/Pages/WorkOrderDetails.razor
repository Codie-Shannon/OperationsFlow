@page "/work-orders/{id:int}"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db
@inject NavigationManager Navigation

<PageTitle>Work Order Details - OperationsFlow</PageTitle>

<div class="page-shell module-page">

    @if (isLoading)
    {
        <section class="form-card">
            <div class="empty-state">Loading work order...</div>
        </section>
    }
    else if (workOrder == null)
    {
        <section class="module-header">
            <div>
                <p class="eyebrow dark">Operations</p>
                <h1>Work Order Not Found</h1>
                <p>
                    The selected work order could not be found.
                </p>
            </div>
        </section>

        <div class="form-actions">
            <button type="button" class="secondary-button" @onclick="BackToList">
                Back to Work Orders
            </button>
        </div>
    }
    else
    {
        <section class="module-header">
            <div>
                <p class="eyebrow dark">Operations</p>
                <h1>@workOrder.WorkOrderNumber</h1>
                <p>
                    @workOrder.Title
                </p>
            </div>

            <div class="module-header-actions">
                <div class="module-header-stat">
                    <span>Status</span>
                    <strong>@workOrder.Status</strong>
                </div>

                <a class="primary-link-button" href="/work-orders/edit/@workOrder.Id?returnUrl=/work-orders/@workOrder.Id">
                    Edit Work Order
                </a>
            </div>
        </section>

        <section class="module-summary-grid">
            <article class="module-summary-card info-card">
                <span>Priority</span>
                <strong>@workOrder.Priority</strong>
                <small>Current priority level</small>
            </article>

            <article class="@GetDueCardClass()">
                <span>Due Date</span>
                <strong>@workOrder.DueDate.ToString("dd MMM")</strong>
                <small>@workOrder.DueDate.ToString("yyyy")</small>
            </article>

            <article class="module-summary-card">
                <span>Owner</span>
                <strong>@workOrder.Owner</strong>
                <small>Assigned person</small>
            </article>

            <article class="module-summary-card">
                <span>Type</span>
                <strong>@workOrder.Type</strong>
                <small>Work category</small>
            </article>
        </section>

        <section class="details-grid">
            <article class="details-card">
                <div class="details-card-header">
                    <h2>Work Order Information</h2>
                </div>

                <div class="details-list">
                    <div class="details-row">
                        <span>Work Order Number</span>
                        <strong>@workOrder.WorkOrderNumber</strong>
                    </div>

                    <div class="details-row">
                        <span>Title</span>
                        <strong>@workOrder.Title</strong>
                    </div>

                    <div class="details-row">
                        <span>Site</span>
                        <strong>@workOrder.Site</strong>
                    </div>

                    <div class="details-row">
                        <span>Department</span>
                        <strong>@workOrder.Department</strong>
                    </div>

                    <div class="details-row">
                        <span>Owner</span>
                        <strong>@workOrder.Owner</strong>
                    </div>

                    <div class="details-row">
                        <span>Type</span>
                        <strong>@workOrder.Type</strong>
                    </div>
                </div>
            </article>

            <article class="details-card">
                <div class="details-card-header">
                    <h2>Status & Dates</h2>
                </div>

                <div class="details-list">
                    <div class="details-row">
                        <span>Priority</span>
                        <strong>
                            <span class="@GetPriorityClass(workOrder.Priority)">
                                @workOrder.Priority
                            </span>
                        </strong>
                    </div>

                    <div class="details-row">
                        <span>Status</span>
                        <strong>
                            <span class="@GetStatusClass(workOrder.Status)">
                                @workOrder.Status
                            </span>
                        </strong>
                    </div>

                    <div class="details-row">
                        <span>Created Date</span>
                        <strong>@workOrder.CreatedDate.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div class="details-row">
                        <span>Due Date</span>
                        <strong>@workOrder.DueDate.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div class="details-row">
                        <span>Flag</span>
                        <strong>
                            @if (workOrder.IsOverdue)
                            {
                                <span class="badge badge-danger">Overdue</span>
                            }
                            else
                            {
                                <span class="badge badge-muted">On Track</span>
                            }
                        </strong>
                    </div>
                </div>
            </article>
        </section>

        <section class="details-card">
            <div class="details-card-header">
                <h2>Notes</h2>
            </div>

            @if (string.IsNullOrWhiteSpace(workOrder.Notes))
            {
                <p class="details-notes muted-text">
                    No notes have been added for this work order.
                </p>
            }
            else
            {
                <p class="details-notes">
                    @workOrder.Notes
                </p>
            }
        </section>

        <div class="form-actions">
            <button type="button" class="secondary-button" @onclick="BackToList">
                Back to Work Orders
            </button>

            <a class="primary-link-button" href="/work-orders/edit/@workOrder.Id?returnUrl=/work-orders/@workOrder.Id">
                Edit Work Order
            </a>
        </div>
    }

</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private WorkOrder? workOrder;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        workOrder = await Db.WorkOrders
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == Id);

        isLoading = false;
    }

    private void BackToList()
    {
        Navigation.NavigateTo("/work-orders");
    }

    private string GetDueCardClass()
    {
        if (workOrder == null)
        {
            return "module-summary-card";
        }

        if (workOrder.IsOverdue)
        {
            return "module-summary-card danger-card";
        }

        if (workOrder.DueDate <= DateTime.Today.AddDays(7))
        {
            return "module-summary-card warning-card";
        }

        return "module-summary-card success-card";
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLower() switch
        {
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "in progress" => "badge badge-info",
            "open" => "badge badge-warning",
            "new" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLower() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }
}