@page "/work-orders/details/{Id:int}"
@page "/work-orders/view/{Id:int}"

@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models

@inject OperationsFlowDbContext Db
@inject NavigationManager Navigation

<PageTitle>Work Order Details - OperationsFlow</PageTitle>

<div class="page-shell module-page work-order-details-page">
    @if (isLoading)
    {
        <section class="table-card">
            <p>Loading work order...</p>
        </section>
    }
    else if (workOrder == null)
    {
        <section class="module-header">
            <div>
                <p class="eyebrow dark">Operations</p>
                <h1>Work Order Not Found</h1>
                <p>The requested work order could not be found.</p>
            </div>
        </section>

        <section class="table-card">
            <button class="btn btn-secondary" type="button" @onclick="BackToWorkOrders">
                Back to Work Orders
            </button>
        </section>
    }
    else
    {
        <section class="module-header">
            <div>
                <p class="eyebrow dark">Operations</p>
                <h1>@workOrder.WorkOrderNumber</h1>
                <p>@workOrder.Title</p>
            </div>

            <div class="module-header-stat">
                <span>Status</span>
                <strong>@workOrder.Status</strong>
            </div>
        </section>

        <section class="detail-action-bar">
            <button class="btn btn-secondary" type="button" @onclick="BackToWorkOrders">
                Back to Work Orders
            </button>

            <button class="btn btn-primary" type="button" @onclick="GoToEdit">
                Edit Work Order
            </button>
        </section>

        <section class="kpi-grid">
            <div class="kpi-card">
                <span class="kpi-label">Priority</span>
                <strong>@workOrder.Priority</strong>
                <span class="kpi-note">@workOrder.Type</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">Due Date</span>
                <strong>@workOrder.DueDate.ToString("dd MMM")</strong>
                <span class="kpi-note">@workOrder.DueDate.ToString("yyyy")</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">Flag</span>
                <strong>@(workOrder.IsOverdue ? "Overdue" : "On Track")</strong>
                <span class="kpi-note">@(workOrder.IsOverdue ? "Past due and not closed" : "No overdue flag")</span>
            </div>

            <div class="kpi-card">
                <span class="kpi-label">Owner</span>
                <strong>@workOrder.Owner</strong>
                <span class="kpi-note">@workOrder.Department</span>
            </div>
        </section>

        <section class="summary-grid">
            <div class="summary-panel">
                <div class="panel-header">
                    <div>
                        <h2>Work Order Details</h2>
                        <p>Core record information used by workload, reminders, reports, and activity history.</p>
                    </div>
                </div>

                <div class="detail-grid">
                    <div>
                        <span>Work Order Number</span>
                        <strong>@workOrder.WorkOrderNumber</strong>
                    </div>

                    <div>
                        <span>Title</span>
                        <strong>@workOrder.Title</strong>
                    </div>

                    <div>
                        <span>Site</span>
                        <strong>@workOrder.Site</strong>
                    </div>

                    <div>
                        <span>Department</span>
                        <strong>@workOrder.Department</strong>
                    </div>

                    <div>
                        <span>Owner</span>
                        <strong>@workOrder.Owner</strong>
                    </div>

                    <div>
                        <span>Type</span>
                        <strong>@workOrder.Type</strong>
                    </div>

                    <div>
                        <span>Priority</span>
                        <strong>
                            <span class="@GetPriorityClass(workOrder.Priority)">
                                @workOrder.Priority
                            </span>
                        </strong>
                    </div>

                    <div>
                        <span>Status</span>
                        <strong>
                            <span class="@GetStatusClass(workOrder.Status)">
                                @workOrder.Status
                            </span>
                        </strong>
                    </div>

                    <div>
                        <span>Created Date</span>
                        <strong>@workOrder.CreatedDate.ToString("dd MMM yyyy")</strong>
                    </div>

                    <div>
                        <span>Due Date</span>
                        <strong>@workOrder.DueDate.ToString("dd MMM yyyy")</strong>
                    </div>
                </div>
            </div>

            <div class="summary-panel">
                <div class="panel-header">
                    <div>
                        <h2>Notes</h2>
                        <p>Recorded context, follow-up details, or operational notes for this work order.</p>
                    </div>
                </div>

                <div class="notes-panel">
                    @DisplayText(workOrder.Notes)
                </div>
            </div>
        </section>

        <section class="activity-history-panel">
            <div class="section-heading-row">
                <div>
                    <h2>Activity History</h2>
                    <p>
                        Record-level traceability for this work order. This helps reviewers see when the item was
                        created, updated, reviewed, completed, or changed.
                    </p>
                </div>

                <div class="activity-count-card">
                    <span>Events</span>
                    <strong>@activityHistory.Count</strong>
                </div>
            </div>

            @if (activityHistory.Count == 0)
            {
                <div class="empty-state">
                    <strong>No activity history yet.</strong>
                    <p>
                        Create, edit, or review this work order to generate activity history.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="data-table activity-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Action</th>
                                <th>Description</th>
                                <th>Created By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var activity in activityHistory)
                            {
                                <tr>
                                    <td>@activity.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                    <td>
                                        <span class="@GetActivityBadgeClass(activity.ActionType)">
                                            @activity.ActionType
                                        </span>
                                    </td>
                                    <td>@activity.Description</td>
                                    <td>@activity.CreatedBy</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="detail-action-bar bottom-actions">
            <button class="btn btn-secondary" type="button" @onclick="BackToWorkOrders">
                Back to Work Orders
            </button>

            <button class="btn btn-primary" type="button" @onclick="GoToEdit">
                Edit Work Order
            </button>
        </section>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private WorkOrder? workOrder;
    private List<ActivityLog> activityHistory = new();
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        workOrder = await Db.WorkOrders
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (workOrder != null)
        {
            await LoadActivityHistory();
        }

        isLoading = false;
    }

    private async Task LoadActivityHistory()
    {
        activityHistory = await Db.ActivityLogs
            .AsNoTracking()
            .Where(x =>
                x.ModuleName == "Work Orders" &&
                x.RecordId == Id)
            .OrderByDescending(x => x.CreatedDate)
            .ToListAsync();
    }

    private string BuildEditUrl()
    {
        return $"/work-orders/edit/{Id}?returnUrl={Uri.EscapeDataString($"/work-orders/details/{Id}")}";
    }

    private void GoToEdit()
    {
        Navigation.NavigateTo(BuildEditUrl());
    }

    private void BackToWorkOrders()
    {
        Navigation.NavigateTo("/work-orders");
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "No notes recorded." : value;
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "in progress" => "badge badge-info",
            "open" => "badge badge-warning",
            "new" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static string GetActivityBadgeClass(string? actionType)
    {
        return actionType?.ToLowerInvariant() switch
        {
            "created" => "badge badge-success",
            "updated" => "badge badge-info",
            "reviewed" => "badge badge-secondary",
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "deleted" => "badge badge-danger",
            _ => "badge badge-secondary"
        };
    }
}