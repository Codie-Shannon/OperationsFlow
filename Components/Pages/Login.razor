@page "/"
@page "/login"
@rendermode InteractiveServer

@using OperationsFlow.Services

@inject LocalAuthService LocalAuthService
@inject LocalCurrentUserService CurrentUserService
@inject LocalSessionStorageService LocalSessionStorageService
@inject NavigationManager Navigation

<PageTitle>Login - OperationsFlow</PageTitle>

<div class="of-page">
    <PageHero Eyebrow="OPERATIONSFLOW / SIGN IN"
              Title="OperationsFlow Login"
              Subtitle="Sign in with a local SQL account, or use Microsoft sign-in to map a tenant account to a local OperationsFlow role."
              BadgeText="Local + Microsoft Auth"
              BadgeClass="of-badge of-badge-success">
        <Actions>
            <a class="of-btn of-btn-secondary" href="/demo-guide">Demo Guide</a>
            <a class="of-btn of-btn-secondary" href="/user-roles">User Roles</a>
            <a class="of-btn of-btn-secondary" href="/admin-settings">Admin Settings</a>
        </Actions>
    </PageHero>

    <PurposeNote Title="Purpose" Icon="🔐">
        <p>
            OperationsFlow supports local SQL-backed login for the free/local version and Microsoft OAuth2 sign-in for the Week 4 Microsoft 365 pilot.
            Microsoft proves the user's identity; OperationsFlow then loads the linked local SQL user, roles, and permissions.
        </p>
    </PurposeNote>

    <div class="of-two-column-grid">
        <InfoPanel Title="Sign in"
                   Subtitle="Use local credentials or Microsoft sign-in. Both paths load local OperationsFlow roles and permissions."
                   Tone="default">

            <ChildContent>
                @if (CurrentUserService.IsSignedIn && CurrentUserService.CurrentUser is not null)
                {
                    <div class="of-review-proof-card">
                        <span class="of-badge of-badge-success">Signed in</span>
                        <h3>@CurrentUserService.CurrentUser.DisplayName</h3>
                        <p class="of-muted-text">@CurrentUserService.CurrentUser.Email</p>

                        <div class="of-link-row">
                            <span class="of-badge @(CurrentUserService.CurrentUser.IsMicrosoftLinked ? "of-badge-info" : "of-badge-muted")">
                                @CurrentUserService.CurrentUser.SignInProviderDisplay
                            </span>

                            @foreach (var role in CurrentUserService.CurrentUser.Roles)
                            {
                                <span class="of-badge of-badge-info">@role</span>
                            }
                        </div>

                        <div class="of-link-row">
                            <a class="of-btn of-btn-primary" href="/dashboard">Go to dashboard</a>
                            <button class="of-btn of-btn-secondary" @onclick="LogoutAsync">Log out</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label">Username or email</label>
                        <input class="of-input" @bind="UserNameOrEmail" autocomplete="username" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input class="of-input" type="password" @bind="Password" autocomplete="current-password" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(StatusMessage))
                    {
                        <div class="@StatusCssClass">
                            @StatusMessage
                        </div>
                    }

                    <div class="of-link-row">
                        <button class="of-btn of-btn-primary" @onclick="LoginAsync" disabled="@IsBusy">
                            @(IsBusy ? "Signing in..." : "Sign in")
                        </button>

                        <a class="of-btn of-btn-secondary"
                           href="@MicrosoftSignInUrl">
                            Sign in with Microsoft
                        </a>
                    </div>
                }
            </ChildContent>
        </InfoPanel>

        <InfoPanel Title="Demo accounts"
                   Subtitle="Local SQL credentials for testing roles without Microsoft sign-in."
                   Tone="info">
            <ChildContent>
                <table class="table">
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Username</th>
                            <th>Password</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span class="of-badge of-badge-danger">Admin</span></td>
                            <td>admin</td>
                            <td>Admin123!</td>
                        </tr>
                        <tr>
                            <td><span class="of-badge of-badge-warning">Manager</span></td>
                            <td>manager</td>
                            <td>Manager123!</td>
                        </tr>
                        <tr>
                            <td><span class="of-badge of-badge-info">Reviewer</span></td>
                            <td>reviewer</td>
                            <td>Reviewer123!</td>
                        </tr>
                        <tr>
                            <td><span class="of-badge of-badge-success">Worker</span></td>
                            <td>worker</td>
                            <td>Worker123!</td>
                        </tr>
                        <tr>
                            <td><span class="of-badge of-badge-muted">ReadOnly</span></td>
                            <td>viewer</td>
                            <td>Viewer123!</td>
                        </tr>
                    </tbody>
                </table>
            </ChildContent>
        </InfoPanel>
    </div>

    <InfoPanel Title="Week 3 / Week 4 auth split"
               Subtitle="The local app authorization model stays consistent across both sign-in paths."
               Tone="success">
        <ChildContent>
            <div class="of-two-column-grid">
                <div class="of-review-proof-card">
                    <span class="of-badge of-badge-success">Week 3</span>
                    <h3>Local/free version</h3>
                    <p>
                        SQL-backed users, hashed passwords, persistent local login, local roles, local permissions,
                        local file storage option, evidence workflow, reports, and activity traceability.
                    </p>
                </div>

                <div class="of-review-proof-card">
                    <span class="of-badge of-badge-info">Week 4</span>
                    <h3>Microsoft 365 pilot</h3>
                    <p>
                        Microsoft OAuth2 sign-in, Microsoft account linking, SharePoint/Graph evidence storage,
                        metadata writeback, and Microsoft 365 configuration checks.
                    </p>
                </div>
            </div>
        </ChildContent>
    </InfoPanel>

    <TableCard Title="Authentication model"
               Subtitle="Microsoft identifies the user; OperationsFlow authorizes the user.">
        <ChildContent>
            <table class="table">
                <thead>
                    <tr>
                        <th>Layer</th>
                        <th>Responsibility</th>
                        <th>Implementation</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="of-badge of-badge-muted">Local login</span></td>
                        <td>Username/password authentication for local/free operation.</td>
                        <td>LocalUsers with hashed passwords.</td>
                    </tr>
                    <tr>
                        <td><span class="of-badge of-badge-info">Microsoft OAuth2</span></td>
                        <td>Tenant account identity proof.</td>
                        <td>Microsoft sign-in returns user identity, email, and provider id.</td>
                    </tr>
                    <tr>
                        <td><span class="of-badge of-badge-warning">ExternalLoginLinks</span></td>
                        <td>Maps Microsoft account to an OperationsFlow local user.</td>
                        <td>Microsoft user is linked to the matching LocalUser record.</td>
                    </tr>
                    <tr>
                        <td><span class="of-badge of-badge-success">Authorization</span></td>
                        <td>Controls what the signed-in user can do.</td>
                        <td>Local SQL roles and permissions remain the app permission source.</td>
                    </tr>
                </tbody>
            </table>
        </ChildContent>
    </TableCard>

    <GuidanceNote Title="Security note" Icon="⚠️" Tone="warning">
        <p>
            Demo credentials are for local portfolio testing only. Microsoft tenant secrets belong in local configuration,
            user-secrets, or environment variables and must not be committed to GitHub.
        </p>
    </GuidanceNote>
</div>

@code {
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string UserNameOrEmail { get; set; } = "admin";

    private string Password { get; set; } = "Admin123!";

    private string StatusMessage { get; set; } = string.Empty;

    private string StatusCssClass { get; set; } = "alert alert-info";

    private bool IsBusy { get; set; }

    private string MicrosoftSignInUrl =>
        string.IsNullOrWhiteSpace(ReturnUrl)
            ? "/auth/microsoft/start?returnUrl=/dashboard"
            : $"/auth/microsoft/start?returnUrl={Uri.EscapeDataString(ReturnUrl)}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LocalSessionStorageService.ClearLegacyLocalStorageAsync();
    }

    private async Task LoginAsync()
    {
        IsBusy = true;
        StatusMessage = string.Empty;

        try
        {
            var result = await LocalAuthService.LoginAsync(UserNameOrEmail, Password);

            if (result.Succeeded && result.User is not null)
            {
                await LocalSessionStorageService.SaveSignedInUserIdAsync(result.User.Id);

                StatusCssClass = "alert alert-success";
                StatusMessage = $"Signed in as {result.User.DisplayName}.";

                var targetUrl = string.IsNullOrWhiteSpace(ReturnUrl)
                    ? "/dashboard"
                    : ReturnUrl;

                Navigation.NavigateTo(targetUrl, replace: true);
            }
            else
            {
                StatusCssClass = "alert alert-danger";
                StatusMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            StatusCssClass = "alert alert-danger";
            StatusMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task LogoutAsync()
    {
        LocalAuthService.Logout();
        await LocalSessionStorageService.ClearSignedInUserIdAsync();

        StatusCssClass = "alert alert-info";
        StatusMessage = "Signed out.";
    }
}