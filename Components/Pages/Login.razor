@page "/"
@page "/login"
@rendermode InteractiveServer

@using OperationsFlow.Services

@inject LocalAuthService LocalAuthService
@inject LocalCurrentUserService CurrentUserService
@inject LocalSessionStorageService LocalSessionStorageService
@inject NavigationManager Navigation

<PageTitle>Login - OperationsFlow</PageTitle>

<PageHero Eyebrow="OPERATIONSFLOW / LOCAL LOGIN"
          Title="Local Login"
          Subtitle="Week 3 local/free mode uses SQL-backed users, hashed password login, local roles, local permissions, persistent local login, and logout controls. Week 4 will add Microsoft OAuth2 linking to these local accounts."
          BadgeText="Local Auth"
          BadgeClass="of-badge of-badge-info" />

<PurposeNote Title="Purpose" Icon="🔐">
    <p>
        Sign in with a local SQL-backed OperationsFlow account. This proves the free/local version of the authentication model
        before Week 4 adds Microsoft OAuth2 account linking, Microsoft 365 configuration, and SharePoint/Graph storage.
    </p>
</PurposeNote>

<div class="of-two-column-grid">
    <InfoPanel Title="Sign in"
               Subtitle="Use a seeded local demo account or a SQL-backed account added later."
               Tone="default">

        @if (CurrentUserService.IsSignedIn && CurrentUserService.CurrentUser is not null)
        {
            <div class="of-review-proof-card">
                <span class="of-badge of-badge-success">Signed in</span>
                <h3>@CurrentUserService.CurrentUser.DisplayName</h3>
                <p class="of-muted-text">@CurrentUserService.CurrentUser.Email</p>

                <div class="of-link-row">
                    @foreach (var role in CurrentUserService.CurrentUser.Roles)
                    {
                        <span class="of-badge of-badge-info">@role</span>
                    }
                </div>

                <div class="of-link-row">
                    <a class="of-btn of-btn-primary" href="/dashboard">Go to dashboard</a>
                    <button class="of-btn of-btn-secondary" @onclick="LogoutAsync">Log out</button>
                </div>
            </div>
        }
        else
        {
            <div class="mb-3">
                <label class="form-label">Username or email</label>
                <input class="of-input" @bind="UserNameOrEmail" autocomplete="username" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input class="of-input" type="password" @bind="Password" autocomplete="current-password" />
            </div>

            @if (!string.IsNullOrWhiteSpace(StatusMessage))
            {
                <div class="@StatusCssClass">
                    @StatusMessage
                </div>
            }

            <div class="of-link-row">
                <button class="of-btn of-btn-primary" @onclick="LoginAsync" disabled="@IsBusy">
                    @(IsBusy ? "Signing in..." : "Sign in")
                </button>
            </div>
        }
    </InfoPanel>

    <InfoPanel Title="Demo accounts"
               Subtitle="Local portfolio credentials only. Do not use these in real production."
               Tone="info">

        <ul class="of-mini-list">
            <li class="of-mini-list-item">
                <strong>Admin:</strong>
                <span>admin / Admin123!</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Manager:</strong>
                <span>manager / Manager123!</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Reviewer:</strong>
                <span>reviewer / Reviewer123!</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Worker:</strong>
                <span>worker / Worker123!</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Viewer:</strong>
                <span>viewer / Viewer123!</span>
            </li>
        </ul>
    </InfoPanel>
</div>

<InfoPanel Title="Week 3 / Week 4 auth split"
           Subtitle="This keeps the local free version and the Microsoft 365 production version cleanly separated."
           Tone="success">

    <div class="of-review-proof-grid">
        <div class="of-review-proof-card">
            <span class="of-badge of-badge-success">Week 3</span>
            <h3>Local/free version</h3>
            <p>
                SQL-backed users, hashed passwords, persistent local login, local roles, local permissions, local file storage,
                local evidence workflow, reports, and activity traceability.
            </p>
        </div>

        <div class="of-review-proof-card">
            <span class="of-badge of-badge-warning">Week 4</span>
            <h3>Licensed/live version</h3>
            <p>
                Microsoft OAuth2 login, Microsoft account linking, SharePoint/Graph storage, production permissions,
                Microsoft 365 configuration, and production deployment hardening.
            </p>
        </div>
    </div>
</InfoPanel>

<InfoPanel Title="Local session behaviour"
           Subtitle="The local/free version now behaves like a usable internal app demo."
           Tone="info">

    <div class="of-review-proof-grid">
        <div class="of-review-proof-card">
            <span class="of-badge of-badge-success">Login</span>
            <h3>SQL account check</h3>
            <p>
                Username/email and password are checked against LocalUsers. Passwords are verified against hashed values.
            </p>
        </div>

        <div class="of-review-proof-card">
            <span class="of-badge of-badge-info">Refresh</span>
            <h3>Persistent local session</h3>
            <p>
                The browser stores only the local user id. The app reloads user, roles, and permissions from SQL after refresh.
            </p>
        </div>

        <div class="of-review-proof-card">
            <span class="of-badge of-badge-warning">Logout</span>
            <h3>Session cleared</h3>
            <p>
                Logout clears the current user and removes the saved local user id from browser storage.
            </p>
        </div>

        <div class="of-review-proof-card">
            <span class="of-badge of-badge-muted">Week 4</span>
            <h3>OAuth2 linking</h3>
            <p>
                Microsoft OAuth2 will identify the user, then ExternalLoginLinks will map that identity to LocalUser.
            </p>
        </div>
    </div>
</InfoPanel>

<GuidanceNote Title="Security boundary" Icon="⚠️" Tone="warning">
    <p>
        Passwords are hashed, not stored as plain text. The browser stores only the local user id so the app can reload the
        account from SQL after refresh. These seeded demo credentials are only for local portfolio testing.
    </p>
</GuidanceNote>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string UserNameOrEmail { get; set; } = "admin";

    private string Password { get; set; } = "Admin123!";

    private string StatusMessage { get; set; } = string.Empty;

    private string StatusCssClass { get; set; } = "alert alert-info";

    private bool IsBusy { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await LocalSessionStorageService.ClearLegacyLocalStorageAsync();
    }

    private async Task LoginAsync()
    {
        IsBusy = true;
        StatusMessage = string.Empty;

        try
        {
            var result = await LocalAuthService.LoginAsync(UserNameOrEmail, Password);

            if (result.Succeeded && result.User is not null)
            {
                await LocalSessionStorageService.SaveSignedInUserIdAsync(result.User.Id);

                StatusCssClass = "alert alert-success";
                StatusMessage = $"Signed in as {result.User.DisplayName}.";

                var targetUrl = string.IsNullOrWhiteSpace(ReturnUrl)
                    ? "/dashboard"
                    : ReturnUrl;

                Navigation.NavigateTo(targetUrl, replace: true);
            }
            else
            {
                StatusCssClass = "alert alert-danger";
                StatusMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            StatusCssClass = "alert alert-danger";
            StatusMessage = $"Login failed: {ex.Message}";
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task LogoutAsync()
    {
        LocalAuthService.Logout();
        await LocalSessionStorageService.ClearSignedInUserIdAsync();

        StatusCssClass = "alert alert-info";
        StatusMessage = "Signed out.";
    }
}