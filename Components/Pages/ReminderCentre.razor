@page "/reminders"

@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake

@inject OperationsFlowDbContext Db

<PageTitle>Reminder Centre - OperationsFlow</PageTitle>

<div class="page-shell module-page reminder-centre-page">
    <section class="module-header">
        <div>
            <p class="eyebrow dark">Daily Focus</p>
            <h1>Reminder Centre</h1>
            <p>
                A focused view of overdue work, due-soon items, compliance reminders,
                training expiries, and document intake records needing attention.
            </p>
        </div>

        <div class="module-header-stat">
            <span>Total Reminders</span>
            <strong>@TotalReminderCount</strong>
        </div>
    </section>

    <section class="page-purpose-note">
        <strong>Purpose:</strong> use this page to open the exact records that need follow-up.
        Reminders now point to work order details, corrective action edit pages, document intake records,
        and the relevant compliance module pages.
    </section>

    <section class="module-summary-grid">
        <article class="module-summary-card danger-card">
            <span>Overdue Work</span>
            <strong>@OverdueWorkCount</strong>
            <small>Work orders and corrective actions</small>
        </article>

        <article class="module-summary-card warning-card">
            <span>Document Reviews</span>
            <strong>@DocumentReminderCount</strong>
            <small>Overdue or due soon</small>
        </article>

        <article class="module-summary-card info-card">
            <span>Training Issues</span>
            <strong>@TrainingReminderCount</strong>
            <small>Expired or expiring soon</small>
        </article>

        <article class="module-summary-card">
            <span>Intake Follow-ups</span>
            <strong>@IntakeReminderCount</strong>
            <small>Overdue, due soon, or review needed</small>
        </article>

        <article class="module-summary-card">
            <span>Action Links</span>
            <strong>@ActionLinkCount</strong>
            <small>Openable reminder records</small>
        </article>
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Recommended Review Order</h2>
                    <p>Use this order when checking daily follow-up work.</p>
                </div>
            </div>

            <ol class="review-list">
                <li>Open overdue work orders and corrective actions first.</li>
                <li>Check document reviews that are overdue or due soon.</li>
                <li>Review expired or expiring training records.</li>
                <li>Process document intake records waiting for review or completion.</li>
                <li>After updates, check Workload, Data Quality, Reports, and Activity Log.</li>
            </ol>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Reminder Coverage</h2>
                    <p>What this page connects together.</p>
                </div>
            </div>

            <div class="review-note-grid">
                <div class="review-note-card">
                    <span>OPERATIONS</span>
                    <strong>Overdue work</strong>
                    <p>Work orders and corrective actions link to their review/edit pages.</p>
                </div>

                <div class="review-note-card">
                    <span>COMPLIANCE</span>
                    <strong>Review cycles</strong>
                    <p>Documents and training records point back to their compliance modules.</p>
                </div>

                <div class="review-note-card">
                    <span>ADMIN</span>
                    <strong>Document intake</strong>
                    <p>Incoming document reminders open the exact intake record.</p>
                </div>

                <div class="review-note-card">
                    <span>MANAGEMENT</span>
                    <strong>Follow-up loop</strong>
                    <p>Reminder actions support workload, reports, data quality, and traceability.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="module-toolbar">
        <input class="search-input"
               placeholder="Search reminder, owner, module, reference, status, or action..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="filter-select" @bind="categoryFilter">
            <option value="">All Categories</option>
            @foreach (var category in CategoryOptions)
            {
                <option value="@category">@category</option>
            }
        </select>

        <select class="filter-select" @bind="urgencyFilter">
            <option value="">All Urgency</option>
            <option value="Overdue">Overdue</option>
            <option value="Due Soon">Due Soon</option>
            <option value="Needs Review">Needs Review</option>
            <option value="Expired">Expired</option>
            <option value="Expiring Soon">Expiring Soon</option>
        </select>
    </section>

    <section class="table-card">
        <div class="table-card-header">
            <div>
                <h2>Reminder Action List</h2>
                <p>Showing @FilteredReminderItems.Count of @AllReminderItems.Count reminders.</p>
            </div>

            <div class="activity-count-card">
                <span>Open Links</span>
                <strong>@FilteredReminderItems.Count(x => !string.IsNullOrWhiteSpace(x.ActionUrl))</strong>
            </div>
        </div>

        @if (!FilteredReminderItems.Any())
        {
            <div class="empty-state">
                <strong>No reminders match the current filters.</strong>
                <p>Clear the search or filters to show more reminder records.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table reminder-table">
                    <thead>
                        <tr>
                            <th>Urgency</th>
                            <th>Category</th>
                            <th>Reference</th>
                            <th>Reminder</th>
                            <th>Owner</th>
                            <th>Due / Review Date</th>
                            <th>Recommended Action</th>
                            <th>Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredReminderItems)
                        {
                            <tr>
                                <td>
                                    <span class="@GetUrgencyClass(item.Urgency)">
                                        @item.Urgency
                                    </span>
                                </td>
                                <td>@item.Category</td>
                                <td class="strong-cell">@item.Reference</td>
                                <td>
                                    <strong>@item.Title</strong>
                                    <small>@item.ModuleDetail</small>
                                </td>
                                <td>@item.Owner</td>
                                <td>
                                    <strong>@item.DueDate.ToString("dd MMM yyyy")</strong>
                                    <small>@GetDueTimingText(item.DueDate)</small>
                                </td>
                                <td>@item.RecommendedAction</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                                    {
                                        <a class="btn btn-small btn-primary" href="@item.ActionUrl">
                                            Open
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-muted">Review</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Overdue Work Orders</h2>
                    <p>Operational work requests past their due date.</p>
                </div>

                <a class="btn btn-small btn-primary" href="/work-orders">View Work Orders</a>
            </div>

            @if (!OverdueWorkOrders.Any())
            {
                <div class="empty-state">
                    <strong>No overdue work orders.</strong>
                    <p>Open work orders currently have no overdue reminder flags.</p>
                </div>
            }
            else
            {
                <div class="issue-card-list">
                    @foreach (var item in OverdueWorkOrders.Take(6))
                    {
                        <article class="issue-card">
                            <div>
                                <strong>@item.WorkOrderNumber — @item.Title</strong>
                                <p>@item.Owner • @item.Department • Due @item.DueDate.ToString("dd MMM yyyy")</p>
                                <span class="badge badge-danger">Overdue</span>
                            </div>

                            <div class="issue-card-actions">
                                <a class="btn btn-small btn-primary" href="/work-orders/details/@item.Id">Open</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Overdue Corrective Actions</h2>
                    <p>Corrective or improvement actions past their due date.</p>
                </div>

                <a class="btn btn-small btn-primary" href="/corrective-actions">View Actions</a>
            </div>

            @if (!OverdueCorrectiveActions.Any())
            {
                <div class="empty-state">
                    <strong>No overdue corrective actions.</strong>
                    <p>Open corrective actions currently have no overdue reminder flags.</p>
                </div>
            }
            else
            {
                <div class="issue-card-list">
                    @foreach (var item in OverdueCorrectiveActions.Take(6))
                    {
                        <article class="issue-card">
                            <div>
                                <strong>CA-@item.Id — @item.Title</strong>
                                <p>@item.Owner • @item.Source • Due @item.DueDate.ToString("dd MMM yyyy")</p>
                                <span class="badge badge-danger">Overdue</span>
                            </div>

                            <div class="issue-card-actions">
                                <a class="btn btn-small btn-primary" href="/corrective-actions/edit/@item.Id">Open</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Document Reviews</h2>
                    <p>Controlled documents overdue for review or due soon.</p>
                </div>

                <a class="btn btn-small btn-primary" href="/documents">View Documents</a>
            </div>

            @if (!DocumentReviewReminders.Any())
            {
                <div class="empty-state">
                    <strong>No document review reminders.</strong>
                    <p>Controlled documents currently have no overdue or due-soon review flags.</p>
                </div>
            }
            else
            {
                <div class="issue-card-list">
                    @foreach (var item in DocumentReviewReminders.Take(6))
                    {
                        <article class="issue-card">
                            <div>
                                <strong>@item.DocumentNumber — @item.Title</strong>
                                <p>@item.Owner • @item.Department • Review @item.NextReviewDate.ToString("dd MMM yyyy")</p>

                                @if (item.IsReviewOverdue)
                                {
                                    <span class="badge badge-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Due Soon</span>
                                }
                            </div>

                            <div class="issue-card-actions">
                                <a class="btn btn-small btn-primary" href="/documents">Open</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Training Compliance</h2>
                    <p>Expired or soon-to-expire training records.</p>
                </div>

                <a class="btn btn-small btn-primary" href="/training">View Training</a>
            </div>

            @if (!TrainingReminders.Any())
            {
                <div class="empty-state">
                    <strong>No training reminders.</strong>
                    <p>Training records currently have no expired or expiring-soon reminder flags.</p>
                </div>
            }
            else
            {
                <div class="issue-card-list">
                    @foreach (var item in TrainingReminders.Take(6))
                    {
                        <article class="issue-card">
                            <div>
                                <strong>@item.StaffName — @item.TrainingName</strong>
                                <p>@item.Department • Expires @item.ExpiryDate.ToString("dd MMM yyyy")</p>

                                @if (item.IsExpired)
                                {
                                    <span class="badge badge-danger">Expired</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Expiring Soon</span>
                                }
                            </div>

                            <div class="issue-card-actions">
                                <a class="btn btn-small btn-primary" href="/training">Open</a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="table-card">
        <div class="table-card-header">
            <div>
                <h2>Document Intake Follow-ups</h2>
                <p>Incoming documents that are overdue, due soon, or waiting for manual review.</p>
            </div>

            <a class="btn btn-small btn-primary" href="/document-intake">View Intake</a>
        </div>

        @if (!IntakeReminders.Any())
        {
            <div class="empty-state">
                <strong>No document intake reminders.</strong>
                <p>Incoming document records currently have no reminder flags.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Document</th>
                            <th>Assigned To</th>
                            <th>Target System</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Flag</th>
                            <th>Open</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in IntakeReminders)
                        {
                            <tr>
                                <td class="strong-cell">@item.DocumentName</td>
                                <td>@item.AssignedTo</td>
                                <td>@item.TargetSystem</td>
                                <td>
                                    <span class="@GetIntakeStatusClass(item.Status)">
                                        @item.Status
                                    </span>
                                </td>
                                <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.IsOverdue)
                                    {
                                        <span class="badge badge-danger">Overdue</span>
                                    }
                                    else if (item.NeedsReview)
                                    {
                                        <span class="badge badge-warning">Needs Review</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-info">Due Soon</span>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-small btn-primary" href="/document-intake/edit/@item.Id">
                                        Open
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private List<WorkOrder> workOrders = new();
    private List<CorrectiveAction> correctiveActions = new();
    private List<DocumentRecord> documents = new();
    private List<TrainingRecord> trainingRecords = new();
    private List<DocumentIntakeModel> documentIntakeItems = new();

    private string searchText = "";
    private string categoryFilter = "";
    private string urgencyFilter = "";

    private List<WorkOrder> OverdueWorkOrders =>
        workOrders
            .Where(x => x.IsOverdue)
            .OrderBy(x => x.DueDate)
            .ThenBy(x => x.Owner)
            .ToList();

    private List<CorrectiveAction> OverdueCorrectiveActions =>
        correctiveActions
            .Where(x => x.IsOverdue)
            .OrderBy(x => x.DueDate)
            .ThenBy(x => x.Owner)
            .ToList();

    private List<DocumentRecord> DocumentReviewReminders =>
        documents
            .Where(x => x.IsReviewOverdue || x.IsDueSoon)
            .OrderByDescending(x => x.IsReviewOverdue)
            .ThenBy(x => x.NextReviewDate)
            .ToList();

    private List<TrainingRecord> TrainingReminders =>
        trainingRecords
            .Where(x => x.IsExpired || x.IsExpiringSoon)
            .OrderByDescending(x => x.IsExpired)
            .ThenBy(x => x.ExpiryDate)
            .ThenBy(x => x.StaffName)
            .ToList();

    private List<DocumentIntakeModel> IntakeReminders =>
        documentIntakeItems
            .Where(x => x.IsOverdue || x.NeedsReview || x.IsDueSoon)
            .OrderByDescending(x => x.IsOverdue)
            .ThenByDescending(x => x.NeedsReview)
            .ThenBy(x => x.DueDate)
            .ThenBy(x => x.DocumentName)
            .ToList();

    private int OverdueWorkCount => OverdueWorkOrders.Count + OverdueCorrectiveActions.Count;

    private int DocumentReminderCount => DocumentReviewReminders.Count;

    private int TrainingReminderCount => TrainingReminders.Count;

    private int IntakeReminderCount => IntakeReminders.Count;

    private int TotalReminderCount => AllReminderItems.Count;

    private int ActionLinkCount => AllReminderItems.Count(x => !string.IsNullOrWhiteSpace(x.ActionUrl));

    private List<string> CategoryOptions =>
        AllReminderItems
            .Select(x => x.Category)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    private List<ReminderItem> AllReminderItems
    {
        get
        {
            var items = new List<ReminderItem>();

            items.AddRange(
                OverdueWorkOrders.Select(x => new ReminderItem(
                    Category: "Work Orders",
                    Reference: x.WorkOrderNumber,
                    Title: x.Title,
                    Owner: SafeText(x.Owner),
                    DueDate: x.DueDate,
                    Urgency: "Overdue",
                    ModuleDetail: $"{x.Department} • {x.Type}",
                    RecommendedAction: "Open the work order, review progress, update owner/status/due date, or close if completed.",
                    ActionUrl: $"/work-orders/details/{x.Id}"
                ))
            );

            items.AddRange(
                OverdueCorrectiveActions.Select(x => new ReminderItem(
                    Category: "Corrective Actions",
                    Reference: $"CA-{x.Id}",
                    Title: x.Title,
                    Owner: SafeText(x.Owner),
                    DueDate: x.DueDate,
                    Urgency: "Overdue",
                    ModuleDetail: $"{x.Source} • {x.Priority}",
                    RecommendedAction: "Open the corrective action, review progress, update owner/status/due date, or close if completed.",
                    ActionUrl: $"/corrective-actions/edit/{x.Id}"
                ))
            );

            items.AddRange(
                DocumentReviewReminders.Select(x => new ReminderItem(
                    Category: "Document Reviews",
                    Reference: x.DocumentNumber,
                    Title: x.Title,
                    Owner: SafeText(x.Owner),
                    DueDate: x.NextReviewDate,
                    Urgency: x.IsReviewOverdue ? "Overdue" : "Due Soon",
                    ModuleDetail: $"{x.Department} • {x.Status}",
                    RecommendedAction: "Open Documents, review the controlled document, update version/status, or create follow-up work.",
                    ActionUrl: "/documents"
                ))
            );

            items.AddRange(
                TrainingReminders.Select(x => new ReminderItem(
                    Category: "Training",
                    Reference: x.StaffName,
                    Title: x.TrainingName,
                    Owner: SafeText(x.StaffName),
                    DueDate: x.ExpiryDate,
                    Urgency: x.IsExpired ? "Expired" : "Expiring Soon",
                    ModuleDetail: $"{x.Department} • {x.Status}",
                    RecommendedAction: "Open Training, confirm refresher requirements, book renewal, or create follow-up work.",
                    ActionUrl: "/training"
                ))
            );

            items.AddRange(
                IntakeReminders.Select(x => new ReminderItem(
                    Category: "Document Intake",
                    Reference: $"DI-{x.Id}",
                    Title: x.DocumentName,
                    Owner: SafeText(x.AssignedTo),
                    DueDate: x.DueDate,
                    Urgency: x.IsOverdue ? "Overdue" : x.NeedsReview ? "Needs Review" : "Due Soon",
                    ModuleDetail: $"{x.TargetSystem} • {x.Status}",
                    RecommendedAction: "Open the intake record, confirm owner/status, process the document, or complete/reject it.",
                    ActionUrl: $"/document-intake/edit/{x.Id}"
                ))
            );

            return items
                .OrderByDescending(x => GetUrgencySort(x.Urgency))
                .ThenBy(x => x.DueDate)
                .ThenBy(x => x.Category)
                .ThenBy(x => x.Reference)
                .ToList();
        }
    }

    private List<ReminderItem> FilteredReminderItems
    {
        get
        {
            var query = AllReminderItems.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.Category, searchText) ||
                    Contains(x.Reference, searchText) ||
                    Contains(x.Title, searchText) ||
                    Contains(x.Owner, searchText) ||
                    Contains(x.Urgency, searchText) ||
                    Contains(x.ModuleDetail, searchText) ||
                    Contains(x.RecommendedAction, searchText));
            }

            if (!string.IsNullOrWhiteSpace(categoryFilter))
            {
                query = query.Where(x =>
                    string.Equals(x.Category, categoryFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(urgencyFilter))
            {
                query = query.Where(x =>
                    string.Equals(x.Urgency, urgencyFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        workOrders = await Db.WorkOrders
            .AsNoTracking()
            .ToListAsync();

        correctiveActions = await Db.CorrectiveActions
            .AsNoTracking()
            .ToListAsync();

        documents = await Db.DocumentRecords
            .AsNoTracking()
            .ToListAsync();

        trainingRecords = await Db.TrainingRecords
            .AsNoTracking()
            .ToListAsync();

        documentIntakeItems = await Db.DocumentIntakeItems
            .AsNoTracking()
            .ToListAsync();
    }

    private static string GetIntakeStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "rejected" => "badge badge-danger",
            "entered" => "badge badge-info",
            "data checked" => "badge badge-info",
            "needs review" => "badge badge-warning",
            "saved" => "badge badge-muted",
            "received" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetUrgencyClass(string? urgency)
    {
        return urgency?.ToLowerInvariant() switch
        {
            "overdue" => "badge badge-danger",
            "expired" => "badge badge-danger",
            "needs review" => "badge badge-warning",
            "due soon" => "badge badge-warning",
            "expiring soon" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static int GetUrgencySort(string? urgency)
    {
        return urgency?.ToLowerInvariant() switch
        {
            "overdue" => 5,
            "expired" => 5,
            "needs review" => 4,
            "due soon" => 3,
            "expiring soon" => 3,
            _ => 0
        };
    }

    private static string GetDueTimingText(DateTime dueDate)
    {
        var days = (dueDate.Date - DateTime.Today).Days;

        if (days < 0)
        {
            return $"{Math.Abs(days)} day(s) overdue";
        }

        if (days == 0)
        {
            return "Due today";
        }

        if (days == 1)
        {
            return "Due tomorrow";
        }

        return $"Due in {days} day(s)";
    }

    private static bool Contains(string? source, string search)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return false;
        }

        return source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string SafeText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Unassigned" : value;
    }

    private sealed record ReminderItem(
        string Category,
        string Reference,
        string Title,
        string Owner,
        DateTime DueDate,
        string Urgency,
        string ModuleDetail,
        string RecommendedAction,
        string ActionUrl);
}