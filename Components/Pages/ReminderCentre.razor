@page "/reminders"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake
@inject OperationsFlowDbContext Db

<PageTitle>Reminder Centre - OperationsFlow</PageTitle>

<PageHero Eyebrow="Daily Focus"
          Title="Reminder Centre"
          Subtitle="A focused view of overdue work, due-soon items, compliance reminders, training expiries, and document intake records needing attention."
          BadgeText="@($"{TotalReminderCount} reminders")"
          BadgeClass="@ReminderBadgeClass">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/workload">Workload</a>
        <a class="of-btn of-btn-secondary" href="/reports">Reports</a>
        <a class="of-btn of-btn-secondary" href="/data-quality">Data Quality</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="⏰">
    <p>
        Use this page to open the exact records that need follow-up. Reminders connect overdue work orders,
        corrective actions, document reviews, training expiries, and document intake items into one daily review view.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Total Reminders"
                Value="@TotalReminderCount.ToString()"
                Detail="All current reminder items"
                Icon="📋"
                Tone="@ReminderTone" />

    <MetricCard Title="Overdue Work"
                Value="@OverdueWorkCount.ToString()"
                Detail="Work orders and corrective actions"
                Icon="🚨"
                Tone="danger" />

    <MetricCard Title="Document Reviews"
                Value="@DocumentReminderCount.ToString()"
                Detail="Overdue or due soon"
                Icon="📄"
                Tone="warning" />

    <MetricCard Title="Training Issues"
                Value="@TrainingReminderCount.ToString()"
                Detail="Expired or expiring soon"
                Icon="🎓"
                Tone="warning" />

    <MetricCard Title="Intake Follow-ups"
                Value="@IntakeReminderCount.ToString()"
                Detail="Overdue, due soon, or review needed"
                Icon="📥"
                Tone="info" />
</MetricGrid>

<InfoPanel Title="Recommended Review Order" Subtitle="Use this order when checking daily follow-up work.">
    <ChildContent>
        <ol class="of-review-steps">
            <li>Open overdue work orders and corrective actions first.</li>
            <li>Check document reviews that are overdue or due soon.</li>
            <li>Review expired or expiring training records.</li>
            <li>Process document intake records waiting for review or completion.</li>
            <li>After updates, check Workload, Data Quality, Reports, and Activity Log.</li>
        </ol>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Reminder Coverage" Subtitle="What this page connects together.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Operations</strong>
                <span>Work orders and corrective actions link directly to their review/edit pages.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Compliance</strong>
                <span>Documents and training records point back to their compliance modules.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Admin</strong>
                <span>Incoming document reminders open the exact intake record.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Management</strong>
                <span>Reminder actions support workload, reports, data quality, and traceability.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<FilterBar Title="Filter Reminders">
    <ChildContent>
        <input class="of-input"
               placeholder="Search reminders..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="of-select" @bind="categoryFilter">
            <option value="">All Categories</option>
            @foreach (var category in CategoryOptions)
            {
                <option value="@category">@category</option>
            }
        </select>

        <select class="of-select" @bind="urgencyFilter">
            <option value="">All Urgency</option>
            <option value="Overdue">Overdue</option>
            <option value="Expired">Expired</option>
            <option value="Needs Review">Needs Review</option>
            <option value="Due Soon">Due Soon</option>
            <option value="Expiring Soon">Expiring Soon</option>
        </select>
    </ChildContent>

    <Actions>
        <a class="of-btn of-btn-secondary" href="/activity-log">Activity Log</a>
        <a class="of-btn of-btn-secondary" href="/corrective-actions">Actions</a>
    </Actions>
</FilterBar>

<TableCard Title="Reminder Action List"
           Subtitle="@($"Showing {FilteredReminderItems.Count} of {AllReminderItems.Count} reminder item(s). {FilteredReminderItems.Count(x => !string.IsNullOrWhiteSpace(x.ActionUrl))} have direct open links.")"
           IsEmpty="@(!FilteredReminderItems.Any())"
           EmptyTitle="No reminders found"
           EmptyMessage="No reminders match the current search or filter selection.">
    <table>
        <thead>
            <tr>
                <th>Urgency</th>
                <th>Category</th>
                <th>Reference</th>
                <th>Reminder</th>
                <th>Owner</th>
                <th>Due / Review</th>
                <th>Recommended Action</th>
                <th>Open</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in FilteredReminderItems)
            {
                <tr>
                    <td>
                        <span class="@GetUrgencyClass(item.Urgency)">
                            @item.Urgency
                        </span>
                    </td>
                    <td>@item.Category</td>
                    <td><strong>@item.Reference</strong></td>
                    <td>
                        <strong>@item.Title</strong>
                        <div class="of-muted-text">@item.ModuleDetail</div>
                    </td>
                    <td>@item.Owner</td>
                    <td>
                        @item.DueDate.ToString("dd MMM yyyy")
                        <div class="of-muted-text">@GetDueTimingText(item.DueDate)</div>
                    </td>
                    <td>@item.RecommendedAction</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.ActionUrl))
                        {
                            <a class="of-card-link" href="@item.ActionUrl">Open</a>
                        }
                        else
                        {
                            <span class="of-muted-text">Review</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</TableCard>

<InfoPanel Title="Overdue Work Orders" Subtitle="Operational work requests past their due date.">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/work-orders">View Work Orders</a>
    </Actions>
    <ChildContent>
        @if (!OverdueWorkOrders.Any())
        {
            <EmptyState Title="No overdue work orders"
                        Message="Open work orders currently have no overdue reminder flags."
                        Icon="✅" />
        }
        else
        {
            <div class="of-review-proof-grid">
                @foreach (var item in OverdueWorkOrders.Take(6))
                {
                    <div class="of-review-proof-card">
                        <strong>@item.WorkOrderNumber — @item.Title</strong>
                        <span>@DisplayText(item.Owner) • @item.Department • Due @item.DueDate.ToString("dd MMM yyyy")</span>

                        <div class="of-link-row">
                            <span class="of-badge of-badge-danger">Overdue</span>
                            <a class="of-card-link" href="@($"/work-orders/details/{item.Id}")">Open</a>
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Overdue Corrective Actions" Subtitle="Corrective or improvement actions past their due date.">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/corrective-actions">View Actions</a>
    </Actions>
    <ChildContent>
        @if (!OverdueCorrectiveActions.Any())
        {
            <EmptyState Title="No overdue corrective actions"
                        Message="Open corrective actions currently have no overdue reminder flags."
                        Icon="✅" />
        }
        else
        {
            <div class="of-review-proof-grid">
                @foreach (var item in OverdueCorrectiveActions.Take(6))
                {
                    <div class="of-review-proof-card">
                        <strong>CA-@item.Id — @item.Title</strong>
                        <span>@DisplayText(item.Owner) • @item.Source • Due @item.DueDate.ToString("dd MMM yyyy")</span>

                        <div class="of-link-row">
                            <span class="of-badge of-badge-danger">Overdue</span>
                            <a class="of-card-link" href="@($"/corrective-actions/edit/{item.Id}?returnUrl={Uri.EscapeDataString("/reminders")}")">Open</a>
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Compliance Reminders" Subtitle="Document reviews and training records requiring follow-up.">
    <ChildContent>
        <div class="of-two-column-grid">
            <div>
                <h3 class="of-section-mini-title">Document Reviews</h3>

                @if (!DocumentReviewReminders.Any())
                {
                    <EmptyState Title="No document review reminders"
                                Message="Controlled documents currently have no overdue or due-soon review flags."
                                Icon="✅" />
                }
                else
                {
                    <div class="of-mini-list">
                        @foreach (var item in DocumentReviewReminders.Take(6))
                        {
                            <div class="of-mini-list-item">
                                <div>
                                    <strong>@item.DocumentNumber — @item.Title</strong>
                                    <span>@DisplayText(item.Owner) • @item.Department • Review @item.NextReviewDate.ToString("dd MMM yyyy")</span>
                                </div>

                                <div class="of-link-row">
                                    @if (item.IsReviewOverdue)
                                    {
                                        <span class="of-badge of-badge-danger">Overdue</span>
                                    }
                                    else
                                    {
                                        <span class="of-badge of-badge-warning">Due Soon</span>
                                    }

                                    <a class="of-card-link" href="/documents">Open</a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div>
                <h3 class="of-section-mini-title">Training Compliance</h3>

                @if (!TrainingReminders.Any())
                {
                    <EmptyState Title="No training reminders"
                                Message="Training records currently have no expired or expiring-soon reminder flags."
                                Icon="✅" />
                }
                else
                {
                    <div class="of-mini-list">
                        @foreach (var item in TrainingReminders.Take(6))
                        {
                            <div class="of-mini-list-item">
                                <div>
                                    <strong>@item.StaffName — @item.TrainingName</strong>
                                    <span>@item.Department • Expires @item.ExpiryDate.ToString("dd MMM yyyy")</span>
                                </div>

                                <div class="of-link-row">
                                    @if (item.IsExpired)
                                    {
                                        <span class="of-badge of-badge-danger">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="of-badge of-badge-warning">Expiring Soon</span>
                                    }

                                    <a class="of-card-link" href="/training">Open</a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Document Intake Follow-ups" Subtitle="Incoming documents that are overdue, due soon, or waiting for manual review.">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/document-intake">View Intake</a>
    </Actions>
    <ChildContent>
        @if (!IntakeReminders.Any())
        {
            <EmptyState Title="No document intake reminders"
                        Message="Incoming document records currently have no reminder flags."
                        Icon="✅" />
        }
        else
        {
            <table class="of-activity-table">
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Assigned To</th>
                        <th>Target System</th>
                        <th>Status</th>
                        <th>Due Date</th>
                        <th>Flag</th>
                        <th>Open</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in IntakeReminders)
                    {
                        <tr>
                            <td><strong>@item.DocumentName</strong></td>
                            <td>@DisplayText(item.AssignedTo)</td>
                            <td>@DisplayText(item.TargetSystem)</td>
                            <td>
                                <span class="@GetIntakeStatusClass(item.Status)">
                                    @DisplayText(item.Status)
                                </span>
                            </td>
                            <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.IsOverdue)
                                {
                                    <span class="of-badge of-badge-danger">Overdue</span>
                                }
                                else if (item.NeedsReview)
                                {
                                    <span class="of-badge of-badge-warning">Needs Review</span>
                                }
                                else
                                {
                                    <span class="of-badge of-badge-info">Due Soon</span>
                                }
                            </td>
                            <td>
                                <a class="of-card-link" href="@($"/document-intake/edit/{item.Id}?returnUrl={Uri.EscapeDataString("/reminders")}")">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Review Notes" Icon="💡" Tone="info">
    <ul>
        <li>Overdue operational work should be reviewed before due-soon compliance reminders.</li>
        <li>Every reminder should either open the exact record or the source module where the follow-up can be created.</li>
        <li>After updating records, confirm Workload, Reports, Data Quality, and Activity Log reflect the changes.</li>
        <li>This page is local SQLite demo logic; production reminders could later trigger Teams/Outlook/Power Automate notifications.</li>
    </ul>
</GuidanceNote>

@code {
    private List<WorkOrder> workOrders = new();
    private List<CorrectiveAction> correctiveActions = new();
    private List<DocumentRecord> documents = new();
    private List<TrainingRecord> trainingRecords = new();
    private List<DocumentIntakeModel> documentIntakeItems = new();

    private string searchText = "";
    private string categoryFilter = "";
    private string urgencyFilter = "";

    private List<WorkOrder> OverdueWorkOrders =>
        workOrders
            .Where(x => x.IsOverdue)
            .OrderBy(x => x.DueDate)
            .ThenBy(x => x.Owner)
            .ToList();

    private List<CorrectiveAction> OverdueCorrectiveActions =>
        correctiveActions
            .Where(x => x.IsOverdue)
            .OrderBy(x => x.DueDate)
            .ThenBy(x => x.Owner)
            .ToList();

    private List<DocumentRecord> DocumentReviewReminders =>
        documents
            .Where(x => x.IsReviewOverdue || x.IsDueSoon)
            .OrderByDescending(x => x.IsReviewOverdue)
            .ThenBy(x => x.NextReviewDate)
            .ToList();

    private List<TrainingRecord> TrainingReminders =>
        trainingRecords
            .Where(x => x.IsExpired || x.IsExpiringSoon)
            .OrderByDescending(x => x.IsExpired)
            .ThenBy(x => x.ExpiryDate)
            .ThenBy(x => x.StaffName)
            .ToList();

    private List<DocumentIntakeModel> IntakeReminders =>
        documentIntakeItems
            .Where(x => x.IsOverdue || x.NeedsReview || x.IsDueSoon)
            .OrderByDescending(x => x.IsOverdue)
            .ThenByDescending(x => x.NeedsReview)
            .ThenBy(x => x.DueDate)
            .ThenBy(x => x.DocumentName)
            .ToList();

    private int OverdueWorkCount => OverdueWorkOrders.Count + OverdueCorrectiveActions.Count;
    private int DocumentReminderCount => DocumentReviewReminders.Count;
    private int TrainingReminderCount => TrainingReminders.Count;
    private int IntakeReminderCount => IntakeReminders.Count;
    private int TotalReminderCount => AllReminderItems.Count;

    private string ReminderTone =>
        TotalReminderCount == 0 ? "success" :
        OverdueWorkCount > 0 ? "danger" :
        "warning";

    private string ReminderBadgeClass =>
        TotalReminderCount == 0 ? "of-badge-success" :
        OverdueWorkCount > 0 ? "of-badge-danger" :
        "of-badge-warning";

    private List<string> CategoryOptions =>
        AllReminderItems
            .Select(x => x.Category)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    private List<ReminderItem> AllReminderItems
    {
        get
        {
            var items = new List<ReminderItem>();

            items.AddRange(
                OverdueWorkOrders.Select(x => new ReminderItem(
                    Category: "Work Orders",
                    Reference: x.WorkOrderNumber,
                    Title: x.Title,
                    Owner: DisplayText(x.Owner),
                    DueDate: x.DueDate,
                    Urgency: "Overdue",
                    ModuleDetail: $"{x.Department} • {x.Type}",
                    RecommendedAction: "Open the work order, review progress, update owner/status/due date, or close if completed.",
                    ActionUrl: $"/work-orders/details/{x.Id}"
                )));

            items.AddRange(
                OverdueCorrectiveActions.Select(x => new ReminderItem(
                    Category: "Corrective Actions",
                    Reference: $"CA-{x.Id}",
                    Title: x.Title,
                    Owner: DisplayText(x.Owner),
                    DueDate: x.DueDate,
                    Urgency: "Overdue",
                    ModuleDetail: $"{x.Source} • {x.Priority}",
                    RecommendedAction: "Open the corrective action, review progress, update owner/status/due date, or close if completed.",
                    ActionUrl: $"/corrective-actions/edit/{x.Id}?returnUrl={Uri.EscapeDataString("/reminders")}"
                )));

            items.AddRange(
                DocumentReviewReminders.Select(x => new ReminderItem(
                    Category: "Document Reviews",
                    Reference: x.DocumentNumber,
                    Title: x.Title,
                    Owner: DisplayText(x.Owner),
                    DueDate: x.NextReviewDate,
                    Urgency: x.IsReviewOverdue ? "Overdue" : "Due Soon",
                    ModuleDetail: $"{x.Department} • {x.Status}",
                    RecommendedAction: "Open Documents, review the controlled document, update version/status, or create follow-up work.",
                    ActionUrl: "/documents"
                )));

            items.AddRange(
                TrainingReminders.Select(x => new ReminderItem(
                    Category: "Training",
                    Reference: x.StaffName,
                    Title: x.TrainingName,
                    Owner: DisplayText(x.StaffName),
                    DueDate: x.ExpiryDate,
                    Urgency: x.IsExpired ? "Expired" : "Expiring Soon",
                    ModuleDetail: $"{x.Department} • {x.Status}",
                    RecommendedAction: "Open Training, confirm refresher requirements, book renewal, or create follow-up work.",
                    ActionUrl: "/training"
                )));

            items.AddRange(
                IntakeReminders.Select(x => new ReminderItem(
                    Category: "Document Intake",
                    Reference: $"DI-{x.Id}",
                    Title: x.DocumentName,
                    Owner: DisplayText(x.AssignedTo),
                    DueDate: x.DueDate,
                    Urgency: x.IsOverdue ? "Overdue" : x.NeedsReview ? "Needs Review" : "Due Soon",
                    ModuleDetail: $"{x.TargetSystem} • {x.Status}",
                    RecommendedAction: "Open the intake record, confirm owner/status, process the document, or complete/reject it.",
                    ActionUrl: $"/document-intake/edit/{x.Id}?returnUrl={Uri.EscapeDataString("/reminders")}"
                )));

            return items
                .OrderByDescending(x => GetUrgencySort(x.Urgency))
                .ThenBy(x => x.DueDate)
                .ThenBy(x => x.Category)
                .ThenBy(x => x.Reference)
                .ToList();
        }
    }

    private List<ReminderItem> FilteredReminderItems
    {
        get
        {
            var query = AllReminderItems.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.Category, searchText) ||
                    Contains(x.Reference, searchText) ||
                    Contains(x.Title, searchText) ||
                    Contains(x.Owner, searchText) ||
                    Contains(x.Urgency, searchText) ||
                    Contains(x.ModuleDetail, searchText) ||
                    Contains(x.RecommendedAction, searchText));
            }

            if (!string.IsNullOrWhiteSpace(categoryFilter))
            {
                query = query.Where(x => string.Equals(x.Category, categoryFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(urgencyFilter))
            {
                query = query.Where(x => string.Equals(x.Urgency, urgencyFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        workOrders = await Db.WorkOrders.AsNoTracking().ToListAsync();
        correctiveActions = await Db.CorrectiveActions.AsNoTracking().ToListAsync();
        documents = await Db.DocumentRecords.AsNoTracking().ToListAsync();
        trainingRecords = await Db.TrainingRecords.AsNoTracking().ToListAsync();
        documentIntakeItems = await Db.DocumentIntakeItems.AsNoTracking().ToListAsync();
    }

    private static string GetIntakeStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "rejected" => "badge badge-danger",
            "entered" => "badge badge-info",
            "data checked" => "badge badge-info",
            "needs review" => "badge badge-warning",
            "saved" => "badge badge-muted",
            "received" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetUrgencyClass(string? urgency)
    {
        return urgency?.ToLowerInvariant() switch
        {
            "overdue" => "badge badge-danger",
            "expired" => "badge badge-danger",
            "needs review" => "badge badge-warning",
            "due soon" => "badge badge-warning",
            "expiring soon" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static int GetUrgencySort(string? urgency)
    {
        return urgency?.ToLowerInvariant() switch
        {
            "overdue" => 5,
            "expired" => 5,
            "needs review" => 4,
            "due soon" => 3,
            "expiring soon" => 3,
            _ => 0
        };
    }

    private static string GetDueTimingText(DateTime dueDate)
    {
        var days = (dueDate.Date - DateTime.Today).Days;

        if (days < 0)
        {
            return $"{Math.Abs(days)} day(s) overdue";
        }

        if (days == 0)
        {
            return "Due today";
        }

        if (days == 1)
        {
            return "Due tomorrow";
        }

        return $"Due in {days} day(s)";
    }

    private static bool Contains(string? source, string search)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Unassigned" : value;
    }

    private sealed record ReminderItem(
        string Category,
        string Reference,
        string Title,
        string Owner,
        DateTime DueDate,
        string Urgency,
        string ModuleDetail,
        string RecommendedAction,
        string ActionUrl);
}