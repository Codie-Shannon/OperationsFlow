@page "/corrective-actions/edit/{Id:int}"

@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@using CorrectiveActionModel = OperationsFlow.Models.CorrectiveAction

@inject OperationsFlowDbContext Db
@inject ActivityLogService ActivityLogService
@inject NavigationManager Navigation

<PageTitle>Edit Corrective Action - OperationsFlow</PageTitle>

<div class="page-shell">

    <section class="page-hero">
        <div>
            <div class="eyebrow">Operations</div>
            <h1>Edit Corrective Action</h1>
            <p>
                Update assigned owner, priority, status, due date, completion state, and follow-up notes
                for a corrective or improvement action.
            </p>
        </div>

        <div class="hero-stat-card">
            <span>Editing</span>
            <strong>@DisplayReference</strong>
        </div>
    </section>

    @if (isLoading)
    {
        <div class="panel-card">
            <p>Loading corrective action...</p>
        </div>
    }
    else if (correctiveAction == null)
    {
        <div class="panel-card">
            <h2>Corrective action could not be found.</h2>
            <button type="button" class="btn btn-secondary" @onclick="BackToReturnPage">
                Back
            </button>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }

        <section class="form-card">
            <div class="form-grid two-column">

                <div class="form-group">
                    <label>Title</label>
                    <input class="form-control" @bind="correctiveAction.Title" />
                </div>

                <div class="form-group">
                    <label>Source</label>
                    <select class="form-select" @bind="correctiveAction.Source">
                        @foreach (var source in SourceOptions)
                        {
                            <option value="@source">@source</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Site</label>
                    <input class="form-control" @bind="correctiveAction.Site" />
                </div>

                <div class="form-group">
                    <label>Department</label>
                    <input class="form-control" @bind="correctiveAction.Department" />
                </div>

                <div class="form-group">
                    <label>Owner</label>
                    <input class="form-control" @bind="correctiveAction.Owner" />
                </div>

                <div class="form-group">
                    <label>Action Type</label>
                    <select class="form-select" @bind="correctiveAction.ActionType">
                        @foreach (var actionType in ActionTypeOptions)
                        {
                            <option value="@actionType">@actionType</option>
                        }
                    </select>
                </div>

                <div class="guidance-box">
                    <div class="guidance-icon">i</div>
                    <div>
                        <strong>Owner guidance</strong>
                        <p>
                            Assign one clear owner so follow-up responsibility appears correctly in workload,
                            reminders, reports, and data quality checks.
                        </p>
                    </div>
                </div>

                <div></div>

                <div class="form-group">
                    <label>Priority</label>
                    <select class="form-select" @bind="correctiveAction.Priority">
                        @foreach (var priority in PriorityOptions)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Status</label>
                    <select class="form-select" @bind="correctiveAction.Status">
                        @foreach (var status in StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>

            </div>

            <div class="status-flow-panel">
                <h3>Corrective action status flow</h3>
                <p>Use statuses consistently so overdue, completed, and active follow-up work stays clear.</p>

                <div class="status-flow-grid">
                    @foreach (var step in CorrectiveActionStatusSteps)
                    {
                        <div class="status-flow-card">
                            <span class="@step.BadgeClass">@step.Label</span>
                            <p>@step.Description</p>
                        </div>
                    }
                </div>
            </div>

            <div class="form-grid two-column">

                <div class="form-group">
                    <label>Due Date</label>
                    <InputDate class="form-control" @bind-Value="correctiveAction.DueDate" />
                </div>

                <div class="form-group">
                    <label>Completed Date</label>
                    <InputDate class="form-control" @bind-Value="correctiveAction.CompletedDate" />
                </div>

                <div class="guidance-box">
                    <div class="guidance-icon">i</div>
                    <div>
                        <strong>Due date guidance</strong>
                        <p>
                            Use the next realistic follow-up date. Overdue actions appear in the Safety Meeting Pack,
                            Compliance Calendar, Workload, Reports, and Data Quality.
                        </p>
                    </div>
                </div>

                <div></div>

                <div class="form-group form-span">
                    <label>Notes</label>
                    <textarea class="form-control notes-textarea" @bind="correctiveAction.Notes"></textarea>
                </div>

                <div class="guidance-box form-span">
                    <div>
                        <strong>Corrective action note guidance</strong>
                        <p>
                            Good corrective action notes should explain the current follow-up state, not just repeat the title.
                        </p>

                        <ul>
                            @foreach (var item in CorrectiveActionNoteGuideItems)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </div>
                </div>

            </div>

            <section class="activity-history-panel">
                <div class="section-heading-row">
                    <div>
                        <h2>Activity History</h2>
                        <p>
                            Record-level traceability for this corrective action. This helps reviewers see what changed,
                            when it changed, and why the item is moving.
                        </p>
                    </div>

                    <div class="activity-count-card">
                        <span>Events</span>
                        <strong>@activityHistory.Count</strong>
                    </div>
                </div>

                @if (activityHistory.Count == 0)
                {
                    <div class="empty-state">
                        <strong>No activity history yet.</strong>
                        <p>
                            Save this corrective action to create a reviewed or updated activity event.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="data-table activity-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Action</th>
                                    <th>Description</th>
                                    <th>Created By</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in activityHistory)
                                {
                                    <tr>
                                        <td>@activity.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                        <td>
                                            <span class="@GetActivityBadgeClass(activity.ActionType)">
                                                @activity.ActionType
                                            </span>
                                        </td>
                                        <td>@activity.Description</td>
                                        <td>@activity.CreatedBy</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" @onclick="BackToReturnPage">
                    Cancel
                </button>

                <button type="button" class="btn btn-primary" @onclick="SaveCorrectiveAction">
                    Save Changes
                </button>
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private CorrectiveActionModel? correctiveAction;
    private List<ActivityLog> activityHistory = new();

    private bool isLoading = true;
    private string errorMessage = "";

    private string originalTitle = "";
    private string originalOwner = "";
    private string originalStatus = "";
    private string originalPriority = "";
    private DateTime originalDueDate;
    private DateTime? originalCompletedDate;

    private string DisplayReference => correctiveAction == null ? "CA" : $"CA-{correctiveAction.Id}";

    private List<string> SourceOptions = new()
    {
        "Incident",
        "Inspection",
        "Internal Audit",
        "Risk Register",
        "Risk Review",
        "Document Control",
        "Document Review",
        "Training Compliance",
        "Hazard Report",
        "Quality Review",
        "Management Review",
        "Manual / Internal"
    };

    private List<string> ActionTypeOptions = new()
    {
        "Investigation",
        "Repair",
        "Process Review",
        "Document Update",
        "Training",
        "Follow-up",
        "Improvement",
        "Containment",
        "Checklist",
        "System Update"
    };

    private List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private List<string> StatusOptions = new()
    {
        "Open",
        "In Progress",
        "Completed",
        "Closed"
    };

    private static readonly IReadOnlyList<StatusFlowStep> CorrectiveActionStatusSteps = new[]
    {
        new StatusFlowStep("Open", "Action has been raised but work has not started yet.", "badge badge-warning"),
        new StatusFlowStep("In Progress", "Owner is actively working through the follow-up.", "badge badge-info"),
        new StatusFlowStep("Completed", "Work is finished and should have a completed date.", "badge badge-success"),
        new StatusFlowStep("Closed", "Final review is complete and no further follow-up is needed.", "badge badge-success")
    };

    private static readonly IReadOnlyList<string> CorrectiveActionNoteGuideItems = new[]
    {
        "What was reviewed or changed?",
        "What is the current blocker or risk?",
        "Who owns the next action?",
        "What needs to happen before this can be closed?",
        "If closing, what evidence or outcome confirms completion?"
    };

    protected override async Task OnInitializedAsync()
    {
        correctiveAction = await Db.CorrectiveActions
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (correctiveAction != null)
        {
            originalTitle = correctiveAction.Title;
            originalOwner = correctiveAction.Owner;
            originalStatus = correctiveAction.Status;
            originalPriority = correctiveAction.Priority;
            originalDueDate = correctiveAction.DueDate;
            originalCompletedDate = correctiveAction.CompletedDate;

            await LoadActivityHistory();
        }

        isLoading = false;
    }

    private async Task SaveCorrectiveAction()
    {
        errorMessage = "";

        if (correctiveAction == null)
        {
            errorMessage = "Corrective action could not be saved because it was not loaded.";
            return;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Title))
        {
            errorMessage = "Please enter a title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Owner))
        {
            errorMessage = "Please enter an owner.";
            return;
        }

        if (correctiveAction.DueDate.Date < correctiveAction.CreatedDate.Date)
        {
            errorMessage = "Due date cannot be before created date.";
            return;
        }

        if (IsClosedStatus(correctiveAction.Status) && correctiveAction.CompletedDate == null)
        {
            correctiveAction.CompletedDate = DateTime.Today;
        }

        if (!IsClosedStatus(correctiveAction.Status))
        {
            correctiveAction.CompletedDate = null;
        }

        var changeDescriptions = BuildChangeDescriptions();

        await Db.SaveChangesAsync();

        if (changeDescriptions.Any())
        {
            await ActivityLogService.LogAsync(
                moduleName: "Corrective Actions",
                recordId: correctiveAction.Id,
                recordReference: $"CA-{correctiveAction.Id}",
                actionType: "Updated",
                description: $"Updated corrective action CA-{correctiveAction.Id}: {string.Join("; ", changeDescriptions)}."
            );
        }
        else
        {
            await ActivityLogService.LogAsync(
                moduleName: "Corrective Actions",
                recordId: correctiveAction.Id,
                recordReference: $"CA-{correctiveAction.Id}",
                actionType: "Reviewed",
                description: $"Reviewed corrective action CA-{correctiveAction.Id} with no tracked field changes."
            );
        }

        UpdateOriginalValues();
        await LoadActivityHistory();

        BackToReturnPage();
    }

    private async Task LoadActivityHistory()
    {
        if (correctiveAction == null)
        {
            activityHistory = new List<ActivityLog>();
            return;
        }

        activityHistory = await Db.ActivityLogs
            .Where(x =>
                x.ModuleName == "Corrective Actions" &&
                x.RecordId == correctiveAction.Id)
            .OrderByDescending(x => x.CreatedDate)
            .ToListAsync();
    }

    private List<string> BuildChangeDescriptions()
    {
        var changes = new List<string>();

        if (correctiveAction == null)
        {
            return changes;
        }

        if (!string.Equals(originalTitle, correctiveAction.Title, StringComparison.Ordinal))
        {
            changes.Add($"title changed from '{originalTitle}' to '{correctiveAction.Title}'");
        }

        if (!string.Equals(originalOwner, correctiveAction.Owner, StringComparison.Ordinal))
        {
            changes.Add($"owner changed from '{originalOwner}' to '{correctiveAction.Owner}'");
        }

        if (!string.Equals(originalStatus, correctiveAction.Status, StringComparison.Ordinal))
        {
            changes.Add($"status changed from '{originalStatus}' to '{correctiveAction.Status}'");
        }

        if (!string.Equals(originalPriority, correctiveAction.Priority, StringComparison.Ordinal))
        {
            changes.Add($"priority changed from '{originalPriority}' to '{correctiveAction.Priority}'");
        }

        if (originalDueDate.Date != correctiveAction.DueDate.Date)
        {
            changes.Add($"due date changed from {originalDueDate:dd MMM yyyy} to {correctiveAction.DueDate:dd MMM yyyy}");
        }

        if (originalCompletedDate?.Date != correctiveAction.CompletedDate?.Date)
        {
            var oldDate = originalCompletedDate.HasValue
                ? originalCompletedDate.Value.ToString("dd MMM yyyy")
                : "not completed";

            var newDate = correctiveAction.CompletedDate.HasValue
                ? correctiveAction.CompletedDate.Value.ToString("dd MMM yyyy")
                : "not completed";

            changes.Add($"completed date changed from {oldDate} to {newDate}");
        }

        return changes;
    }

    private void UpdateOriginalValues()
    {
        if (correctiveAction == null)
        {
            return;
        }

        originalTitle = correctiveAction.Title;
        originalOwner = correctiveAction.Owner;
        originalStatus = correctiveAction.Status;
        originalPriority = correctiveAction.Priority;
        originalDueDate = correctiveAction.DueDate;
        originalCompletedDate = correctiveAction.CompletedDate;
    }

    private void BackToReturnPage()
    {
        var fallbackUrl = "/corrective-actions";

        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        if (!ReturnUrl.StartsWith("/"))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        Navigation.NavigateTo(ReturnUrl);
    }

    private static bool IsClosedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetActivityBadgeClass(string? actionType)
    {
        return actionType?.ToLowerInvariant() switch
        {
            "created" => "badge badge-success",
            "updated" => "badge badge-info",
            "reviewed" => "badge badge-secondary",
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "deleted" => "badge badge-danger",
            _ => "badge badge-secondary"
        };
    }

    private sealed record StatusFlowStep(string Label, string Description, string BadgeClass);
}