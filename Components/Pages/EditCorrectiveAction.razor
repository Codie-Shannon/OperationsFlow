@page "/corrective-actions/edit/{Id:int}"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@inject OperationsFlowDbContext Db
@inject ActivityLogService ActivityLogService
@inject NavigationManager Navigation

<PageTitle>Edit Corrective Action - OperationsFlow</PageTitle>

<PageHero
    Eyebrow="Operations"
    Title="Edit Corrective Action"
    Subtitle="Update owner, source, action type, priority, status, due date, completion date, and notes."
    BadgeText="@DisplayReference"
    BadgeClass="of-badge-warning">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/corrective-actions">Back to Actions</a>
        @if (correctiveAction != null)
        {
            <a class="of-btn of-btn-secondary" href="@($"/corrective-actions/details/{correctiveAction.Id}")">View Details</a>
        }
    </Actions>
</PageHero>

@if (isLoading)
{
    <InfoPanel Title="Loading Corrective Action" Subtitle="Retrieving the selected corrective action record.">
        <p class="of-muted-text">Loading corrective action...</p>
    </InfoPanel>
}
else if (correctiveAction == null)
{
    <EmptyState
        Title="Corrective action could not be found"
        Message="The record may have been removed, or the link may be using an invalid ID."
        Icon="⚠️"
        ActionText="Back to Actions"
        ActionHref="/corrective-actions" />
}
else
{
    <PurposeNote Title="Purpose" Icon="✏️">
        <p>
            Use this page to keep action ownership, source context, progress, completion evidence,
            and follow-up dates current. Changes feed Workload, Reminders, Reports, Data Quality,
            action details, and Activity Log.
        </p>
    </PurposeNote>

    <MetricGrid>
        <MetricCard
            Title="Status"
            Value="@DisplayText(correctiveAction.Status)"
            Detail="Update as the action progresses"
            Icon="🔄"
            Tone="@GetStatusTone(correctiveAction.Status)" />

        <MetricCard
            Title="Priority"
            Value="@DisplayText(correctiveAction.Priority)"
            Detail="@DisplayText(correctiveAction.ActionType)"
            Icon="⚡"
            Tone="@GetPriorityTone(correctiveAction.Priority)" />

        <MetricCard
            Title="Owner"
            Value="@DisplayText(correctiveAction.Owner)"
            Detail="@DisplayText(correctiveAction.Department)"
            Icon="👤" />

        <MetricCard
            Title="Due Date"
            Value="@correctiveAction.DueDate.ToString("dd MMM")"
            Detail="@correctiveAction.DueDate.ToString("yyyy")"
            Icon="📅"
            Tone="info" />
    </MetricGrid>

    <GuidanceNote Title="Before Saving" Icon="💡" Tone="info">
        <ul>
            <li>Confirm the owner is still responsible for the next action.</li>
            <li>Update status if the action has moved forward.</li>
            <li>Use completion date only when the action is completed or closed.</li>
            <li>Add notes explaining progress, blockers, decisions, or closure evidence.</li>
            <li>Completed or closed actions should have enough notes to explain the outcome.</li>
        </ul>
    </GuidanceNote>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <GuidanceNote Title="Save blocked" Icon="⚠️" Tone="danger">
            <p>@errorMessage</p>
        </GuidanceNote>
    }

    <InfoPanel Title="Edit Corrective Action" Subtitle="Update the fields below and save the changes.">
        <ChildContent>
            <EditForm Model="correctiveAction" OnSubmit="SaveCorrectiveAction">
                <div class="of-form-grid">
                    <div class="of-form-field of-form-field--wide">
                        <label for="title">Title</label>
                        <InputText id="title" class="of-input" @bind-Value="correctiveAction.Title" />
                    </div>

                    <div class="of-form-field">
                        <label for="source">Source</label>
                        <InputSelect id="source" class="of-select" @bind-Value="correctiveAction.Source">
                            @foreach (var source in SourceOptions)
                            {
                                <option value="@source">@source</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="site">Site</label>
                        <InputSelect id="site" class="of-select" @bind-Value="correctiveAction.Site">
                            @foreach (var site in SiteOptions)
                            {
                                <option value="@site">@site</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="department">Department</label>
                        <InputSelect id="department" class="of-select" @bind-Value="correctiveAction.Department">
                            @foreach (var department in DepartmentOptions)
                            {
                                <option value="@department">@department</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="owner">Owner</label>
                        <InputText id="owner" class="of-input" @bind-Value="correctiveAction.Owner" />
                    </div>

                    <div class="of-form-field">
                        <label for="actionType">Action Type</label>
                        <InputSelect id="actionType" class="of-select" @bind-Value="correctiveAction.ActionType">
                            @foreach (var actionType in ActionTypeOptions)
                            {
                                <option value="@actionType">@actionType</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="priority">Priority</label>
                        <InputSelect id="priority" class="of-select" @bind-Value="correctiveAction.Priority">
                            @foreach (var priority in PriorityOptions)
                            {
                                <option value="@priority">@priority</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="status">Status</label>
                        <InputSelect id="status" class="of-select" @bind-Value="correctiveAction.Status">
                            @foreach (var status in StatusOptions)
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="of-form-field">
                        <label for="dueDate">Due Date</label>
                        <InputDate id="dueDate" class="of-input" @bind-Value="correctiveAction.DueDate" />
                    </div>

                    <div class="of-form-field">
                        <label for="completedDate">Completed Date</label>
                        <InputDate id="completedDate" class="of-input" @bind-Value="correctiveAction.CompletedDate" />
                    </div>

                    <div class="of-form-field of-form-field--full">
                        <label for="notes">Notes</label>
                        <InputTextArea id="notes" class="of-textarea" @bind-Value="correctiveAction.Notes" />
                    </div>
                </div>

                <div class="of-form-actions">
                    <button type="button" class="of-btn of-btn-secondary" @onclick="BackToReturnPage">Cancel</button>
                    <button type="button" class="of-btn of-btn-secondary" @onclick="GoToDetails">View Details</button>
                    <button type="submit" class="of-btn of-btn-primary">Save Changes</button>
                </div>
            </EditForm>
        </ChildContent>
    </InfoPanel>

    <ActivityHistoryPanel Title="Activity History"
                          Subtitle="Record-level traceability for this corrective action."
                          IsEmpty="@(!HasActivityHistory)"
                          EmptyTitle="No activity history yet"
                          EmptyMessage="Save this corrective action to create a reviewed or updated activity event.">
        <ChildContent>
            @if (HasActivityHistory)
            {
                <table class="of-activity-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>Description</th>
                            <th>Created By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var activity in activityHistory)
                        {
                            <tr>
                                <td>@activity.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>
                                    <span class="@GetActivityBadgeClass(activity.ActionType)">
                                        @activity.ActionType
                                    </span>
                                </td>
                                <td>@activity.Description</td>
                                <td>@activity.CreatedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </ActivityHistoryPanel>
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private CorrectiveAction? correctiveAction;
    private List<ActivityLog> activityHistory = new();
    private bool isLoading = true;
    private string errorMessage = "";

    private string originalTitle = "";
    private string originalSource = "";
    private string originalSite = "";
    private string originalDepartment = "";
    private string originalOwner = "";
    private string originalActionType = "";
    private string originalPriority = "";
    private string originalStatus = "";
    private DateTime originalDueDate;
    private DateTime? originalCompletedDate;
    private string originalNotes = "";

    private bool HasActivityHistory => activityHistory.Any();

    private string DisplayReference => correctiveAction == null ? "Action" : correctiveAction.Title;

    private readonly List<string> SourceOptions = new()
    {
        "Manual Entry",
        "Incident",
        "Audit",
        "Inspection",
        "Risk Register",
        "Training",
        "Document Control",
        "Work Order",
        "Management Review",
        "Improvement"
    };

    private readonly List<string> SiteOptions = new()
    {
        "Main Workshop",
        "Yard",
        "Admin Office",
        "Warehouse",
        "Dispatch Bay",
        "All Sites"
    };

    private readonly List<string> DepartmentOptions = new()
    {
        "Operations",
        "Health & Safety",
        "Admin",
        "Maintenance",
        "Warehouse",
        "Dispatch",
        "Quality",
        "Management"
    };

    private readonly List<string> ActionTypeOptions = new()
    {
        "Corrective Action",
        "Preventive Action",
        "Improvement",
        "Review",
        "Process Review",
        "Checklist",
        "Training",
        "Document Update",
        "Maintenance",
        "Repair",
        "Investigation",
        "System Update",
        "Evidence Required"
    };

    private readonly List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private readonly List<string> StatusOptions = new()
    {
        "Open",
        "In Progress",
        "Completed",
        "Closed"
    };

    protected override async Task OnInitializedAsync()
    {
        correctiveAction = await Db.CorrectiveActions
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (correctiveAction != null)
        {
            CaptureOriginalValues();
            await LoadActivityHistory();
        }

        isLoading = false;
    }

    private async Task SaveCorrectiveAction()
    {
        errorMessage = "";

        if (correctiveAction == null)
        {
            errorMessage = "Corrective action could not be saved because it was not loaded.";
            return;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Title))
        {
            errorMessage = "Please enter a title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Owner))
        {
            errorMessage = "Please enter an owner.";
            return;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Source))
        {
            errorMessage = "Please select or enter a source.";
            return;
        }

        if (IsCompletedStatus(correctiveAction.Status) && !correctiveAction.CompletedDate.HasValue)
        {
            correctiveAction.CompletedDate = DateTime.Today;
        }

        if (!IsCompletedStatus(correctiveAction.Status))
        {
            correctiveAction.CompletedDate = null;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Notes))
        {
            correctiveAction.Notes = BuildDefaultNotes();
        }

        var changeDescriptions = BuildChangeDescriptions();

        await Db.SaveChangesAsync();

        if (changeDescriptions.Any())
        {
            await ActivityLogService.LogAsync(
                moduleName: "Corrective Actions",
                recordId: correctiveAction.Id,
                recordReference: correctiveAction.Title,
                actionType: GetSaveActionType(changeDescriptions),
                description: $"Updated corrective action '{correctiveAction.Title}': {string.Join("; ", changeDescriptions)}.");
        }
        else
        {
            await ActivityLogService.LogAsync(
                moduleName: "Corrective Actions",
                recordId: correctiveAction.Id,
                recordReference: correctiveAction.Title,
                actionType: "Reviewed",
                description: $"Reviewed corrective action '{correctiveAction.Title}' with no tracked field changes.");
        }

        CaptureOriginalValues();
        await LoadActivityHistory();
        BackToReturnPage();
    }

    private async Task LoadActivityHistory()
    {
        if (correctiveAction == null)
        {
            activityHistory = new List<ActivityLog>();
            return;
        }

        activityHistory = await Db.ActivityLogs
            .AsNoTracking()
            .Where(x => x.ModuleName == "Corrective Actions" && x.RecordId == correctiveAction.Id)
            .OrderByDescending(x => x.CreatedDate)
            .ToListAsync();
    }

    private List<string> BuildChangeDescriptions()
    {
        var changes = new List<string>();

        if (correctiveAction == null)
        {
            return changes;
        }

        if (!string.Equals(originalTitle, correctiveAction.Title, StringComparison.Ordinal))
        {
            changes.Add($"title changed from '{originalTitle}' to '{correctiveAction.Title}'");
        }

        if (!string.Equals(originalSource, correctiveAction.Source, StringComparison.Ordinal))
        {
            changes.Add($"source changed from '{originalSource}' to '{correctiveAction.Source}'");
        }

        if (!string.Equals(originalSite, correctiveAction.Site, StringComparison.Ordinal))
        {
            changes.Add($"site changed from '{originalSite}' to '{correctiveAction.Site}'");
        }

        if (!string.Equals(originalDepartment, correctiveAction.Department, StringComparison.Ordinal))
        {
            changes.Add($"department changed from '{originalDepartment}' to '{correctiveAction.Department}'");
        }

        if (!string.Equals(originalOwner, correctiveAction.Owner, StringComparison.Ordinal))
        {
            changes.Add($"owner changed from '{originalOwner}' to '{correctiveAction.Owner}'");
        }

        if (!string.Equals(originalActionType, correctiveAction.ActionType, StringComparison.Ordinal))
        {
            changes.Add($"action type changed from '{originalActionType}' to '{correctiveAction.ActionType}'");
        }

        if (!string.Equals(originalPriority, correctiveAction.Priority, StringComparison.Ordinal))
        {
            changes.Add($"priority changed from '{originalPriority}' to '{correctiveAction.Priority}'");
        }

        if (!string.Equals(originalStatus, correctiveAction.Status, StringComparison.Ordinal))
        {
            changes.Add($"status changed from '{originalStatus}' to '{correctiveAction.Status}'");
        }

        if (originalDueDate.Date != correctiveAction.DueDate.Date)
        {
            changes.Add($"due date changed from {originalDueDate:dd MMM yyyy} to {correctiveAction.DueDate:dd MMM yyyy}");
        }

        if (originalCompletedDate?.Date != correctiveAction.CompletedDate?.Date)
        {
            var oldValue = originalCompletedDate.HasValue ? originalCompletedDate.Value.ToString("dd MMM yyyy") : "Not completed";
            var newValue = correctiveAction.CompletedDate.HasValue ? correctiveAction.CompletedDate.Value.ToString("dd MMM yyyy") : "Not completed";
            changes.Add($"completed date changed from {oldValue} to {newValue}");
        }

        if (!string.Equals(originalNotes?.Trim(), correctiveAction.Notes?.Trim(), StringComparison.Ordinal))
        {
            changes.Add("notes updated");
        }

        return changes;
    }

    private string BuildDefaultNotes()
    {
        if (correctiveAction == null)
        {
            return "";
        }

        return "Corrective action reviewed."
            + Environment.NewLine + $"Source: {correctiveAction.Source}"
            + Environment.NewLine + $"Site: {correctiveAction.Site}"
            + Environment.NewLine + $"Department: {correctiveAction.Department}"
            + Environment.NewLine + $"Action Type: {correctiveAction.ActionType}"
            + Environment.NewLine + $"Owner: {correctiveAction.Owner}"
            + Environment.NewLine + "Next step: progress, review, complete, or close the action.";
    }

    private void CaptureOriginalValues()
    {
        if (correctiveAction == null)
        {
            return;
        }

        originalTitle = correctiveAction.Title;
        originalSource = correctiveAction.Source;
        originalSite = correctiveAction.Site;
        originalDepartment = correctiveAction.Department;
        originalOwner = correctiveAction.Owner;
        originalActionType = correctiveAction.ActionType;
        originalPriority = correctiveAction.Priority;
        originalStatus = correctiveAction.Status;
        originalDueDate = correctiveAction.DueDate;
        originalCompletedDate = correctiveAction.CompletedDate;
        originalNotes = correctiveAction.Notes ?? "";
    }

    private static string GetSaveActionType(List<string> changes)
    {
        var statusChange = changes.FirstOrDefault(x =>
            x.StartsWith("status changed", StringComparison.OrdinalIgnoreCase));

        if (statusChange != null &&
            (statusChange.Contains("Completed", StringComparison.OrdinalIgnoreCase) ||
             statusChange.Contains("Closed", StringComparison.OrdinalIgnoreCase)))
        {
            return "Completed";
        }

        return "Updated";
    }

    private void GoToDetails()
    {
        if (correctiveAction == null)
        {
            BackToReturnPage();
            return;
        }

        Navigation.NavigateTo($"/corrective-actions/details/{correctiveAction.Id}");
    }

    private void BackToReturnPage()
    {
        const string fallbackUrl = "/corrective-actions";

        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        if (!ReturnUrl.StartsWith("/"))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        Navigation.NavigateTo(ReturnUrl);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static bool IsCompletedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetStatusTone(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "success",
            "closed" => "success",
            "in progress" => "info",
            "open" => "warning",
            "new" => "warning",
            _ => "default"
        };
    }

    private static string GetPriorityTone(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "danger",
            "high" => "warning",
            "medium" => "info",
            "low" => "default",
            _ => "default"
        };
    }

    private static string GetActivityBadgeClass(string? actionType)
    {
        return actionType?.ToLowerInvariant() switch
        {
            "created" => "badge badge-success",
            "updated" => "badge badge-info",
            "reviewed" => "badge badge-secondary",
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "deleted" => "badge badge-danger",
            _ => "badge badge-secondary"
        };
    }
}