@page "/admin-settings"

@using Microsoft.Extensions.Options
@using OperationsFlow.Options
@inject IOptions<Microsoft365Options> Microsoft365Settings

@using OperationsFlow.Services.Microsoft365
@inject Microsoft365GraphService Microsoft365GraphService

<PageTitle>Admin Settings - OperationsFlow</PageTitle>

<PageHero Eyebrow="OPERATIONSFLOW / ADMINISTRATION"
          Title="Admin Settings"
          Subtitle="Admin Settings documents the Week 3 local/free configuration surface and the Week 4 production upgrade path for OAuth2, Microsoft 365, SharePoint storage, notifications, reporting, and deployment hardening."
          BadgeText="@Microsoft365BadgeText"
          BadgeClass="@Microsoft365BadgeClass">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/user-roles">User Roles</a>
        <a class="of-btn of-btn-secondary" href="/technical-overview">Technical Overview</a>
        <a class="of-btn of-btn-secondary" href="/integration-overview">Integration Overview</a>
        <a class="of-btn of-btn-primary" href="/document-library">Document Library</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="⚙️">
    <p>
        This page explains the configuration surface OperationsFlow needs for a local/free deployment and a future Microsoft 365 production deployment.
        Week 3 now includes SQL-backed local authentication. Week 4 will add Microsoft OAuth2 account linking and live Microsoft 365 integration.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Current Mode"
                Value="Local SQL"
                Detail="SQL-backed users, password login, roles, and permissions."
                Icon="🖥️"
                Tone="success" />

    <MetricCard Title="Storage Provider"
                Value="Local"
                Detail="Files are stored under wwwroot/uploads for local proof."
                Icon="📁"
                Tone="info" />

    <MetricCard Title="Future Auth"
                Value="OAuth2"
                Detail="Week 4 target for Microsoft account linking."
                Icon="🔐"
                Tone="warning" />

    <MetricCard Title="Future Files"
                Value="SharePoint"
                Detail="Week 4 target for production document library storage."
                Icon="☁️"
                Tone="warning" />
</MetricGrid>

<TableCard Title="Week 4 Microsoft 365 configuration status"
           Subtitle="These values are read from configuration. Secrets should be stored locally or in environment/user-secrets, not committed to GitHub.">
    <table class="table">
        <thead>
            <tr>
                <th>Setting</th>
                <th>Status</th>
                <th>Configured Value</th>
                <th>Purpose</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Microsoft 365 integration</td>
                <td><span class="@StatusBadge(Microsoft365.Enabled)">@StatusText(Microsoft365.Enabled)</span></td>
                <td>@(Microsoft365.Enabled ? "Enabled" : "Disabled")</td>
                <td>Controls whether Week 4 Microsoft 365 integration is active.</td>
            </tr>
            <tr>
                <td>Tenant ID</td>
                <td><span class="@StatusBadge(Microsoft365.HasTenantId)">@StatusText(Microsoft365.HasTenantId)</span></td>
                <td>@(Microsoft365.HasTenantId ? "Configured" : "Not configured")</td>
                <td>Identifies the Codie Systems Microsoft 365 tenant.</td>
            </tr>
            <tr>
                <td>Client ID</td>
                <td><span class="@StatusBadge(Microsoft365.HasClientId)">@StatusText(Microsoft365.HasClientId)</span></td>
                <td>@(Microsoft365.HasClientId ? "Configured" : "Not configured")</td>
                <td>Identifies the OperationsFlow Week 4 Entra app registration.</td>
            </tr>
            <tr>
                <td>Client secret</td>
                <td><span class="@SecretStatusBadge">@SecretStatusText</span></td>
                <td>@SecretStatusText</td>
                <td>Used privately for Graph/SharePoint access. Never commit the value.</td>
            </tr>
            <tr>
                <td>Redirect URI</td>
                <td><span class="@StatusBadge(Microsoft365.HasRedirectUri)">@StatusText(Microsoft365.HasRedirectUri)</span></td>
                <td>@Microsoft365.RedirectUri</td>
                <td>Microsoft sign-in callback URL for local development.</td>
            </tr>
            <tr>
                <td>SharePoint site</td>
                <td><span class="@StatusBadge(Microsoft365.HasSharePointTarget)">@StatusText(Microsoft365.HasSharePointTarget)</span></td>
                <td>@Microsoft365.SafeSharePointTargetDisplay</td>
                <td>Target SharePoint site for Week 4 evidence storage.</td>
            </tr>
            <tr>
                <td>Document library</td>
                <td><span class="@StatusBadge(Microsoft365.HasDocumentLibraryTarget)">@StatusText(Microsoft365.HasDocumentLibraryTarget)</span></td>
                <td>@Microsoft365.SafeLibraryTargetDisplay</td>
                <td>Target document library for uploaded OperationsFlow evidence.</td>
            </tr>
            <tr>
                <td>Microsoft login</td>
                <td><span class="@StatusBadge(Microsoft365.IsMicrosoftLoginReady)">@StatusText(Microsoft365.IsMicrosoftLoginReady)</span></td>
                <td>@(Microsoft365.UseMicrosoftLogin ? "Enabled" : "Disabled")</td>
                <td>Later Week 4 block: Microsoft identity links to local OperationsFlow users/roles.</td>
            </tr>
            <tr>
                <td>SharePoint storage</td>
                <td><span class="@StatusBadge(Microsoft365.IsSharePointStorageReady)">@StatusText(Microsoft365.IsSharePointStorageReady)</span></td>
                <td>@(Microsoft365.UseSharePointStorage ? "Enabled" : "Disabled")</td>
                <td>Later Week 4 block: uploaded evidence files are stored in SharePoint.</td>
            </tr>
        </tbody>
    </table>
</TableCard>

<InfoPanel Title="Microsoft 365 connection test"
           Subtitle="Tests the configured Entra app registration, Graph access, SharePoint site, and OperationsFlow Evidence document library.">
    <Actions>
        <span class="@Microsoft365ConnectionBadgeClass">@Microsoft365ConnectionBadgeText</span>
    </Actions>

    <ChildContent>
        <p>
            This test uses the configured Tenant ID, Client ID, private client secret, SharePoint site URL,
            and document library name. It does not upload files yet.
        </p>

        <button type="button"
                class="of-btn of-btn-primary"
                disabled="@isTestingMicrosoft365Connection"
                @onclick="TestMicrosoft365ConnectionAsync">
            @if (isTestingMicrosoft365Connection)
            {
                <span>Testing Microsoft 365 connection...</span>
            }
            else
            {
                <span>Test Microsoft 365 Connection</span>
            }
        </button>

        @if (microsoft365ConnectionStatus is not null)
        {
            <div class="of-section-card" style="margin-top: 1rem;">
                <div class="of-section-card__header">
                    <div>
                        <h3>@microsoft365ConnectionStatus.Message</h3>
                        <p>Graph / SharePoint connection proof for Week 4.</p>
                    </div>
                </div>

                <div class="of-section-card__body">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Check</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Configuration</td>
                                <td>@(microsoft365ConnectionStatus.ConfigurationReady ? "Ready" : "Incomplete")</td>
                            </tr>
                            <tr>
                                <td>Graph connection</td>
                                <td>@(microsoft365ConnectionStatus.GraphConnected ? "Connected" : "Not connected")</td>
                            </tr>
                            <tr>
                                <td>SharePoint site</td>
                                <td>@(microsoft365ConnectionStatus.SiteResolved ? "Resolved" : "Not resolved")</td>
                            </tr>
                            <tr>
                                <td>Document library</td>
                                <td>@(microsoft365ConnectionStatus.DocumentLibraryResolved ? "Resolved" : "Not resolved")</td>
                            </tr>
                            <tr>
                                <td>Site ID</td>
                                <td>@(microsoft365ConnectionStatus.SiteId ?? "Not available")</td>
                            </tr>
                            <tr>
                                <td>Drive / Library ID</td>
                                <td>@(microsoft365ConnectionStatus.DriveId ?? "Not available")</td>
                            </tr>
                            <tr>
                                <td>Web URL</td>
                                <td>@(microsoft365ConnectionStatus.WebUrl ?? "Not available")</td>
                            </tr>
                        </tbody>
                    </table>

                    @if (microsoft365ConnectionStatus.Checks.Any())
                    {
                        <h4>Checks</h4>
                        <ul>
                            @foreach (var check in microsoft365ConnectionStatus.Checks)
                            {
                                <li>@check</li>
                            }
                        </ul>
                    }

                    @if (microsoft365ConnectionStatus.Errors.Any())
                    {
                        <h4>Errors</h4>
                        <ul>
                            @foreach (var error in microsoft365ConnectionStatus.Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Current boundary" Icon="⚠️" Tone="warning">
    <p>
        Week 3 is a local/free implementation. It includes local password login and role loading, but it does not yet include
        Microsoft OAuth2, real Microsoft tenant authentication, live SharePoint storage, production password reset, hosted deployment,
        backup policy, or retention/compliance sign-off.
    </p>
</GuidanceNote>

<TableCard Title="Current local/free settings"
           Subtitle="These settings describe the working Week 3 local foundation.">

    <table class="table">
        <thead>
            <tr>
                <th>Setting</th>
                <th>Current Value</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><span class="of-badge of-badge-info">Application mode</span></td>
                <td>Local demo / portfolio prototype</td>
                <td>Used to prove the workflow and local/free deployment path.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-success">Database</span></td>
                <td>SQL Server Express / LocalDB</td>
                <td>Stores workflow records, activity logs, attachment metadata, users, roles, and permissions.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-success">Auth provider</span></td>
                <td>Local SQL</td>
                <td>Username/password login backed by LocalUsers.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-success">Password storage</span></td>
                <td>Hashed passwords</td>
                <td>Passwords are not stored in plain text.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-info">Session mode</span></td>
                <td>Persistent local login</td>
                <td>Browser stores local user id only; app reloads roles/permissions from SQL.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-warning">File storage provider</span></td>
                <td>Local</td>
                <td>Files are stored locally under wwwroot/uploads.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-info">Attachment metadata</span></td>
                <td>DocumentAttachment records</td>
                <td>Links files to module, record id, provider, file name, path/key, and status.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-success">Activity audit</span></td>
                <td>Activity Log</td>
                <td>Upload/delete and workflow events are recorded for reviewer evidence.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-danger">Git safety</span></td>
                <td>Do not commit uploads or database files</td>
                <td>wwwroot/uploads, *.db, *.db-shm, *.db-wal, *.mdf, and *.ldf must stay out of commits.</td>
            </tr>
        </tbody>
    </table>
</TableCard>

<div class="of-two-column-grid">
    <InfoPanel Title="Week 3 identity settings"
               Subtitle="The local/free version now has a real SQL-backed auth model."
               Tone="success">

        <ul class="of-mini-list">
            <li class="of-mini-list-item">
                <strong>Provider:</strong>
                <span>Local SQL authentication.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Users:</strong>
                <span>LocalUsers table.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Roles:</strong>
                <span>LocalRoles and LocalUserRoles.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Permissions:</strong>
                <span>LocalPermissions and LocalRolePermissions.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Session:</strong>
                <span>Persistent local login using saved user id, then SQL reload.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Logout:</strong>
                <span>Clears saved local user id and current in-memory user.</span>
            </li>
        </ul>
    </InfoPanel>

    <InfoPanel Title="Week 4 auth/settings needed"
               Subtitle="These settings support the move from local login to Microsoft OAuth2 linking."
               Tone="warning">

        <ul class="of-mini-list">
            <li class="of-mini-list-item">
                <strong>OAuth2 provider:</strong>
                <span>Microsoft OAuth2 / Entra ID.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Tenant id:</strong>
                <span>Microsoft 365 tenant identifier.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Client id:</strong>
                <span>App registration id.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Secret/certificate:</strong>
                <span>Secure OAuth2 credential.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>External link:</strong>
                <span>Microsoft account maps to LocalUser through ExternalLoginLinks.</span>
            </li>
            <li class="of-mini-list-item">
