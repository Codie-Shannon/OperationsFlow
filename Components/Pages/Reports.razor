@page "/reports"

@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake

@inject OperationsFlowDbContext Db
@inject DocumentAttachmentService AttachmentService

<PageTitle>Reports - OperationsFlow</PageTitle>

<PageHero Eyebrow="Management"
          Title="Reports"
          Subtitle="Review management-level workflow pressure, evidence coverage, compliance flags, document intake pressure, and export-ready reporting data."
          BadgeText="@($"{ReportActionCount} actions")"
          BadgeClass="@OpenIssueBadgeClass">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/work-orders">Work Orders</a>
        <a class="of-btn of-btn-secondary" href="/corrective-actions">Corrective Actions</a>
        <a class="of-btn of-btn-secondary" href="/data-quality">Data Quality</a>
        <a class="of-btn of-btn-secondary" href="/activity-log">Activity Log</a>
        <a class="of-btn of-btn-secondary" href="/document-library">Document Library</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="📊">
    <p>
        Use this page to review management-level workflow pressure and open the exact records that need action.
        Reports connect back to Work Orders, Corrective Actions, Document Intake, Documents, Risk Register,
        Training, Data Quality, Activity Log, Document Library, and CSV export evidence.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Open Work Orders"
                Value="@WorkOrdersOpen.ToString()"
                Detail="@($"{WorkOrdersTotal} total work order records")"
                Icon="🛠️"
                Tone="info" />

    <MetricCard Title="Open Actions"
                Value="@CorrectiveActionsOpen.ToString()"
                Detail="@($"{CorrectiveActionsOverdue} overdue corrective actions")"
                Icon="✅"
                Tone="@ActionTone" />

    <MetricCard Title="High/Critical Risks"
                Value="@HighCriticalRisks.ToString()"
                Detail="@($"{RisksTotal} total risk records")"
                Icon="⚠️"
                Tone="warning" />

    <MetricCard Title="Training Compliance"
                Value="@($"{TrainingComplianceRate:0.0}%")"
                Detail="@($"{ExpiredTraining} expired required records")"
                Icon="🎓"
                Tone="@TrainingTone" />

    <MetricCard Title="Document Intake"
                Value="@DocumentIntakeOpen.ToString()"
                Detail="@($"{DocumentIntakeNeedsReview} need review, {DocumentIntakeOverdue} overdue")"
                Icon="📥"
                Tone="@DocumentIntakeTone" />

    <MetricCard Title="Report Actions"
                Value="@ReportActionCount.ToString()"
                Detail="Rows needing review"
                Icon="🔎"
                Tone="warning" />

    <MetricCard Title="Attached Files"
                Value="@AttachmentTotal.ToString()"
                Detail="Active evidence/library files"
                Icon="📎"
                Tone="info" />

    <MetricCard Title="Missing Evidence"
                Value="@MissingEvidenceReportRows.Count.ToString()"
                Detail="Priority records without files"
                Icon="🧪"
                Tone="@EvidenceTone" />
</MetricGrid>

<InfoPanel Title="Report Review Flow" Subtitle="Recommended management review order.">
    <ChildContent>
        <ol>
            <li>Review overdue work orders and corrective actions first.</li>
            <li>Check owner workload pressure and unclosed high-priority work.</li>
            <li>Review high/critical risks and overdue document reviews.</li>
            <li>Confirm expired or expiring training records have follow-up owners.</li>
            <li>Check document intake items that are overdue, due soon, or waiting for review.</li>
            <li>Review Missing Evidence before management screenshots or review meetings.</li>
            <li>Use Activity Log after updates to prove what changed.</li>
        </ol>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Report Value" Subtitle="What this page proves.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Actionable</strong>
                <span>Management rows link back to edit, details, or source workflow pages.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Connected</strong>
                <span>Work, actions, risks, documents, training, intake, and evidence are reviewed together.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Traceable</strong>
                <span>After updates, reviewers can confirm created, reviewed, uploaded, and changed events.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Exportable</strong>
                <span>Reports can be exported for Excel, Power BI-style review, or management packs.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="CSV Exports" Subtitle="Download operational, compliance, evidence, and admin workflow data.">
    <Actions>
        <span class="of-badge of-badge-info">7 exports</span>
    </Actions>

    <ChildContent>
        <div class="of-review-proof-grid">
            <a class="of-review-proof-card" href="/exports/work-orders.csv">
                <strong>Work Orders CSV</strong>
                <span>Operational requests, owners, priorities, statuses, and due dates.</span>
            </a>

            <a class="of-review-proof-card" href="/exports/corrective-actions.csv">
                <strong>Corrective Actions CSV</strong>
                <span>Open, overdue, priority, owner, source, and follow-up notes.</span>
            </a>

            <a class="of-review-proof-card" href="/exports/risk-register.csv">
                <strong>Risk Register CSV</strong>
                <span>Risk ratings, controls, owners, review dates, and overdue reviews.</span>
            </a>

            <a class="of-review-proof-card" href="/exports/training.csv">
                <strong>Training CSV</strong>
                <span>Training status, expiry dates, required records, and compliance flags.</span>
            </a>

            <a class="of-review-proof-card" href="/exports/document-reviews.csv">
                <strong>Document Reviews CSV</strong>
                <span>Controlled document owners, review dates, statuses, and due flags.</span>
            </a>

            <a class="of-review-proof-card" href="/exports/document-intake.csv">
                <strong>Document Intake CSV</strong>
                <span>Incoming document workflow items, target systems, owners, and due dates.</span>
            </a>

            <a class="of-review-proof-card" href="/exports/activity-log.csv">
                <strong>Activity Log CSV</strong>
                <span>Record-level traceability for created, updated, uploaded, and reviewed items.</span>
            </a>
        </div>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Evidence Coverage Report" Subtitle="Shows which workflow modules have attached files and which priority records still need evidence.">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/document-library">Open Document Library</a>
        <a class="of-btn of-btn-secondary" href="/data-quality">Open Data Quality</a>
    </Actions>

    <ChildContent>
        <div class="of-review-proof-grid">
            @foreach (var row in EvidenceCoverageRows)
            {
                <div class="of-review-proof-card">
                    <strong>@row.ModuleName</strong>
                    <span>@row.AttachedRecordCount of @row.CheckedRecordCount checked records have files.</span>
                    <span>@row.AttachmentCount active attachment(s).</span>

                    <div class="of-link-row">
                        <span class="@GetEvidenceCoverageClass(row)">
                            @row.CoveragePercent.ToString("0.0")%
                        </span>

                        @if (row.MissingEvidenceCount > 0)
                        {
                            <span class="of-badge of-badge-warning">
                                @row.MissingEvidenceCount missing
                            </span>
                        }
                        else
                        {
                            <span class="of-badge of-badge-success">
                                covered
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</InfoPanel>

<TableCard Title="Missing Evidence Report"
           Subtitle="Priority, overdue, closed, or review-needed records that should have at least one supporting file."
           IsEmpty="@(!MissingEvidenceReportRows.Any())"
           EmptyTitle="No missing evidence report rows"
           EmptyMessage="All checked priority records currently have supporting files attached.">
    <Actions>
        <span class="of-badge of-badge-warning">@MissingEvidenceReportRows.Count rows</span>
    </Actions>

    <ChildContent>
        @if (MissingEvidenceReportRows.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Severity</th>
                        <th>Module</th>
                        <th>Reference</th>
                        <th>Reason</th>
                        <th>Owner</th>
                        <th>Recommended Action</th>
                        <th>Open</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in MissingEvidenceReportRows)
                    {
                        <tr>
                            <td>
                                <span class="@row.SeverityClass">
                                    @row.Severity
                                </span>
                            </td>
                            <td>@row.Module</td>
                            <td><strong>@row.Reference</strong></td>
                            <td>@row.Reason</td>
                            <td>@row.Owner</td>
                            <td>@row.RecommendedAction</td>
                            <td>
                                <a class="of-card-link" href="@row.Url">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>
</TableCard>

<div class="of-two-column-grid">
    <TableCard Title="Work Orders by Status"
               Subtitle="Current operational workload status."
               IsEmpty="@(!WorkOrdersByStatus.Any())"
               EmptyTitle="No work order data"
               EmptyMessage="No work orders are available for reporting.">
        <Actions>
            <a class="of-card-link" href="/work-orders">Open Work Orders</a>
        </Actions>

        <ChildContent>
            @if (WorkOrdersByStatus.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in WorkOrdersByStatus)
                        {
                            <tr>
                                <td>
                                    <span class="@GetStatusClass(row.Label)">
                                        @row.Label
                                    </span>
                                </td>
                                <td><strong>@row.Count</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </TableCard>

    <TableCard Title="Corrective Actions by Priority"
               Subtitle="Action pressure by priority level."
               IsEmpty="@(!CorrectiveActionsByPriority.Any())"
               EmptyTitle="No corrective action data"
               EmptyMessage="No corrective actions are available for reporting.">
        <Actions>
            <a class="of-card-link" href="/corrective-actions">Open Actions</a>
        </Actions>

        <ChildContent>
            @if (CorrectiveActionsByPriority.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Priority</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in CorrectiveActionsByPriority)
                        {
                            <tr>
                                <td>
                                    <span class="@GetPriorityClass(row.Label)">
                                        @row.Label
                                    </span>
                                </td>
                                <td><strong>@row.Count</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </TableCard>
</div>

<div class="of-two-column-grid">
    <TableCard Title="Risk Register by Risk Level"
               Subtitle="Risk profile by current risk level."
               IsEmpty="@(!RisksByLevel.Any())"
               EmptyTitle="No risk data"
               EmptyMessage="No risk records are available for reporting.">
        <Actions>
            <a class="of-card-link" href="/risk-register">Open Risks</a>
        </Actions>

        <ChildContent>
            @if (RisksByLevel.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Risk Level</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in RisksByLevel)
                        {
                            <tr>
                                <td>
                                    <span class="@GetRiskLevelClass(row.Label)">
                                        @row.Label
                                    </span>
                                </td>
                                <td><strong>@row.Count</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </TableCard>

    <TableCard Title="Document Intake by Target System"
               Subtitle="Incoming document workflow pressure by destination."
               IsEmpty="@(!DocumentIntakeByTargetSystem.Any())"
               EmptyTitle="No document intake data"
               EmptyMessage="No intake records are available for reporting.">
        <Actions>
            <a class="of-card-link" href="/document-intake">Open Intake</a>
        </Actions>

        <ChildContent>
            @if (DocumentIntakeByTargetSystem.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Target System</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in DocumentIntakeByTargetSystem)
                        {
                            <tr>
                                <td>@row.Label</td>
                                <td><strong>@row.Count</strong></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </TableCard>
</div>

<TableCard Title="Management Action Report"
           Subtitle="@($"{ManagementActionRows.Count} highest-priority management action row(s).")"
           IsEmpty="@(!ManagementActionRows.Any())"
           EmptyTitle="No management action rows"
           EmptyMessage="No overdue, high-priority, or compliance review rows currently need attention.">
    <ChildContent>
        @if (ManagementActionRows.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Severity</th>
                        <th>Module</th>
                        <th>Reference</th>
                        <th>Issue</th>
                        <th>Owner</th>
                        <th>Due / Review</th>
                        <th>Recommended Action</th>
                        <th>Open</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in ManagementActionRows)
                    {
                        <tr>
                            <td>
                                <span class="@row.SeverityClass">
                                    @row.Severity
                                </span>
                            </td>
                            <td>@row.Module</td>
                            <td><strong>@row.Reference</strong></td>
                            <td>@row.Issue</td>
                            <td>@row.Owner</td>
                            <td>@row.DueText</td>
                            <td>@row.RecommendedAction</td>
                            <td>
                                <a class="of-card-link" href="@row.Url">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>
</TableCard>

<div class="of-two-column-grid">
    <TableCard Title="Training Compliance by Department"
               Subtitle="Required training completion by department."
               IsEmpty="@(!TrainingByDepartment.Any())"
               EmptyTitle="No required training data"
               EmptyMessage="No required training records are available for reporting.">
        <Actions>
            <a class="of-card-link" href="/training">Open Training</a>
        </Actions>

        <ChildContent>
            @if (TrainingByDepartment.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Department</th>
                            <th>Required</th>
                            <th>Current</th>
                            <th>Compliance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in TrainingByDepartment)
                        {
                            <tr>
                                <td>@row.Department</td>
                                <td>@row.RequiredCount</td>
                                <td>@row.CurrentCount</td>
                                <td>
                                    <span class="@GetComplianceClass(row.ComplianceRate)">
                                        @row.ComplianceRate.ToString("0.0")%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </TableCard>

    <TableCard Title="Overdue Work by Owner"
               Subtitle="Owners with overdue work orders or corrective actions."
               IsEmpty="@(!OverdueItemsByOwner.Any())"
               EmptyTitle="No overdue owner pressure"
               EmptyMessage="No owners currently have overdue work order or corrective action pressure.">
        <Actions>
            <a class="of-card-link" href="/workload">Open Workload</a>
        </Actions>

        <ChildContent>
            @if (OverdueItemsByOwner.Any())
            {
                <table>
                    <thead>
                        <tr>
                            <th>Owner</th>
                            <th>Work Orders</th>
                            <th>Actions</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in OverdueItemsByOwner)
                        {
                            <tr>
                                <td><strong>@row.Owner</strong></td>
                                <td>@row.OverdueWorkOrders</td>
                                <td>@row.OverdueCorrectiveActions</td>
                                <td>
                                    <span class="badge badge-danger">
                                        @row.TotalOverdue
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </ChildContent>
    </TableCard>
</div>

<TableCard Title="Document Review Report"
           Subtitle="Controlled documents that are overdue or due soon for review."
           IsEmpty="@(!DocumentReviewRows.Any())"
           EmptyTitle="No document reviews need attention"
           EmptyMessage="No controlled document reviews are overdue or due soon.">
    <Actions>
        <a class="of-card-link" href="/documents">View Documents</a>
    </Actions>

    <ChildContent>
        @if (DocumentReviewRows.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Document #</th>
                        <th>Title</th>
                        <th>Department</th>
                        <th>Owner</th>
                        <th>Next Review</th>
                        <th>Flag</th>
                        <th>Open</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in DocumentReviewRows)
                    {
                        <tr>
                            <td><strong>@item.DocumentNumber</strong></td>
                            <td>@item.Title</td>
                            <td>@item.Department</td>
                            <td>@DisplayText(item.Owner)</td>
                            <td>@item.NextReviewDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.IsReviewOverdue)
                                {
                                    <span class="badge badge-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">Due Soon</span>
                                }
                            </td>
                            <td>
                                <a class="of-card-link" href="/documents">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>
</TableCard>

<TableCard Title="Document Intake Attention Report"
           Subtitle="Incoming documents that are overdue, due soon, or waiting for review."
           IsEmpty="@(!DocumentIntakeAttentionRows.Any())"
           EmptyTitle="No document intake rows need attention"
           EmptyMessage="No intake records are overdue, due soon, or waiting for manual review.">
    <Actions>
        <a class="of-card-link" href="/document-intake">View Intake</a>
    </Actions>

    <ChildContent>
        @if (DocumentIntakeAttentionRows.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>Document</th>
                        <th>Assigned To</th>
                        <th>Target System</th>
                        <th>Status</th>
                        <th>Due Date</th>
                        <th>Flag</th>
                        <th>Open</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in DocumentIntakeAttentionRows)
                    {
                        <tr>
                            <td><strong>@item.DocumentName</strong></td>
                            <td>@DisplayText(item.AssignedTo)</td>
                            <td>@item.TargetSystem</td>
                            <td>
                                <span class="@GetIntakeStatusClass(item.Status)">
                                    @item.Status
                                </span>
                            </td>
                            <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.IsOverdue)
                                {
                                    <span class="badge badge-danger">Overdue</span>
                                }
                                else if (item.NeedsReview)
                                {
                                    <span class="badge badge-warning">Needs Review</span>
                                }
                                else
                                {
                                    <span class="badge badge-info">Due Soon</span>
                                }
                            </td>
                            <td>
                                <a class="of-card-link" href="@BuildDocumentIntakeDetailsUrl(item.Id)">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>
</TableCard>

<GuidanceNote Title="Review Notes" Icon="💡" Tone="info">
    <ul>
        <li>Reports should show workflow pressure across operations, compliance, admin workflow, system evidence, and document traceability.</li>
        <li>Management rows should open the relevant record or source module for review.</li>
        <li>Missing Evidence rows show priority records that need supporting files before review.</li>
        <li>CSV exports support Excel, Power BI-style review, email follow-ups, and management packs.</li>
        <li>This is local SQLite demo reporting; production reporting could connect to Microsoft Lists, SharePoint, Power BI, and Power Automate.</li>
    </ul>
</GuidanceNote>

@code {
    private List<WorkOrder> workOrders = new();
    private List<CorrectiveAction> correctiveActions = new();
    private List<DocumentRecord> documents = new();
    private List<RiskItem> risks = new();
    private List<TrainingRecord> trainingRecords = new();
    private List<DocumentIntakeModel> documentIntakeItems = new();
    private List<DocumentAttachment> attachments = new();

    private int WorkOrdersTotal => workOrders.Count;

    private int WorkOrdersOpen => workOrders.Count(x => !IsClosedStatus(x.Status));

    private int CorrectiveActionsOpen => correctiveActions.Count(x => !IsClosedStatus(x.Status));

    private int CorrectiveActionsOverdue => correctiveActions.Count(x => x.IsOverdue);

    private int RisksTotal => risks.Count;

    private int HighCriticalRisks => risks.Count(x => x.RiskLevel == "High" || x.RiskLevel == "Critical");

    private int ExpiredTraining => trainingRecords.Count(x => x.IsRequired && x.IsExpired);

    private int DocumentIntakeOpen => documentIntakeItems.Count(x => !x.IsCompleted);

    private int DocumentIntakeNeedsReview => documentIntakeItems.Count(x => x.NeedsReview);

    private int DocumentIntakeOverdue => documentIntakeItems.Count(x => x.IsOverdue);

    private int AttachmentTotal => attachments.Count(x => !x.IsDeleted);

    private int OpenIssueCount =>
        WorkOrdersOpen +
        CorrectiveActionsOpen +
        HighCriticalRisks +
        ExpiredTraining +
        DocumentIntakeNeedsReview +
        DocumentIntakeOverdue +
        MissingEvidenceReportRows.Count;

    private int ReportActionCount =>
        ManagementActionRows.Count +
        DocumentReviewRows.Count +
        DocumentIntakeAttentionRows.Count +
        MissingEvidenceReportRows.Count;

    private string OpenIssueBadgeClass =>
        OpenIssueCount == 0
            ? "of-badge-success"
            : CorrectiveActionsOverdue > 0 || DocumentIntakeOverdue > 0 || MissingEvidenceReportRows.Any(x => x.Severity == "Critical")
                ? "of-badge-danger"
                : "of-badge-warning";

    private string ActionTone =>
        CorrectiveActionsOverdue > 0 ? "danger" : "warning";

    private string TrainingTone =>
        ExpiredTraining > 0 ? "danger" : "success";

    private string DocumentIntakeTone =>
        DocumentIntakeOverdue > 0 ? "danger" :
        DocumentIntakeNeedsReview > 0 ? "warning" :
        "success";

    private string EvidenceTone =>
        MissingEvidenceReportRows.Any() ? "warning" : "success";

    private decimal TrainingComplianceRate
    {
        get
        {
            var required = trainingRecords
                .Where(x => x.IsRequired)
                .ToList();

            if (!required.Any())
            {
                return 0;
            }

            var current = required.Count(x => !x.IsExpired);

            return (decimal)current / required.Count * 100;
        }
    }

    private List<ReportCountRow> WorkOrdersByStatus =>
        workOrders
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Status) ? "Unknown" : x.Status)
            .Select(x => new ReportCountRow(x.Key, x.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Label)
            .ToList();

    private List<ReportCountRow> CorrectiveActionsByPriority =>
        correctiveActions
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Priority) ? "Unknown" : x.Priority)
            .Select(x => new ReportCountRow(x.Key, x.Count()))
            .OrderBy(x => GetPrioritySortOrder(x.Label))
            .ThenBy(x => x.Label)
            .ToList();

    private List<ReportCountRow> RisksByLevel =>
        risks
            .GroupBy(x => string.IsNullOrWhiteSpace(x.RiskLevel) ? "Unknown" : x.RiskLevel)
            .Select(x => new ReportCountRow(x.Key, x.Count()))
            .OrderBy(x => GetRiskSortOrder(x.Label))
            .ThenBy(x => x.Label)
            .ToList();

    private List<ReportCountRow> DocumentIntakeByTargetSystem =>
        documentIntakeItems
            .GroupBy(x => string.IsNullOrWhiteSpace(x.TargetSystem) ? "Unknown" : x.TargetSystem)
            .Select(x => new ReportCountRow(x.Key, x.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Label)
            .ToList();

    private List<TrainingDepartmentReportRow> TrainingByDepartment
    {
        get
        {
            return trainingRecords
                .Where(x => x.IsRequired)
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Department) ? "Unknown" : x.Department)
                .Select(group =>
                {
                    var requiredCount = group.Count();
                    var currentCount = group.Count(x => !x.IsExpired);
                    var compliance = requiredCount == 0
                        ? 0
                        : (decimal)currentCount / requiredCount * 100;

                    return new TrainingDepartmentReportRow(
                        Department: group.Key,
                        RequiredCount: requiredCount,
                        CurrentCount: currentCount,
                        ComplianceRate: compliance);
                })
                .OrderBy(x => x.ComplianceRate)
                .ThenBy(x => x.Department)
                .ToList();
        }
    }

    private List<OverdueOwnerReportRow> OverdueItemsByOwner
    {
        get
        {
            var overdueWorkOrders = workOrders
                .Where(x => x.IsOverdue)
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Owner) ? "Unassigned" : x.Owner)
                .ToDictionary(x => x.Key, x => x.Count());

            var overdueCorrectiveActions = correctiveActions
                .Where(x => x.IsOverdue)
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Owner) ? "Unassigned" : x.Owner)
                .ToDictionary(x => x.Key, x => x.Count());

            var owners = overdueWorkOrders.Keys
                .Union(overdueCorrectiveActions.Keys)
                .OrderBy(x => x)
                .ToList();

            return owners
                .Select(owner =>
                {
                    var workOrderCount = overdueWorkOrders.GetValueOrDefault(owner, 0);
                    var actionCount = overdueCorrectiveActions.GetValueOrDefault(owner, 0);

                    return new OverdueOwnerReportRow(
                        Owner: owner,
                        OverdueWorkOrders: workOrderCount,
                        OverdueCorrectiveActions: actionCount);
                })
                .OrderByDescending(x => x.TotalOverdue)
                .ThenBy(x => x.Owner)
                .ToList();
        }
    }

    private List<DocumentRecord> DocumentReviewRows =>
        documents
            .Where(x => x.IsReviewOverdue || x.IsDueSoon)
            .OrderByDescending(x => x.IsReviewOverdue)
            .ThenBy(x => x.NextReviewDate)
            .ThenBy(x => x.Title)
            .ToList();

    private List<DocumentIntakeModel> DocumentIntakeAttentionRows =>
        documentIntakeItems
            .Where(x => x.IsOverdue || x.NeedsReview || x.IsDueSoon)
            .OrderByDescending(x => x.IsOverdue)
            .ThenByDescending(x => x.NeedsReview)
            .ThenBy(x => x.DueDate)
            .ToList();

    private List<EvidenceCoverageRow> EvidenceCoverageRows
    {
        get
        {
            return new List<EvidenceCoverageRow>
            {
                BuildEvidenceCoverageRow(
                    moduleName: "Work Orders",
                    checkedRecordCount: workOrders.Count,
                    attachedRecordCount: CountRecordsWithAttachments("Work Orders"),
                    attachmentCount: CountAttachments("Work Orders"),
                    missingEvidenceCount: MissingEvidenceReportRows.Count(x => x.Module == "Work Orders")),

                BuildEvidenceCoverageRow(
                    moduleName: "Corrective Actions",
                    checkedRecordCount: correctiveActions.Count,
                    attachedRecordCount: CountRecordsWithAttachments("Corrective Actions"),
                    attachmentCount: CountAttachments("Corrective Actions"),
                    missingEvidenceCount: MissingEvidenceReportRows.Count(x => x.Module == "Corrective Actions")),

                BuildEvidenceCoverageRow(
                    moduleName: "Document Intake",
                    checkedRecordCount: documentIntakeItems.Count,
                    attachedRecordCount: CountRecordsWithAttachments("Document Intake"),
                    attachmentCount: CountAttachments("Document Intake"),
                    missingEvidenceCount: MissingEvidenceReportRows.Count(x => x.Module == "Document Intake"))
            };
        }
    }

    private List<MissingEvidenceReportRow> MissingEvidenceReportRows
    {
        get
        {
            var rows = new List<MissingEvidenceReportRow>();

            rows.AddRange(workOrders
                .Where(x =>
                    (x.IsOverdue || IsHighPriority(x.Priority)) &&
                    !HasAttachment("Work Orders", x.Id))
                .Select(x => new MissingEvidenceReportRow(
                    Severity: x.IsOverdue ? "Critical" : "Warning",
                    SeverityClass: x.IsOverdue ? "badge badge-danger" : "badge badge-warning",
                    Module: "Work Orders",
                    Reference: x.WorkOrderNumber,
                    Reason: x.IsOverdue
                        ? $"Overdue work order has no attached evidence: {x.Title}."
                        : $"High-priority work order has no attached evidence: {x.Title}.",
                    Owner: DisplayText(x.Owner),
                    RecommendedAction: "Open the work order and upload photos, notes, forms, or supporting evidence.",
                    Url: $"/work-orders/details/{x.Id}")));

            rows.AddRange(correctiveActions
                .Where(x =>
                    (x.IsOverdue || IsHighPriority(x.Priority) || IsClosedStatus(x.Status)) &&
                    !HasAttachment("Corrective Actions", x.Id))
                .Select(x => new MissingEvidenceReportRow(
                    Severity: x.IsOverdue ? "Critical" : "Warning",
                    SeverityClass: x.IsOverdue ? "badge badge-danger" : "badge badge-warning",
                    Module: "Corrective Actions",
                    Reference: $"CA-{x.Id}",
                    Reason: x.IsOverdue
                        ? $"Overdue corrective action has no close-out evidence: {x.Title}."
                        : $"Priority or closed corrective action has no attached evidence: {x.Title}.",
                    Owner: DisplayText(x.Owner),
                    RecommendedAction: "Open the corrective action and upload close-out evidence, photos, review notes, or supporting files.",
                    Url: $"/corrective-actions/details/{x.Id}")));

            rows.AddRange(documentIntakeItems
                .Where(x =>
                    (x.IsOverdue || x.NeedsReview || IsHighPriority(x.Priority)) &&
                    !HasAttachment("Document Intake", x.Id))
                .Select(x => new MissingEvidenceReportRow(
                    Severity: x.IsOverdue ? "Critical" : "Warning",
                    SeverityClass: x.IsOverdue ? "badge badge-danger" : "badge badge-warning",
                    Module: "Document Intake",
                    Reference: $"DI-{x.Id}",
                    Reason: x.IsOverdue
                        ? $"Overdue intake record has no source file attached: {x.DocumentName}."
                        : $"Review-needed intake record has no source file attached: {x.DocumentName}.",
                    Owner: DisplayText(x.AssignedTo),
                    RecommendedAction: "Open the intake record and attach the source document, scan, email export, PDF, or processing evidence.",
                    Url: $"/document-intake/details/{x.Id}")));

            return rows
                .OrderBy(x => GetSeveritySortOrder(x.Severity))
                .ThenBy(x => x.Module)
                .ThenBy(x => x.Reference)
                .ToList();
        }
    }

    private List<ManagementActionRow> ManagementActionRows
    {
        get
        {
            var rows = new List<ManagementActionRow>();

            rows.AddRange(workOrders
                .Where(x =>
                    x.IsOverdue ||
                    string.Equals(x.Priority, "High", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(x.Priority, "Critical", StringComparison.OrdinalIgnoreCase))
                .Select(x => new ManagementActionRow(
                    Severity: x.IsOverdue ? "Critical" : GetPrioritySeverity(x.Priority),
                    SeverityClass: x.IsOverdue ? "badge badge-danger" : GetPriorityClass(x.Priority),
                    Module: "Work Orders",
                    Reference: x.WorkOrderNumber,
                    Issue: x.IsOverdue
                        ? $"Work order is overdue: {x.Title}."
                        : $"High-priority work order: {x.Title}.",
                    Owner: DisplayText(x.Owner),
                    DueText: x.DueDate.ToString("dd MMM yyyy"),
                    RecommendedAction: "Open the work order, review progress, update owner/status/due date, attach evidence, or close if completed.",
                    Url: $"/work-orders/details/{x.Id}")));

            rows.AddRange(correctiveActions
                .Where(x =>
                    x.IsOverdue ||
                    string.Equals(x.Priority, "High", StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(x.Priority, "Critical", StringComparison.OrdinalIgnoreCase))
                .Select(x => new ManagementActionRow(
                    Severity: x.IsOverdue ? "Critical" : GetPrioritySeverity(x.Priority),
                    SeverityClass: x.IsOverdue ? "badge badge-danger" : GetPriorityClass(x.Priority),
                    Module: "Corrective Actions",
                    Reference: $"CA-{x.Id}",
                    Issue: x.IsOverdue
                        ? $"Corrective action is overdue: {x.Title}."
                        : $"High-priority corrective action: {x.Title}.",
                    Owner: DisplayText(x.Owner),
                    DueText: x.DueDate.ToString("dd MMM yyyy"),
                    RecommendedAction: "Open the corrective action, review progress, update owner/status/due date, attach evidence, or close if completed.",
                    Url: $"/corrective-actions/details/{x.Id}")));

            rows.AddRange(risks
                .Where(x => x.IsReviewOverdue || x.RiskLevel == "Critical" || x.RiskLevel == "High")
                .Select(x => new ManagementActionRow(
                    Severity: x.IsReviewOverdue || x.RiskLevel == "Critical" ? "Critical" : "Warning",
                    SeverityClass: x.IsReviewOverdue || x.RiskLevel == "Critical" ? "badge badge-danger" : "badge badge-warning",
                    Module: "Risk Register",
                    Reference: x.Title,
                    Issue: x.IsReviewOverdue
                        ? $"Risk review is overdue. Hazard: {x.Hazard}."
                        : $"High-risk item needs monitoring. Hazard: {x.Hazard}.",
                    Owner: DisplayText(x.Owner),
                    DueText: x.ReviewDate.ToString("dd MMM yyyy"),
                    RecommendedAction: "Open Risk Register, review controls, confirm owner, or create a corrective action.",
                    Url: "/risk-register")));

            rows.AddRange(trainingRecords
                .Where(x => x.IsExpired || x.IsExpiringSoon)
                .Select(x => new ManagementActionRow(
                    Severity: x.IsExpired ? "Critical" : "Warning",
                    SeverityClass: x.IsExpired ? "badge badge-danger" : "badge badge-warning",
                    Module: "Training",
                    Reference: x.StaffName,
                    Issue: $"{x.TrainingName} is {(x.IsExpired ? "expired" : "expiring soon")}.",
                    Owner: DisplayText(x.StaffName),
                    DueText: x.ExpiryDate.ToString("dd MMM yyyy"),
                    RecommendedAction: "Open Training, confirm refresher requirements, book renewal, or create follow-up work.",
                    Url: "/training")));

            rows.AddRange(DocumentReviewRows
                .Select(x => new ManagementActionRow(
                    Severity: x.IsReviewOverdue ? "Critical" : "Warning",
                    SeverityClass: x.IsReviewOverdue ? "badge badge-danger" : "badge badge-warning",
                    Module: "Document Control",
                    Reference: x.DocumentNumber,
                    Issue: x.IsReviewOverdue
                        ? $"Document review is overdue: {x.Title}."
                        : $"Document review is due soon: {x.Title}.",
                    Owner: DisplayText(x.Owner),
                    DueText: x.NextReviewDate.ToString("dd MMM yyyy"),
                    RecommendedAction: "Open Documents, review the controlled document, update version/status, or create a corrective action.",
                    Url: "/documents")));

            rows.AddRange(DocumentIntakeAttentionRows
                .Select(x => new ManagementActionRow(
                    Severity: x.IsOverdue ? "Critical" : "Warning",
                    SeverityClass: x.IsOverdue ? "badge badge-danger" : "badge badge-warning",
                    Module: "Document Intake",
                    Reference: $"DI-{x.Id}",
                    Issue: x.IsOverdue
                        ? $"Document intake is overdue: {x.DocumentName}."
                        : $"Document intake needs review or is due soon: {x.DocumentName}.",
                    Owner: DisplayText(x.AssignedTo),
                    DueText: x.DueDate.ToString("dd MMM yyyy"),
                    RecommendedAction: "Open the intake record, confirm owner/status, attach the source document, process it, or complete/reject it.",
                    Url: BuildDocumentIntakeDetailsUrl(x.Id))));

            return rows
                .OrderBy(x => GetSeveritySortOrder(x.Severity))
                .ThenBy(x => x.DueText)
                .ThenBy(x => x.Module)
                .Take(30)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        workOrders = await Db.WorkOrders
            .AsNoTracking()
            .ToListAsync();

        correctiveActions = await Db.CorrectiveActions
            .AsNoTracking()
            .ToListAsync();

        documents = await Db.DocumentRecords
            .AsNoTracking()
            .ToListAsync();

        risks = await Db.RiskItems
            .AsNoTracking()
            .ToListAsync();

        trainingRecords = await Db.TrainingRecords
            .AsNoTracking()
            .ToListAsync();

        documentIntakeItems = await Db.DocumentIntakeItems
            .AsNoTracking()
            .ToListAsync();

        attachments = await AttachmentService.GetAllActiveAsync();
    }

    private bool HasAttachment(string moduleName, int recordId)
    {
        return attachments.Any(x =>
            !x.IsDeleted &&
            x.RecordId == recordId &&
            string.Equals(x.ModuleName, moduleName, StringComparison.OrdinalIgnoreCase));
    }

    private int CountAttachments(string moduleName)
    {
        return attachments.Count(x =>
            !x.IsDeleted &&
            string.Equals(x.ModuleName, moduleName, StringComparison.OrdinalIgnoreCase));
    }

    private int CountRecordsWithAttachments(string moduleName)
    {
        return attachments
            .Where(x =>
                !x.IsDeleted &&
                x.RecordId.HasValue &&
                string.Equals(x.ModuleName, moduleName, StringComparison.OrdinalIgnoreCase))
            .Select(x => x.RecordId!.Value)
            .Distinct()
            .Count();
    }

    private static EvidenceCoverageRow BuildEvidenceCoverageRow(
        string moduleName,
        int checkedRecordCount,
        int attachedRecordCount,
        int attachmentCount,
        int missingEvidenceCount)
    {
        var coveragePercent = checkedRecordCount == 0
            ? 0
            : (decimal)attachedRecordCount / checkedRecordCount * 100;

        return new EvidenceCoverageRow(
            ModuleName: moduleName,
            CheckedRecordCount: checkedRecordCount,
            AttachedRecordCount: attachedRecordCount,
            AttachmentCount: attachmentCount,
            MissingEvidenceCount: missingEvidenceCount,
            CoveragePercent: coveragePercent);
    }

    private static string GetEvidenceCoverageClass(EvidenceCoverageRow row)
    {
        if (row.MissingEvidenceCount == 0 && row.AttachedRecordCount > 0)
        {
            return "of-badge of-badge-success";
        }

        if (row.MissingEvidenceCount > 0)
        {
            return "of-badge of-badge-warning";
        }

        return "of-badge of-badge-info";
    }

    private static string BuildDocumentIntakeDetailsUrl(int id)
    {
        return $"/document-intake/details/{id}";
    }

    private static bool IsClosedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsHighPriority(string? priority)
    {
        return string.Equals(priority, "High", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(priority, "Critical", StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static string GetPrioritySeverity(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "Critical",
            "high" => "Warning",
            _ => "Info"
        };
    }

    private static int GetSeveritySortOrder(string? severity)
    {
        return severity?.ToLowerInvariant() switch
        {
            "critical" => 1,
            "warning" => 2,
            "info" => 3,
            _ => 99
        };
    }

    private static int GetPrioritySortOrder(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => 1,
            "high" => 2,
            "medium" => 3,
            "low" => 4,
            _ => 99
        };
    }

    private static int GetRiskSortOrder(string? level)
    {
        return level?.ToLowerInvariant() switch
        {
            "critical" => 1,
            "high" => 2,
            "medium" => 3,
            "low" => 4,
            _ => 99
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "in progress" => "badge badge-info",
            "open" => "badge badge-warning",
            "new" => "badge badge-warning",
            "active" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetRiskLevelClass(string? level)
    {
        return level?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetComplianceClass(decimal complianceRate)
    {
        if (complianceRate >= 90)
        {
            return "badge badge-success";
        }

        if (complianceRate >= 70)
        {
            return "badge badge-warning";
        }

        return "badge badge-danger";
    }

    private static string GetIntakeStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "rejected" => "badge badge-danger",
            "entered" => "badge badge-info",
            "data checked" => "badge badge-info",
            "needs review" => "badge badge-warning",
            "saved" => "badge badge-muted",
            "received" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

