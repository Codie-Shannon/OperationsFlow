@page "/reports"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db

<PageTitle>Reports - OperationsFlow</PageTitle>

<div class="operations-dashboard">
    <PageIntro Eyebrow="Management Reporting"
               Title="Reports"
               Subtitle="Management-level reporting across work orders, corrective actions, safety/compliance, risk, document control, training compliance, document intake exports, and activity traceability.">
        <a class="btn btn-secondary" href="safety-meeting-pack">Safety Meeting Pack</a>
        <a class="btn btn-secondary" href="compliance-calendar">Compliance Calendar</a>
        <a class="btn btn-primary" href="data-quality">Data Quality</a>
    </PageIntro>

    <div class="page-purpose-note">
        <strong>Purpose:</strong> use this page to export safety/compliance data, review management summaries, and prepare CSVs for Excel, Power BI-style analysis, or meeting follow-up.
        <div class="status-guide">
            <span class="status-guide-item"><span class="badge badge-danger">Critical</span> Overdue or high-risk reporting item</span>
            <span class="status-guide-item"><span class="badge badge-warning">Warning</span> Needs review or follow-up</span>
            <span class="status-guide-item"><span class="badge badge-success">Current</span> Healthy reporting area</span>
        </div>
    </div>

    <section class="kpi-grid">
        <div class="kpi-card">
            <span class="kpi-label">Open Issues</span>
            <strong>@OpenIssueCount</strong>
            <span class="kpi-note">Open work, actions, risks, and expired training</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Open Work Orders</span>
            <strong>@WorkOrdersOpen</strong>
            <span class="kpi-note">@WorkOrdersTotal total work orders</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Open Actions</span>
            <strong>@CorrectiveActionsOpen</strong>
            <span class="kpi-note">@CorrectiveActionsOverdue overdue actions</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">High / Critical Risks</span>
            <strong>@HighCriticalRisks</strong>
            <span class="kpi-note">@RisksTotal total risk items</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Training Compliance</span>
            <strong>@TrainingComplianceRate.ToString("0.0")%</strong>
            <span class="kpi-note">@ExpiredTraining expired records</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">CSV Exports</span>
            <strong>6</strong>
            <span class="kpi-note">Safety/compliance export pack</span>
        </div>
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Safety / Compliance Export Pack</h2>
                    <p>
                        Use these exports for safety meetings, compliance reviews, management reporting,
                        follow-up planning, or Excel/Power BI-style analysis.
                    </p>
                </div>
            </div>

            <div class="export-grid">
                <a class="export-card" href="/exports/corrective-actions.csv">
                    <strong>Corrective Actions CSV</strong>
                    <span>Open, overdue, priority, owner, status, source, and follow-up notes.</span>
                </a>

                <a class="export-card" href="/exports/risk-register.csv">
                    <strong>Risk Register CSV</strong>
                    <span>Risk ratings, controls, owners, review dates, and overdue reviews.</span>
                </a>

                <a class="export-card" href="/exports/training.csv">
                    <strong>Training CSV</strong>
                    <span>Training status, expiry dates, required records, and compliance flags.</span>
                </a>

                <a class="export-card" href="/exports/document-reviews.csv">
                    <strong>Document Reviews CSV</strong>
                    <span>Controlled document owners, review dates, status, and due/overdue flags.</span>
                </a>

                <a class="export-card" href="/exports/activity-log.csv">
                    <strong>Activity Log CSV</strong>
                    <span>Record-level traceability for created, updated, and reviewed items.</span>
                </a>

                <a class="export-card" href="/exports/document-intake.csv">
                    <strong>Document Intake CSV</strong>
                    <span>Incoming document workflow items, target systems, owners, and due dates.</span>
                </a>
            </div>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Suggested Safety Meeting Flow</h2>
                    <p>Use this order when reviewing the compliance export pack.</p>
                </div>
            </div>

            <ol class="action-list">
                <li>Review overdue corrective actions and confirm owners/status.</li>
                <li>Review high/critical risks and confirm controls are still valid.</li>
                <li>Confirm expired or expiring training records have follow-up owners.</li>
                <li>Review overdue or due-soon document reviews.</li>
                <li>Export CSVs for meeting notes, Excel analysis, or management reporting.</li>
                <li>Check Activity Log for traceability after updates are made.</li>
            </ol>
        </div>
    </section>

    <section class="summary-grid">
        <ReportCountCard Title="Work Orders by Status"
                         Subtitle="Current operational workload grouped by status."
                         FirstColumn="Status"
                         Rows="WorkOrdersByStatus"
                         EmptyMessage="No work order data available." />

        <ReportCountCard Title="Corrective Actions by Priority"
                         Subtitle="Action workload grouped by priority level."
                         FirstColumn="Priority"
                         Rows="CorrectiveActionsByPriority"
                         EmptyMessage="No corrective action data available." />

        <ReportCountCard Title="Risks by Level"
                         Subtitle="Risk register items grouped by calculated risk level."
                         FirstColumn="Risk Level"
                         Rows="RisksByLevel"
                         EmptyMessage="No risk data available." />
    </section>

    <section class="summary-grid">
        <div class="report-card">
            <div class="panel-header">
                <div>
                    <h2>Training by Department</h2>
                    <p>Required training compliance grouped by department.</p>
                </div>
                <a class="btn btn-secondary" href="/exports/training.csv">Export Training</a>
            </div>

            @if (!TrainingByDepartment.Any())
            {
                <p class="empty-state">No training data available.</p>
            }
            else
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Department</th>
                            <th>Required</th>
                            <th>Current</th>
                            <th>Compliance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in TrainingByDepartment)
                        {
                            <tr>
                                <td>@row.Department</td>
                                <td>@row.RequiredCount</td>
                                <td>@row.CurrentCount</td>
                                <td>
                                    <span class="@GetComplianceClass(row.ComplianceRate)">
                                        @row.ComplianceRate.ToString("0.0")%
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="report-card">
            <div class="panel-header">
                <div>
                    <h2>Overdue Items by Owner</h2>
                    <p>Work orders and corrective actions currently overdue, grouped by owner.</p>
                </div>
            </div>

            @if (!OverdueItemsByOwner.Any())
            {
                <p class="empty-state">No overdue owner data available.</p>
            }
            else
            {
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Owner</th>
                            <th>Work Orders</th>
                            <th>Corrective Actions</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in OverdueItemsByOwner)
                        {
                            <tr>
                                <td>@row.Owner</td>
                                <td>@row.OverdueWorkOrders</td>
                                <td>@row.OverdueCorrectiveActions</td>
                                <td><span class="badge badge-danger">@row.TotalOverdue</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </section>

    <section class="report-card">
        <div class="panel-header">
            <div>
                <h2>Document Review Report</h2>
                <p>Controlled documents that are overdue for review or due soon.</p>
            </div>
            <div class="header-actions">
                <a class="btn btn-secondary" href="documents">View Documents</a>
                <a class="btn btn-primary" href="/exports/document-reviews.csv">Export Reviews</a>
            </div>
        </div>

        @if (!DocumentReviewRows.Any())
        {
            <p class="empty-state">No document review items require attention.</p>
        }
        else
        {
            <table class="report-table">
                <thead>
                    <tr>
                        <th>Document #</th>
                        <th>Title</th>
                        <th>Department</th>
                        <th>Owner</th>
                        <th>Next Review</th>
                        <th>Flag</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in DocumentReviewRows)
                    {
                        <tr>
                            <td>@item.DocumentNumber</td>
                            <td>@item.Title</td>
                            <td>@item.Department</td>
                            <td>@item.Owner</td>
                            <td>@item.NextReviewDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.IsReviewOverdue)
                                {
                                    <span class="badge badge-danger">Overdue</span>
                                }
                                else if (item.IsDueSoon)
                                {
                                    <span class="badge badge-warning">Due Soon</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">Current</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>

@code {
    private List<WorkOrder> workOrders = new();
    private List<CorrectiveAction> correctiveActions = new();
    private List<DocumentRecord> documents = new();
    private List<RiskItem> risks = new();
    private List<TrainingRecord> trainingRecords = new();

    private int WorkOrdersTotal => workOrders.Count;
    private int WorkOrdersOpen => workOrders.Count(x => !IsClosedStatus(x.Status));
    private int CorrectiveActionsOpen => correctiveActions.Count(x => !IsClosedStatus(x.Status));
    private int CorrectiveActionsOverdue => correctiveActions.Count(x => x.IsOverdue);
    private int RisksTotal => risks.Count;
    private int HighCriticalRisks => risks.Count(x => x.RiskLevel == "High" || x.RiskLevel == "Critical");
    private int ExpiredTraining => trainingRecords.Count(x => x.IsRequired && x.IsExpired);

    private int OpenIssueCount =>
        WorkOrdersOpen
        + CorrectiveActionsOpen
        + HighCriticalRisks
        + ExpiredTraining;

    private decimal TrainingComplianceRate
    {
        get
        {
            var required = trainingRecords.Where(x => x.IsRequired).ToList();

            if (!required.Any())
            {
                return 0;
            }

            var current = required.Count(x => !x.IsExpired);
            return (decimal)current / required.Count * 100;
        }
    }

    private List<ReportCountRow> WorkOrdersByStatus =>
        workOrders
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Status) ? "Unknown" : x.Status)
            .Select(x => new ReportCountRow(x.Key, x.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.Label)
            .ToList();

    private List<ReportCountRow> CorrectiveActionsByPriority =>
        correctiveActions
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Priority) ? "Unknown" : x.Priority)
            .Select(x => new ReportCountRow(x.Key, x.Count()))
            .OrderBy(x => GetPrioritySortOrder(x.Label))
            .ThenBy(x => x.Label)
            .ToList();

    private List<ReportCountRow> RisksByLevel =>
        risks
            .GroupBy(x => string.IsNullOrWhiteSpace(x.RiskLevel) ? "Unknown" : x.RiskLevel)
            .Select(x => new ReportCountRow(x.Key, x.Count()))
            .OrderBy(x => GetRiskSortOrder(x.Label))
            .ThenBy(x => x.Label)
            .ToList();

    private List<TrainingDepartmentReportRow> TrainingByDepartment
    {
        get
        {
            return trainingRecords
                .Where(x => x.IsRequired)
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Department) ? "Unknown" : x.Department)
                .Select(group =>
                {
                    var requiredCount = group.Count();
                    var currentCount = group.Count(x => !x.IsExpired);
                    var compliance = requiredCount == 0 ? 0 : (decimal)currentCount / requiredCount * 100;

                    return new TrainingDepartmentReportRow(
                        Department: group.Key,
                        RequiredCount: requiredCount,
                        CurrentCount: currentCount,
                        ComplianceRate: compliance
                    );
                })
                .OrderBy(x => x.ComplianceRate)
                .ThenBy(x => x.Department)
                .ToList();
        }
    }

    private List<OverdueOwnerReportRow> OverdueItemsByOwner
    {
        get
        {
            var overdueWorkOrders = workOrders
                .Where(x => x.IsOverdue)
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Owner) ? "Unassigned" : x.Owner)
                .ToDictionary(x => x.Key, x => x.Count());

            var overdueCorrectiveActions = correctiveActions
                .Where(x => x.IsOverdue)
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Owner) ? "Unassigned" : x.Owner)
                .ToDictionary(x => x.Key, x => x.Count());

            var owners = overdueWorkOrders.Keys
                .Union(overdueCorrectiveActions.Keys)
                .OrderBy(x => x)
                .ToList();

            return owners
                .Select(owner =>
                {
                    var workOrderCount = overdueWorkOrders.GetValueOrDefault(owner, 0);
                    var actionCount = overdueCorrectiveActions.GetValueOrDefault(owner, 0);

                    return new OverdueOwnerReportRow(
                        Owner: owner,
                        OverdueWorkOrders: workOrderCount,
                        OverdueCorrectiveActions: actionCount
                    );
                })
                .OrderByDescending(x => x.TotalOverdue)
                .ThenBy(x => x.Owner)
                .ToList();
        }
    }

    private List<DocumentRecord> DocumentReviewRows =>
        documents
            .Where(x => x.IsReviewOverdue || x.IsDueSoon)
            .OrderByDescending(x => x.IsReviewOverdue)
            .ThenBy(x => x.NextReviewDate)
            .ThenBy(x => x.Title)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        workOrders = await Db.WorkOrders
            .AsNoTracking()
            .ToListAsync();

        correctiveActions = await Db.CorrectiveActions
            .AsNoTracking()
            .ToListAsync();

        documents = await Db.DocumentRecords
            .AsNoTracking()
            .ToListAsync();

        risks = await Db.RiskItems
            .AsNoTracking()
            .ToListAsync();

        trainingRecords = await Db.TrainingRecords
            .AsNoTracking()
            .ToListAsync();
    }

    private static bool IsClosedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase);
    }

    private static int GetPrioritySortOrder(string? priority)
    {
        return priority?.ToLower() switch
        {
            "critical" => 1,
            "high" => 2,
            "medium" => 3,
            "low" => 4,
            _ => 99
        };
    }

    private static int GetRiskSortOrder(string? level)
    {
        return level?.ToLower() switch
        {
            "critical" => 1,
            "high" => 2,
            "medium" => 3,
            "low" => 4,
            _ => 99
        };
    }

    private static string GetComplianceClass(decimal complianceRate)
    {
        if (complianceRate >= 90)
        {
            return "badge badge-success";
        }

        if (complianceRate >= 70)
        {
            return "badge badge-warning";
        }

        return "badge badge-danger";
    }

    public record ReportCountRow(string Label, int Count);

    private record TrainingDepartmentReportRow(
        string Department,
        int RequiredCount,
        int CurrentCount,
        decimal ComplianceRate);

    private record OverdueOwnerReportRow(
        string Owner,
        int OverdueWorkOrders,
        int OverdueCorrectiveActions)
    {
        public int TotalOverdue => OverdueWorkOrders + OverdueCorrectiveActions;
    }
}