@page "/document-intake/create"
@using OperationsFlow.Data
@using OperationsFlow.Services
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake
@inject OperationsFlowDbContext Db
@inject ActivityLogService ActivityLogService
@inject NavigationManager Navigation

<PageTitle>Create Document Intake - OperationsFlow</PageTitle>

<PageHero Eyebrow="Admin Workflow"
          Title="Create Document Intake"
          Subtitle="Add an incoming document, email, PDF, form, supplier document, compliance record, or job paperwork item for review, entry, storage, and completion tracking."
          BadgeText="New Record"
          BadgeClass="of-badge-info">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/document-intake">Back to Intake</a>
        <a class="of-btn of-btn-secondary" href="/workload">Workload</a>
        <a class="of-btn of-btn-secondary" href="/reminders">Reminders</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="📥">
    <p>
        Use this page to capture incoming admin/document work before it disappears into email,
        folders, paper piles, or someone’s memory. Once saved, the item appears in Document Intake,
        Workload, Reminders, Reports, Data Quality, and Activity Log.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Record Type"
                Value="DI"
                Detail="Document intake workflow"
                Icon="📋" />

    <MetricCard Title="Default Status"
                Value="@documentIntake.Status"
                Detail="New records start as received"
                Icon="📥"
                Tone="info" />

    <MetricCard Title="Default Priority"
                Value="@documentIntake.Priority"
                Detail="Adjust if the record is urgent"
                Icon="⚡"
                Tone="@GetPriorityTone(documentIntake.Priority)" />

    <MetricCard Title="Due Date"
                Value="@documentIntake.DueDate.ToString("dd MMM")"
                Detail="@documentIntake.DueDate.ToString("yyyy")"
                Icon="📅"
                Tone="success" />
</MetricGrid>

<InfoPanel Title="Document Intake Workflow" Subtitle="What this record is expected to track.">
    <ChildContent>
        <div class="of-two-column-grid">
            <GuidanceNote Title="Record should answer" Icon="✅" Tone="success">
                <ul>
                    <li>Where did the document come from?</li>
                    <li>What type of document or request is it?</li>
                    <li>Who owns the next processing step?</li>
                    <li>Which target system or folder does it belong in?</li>
                    <li>Is it received, saved, checked, entered, completed, or rejected?</li>
                </ul>
            </GuidanceNote>

            <GuidanceNote Title="Before saving" Icon="💡" Tone="info">
                <ul>
                    <li>Use a clear document name that can be recognised later.</li>
                    <li>Assign one owner so workload and reminders stay accurate.</li>
                    <li>Pick the target system so the processing destination is clear.</li>
                    <li>Add notes explaining the current state or next step.</li>
                    <li>Use a realistic due date so overdue work is visible.</li>
                </ul>
            </GuidanceNote>
        </div>
    </ChildContent>
</InfoPanel>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <GuidanceNote Title="Save blocked" Icon="⚠️" Tone="danger">
        <p>@errorMessage</p>
    </GuidanceNote>
}

<InfoPanel Title="New Document Intake" Subtitle="Complete the fields below and save the record.">
    <ChildContent>
        <EditForm Model="documentIntake" OnSubmit="SaveDocumentIntake">
            <div class="of-form-grid">
                <div class="of-form-field of-form-field--wide">
                    <label for="documentName">Document Name</label>
                    <InputText id="documentName" class="of-input" @bind-Value="documentIntake.DocumentName" />
                </div>

                <div class="of-form-field">
                    <label for="receivedDate">Received Date</label>
                    <InputDate id="receivedDate" class="of-input" @bind-Value="documentIntake.ReceivedDate" />
                </div>

                <div class="of-form-field">
                    <label for="receivedFrom">Received From</label>
                    <InputText id="receivedFrom" class="of-input" @bind-Value="documentIntake.ReceivedFrom" />
                </div>

                <div class="of-form-field">
                    <label for="sourceType">Source Type</label>
                    <InputSelect id="sourceType" class="of-select" @bind-Value="documentIntake.SourceType">
                        @foreach (var sourceType in SourceTypeOptions)
                        {
                            <option value="@sourceType">@sourceType</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="documentType">Document Type</label>
                    <InputSelect id="documentType" class="of-select" @bind-Value="documentIntake.DocumentType">
                        @foreach (var documentType in DocumentTypeOptions)
                        {
                            <option value="@documentType">@documentType</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="assignedTo">Assigned To</label>
                    <InputText id="assignedTo" class="of-input" @bind-Value="documentIntake.AssignedTo" />
                </div>

                <div class="of-form-field">
                    <label for="targetSystem">Target System</label>
                    <InputSelect id="targetSystem" class="of-select" @bind-Value="documentIntake.TargetSystem">
                        @foreach (var targetSystem in TargetSystemOptions)
                        {
                            <option value="@targetSystem">@targetSystem</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="priority">Priority</label>
                    <InputSelect id="priority" class="of-select" @bind-Value="documentIntake.Priority">
                        @foreach (var priority in PriorityOptions)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="status">Status</label>
                    <InputSelect id="status" class="of-select" @bind-Value="documentIntake.Status">
                        @foreach (var status in StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="dueDate">Due Date</label>
                    <InputDate id="dueDate" class="of-input" @bind-Value="documentIntake.DueDate" />
                </div>

                <div class="of-form-field">
                    <label for="completedDate">Completed Date</label>
                    <InputDate id="completedDate" class="of-input" @bind-Value="documentIntake.CompletedDate" />
                </div>

                <div class="of-form-field of-form-field--full">
                    <label for="notes">Notes</label>
                    <InputTextArea id="notes" class="of-textarea" @bind-Value="documentIntake.Notes" />
                </div>
            </div>

            <div class="of-form-actions">
                <button type="button" class="of-btn of-btn-secondary" @onclick="Cancel">Cancel</button>
                <button type="submit" class="of-btn of-btn-primary">Save Intake Record</button>
            </div>
        </EditForm>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="After Saving" Subtitle="This record becomes part of the wider workflow.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Document Intake</strong>
                <span>The saved record can be searched, filtered, edited, and reviewed.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Workload</strong>
                <span>The assigned person receives workload pressure and due-date visibility.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Reminders</strong>
                <span>Overdue, due-soon, and needs-review records appear in Reminder Centre.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Traceability</strong>
                <span>The Activity Log records that this intake item was created.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Prototype Boundary" Icon="🧱" Tone="warning">
    <ul>
        <li>This page tracks document workflow metadata.</li>
        <li>It does not upload or store the actual document file yet.</li>
        <li>It does not currently write to SharePoint, Xero, Cin7, or WorkflowMax.</li>
        <li>A production version would add permissions, file storage, integrations, and audit rules.</li>
    </ul>
</GuidanceNote>

@code {
    private DocumentIntakeModel documentIntake = new();
    private string errorMessage = "";

    private readonly List<string> SourceTypeOptions = new()
    {
        "Email",
        "PDF",
        "Scanned Document",
        "Supplier Document",
        "Customer Request",
        "Internal Form"
    };

    private readonly List<string> DocumentTypeOptions = new()
    {
        "Supplier Invoice",
        "Supplier Statement",
        "Purchase Order",
        "Quote Request",
        "Delivery Docket",
        "Compliance Document",
        "Incident Evidence",
        "Specification",
        "Training Certificate",
        "Job Paperwork"
    };

    private readonly List<string> TargetSystemOptions = new()
    {
        "SharePoint",
        "Xero",
        "Cin7",
        "WorkflowMax",
        "Email Folder",
        "Internal System"
    };

    private readonly List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private readonly List<string> StatusOptions = new()
    {
        "Received",
        "Saved",
        "Needs Review",
        "Data Checked",
        "Entered",
        "Completed",
        "Rejected"
    };

    protected override void OnInitialized()
    {
        documentIntake = new DocumentIntakeModel
        {
            DocumentName = "",
            ReceivedDate = DateTime.Today,
            ReceivedFrom = "",
            SourceType = "Email",
            DocumentType = "Supplier Invoice",
            AssignedTo = "",
            TargetSystem = "SharePoint",
            Status = "Received",
            Priority = "Medium",
            DueDate = DateTime.Today.AddDays(7),
            CompletedDate = null,
            Notes = ""
        };
    }

    private async Task SaveDocumentIntake()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(documentIntake.DocumentName))
        {
            errorMessage = "Please enter a document name.";
            return;
        }

        if (string.IsNullOrWhiteSpace(documentIntake.ReceivedFrom))
        {
            errorMessage = "Please enter who the document was received from.";
            return;
        }

        if (string.IsNullOrWhiteSpace(documentIntake.AssignedTo))
        {
            errorMessage = "Please enter who this document is assigned to.";
            return;
        }

        if (documentIntake.DueDate.Date < documentIntake.ReceivedDate.Date)
        {
            errorMessage = "Due date cannot be before received date.";
            return;
        }

        if (IsCompletedStatus(documentIntake.Status) && documentIntake.CompletedDate == null)
        {
            documentIntake.CompletedDate = DateTime.Today;
        }

        if (!IsCompletedStatus(documentIntake.Status))
        {
            documentIntake.CompletedDate = null;
        }

        if (string.IsNullOrWhiteSpace(documentIntake.Notes))
        {
            documentIntake.Notes = BuildDefaultNotes();
        }

        Db.DocumentIntakeItems.Add(documentIntake);
        await Db.SaveChangesAsync();

        await ActivityLogService.LogAsync(
            moduleName: "Document Intake",
            recordId: documentIntake.Id,
            recordReference: $"DI-{documentIntake.Id}",
            actionType: "Created",
            description: BuildCreatedDescription());

        Navigation.NavigateTo("/document-intake");
    }

    private string BuildCreatedDescription()
    {
        return $"Created document intake DI-{documentIntake.Id}: {documentIntake.DocumentName}. Assigned to {documentIntake.AssignedTo}, target system {documentIntake.TargetSystem}, status {documentIntake.Status}.";
    }

    private string BuildDefaultNotes()
    {
        return "Initial intake record created."
            + Environment.NewLine + $"Source type: {documentIntake.SourceType}"
            + Environment.NewLine + $"Document type: {documentIntake.DocumentType}"
            + Environment.NewLine + $"Received from: {documentIntake.ReceivedFrom}"
            + Environment.NewLine + $"Target system: {documentIntake.TargetSystem}"
            + Environment.NewLine + "Next step: review, save, enter, complete, or reject the document.";
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/document-intake");
    }

    private static bool IsCompletedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetPriorityTone(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "danger",
            "high" => "warning",
            "medium" => "info",
            "low" => "default",
            _ => "default"
        };
    }
}