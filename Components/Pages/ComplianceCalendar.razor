@page "/compliance-calendar"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db

<PageTitle>Compliance Calendar - OperationsFlow</PageTitle>

<PageHero Eyebrow="Compliance" Title="Compliance Calendar" Subtitle="Plan overdue, due-this-week, next-30-days, and future compliance follow-up before it becomes missed work." BadgeText="@($"{OverdueItems.Count} overdue")" BadgeClass="@(OverdueItems.Any() ? "of-badge-danger" : "of-badge-success")">
    <Actions><a class="of-btn of-btn-secondary" href="/compliance-dashboard">Safety Overview</a><a class="of-btn of-btn-secondary" href="/safety-meeting-pack">Meeting Pack</a><a class="of-btn of-btn-secondary" href="/reports">Reports</a></Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="📅"><p>Use this page to see what is overdue, what is due this week, and what compliance work is coming up across corrective actions, risk reviews, training expiries, and document reviews.</p></PurposeNote>

<MetricGrid>
    <MetricCard Title="Overdue" Value="@OverdueItems.Count.ToString()" Detail="Needs immediate review" Icon="🚨" Tone="danger" />
    <MetricCard Title="Due This Week" Value="@DueThisWeekItems.Count.ToString()" Detail="Next 7 days" Icon="⏰" Tone="warning" />
    <MetricCard Title="Due Next 30 Days" Value="@DueNext30DaysItems.Count.ToString()" Detail="Upcoming compliance work" Icon="📆" Tone="info" />
    <MetricCard Title="Future Items" Value="@FutureItems.Count.ToString()" Detail="Later review dates" Icon="✅" Tone="success" />
</MetricGrid>

<InfoPanel Title="How To Use This View" Subtitle="Plan safety/compliance follow-up before items become overdue."><ChildContent><ol class="of-review-steps"><li>Start with overdue items and confirm current progress.</li><li>Review items due this week and assign follow-up owners.</li><li>Check the next 30 days for training, document reviews, risk reviews, and action due dates.</li><li>Use the Safety Meeting Pack for discussion and Reports for exports.</li></ol></ChildContent></InfoPanel>

<InfoPanel Title="Planning Focus" Subtitle="Current compliance planning pressure based on saved demo data."><ChildContent><ul>@if(OverdueItems.Any()){<li>@OverdueItems.Count overdue item(s) need immediate follow-up.</li>}@if(DueThisWeekItems.Any()){<li>@DueThisWeekItems.Count item(s) are due within the next 7 days.</li>}@if(DueNext30DaysItems.Any()){<li>@DueNext30DaysItems.Count item(s) are due within the next 30 days.</li>}@if(!OverdueItems.Any()&&!DueThisWeekItems.Any()&&!DueNext30DaysItems.Any()){<li>No urgent compliance calendar pressure found. Review future items for planning.</li>}</ul></ChildContent></InfoPanel>

<TableCard Title="Compliance Calendar Items" Subtitle="@($"Showing {CalendarItems.Count} compliance planning item(s).")" IsEmpty="@(!CalendarItems.Any())" EmptyTitle="No calendar items" EmptyMessage="No compliance due dates are available yet.">
    <ChildContent><table><thead><tr><th>Flag</th><th>Type</th><th>Title</th><th>Owner</th><th>Department</th><th>Date</th><th>Priority</th><th>Open</th></tr></thead><tbody>@foreach(var item in CalendarItems.OrderBy(x=>x.Date)){<tr><td><span class="@GetStatusClass(item)">@GetFlagLabel(item)</span></td><td>@item.Type</td><td><strong>@item.Title</strong><div class="of-muted-text">@item.Source</div></td><td>@item.Owner</td><td>@item.Department</td><td>@item.Date.ToString("dd MMM yyyy")</td><td><span class="@GetPriorityClass(item.Priority)">@item.Priority</span></td><td><a class="of-card-link" href="/@item.Url">Open</a></td></tr>}</tbody></table></ChildContent>
</TableCard>

<GuidanceNote Title="Review Notes" Icon="💡" Tone="info"><ul><li>Overdue items should be checked before due-soon work.</li><li>This view combines compliance due dates from multiple modules.</li><li>Production reminders could later be driven by Power Automate, Teams, Outlook, or Microsoft Lists.</li></ul></GuidanceNote>

@code { private List<CorrectiveAction> correctiveActions=new(); private List<RiskItem> risks=new(); private List<TrainingRecord> trainingRecords=new(); private List<DocumentRecord> documents=new(); private List<CalendarItem> CalendarItems{get;set;}=new();
private List<CalendarItem> OverdueItems=>CalendarItems.Where(x=>x.Date.Date<DateTime.Today).OrderBy(x=>x.Date).ToList(); private List<CalendarItem> DueThisWeekItems=>CalendarItems.Where(x=>x.Date.Date>=DateTime.Today&&x.Date.Date<=DateTime.Today.AddDays(7)).OrderBy(x=>x.Date).ToList(); private List<CalendarItem> DueNext30DaysItems=>CalendarItems.Where(x=>x.Date.Date>DateTime.Today.AddDays(7)&&x.Date.Date<=DateTime.Today.AddDays(30)).OrderBy(x=>x.Date).ToList(); private List<CalendarItem> FutureItems=>CalendarItems.Where(x=>x.Date.Date>DateTime.Today.AddDays(30)).OrderBy(x=>x.Date).Take(20).ToList();
protected override async Task OnInitializedAsync(){correctiveActions=await Db.CorrectiveActions.AsNoTracking().ToListAsync();risks=await Db.RiskItems.AsNoTracking().ToListAsync();trainingRecords=await Db.TrainingRecords.AsNoTracking().ToListAsync();documents=await Db.DocumentRecords.AsNoTracking().ToListAsync();BuildCalendarItems();}
private void BuildCalendarItems(){var items=new List<CalendarItem>(); items.AddRange(correctiveActions.Where(x=>!IsClosedStatus(x.Status)).Select(x=>new CalendarItem("Corrective Action",x.Title,SafeText(x.Owner,"Unassigned"),SafeText(x.Department,x.Site),x.DueDate,"Due",x.IsOverdue?"Overdue":SafeText(x.Status,"Open"),SafeText(x.Priority,"Unknown"),SafeText(x.Source,"Manual / Internal"),"corrective-actions"))); items.AddRange(risks.Select(x=>new CalendarItem("Risk Review",x.Title,SafeText(x.Owner,"Unassigned"),SafeText(x.Department,x.Site),x.ReviewDate,"Review",x.IsReviewOverdue?"Overdue":"Review Scheduled",x.RiskLevel,SafeText(x.Hazard,"Risk Register"),"risk-register"))); items.AddRange(trainingRecords.Where(x=>x.IsRequired).Select(x=>new CalendarItem("Training",x.TrainingName,SafeText(x.StaffName,"Unknown"),SafeText(x.Department,x.Site),x.ExpiryDate,"Expiry",x.IsExpired?"Expired":x.IsExpiringSoon?"Expiring Soon":SafeText(x.Status,"Current"),x.IsExpired?"High":x.IsExpiringSoon?"Medium":"Low",SafeText(x.Notes,"Training Compliance"),"training"))); items.AddRange(documents.Select(x=>new CalendarItem("Document Review",x.Title,SafeText(x.Owner,"Unassigned"),SafeText(x.Department,x.DocumentType),x.NextReviewDate,"Review",x.IsReviewOverdue?"Overdue":x.IsDueSoon?"Due Soon":SafeText(x.Status,"Current"),x.IsReviewOverdue?"High":x.IsDueSoon?"Medium":"Low",SafeText(x.DocumentNumber,"Document Control"),"documents"))); CalendarItems=items;}
private static bool IsClosedStatus(string? status)=>string.Equals(status,"Completed",StringComparison.OrdinalIgnoreCase)||string.Equals(status,"Closed",StringComparison.OrdinalIgnoreCase)||string.Equals(status,"Rejected",StringComparison.OrdinalIgnoreCase); private static string SafeText(string? value,string fallback)=>string.IsNullOrWhiteSpace(value)?fallback:value; private static string GetFlagLabel(CalendarItem item)=>item.Date.Date<DateTime.Today?"Overdue":item.Date.Date<=DateTime.Today.AddDays(7)?"Due This Week":item.Date.Date<=DateTime.Today.AddDays(30)?"Due Soon":"Future"; private static string GetStatusClass(CalendarItem item)=>item.Date.Date<DateTime.Today?"badge badge-danger":item.Date.Date<=DateTime.Today.AddDays(7)?"badge badge-warning":"badge badge-info"; private static string GetPriorityClass(string? priority)=>priority?.ToLowerInvariant() switch{"critical"=>"badge badge-danger","high"=>"badge badge-warning","medium"=>"badge badge-info","low"=>"badge badge-muted",_=>"badge badge-muted"}; public record CalendarItem(string Type,string Title,string Owner,string Department,DateTime Date,string DateLabel,string Status,string Priority,string Source,string Url); }
