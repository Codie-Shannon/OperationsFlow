@page "/work-orders/edit/{Id:int}"

@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services

@inject OperationsFlowDbContext Db
@inject ActivityLogService ActivityLogService
@inject NavigationManager Navigation

<PageTitle>Edit Work Order - OperationsFlow</PageTitle>

<div class="page-shell module-page work-order-edit-page">
    <section class="module-header">
        <div>
            <p class="eyebrow dark">Operations</p>
            <h1>Edit Work Order</h1>
            <p>
                Update work order owner, site, department, type, priority, status,
                due date, and notes.
            </p>
        </div>

        <div class="module-header-stat">
            <span>Editing</span>
            <strong>@DisplayReference</strong>
        </div>
    </section>

    @if (isLoading)
    {
        <section class="table-card">
            <p>Loading work order...</p>
        </section>
    }
    else if (workOrder == null)
    {
        <section class="table-card">
            <h2>Work order could not be found.</h2>

            <button class="btn btn-secondary" type="button" @onclick="BackToReturnPage">
                Back
            </button>
        </section>
    }
    else
    {
        <section class="page-purpose-note">
            <strong>Purpose:</strong> use this page to keep operational follow-up current. Changes made here feed
            Workload, Reminders, Reports, Data Quality, Work Order Details, and Activity Log.
        </section>

        <section class="summary-grid">
            <div class="summary-panel">
                <div class="panel-header">
                    <div>
                        <h2>Current Work Order State</h2>
                        <p>Quick review before saving changes.</p>
                    </div>

                    <span class="@GetStatusClass(workOrder.Status)">
                        @workOrder.Status
                    </span>
                </div>

                <div class="detail-grid">
                    <div>
                        <span>Work Order</span>
                        <strong>@workOrder.WorkOrderNumber</strong>
                    </div>

                    <div>
                        <span>Owner</span>
                        <strong>@DisplayText(workOrder.Owner)</strong>
                    </div>

                    <div>
                        <span>Priority</span>
                        <strong>
                            <span class="@GetPriorityClass(workOrder.Priority)">
                                @workOrder.Priority
                            </span>
                        </strong>
                    </div>

                    <div>
                        <span>Due Date</span>
                        <strong>@workOrder.DueDate.ToString("dd MMM yyyy")</strong>
                    </div>
                </div>
            </div>

            <div class="summary-panel">
                <div class="panel-header">
                    <div>
                        <h2>Before Saving</h2>
                        <p>Use this quick check to keep the record useful.</p>
                    </div>
                </div>

                <ul class="review-list">
                    <li>Confirm the owner is still the person responsible for the next action.</li>
                    <li>Update status if the work has moved forward.</li>
                    <li>Use the due date to show the next realistic follow-up point.</li>
                    <li>Add notes explaining progress, blockers, decisions, or closure evidence.</li>
                    <li>Completed or closed work should have enough notes to explain the outcome.</li>
                </ul>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <section class="table-card work-order-edit-card">
            <div class="form-grid">
                <div class="form-field">
                    <label>Work Order Number</label>
                    <input class="form-control" @bind="workOrder.WorkOrderNumber" />

                    <FormFieldGuide Title="Work order number guidance"
                                    Text="Keep the work order number unique so reports, activity history, and links stay clear." />
                </div>

                <div class="form-field full-width">
                    <label>Title</label>
                    <input class="form-control" @bind="workOrder.Title" />

                    <FormFieldGuide Title="Title guidance"
                                    Text="Use a short clear title that explains the work, such as repair roller door sensor, check spill kit contents, or investigate dispatch scanner issue." />
                </div>

                <div class="form-field">
                    <label>Site</label>
                    <select class="form-select" @bind="workOrder.Site">
                        @foreach (var site in SiteOptions)
                        {
                            <option value="@site">@site</option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label>Department</label>
                    <select class="form-select" @bind="workOrder.Department">
                        @foreach (var department in DepartmentOptions)
                        {
                            <option value="@department">@department</option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label>Owner</label>
                    <input class="form-control" @bind="workOrder.Owner" />

                    <FormFieldGuide Title="Owner guidance"
                                    Text="Assign one clear owner so this work order appears correctly in workload, reminders, reports, and data quality checks." />
                </div>

                <div class="form-field">
                    <label>Type</label>
                    <select class="form-select" @bind="workOrder.Type">
                        @foreach (var type in TypeOptions)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label>Priority</label>
                    <select class="form-select" @bind="workOrder.Priority">
                        @foreach (var priority in PriorityOptions)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </select>
                </div>

                <div class="form-field">
                    <label>Status</label>
                    <select class="form-select" @bind="workOrder.Status">
                        @foreach (var status in StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
            </div>

            <StatusFlowGuide Title="Work order status flow"
                             Description="Use statuses consistently so operational work can be tracked through open, active, completed, and closed states."
                             Steps="WorkOrderStatusSteps" />

            <div class="form-grid form-grid-spaced">
                <div class="form-field">
                    <label>Created Date</label>
                    <input class="form-control" type="date" @bind="workOrder.CreatedDate" />
                </div>

                <div class="form-field">
                    <label>Due Date</label>
                    <input class="form-control" type="date" @bind="workOrder.DueDate" />

                    <FormFieldGuide Title="Due date guidance"
                                    Text="Use the next realistic follow-up date. Overdue work orders appear in Workload, Reminders, Reports, Data Quality, and management review pages." />
                </div>

                <div class="form-field full-width">
                    <label>Notes</label>
                    <textarea class="form-control" rows="8" @bind="workOrder.Notes"></textarea>

                    <div class="guidance-card">
                        <div>
                            <strong>Work order note guidance</strong>
                            <p>
                                Good work order notes should explain the current work state,
                                not just repeat the title.
                            </p>

                            <ul>
                                @foreach (var item in WorkOrderNoteGuideItems)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <section class="activity-history-panel">
                <div class="section-heading-row">
                    <div>
                        <h2>Activity History</h2>
                        <p>
                            Record-level traceability for this work order. This helps reviewers see when the item was
                            created, updated, reviewed, completed, or changed.
                        </p>
                    </div>

                    <div class="activity-count-card">
                        <span>Events</span>
                        <strong>@activityHistory.Count</strong>
                    </div>
                </div>

                @if (activityHistory.Count == 0)
                {
                    <div class="empty-state">
                        <strong>No activity history yet.</strong>
                        <p>
                            Save this work order to create a reviewed or updated activity event.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="data-table activity-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Action</th>
                                    <th>Description</th>
                                    <th>Created By</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var activity in activityHistory)
                                {
                                    <tr>
                                        <td>@activity.CreatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                        <td>
                                            <span class="@GetActivityBadgeClass(activity.ActionType)">
                                                @activity.ActionType
                                            </span>
                                        </td>
                                        <td>@activity.Description</td>
                                        <td>@activity.CreatedBy</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            <div class="form-actions">
                <button class="btn btn-secondary" type="button" @onclick="BackToReturnPage">
                    Cancel
                </button>

                <button class="btn btn-secondary" type="button" @onclick="GoToDetails">
                    View Details
                </button>

                <button class="btn btn-primary" type="button" @onclick="SaveWorkOrder">
                    Save Changes
                </button>
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private WorkOrder? workOrder;
    private List<ActivityLog> activityHistory = new();

    private bool isLoading = true;
    private string errorMessage = "";

    private string originalWorkOrderNumber = "";
    private string originalTitle = "";
    private string originalSite = "";
    private string originalDepartment = "";
    private string originalOwner = "";
    private string originalType = "";
    private string originalPriority = "";
    private string originalStatus = "";
    private DateTime originalCreatedDate;
    private DateTime originalDueDate;
    private string originalNotes = "";

    private string DisplayReference => workOrder == null ? "WO" : workOrder.WorkOrderNumber;

    private List<string> SiteOptions = new()
    {
        "Main Workshop",
        "Yard",
        "Admin Office",
        "Warehouse",
        "Dispatch Bay"
    };

    private List<string> DepartmentOptions = new()
    {
        "Operations",
        "Health & Safety",
        "Admin",
        "Maintenance",
        "Warehouse",
        "Dispatch",
        "Quality"
    };

    private List<string> TypeOptions = new()
    {
        "Maintenance",
        "Repair",
        "Supply",
        "Admin",
        "Compliance",
        "Inspection",
        "Preventative Maintenance",
        "Site Improvement",
        "IT Support"
    };

    private List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private List<string> StatusOptions = new()
    {
        "Open",
        "In Progress",
        "Completed",
        "Closed"
    };

    private static readonly IReadOnlyList<string> WorkOrderNoteGuideItems = new[]
    {
        "What issue, request, or task created this work order?",
        "Where is the work located?",
        "What has already been checked or completed?",
        "What is still blocking completion?",
        "If completed or closed, what confirms the outcome?"
    };

    private static readonly IReadOnlyList<StatusFlowGuide.StatusFlowStep> WorkOrderStatusSteps = new[]
    {
        new StatusFlowGuide.StatusFlowStep("Open", "Work has been raised but has not started yet.", "badge badge-warning"),
        new StatusFlowGuide.StatusFlowStep("In Progress", "Owner is actively working through the task.", "badge badge-info"),
        new StatusFlowGuide.StatusFlowStep("Completed", "Work is finished and ready for review or closure.", "badge badge-success"),
        new StatusFlowGuide.StatusFlowStep("Closed", "Final review is complete and no further follow-up is needed.", "badge badge-success")
    };

    protected override async Task OnInitializedAsync()
    {
        workOrder = await Db.WorkOrders
            .FirstOrDefaultAsync(x => x.Id == Id);

        if (workOrder != null)
        {
            CaptureOriginalValues();
            await LoadActivityHistory();
        }

        isLoading = false;
    }

    private async Task SaveWorkOrder()
    {
        errorMessage = "";

        if (workOrder == null)
        {
            errorMessage = "Work order could not be saved because it was not loaded.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.WorkOrderNumber))
        {
            errorMessage = "Please enter a work order number.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.Title))
        {
            errorMessage = "Please enter a title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.Owner))
        {
            errorMessage = "Please enter an owner.";
            return;
        }

        if (workOrder.DueDate < workOrder.CreatedDate)
        {
            errorMessage = "Due date cannot be before created date.";
            return;
        }

        var duplicateNumberExists = await Db.WorkOrders
            .AnyAsync(x =>
                x.Id != workOrder.Id &&
                x.WorkOrderNumber == workOrder.WorkOrderNumber);

        if (duplicateNumberExists)
        {
            errorMessage = "Another work order already uses this work order number.";
            return;
        }

        if (string.IsNullOrWhiteSpace(workOrder.Notes))
        {
            workOrder.Notes = BuildDefaultNotes();
        }

        var changeDescriptions = BuildChangeDescriptions();

        await Db.SaveChangesAsync();

        if (changeDescriptions.Any())
        {
            await ActivityLogService.LogAsync(
                moduleName: "Work Orders",
                recordId: workOrder.Id,
                recordReference: workOrder.WorkOrderNumber,
                actionType: GetSaveActionType(changeDescriptions),
                description: $"Updated work order {workOrder.WorkOrderNumber}: {string.Join("; ", changeDescriptions)}."
            );
        }
        else
        {
            await ActivityLogService.LogAsync(
                moduleName: "Work Orders",
                recordId: workOrder.Id,
                recordReference: workOrder.WorkOrderNumber,
                actionType: "Reviewed",
                description: $"Reviewed work order {workOrder.WorkOrderNumber} with no tracked field changes."
            );
        }

        CaptureOriginalValues();
        await LoadActivityHistory();

        BackToReturnPage();
    }

    private async Task LoadActivityHistory()
    {
        if (workOrder == null)
        {
            activityHistory = new List<ActivityLog>();
            return;
        }

        activityHistory = await Db.ActivityLogs
            .AsNoTracking()
            .Where(x =>
                x.ModuleName == "Work Orders" &&
                x.RecordId == workOrder.Id)
            .OrderByDescending(x => x.CreatedDate)
            .ToListAsync();
    }

    private List<string> BuildChangeDescriptions()
    {
        var changes = new List<string>();

        if (workOrder == null)
        {
            return changes;
        }

        if (!string.Equals(originalWorkOrderNumber, workOrder.WorkOrderNumber, StringComparison.Ordinal))
        {
            changes.Add($"work order number changed from '{originalWorkOrderNumber}' to '{workOrder.WorkOrderNumber}'");
        }

        if (!string.Equals(originalTitle, workOrder.Title, StringComparison.Ordinal))
        {
            changes.Add($"title changed from '{originalTitle}' to '{workOrder.Title}'");
        }

        if (!string.Equals(originalSite, workOrder.Site, StringComparison.Ordinal))
        {
            changes.Add($"site changed from '{originalSite}' to '{workOrder.Site}'");
        }

        if (!string.Equals(originalDepartment, workOrder.Department, StringComparison.Ordinal))
        {
            changes.Add($"department changed from '{originalDepartment}' to '{workOrder.Department}'");
        }

        if (!string.Equals(originalOwner, workOrder.Owner, StringComparison.Ordinal))
        {
            changes.Add($"owner changed from '{originalOwner}' to '{workOrder.Owner}'");
        }

        if (!string.Equals(originalType, workOrder.Type, StringComparison.Ordinal))
        {
            changes.Add($"type changed from '{originalType}' to '{workOrder.Type}'");
        }

        if (!string.Equals(originalPriority, workOrder.Priority, StringComparison.Ordinal))
        {
            changes.Add($"priority changed from '{originalPriority}' to '{workOrder.Priority}'");
        }

        if (!string.Equals(originalStatus, workOrder.Status, StringComparison.Ordinal))
        {
            changes.Add($"status changed from '{originalStatus}' to '{workOrder.Status}'");
        }

        if (originalCreatedDate.Date != workOrder.CreatedDate.Date)
        {
            changes.Add($"created date changed from {originalCreatedDate:dd MMM yyyy} to {workOrder.CreatedDate:dd MMM yyyy}");
        }

        if (originalDueDate.Date != workOrder.DueDate.Date)
        {
            changes.Add($"due date changed from {originalDueDate:dd MMM yyyy} to {workOrder.DueDate:dd MMM yyyy}");
        }

        if (!string.Equals(originalNotes?.Trim(), workOrder.Notes?.Trim(), StringComparison.Ordinal))
        {
            changes.Add("notes updated");
        }

        return changes;
    }

    private string BuildDefaultNotes()
    {
        if (workOrder == null)
        {
            return "";
        }

        return "Work order reviewed." + Environment.NewLine
            + $"Site: {workOrder.Site}" + Environment.NewLine
            + $"Department: {workOrder.Department}" + Environment.NewLine
            + $"Type: {workOrder.Type}" + Environment.NewLine
            + $"Owner: {workOrder.Owner}" + Environment.NewLine
            + "Next step: review, progress, complete, or close the work order.";
    }

    private void CaptureOriginalValues()
    {
        if (workOrder == null)
        {
            return;
        }

        originalWorkOrderNumber = workOrder.WorkOrderNumber;
        originalTitle = workOrder.Title;
        originalSite = workOrder.Site;
        originalDepartment = workOrder.Department;
        originalOwner = workOrder.Owner;
        originalType = workOrder.Type;
        originalPriority = workOrder.Priority;
        originalStatus = workOrder.Status;
        originalCreatedDate = workOrder.CreatedDate;
        originalDueDate = workOrder.DueDate;
        originalNotes = workOrder.Notes ?? "";
    }

    private static string GetSaveActionType(List<string> changes)
    {
        var statusChange = changes.FirstOrDefault(x => x.StartsWith("status changed", StringComparison.OrdinalIgnoreCase));

        if (statusChange != null &&
            (statusChange.Contains("Completed", StringComparison.OrdinalIgnoreCase) ||
             statusChange.Contains("Closed", StringComparison.OrdinalIgnoreCase)))
        {
            return "Completed";
        }

        return "Updated";
    }

    private void GoToDetails()
    {
        if (workOrder == null)
        {
            BackToReturnPage();
            return;
        }

        Navigation.NavigateTo($"/work-orders/details/{workOrder.Id}");
    }

    private void BackToReturnPage()
    {
        var fallbackUrl = "/work-orders";

        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        if (!ReturnUrl.StartsWith("/"))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        Navigation.NavigateTo(ReturnUrl);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "in progress" => "badge badge-info",
            "open" => "badge badge-warning",
            "new" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static string GetActivityBadgeClass(string? actionType)
    {
        return actionType?.ToLowerInvariant() switch
        {
            "created" => "badge badge-success",
            "updated" => "badge badge-info",
            "reviewed" => "badge badge-secondary",
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "deleted" => "badge badge-danger",
            _ => "badge badge-secondary"
        };
    }
}