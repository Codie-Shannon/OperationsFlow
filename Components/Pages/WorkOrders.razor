@page "/work-orders"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@inject OperationsFlowDbContext Db
@inject DocumentAttachmentService AttachmentService
@inject LocalCurrentUserService CurrentUserService

<PageTitle>Work Orders - OperationsFlow</PageTitle>

<PageHero Eyebrow="Operations"
          Title="Work Orders"
          Subtitle="Track operational requests by site, department, owner, priority, status, and due date."
          BadgeText="@($"{OpenCount} open")"
          BadgeClass="of-badge-info">
    <Actions>
        @if (CurrentUserService.CanEditWorkflow)
        {
            <a class="of-btn of-btn-primary" href="/work-orders/create">+ New Work Order</a>
        }
        <a class="of-btn of-btn-secondary" href="/workload">Workload</a>
        <a class="of-btn of-btn-secondary" href="/reminders">Reminders</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="🛠️">
    <p>
        Work Orders capture operational tasks before they disappear into verbal updates,
        emails, paper notes, or handover gaps. The records feed workload pressure,
        due-date reminders, reports, data quality checks, and activity traceability.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Total Work Orders"
                Value="@TotalCount.ToString()"
                Detail="All seeded and created operational work requests"
                Icon="📋" />

    <MetricCard Title="Open"
                Value="@OpenCount.ToString()"
                Detail="Currently active or in progress"
                Icon="🟡"
                Tone="warning" />

    <MetricCard Title="Overdue"
                Value="@OverdueCount.ToString()"
                Detail="Past due and not closed"
                Icon="🚨"
                Tone="danger" />

    <MetricCard Title="Completed"
                Value="@CompletedCount.ToString()"
                Detail="Completed or closed work orders"
                Icon="✅"
                Tone="success" />
</MetricGrid>

<FilterBar Title="Filter Work Orders">
    <ChildContent>
        <input class="of-input"
               placeholder="Search work orders..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="of-select" @bind="statusFilter">
            <option value="">All Statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>

        <select class="of-select" @bind="priorityFilter">
            <option value="">All Priorities</option>
            @foreach (var priority in PriorityOptions)
            {
                <option value="@priority">@priority</option>
            }
        </select>
    </ChildContent>

    <Actions>
        <a class="of-btn of-btn-secondary" href="/reports">Reports</a>
        <a class="of-btn of-btn-secondary" href="/data-quality">Data Quality</a>
    </Actions>
</FilterBar>

@if (workOrders == null)
{
    <InfoPanel Title="Loading Work Orders" Subtitle="Loading seeded and created work order records.">
        <p class="of-muted-text">Loading work orders...</p>
    </InfoPanel>
}
else
{
    <TableCard Title="Work Order Register"
               Subtitle="Search, filter, open, and edit operational work requests."
               IsEmpty="@(!FilteredWorkOrders.Any())"
               EmptyTitle="No work orders found"
               EmptyMessage="No work orders match the current search or filter selection.">
        <table>
            <thead>
                <tr>
                    <th>WO #</th>
                    <th>Title</th>
                    <th>Site</th>
                    <th>Department</th>
                    <th>Owner</th>
                    <th>Type</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Due Date</th>
                    <th>Files</th>
                    <th>Flag</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredWorkOrders)
                {
                    <tr>
                        <td><strong>@item.WorkOrderNumber</strong></td>
                        <td>@item.Title</td>
                        <td>@item.Site</td>
                        <td>@item.Department</td>
                        <td>@item.Owner</td>
                        <td>@item.Type</td>
                        <td>
                            <span class="@GetPriorityClass(item.Priority)">
                                @item.Priority
                            </span>
                        </td>
                        <td>
                            <span class="@GetStatusClass(item.Status)">
                                @item.Status
                            </span>
                        </td>
                        <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                        <td>
                            <span class="@GetFileCountClass(item.Id)">
                                @GetAttachmentCount(item.Id) file(s)
                            </span>
                        </td>
                        <td>
                            @if (item.IsOverdue)
                            {
                                <span class="of-badge of-badge-danger">Overdue</span>
                            }
                            else
                            {
                                <span class="of-badge of-badge-success">On Track</span>
                            }
                        </td>
                        <td>
                            <div class="of-row-actions">
                                <a class="of-card-link" href="@($"/work-orders/details/{item.Id}")">View</a>
                                @if (CurrentUserService.CanEditWorkflow)
                                {
                                    <a class="of-card-link" href="@($"/work-orders/edit/{item.Id}?returnUrl={Uri.EscapeDataString("/work-orders")}")">Edit</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </TableCard>
}

<GuidanceNote Title="Review Notes" Icon="💡" Tone="info">
    <ul>
        <li>Open work orders should appear in Workload and Reminders.</li>
        <li>Overdue work orders should be visible in follow-up views and management reports.</li>
        <li>Creating or editing a work order should generate activity history.</li>
        <li>This prototype stores workflow metadata locally in SQLite; production sync is a later Microsoft 365 implementation step.</li>
    </ul>
</GuidanceNote>

@code {
    private List<WorkOrder>? workOrders;
    private Dictionary<int, int> attachmentCounts = new();

    private string searchText = "";
    private string statusFilter = "";
    private string priorityFilter = "";

    private IEnumerable<WorkOrder> FilteredWorkOrders
    {
        get
        {
            if (workOrders == null)
            {
                return Enumerable.Empty<WorkOrder>();
            }

            var query = workOrders.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.WorkOrderNumber, searchText) ||
                    Contains(x.Title, searchText) ||
                    Contains(x.Site, searchText) ||
                    Contains(x.Department, searchText) ||
                    Contains(x.Owner, searchText) ||
                    Contains(x.Type, searchText) ||
                    Contains(x.Priority, searchText) ||
                    Contains(x.Status, searchText));
            }

            if (!string.IsNullOrWhiteSpace(statusFilter))
            {
                query = query.Where(x => string.Equals(x.Status, statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(priorityFilter))
            {
                query = query.Where(x => string.Equals(x.Priority, priorityFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x => x.IsOverdue)
                .ThenBy(x => x.DueDate)
                .ThenBy(x => x.Priority)
                .ToList();
        }
    }

    private int TotalCount => workOrders?.Count ?? 0;

    private int OpenCount =>
        workOrders?.Count(x =>
            !string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(x.Status, "Closed", StringComparison.OrdinalIgnoreCase)) ?? 0;

    private int OverdueCount => workOrders?.Count(x => x.IsOverdue) ?? 0;

    private int CompletedCount =>
        workOrders?.Count(x =>
            string.Equals(x.Status, "Completed", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Status, "Closed", StringComparison.OrdinalIgnoreCase)) ?? 0;

    private List<string> StatusOptions =>
        workOrders?
            .Select(x => x.Status)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> PriorityOptions =>
        workOrders?
            .Select(x => x.Priority)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    protected override async Task OnInitializedAsync()
    {
        workOrders = await Db.WorkOrders
            .AsNoTracking()
            .ToListAsync();

        await LoadAttachmentCountsAsync();
    }

    private static bool Contains(string? source, string search)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return false;
        }

        return source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "completed" => "badge badge-success",
            "closed" => "badge badge-success",
            "in progress" => "badge badge-info",
            "open" => "badge badge-warning",
            "new" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private async Task LoadAttachmentCountsAsync()
    {
        var attachments = await AttachmentService.GetAllActiveAsync();

        attachmentCounts = attachments
            .Where(x =>
                string.Equals(x.ModuleName, "Work Orders", StringComparison.OrdinalIgnoreCase) &&
                x.RecordId.HasValue)
            .GroupBy(x => x.RecordId!.Value)
            .ToDictionary(x => x.Key, x => x.Count());
    }

    private int GetAttachmentCount(int workOrderId)
    {
        return attachmentCounts.TryGetValue(workOrderId, out var count)
            ? count
            : 0;
    }

    private string GetFileCountClass(int workOrderId)
    {
        return GetAttachmentCount(workOrderId) > 0
            ? "badge badge-success"
            : "badge badge-muted";
    }
}
