@page "/workload"

@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake

@inject OperationsFlowDbContext Db

<PageTitle>Workload - OperationsFlow</PageTitle>

<div class="page-shell module-page workload-page">
    <section class="module-header">
        <div>
            <p class="eyebrow dark">Management</p>
            <h1>Workload</h1>
            <p>
                Review assigned open work by owner, pressure level, overdue count, high-priority work,
                next due date, and module source.
            </p>
        </div>

        <div class="module-header-stat">
            <span>Active Owners</span>
            <strong>@WorkloadRows.Count</strong>
        </div>
    </section>

    <section class="page-purpose-note">
        <strong>Purpose:</strong> use this page to answer who owns the follow-up, who is overloaded,
        what is overdue, and which records should be opened first.
    </section>

    <section class="module-summary-grid">
        <article class="module-summary-card info-card">
            <span>Total Assigned</span>
            <strong>@TotalAssignedCount</strong>
            <small>Open assigned items</small>
        </article>

        <article class="module-summary-card danger-card">
            <span>Overdue</span>
            <strong>@TotalOverdueCount</strong>
            <small>Assigned items past due</small>
        </article>

        <article class="module-summary-card warning-card">
            <span>High Priority</span>
            <strong>@TotalHighPriorityCount</strong>
            <small>High or critical assigned items</small>
        </article>

        <article class="module-summary-card">
            <span>Highest Load</span>
            <strong>@HighestLoadCount</strong>
            <small>@HighestLoadOwner</small>
        </article>

        <article class="module-summary-card">
            <span>High Pressure Owners</span>
            <strong>@HighPressureOwnerCount</strong>
            <small>Need review first</small>
        </article>
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Owner Follow-Up Focus</h2>
                    <p>Use this summary before checking individual owner cards.</p>
                </div>
            </div>

            <ul class="review-list">
                @if (UnassignedRow is not null)
                {
                    <li>
                        Assign ownership for <strong>@UnassignedRow.TotalAssigned</strong> unassigned item(s).
                    </li>
                }

                @if (HighPressureRows.Any())
                {
                    <li>
                        Review <strong>@HighPressureRows.Count</strong> high-pressure owner(s) first:
                        <strong>@string.Join(", ", HighPressureRows.Select(x => x.Owner))</strong>.
                    </li>
                }

                @if (TotalOverdueCount > 0)
                {
                    <li>
                        Follow up on <strong>@TotalOverdueCount</strong> overdue assigned item(s).
                    </li>
                }

                @if (TotalHighPriorityCount > 0)
                {
                    <li>
                        Confirm owners and next steps for <strong>@TotalHighPriorityCount</strong> high/critical item(s).
                    </li>
                }

                @if (!HighPressureRows.Any() && TotalOverdueCount == 0 && TotalHighPriorityCount == 0 && UnassignedRow is null)
                {
                    <li>No urgent workload pressure found. Review next due dates and upcoming work.</li>
                }
            </ul>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Suggested Review Order</h2>
                    <p>Recommended sequence for a workload or follow-up meeting.</p>
                </div>
            </div>

            <ol class="review-list">
                <li>Start with unassigned work so accountability is clear.</li>
                <li>Review owners with high pressure or multiple overdue items.</li>
                <li>Open overdue and high-priority records directly from the owner cards.</li>
                <li>Confirm next actions, status, due dates, and notes.</li>
                <li>Re-check Data Quality and Reports after updating key records.</li>
            </ol>
        </div>
    </section>

    <section class="module-toolbar">
        <input class="search-input"
               placeholder="Search owner, record, module, priority, or focus..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="filter-select" @bind="pressureFilter">
            <option value="">All Pressure Levels</option>
            <option value="High">High Pressure</option>
            <option value="Medium">Medium Pressure</option>
            <option value="Low">Low Pressure</option>
        </select>

        <select class="filter-select" @bind="ownerFilter">
            <option value="">All Owners</option>
            @foreach (var owner in OwnerOptions)
            {
                <option value="@owner">@owner</option>
            }
        </select>

        <select class="filter-select" @bind="moduleFilter">
            <option value="">All Modules</option>
            @foreach (var module in ModuleOptions)
            {
                <option value="@module">@module</option>
            }
        </select>
    </section>

    <section class="table-card">
        <div class="table-card-header">
            <div>
                <h2>Owner Workload Summary</h2>
                <p>
                    Showing @FilteredWorkloadRows.Count of @WorkloadRows.Count owner workload group(s).
                </p>
            </div>

            <div class="activity-count-card">
                <span>Assigned</span>
                <strong>@FilteredAssignedCount</strong>
            </div>
        </div>

        @if (!FilteredWorkloadRows.Any())
        {
            <div class="empty-state">
                <strong>No workload records match the current filters.</strong>
                <p>Clear search or filters to show more owner groups.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table workload-table">
                    <thead>
                        <tr>
                            <th>Owner</th>
                            <th>Pressure</th>
                            <th>Total</th>
                            <th>Work Orders</th>
                            <th>Corrective</th>
                            <th>Intake</th>
                            <th>Overdue</th>
                            <th>High Priority</th>
                            <th>Next Due</th>
                            <th>Recommended Focus</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredWorkloadRows)
                        {
                            <tr>
                                <td class="strong-cell">@row.Owner</td>
                                <td>
                                    <span class="@GetPressureClass(row.PressureLevel)">
                                        @row.PressureLevel
                                    </span>
                                </td>
                                <td>@row.TotalAssigned</td>
                                <td>@row.OpenWorkOrders</td>
                                <td>@row.OpenCorrectiveActions</td>
                                <td>@row.OpenDocumentIntake</td>
                                <td>
                                    @if (row.OverdueCount > 0)
                                    {
                                        <span class="badge badge-danger">@row.OverdueCount</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-muted">0</span>
                                    }
                                </td>
                                <td>
                                    @if (row.HighPriorityCount > 0)
                                    {
                                        <span class="badge badge-warning">@row.HighPriorityCount</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-muted">0</span>
                                    }
                                </td>
                                <td>
                                    @if (row.NextDueDate.HasValue)
                                    {
                                        <strong>@row.NextDueDate.Value.ToString("dd MMM yyyy")</strong>
                                        <small>@GetDueTimingText(row.NextDueDate.Value)</small>
                                    }
                                    else
                                    {
                                        <span>No due items</span>
                                    }
                                </td>
                                <td>@row.RecommendedFocus</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="owner-card-grid">
        @foreach (var row in FilteredWorkloadRows)
        {
            <article class="owner-workload-card">
                <div class="owner-card-header">
                    <div>
                        <span class="eyebrow dark">Owner</span>
                        <h2>@row.Owner</h2>
                        <p>@GetOwnerSummary(row)</p>
                    </div>

                    <span class="@GetPressureClass(row.PressureLevel)">
                        @row.PressureLevel
                    </span>
                </div>

                <div class="owner-metrics-grid">
                    <div>
                        <span>Total</span>
                        <strong>@row.TotalAssigned</strong>
                    </div>

                    <div>
                        <span>Overdue</span>
                        <strong>@row.OverdueCount</strong>
                    </div>

                    <div>
                        <span>High</span>
                        <strong>@row.HighPriorityCount</strong>
                    </div>

                    <div>
                        <span>Next Due</span>
                        <strong>@(row.NextDueDate.HasValue ? row.NextDueDate.Value.ToString("dd MMM") : "None")</strong>
                    </div>
                </div>

                <div class="owner-focus-note">
                    <strong>Recommended focus</strong>
                    <p>@row.RecommendedFocus</p>
                </div>

                @if (!row.Items.Any())
                {
                    <div class="empty-state">
                        <strong>No active items assigned.</strong>
                        <p>This owner currently has no open workload records.</p>
                    </div>
                }
                else
                {
                    <div class="owner-item-list">
                        @foreach (var item in row.Items.Take(10))
                        {
                            <article class="owner-item-card">
                                <div>
                                    <div class="owner-item-meta">
                                        <span>@item.ModuleName</span>

                                        @if (item.IsOverdue)
                                        {
                                            <span class="badge badge-danger">Overdue</span>
                                        }

                                        @if (IsHighPriority(item.Priority))
                                        {
                                            <span class="badge badge-warning">@item.Priority</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-muted">@item.Priority</span>
                                        }
                                    </div>

                                    <strong>@item.Reference — @item.Title</strong>
                                    <p>@GetDueTimingText(item.DueDate)</p>
                                </div>

                                <a class="btn btn-small btn-primary" href="@item.Url">
                                    Open
                                </a>
                            </article>
                        }

                        @if (row.Items.Count > 10)
                        {
                            <div class="owner-more-note">
                                <strong>@(row.Items.Count - 10)</strong> more item(s) hidden by card limit.
                                Use filters or module pages for the full list.
                            </div>
                        }
                    </div>
                }
            </article>
        }
    </section>
</div>

@code {
    private List<WorkOrder> workOrders = new();
    private List<CorrectiveAction> correctiveActions = new();
    private List<DocumentIntakeModel> documentIntakeItems = new();

    private string searchText = "";
    private string pressureFilter = "";
    private string ownerFilter = "";
    private string moduleFilter = "";

    private List<WorkloadRow> WorkloadRows
    {
        get
        {
            var workloadItems = new List<WorkloadItem>();

            workloadItems.AddRange(
                workOrders
                    .Where(x => !IsClosedStatus(x.Status))
                    .Select(x => new WorkloadItem(
                        Owner: string.IsNullOrWhiteSpace(x.Owner) ? "Unassigned" : x.Owner,
                        ModuleName: "Work Orders",
                        Reference: x.WorkOrderNumber,
                        Title: x.Title,
                        Priority: x.Priority,
                        DueDate: x.DueDate,
                        IsOverdue: x.IsOverdue,
                        Url: $"/work-orders/details/{x.Id}"
                    ))
            );

            workloadItems.AddRange(
                correctiveActions
                    .Where(x => !IsClosedStatus(x.Status))
                    .Select(x => new WorkloadItem(
                        Owner: string.IsNullOrWhiteSpace(x.Owner) ? "Unassigned" : x.Owner,
                        ModuleName: "Corrective Actions",
                        Reference: $"CA-{x.Id}",
                        Title: x.Title,
                        Priority: x.Priority,
                        DueDate: x.DueDate,
                        IsOverdue: x.IsOverdue,
                        Url: $"/corrective-actions/edit/{x.Id}"
                    ))
            );

            workloadItems.AddRange(
                documentIntakeItems
                    .Where(x => !x.IsCompleted)
                    .Select(x => new WorkloadItem(
                        Owner: string.IsNullOrWhiteSpace(x.AssignedTo) ? "Unassigned" : x.AssignedTo,
                        ModuleName: "Document Intake",
                        Reference: $"DI-{x.Id}",
                        Title: x.DocumentName,
                        Priority: x.Priority,
                        DueDate: x.DueDate,
                        IsOverdue: x.IsOverdue,
                        Url: $"/document-intake/edit/{x.Id}"
                    ))
            );

            return workloadItems
                .GroupBy(x => x.Owner)
                .Select(group =>
                {
                    var items = group
                        .OrderByDescending(x => x.IsOverdue)
                        .ThenBy(x => x.DueDate)
                        .ThenByDescending(x => IsHighPriority(x.Priority))
                        .ThenBy(x => x.ModuleName)
                        .ToList();

                    var openWorkOrders = items.Count(x => x.ModuleName == "Work Orders");
                    var openCorrectiveActions = items.Count(x => x.ModuleName == "Corrective Actions");
                    var openDocumentIntake = items.Count(x => x.ModuleName == "Document Intake");

                    var overdueCount = items.Count(x => x.IsOverdue);
                    var highPriorityCount = items.Count(x => IsHighPriority(x.Priority));
                    var nextDueDate = items.Any() ? items.Min(x => x.DueDate) : (DateTime?)null;

                    var pressureLevel = GetPressureLevel(
                        totalAssigned: items.Count,
                        overdueCount: overdueCount,
                        highPriorityCount: highPriorityCount
                    );

                    var recommendedFocus = GetRecommendedFocus(
                        owner: group.Key,
                        totalAssigned: items.Count,
                        overdueCount: overdueCount,
                        highPriorityCount: highPriorityCount,
                        nextDueDate: nextDueDate
                    );

                    return new WorkloadRow(
                        Owner: group.Key,
                        TotalAssigned: items.Count,
                        OpenWorkOrders: openWorkOrders,
                        OpenCorrectiveActions: openCorrectiveActions,
                        OpenDocumentIntake: openDocumentIntake,
                        OverdueCount: overdueCount,
                        HighPriorityCount: highPriorityCount,
                        NextDueDate: nextDueDate,
                        PressureLevel: pressureLevel,
                        RecommendedFocus: recommendedFocus,
                        Items: items
                    );
                })
                .OrderByDescending(x => x.PressureSort)
                .ThenByDescending(x => x.OverdueCount)
                .ThenByDescending(x => x.HighPriorityCount)
                .ThenByDescending(x => x.TotalAssigned)
                .ThenBy(x => x.Owner)
                .ToList();
        }
    }

    private List<WorkloadRow> FilteredWorkloadRows
    {
        get
        {
            var query = WorkloadRows.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(row =>
                    Contains(row.Owner, searchText) ||
                    Contains(row.PressureLevel, searchText) ||
                    Contains(row.RecommendedFocus, searchText) ||
                    row.Items.Any(item =>
                        Contains(item.ModuleName, searchText) ||
                        Contains(item.Reference, searchText) ||
                        Contains(item.Title, searchText) ||
                        Contains(item.Priority, searchText)));
            }

            if (!string.IsNullOrWhiteSpace(pressureFilter))
            {
                query = query.Where(row =>
                    string.Equals(row.PressureLevel, pressureFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(ownerFilter))
            {
                query = query.Where(row =>
                    string.Equals(row.Owner, ownerFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(moduleFilter))
            {
                query = query
                    .Select(row => row with
                    {
                        Items = row.Items
                            .Where(item => string.Equals(item.ModuleName, moduleFilter, StringComparison.OrdinalIgnoreCase))
                            .ToList()
                    })
                    .Where(row => row.Items.Any())
                    .Select(row => RebuildRowFromFilteredItems(row.Owner, row.Items));
            }

            return query.ToList();
        }
    }

    private int TotalAssignedCount => WorkloadRows.Sum(x => x.TotalAssigned);

    private int TotalOverdueCount => WorkloadRows.Sum(x => x.OverdueCount);

    private int TotalHighPriorityCount => WorkloadRows.Sum(x => x.HighPriorityCount);

    private int HighestLoadCount => WorkloadRows.Any() ? WorkloadRows.Max(x => x.TotalAssigned) : 0;

    private string HighestLoadOwner =>
        WorkloadRows
            .OrderByDescending(x => x.TotalAssigned)
            .ThenBy(x => x.Owner)
            .FirstOrDefault()?.Owner ?? "No assigned work";

    private int HighPressureOwnerCount => WorkloadRows.Count(x => x.PressureLevel == "High");

    private int FilteredAssignedCount => FilteredWorkloadRows.Sum(x => x.TotalAssigned);

    private List<WorkloadRow> HighPressureRows =>
        WorkloadRows
            .Where(x => x.PressureLevel == "High")
            .ToList();

    private WorkloadRow? UnassignedRow =>
        WorkloadRows
            .FirstOrDefault(x => x.Owner == "Unassigned");

    private List<string> OwnerOptions =>
        WorkloadRows
            .Select(x => x.Owner)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    private List<string> ModuleOptions =>
        WorkloadRows
            .SelectMany(x => x.Items)
            .Select(x => x.ModuleName)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        workOrders = await Db.WorkOrders
            .AsNoTracking()
            .ToListAsync();

        correctiveActions = await Db.CorrectiveActions
            .AsNoTracking()
            .ToListAsync();

        documentIntakeItems = await Db.DocumentIntakeItems
            .AsNoTracking()
            .ToListAsync();
    }

    private static WorkloadRow RebuildRowFromFilteredItems(string owner, List<WorkloadItem> items)
    {
        var orderedItems = items
            .OrderByDescending(x => x.IsOverdue)
            .ThenBy(x => x.DueDate)
            .ThenByDescending(x => IsHighPriority(x.Priority))
            .ThenBy(x => x.ModuleName)
            .ToList();

        var openWorkOrders = orderedItems.Count(x => x.ModuleName == "Work Orders");
        var openCorrectiveActions = orderedItems.Count(x => x.ModuleName == "Corrective Actions");
        var openDocumentIntake = orderedItems.Count(x => x.ModuleName == "Document Intake");

        var overdueCount = orderedItems.Count(x => x.IsOverdue);
        var highPriorityCount = orderedItems.Count(x => IsHighPriority(x.Priority));
        var nextDueDate = orderedItems.Any() ? orderedItems.Min(x => x.DueDate) : (DateTime?)null;

        var pressureLevel = GetPressureLevel(
            totalAssigned: orderedItems.Count,
            overdueCount: overdueCount,
            highPriorityCount: highPriorityCount
        );

        var recommendedFocus = GetRecommendedFocus(
            owner: owner,
            totalAssigned: orderedItems.Count,
            overdueCount: overdueCount,
            highPriorityCount: highPriorityCount,
            nextDueDate: nextDueDate
        );

        return new WorkloadRow(
            Owner: owner,
            TotalAssigned: orderedItems.Count,
            OpenWorkOrders: openWorkOrders,
            OpenCorrectiveActions: openCorrectiveActions,
            OpenDocumentIntake: openDocumentIntake,
            OverdueCount: overdueCount,
            HighPriorityCount: highPriorityCount,
            NextDueDate: nextDueDate,
            PressureLevel: pressureLevel,
            RecommendedFocus: recommendedFocus,
            Items: orderedItems
        );
    }

    private static bool IsClosedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsHighPriority(string? priority)
    {
        return string.Equals(priority, "High", StringComparison.OrdinalIgnoreCase)
            || string.Equals(priority, "Critical", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetPressureLevel(int totalAssigned, int overdueCount, int highPriorityCount)
    {
        if (overdueCount >= 2 || highPriorityCount >= 3 || totalAssigned >= 8)
        {
            return "High";
        }

        if (overdueCount >= 1 || highPriorityCount >= 1 || totalAssigned >= 4)
        {
            return "Medium";
        }

        return "Low";
    }

    private static string GetRecommendedFocus(
        string owner,
        int totalAssigned,
        int overdueCount,
        int highPriorityCount,
        DateTime? nextDueDate)
    {
        if (owner == "Unassigned")
        {
            return "Assign ownership before reviewing workload pressure.";
        }

        if (overdueCount > 0 && highPriorityCount > 0)
        {
            return "Review overdue and high-priority work first.";
        }

        if (overdueCount > 0)
        {
            return "Review overdue work and update status, owner notes, or due dates.";
        }

        if (highPriorityCount > 0)
        {
            return "Confirm next actions for high-priority work.";
        }

        if (totalAssigned >= 6)
        {
            return "Review capacity and upcoming due dates.";
        }

        if (nextDueDate.HasValue)
        {
            return $"Next follow-up due {nextDueDate.Value:dd MMM yyyy}.";
        }

        return "No immediate follow-up pressure found.";
    }

    private static string GetOwnerSummary(WorkloadRow row)
    {
        return $"{row.OpenWorkOrders} work orders • {row.OpenCorrectiveActions} actions • {row.OpenDocumentIntake} intake";
    }

    private static string GetDueTimingText(DateTime dueDate)
    {
        var days = (dueDate.Date - DateTime.Today).Days;

        if (days < 0)
        {
            return $"{Math.Abs(days)} day(s) overdue";
        }

        if (days == 0)
        {
            return "Due today";
        }

        if (days == 1)
        {
            return "Due tomorrow";
        }

        return $"Due in {days} day(s)";
    }

    private static string GetPressureClass(string? pressure)
    {
        return pressure?.ToLowerInvariant() switch
        {
            "high" => "badge badge-danger",
            "medium" => "badge badge-warning",
            "low" => "badge badge-success",
            _ => "badge badge-muted"
        };
    }

    private static bool Contains(string? source, string search)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return false;
        }

        return source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private sealed record WorkloadItem(
        string Owner,
        string ModuleName,
        string Reference,
        string Title,
        string Priority,
        DateTime DueDate,
        bool IsOverdue,
        string Url);

    private sealed record WorkloadRow(
        string Owner,
        int TotalAssigned,
        int OpenWorkOrders,
        int OpenCorrectiveActions,
        int OpenDocumentIntake,
        int OverdueCount,
        int HighPriorityCount,
        DateTime? NextDueDate,
        string PressureLevel,
        string RecommendedFocus,
        List<WorkloadItem> Items)
    {
        public int PressureSort => PressureLevel switch
        {
            "High" => 3,
            "Medium" => 2,
            "Low" => 1,
            _ => 0
        };
    }
}