@page "/workload"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake
@inject OperationsFlowDbContext Db

<PageTitle>Workload - OperationsFlow</PageTitle>

<PageHero Eyebrow="Management"
          Title="Workload"
          Subtitle="Review assigned open work by owner, pressure level, overdue count, high-priority work, next due date, and module source."
          BadgeText="@($"{WorkloadRows.Count} active owners")"
          BadgeClass="@WorkloadBadgeClass">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/reminders">Reminders</a>
        <a class="of-btn of-btn-secondary" href="/reports">Reports</a>
        <a class="of-btn of-btn-secondary" href="/data-quality">Data Quality</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="👥">
    <p>
        Use this page to answer who owns follow-up work, who is overloaded, what is overdue,
        and which records should be opened first across Work Orders, Corrective Actions, and Document Intake.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Total Assigned"
                Value="@TotalAssignedCount.ToString()"
                Detail="Open assigned items"
                Icon="📋" />

    <MetricCard Title="Overdue"
                Value="@TotalOverdueCount.ToString()"
                Detail="Assigned items past due"
                Icon="🚨"
                Tone="danger" />

    <MetricCard Title="High Priority"
                Value="@TotalHighPriorityCount.ToString()"
                Detail="High or critical assigned items"
                Icon="⚡"
                Tone="warning" />

    <MetricCard Title="Highest Load"
                Value="@HighestLoadCount.ToString()"
                Detail="@HighestLoadOwner"
                Icon="📈"
                Tone="info" />

    <MetricCard Title="High Pressure Owners"
                Value="@HighPressureOwnerCount.ToString()"
                Detail="Need review first"
                Icon="🔥"
                Tone="@HighPressureTone" />
</MetricGrid>

<InfoPanel Title="Owner Follow-Up Focus" Subtitle="Use this summary before checking individual owner cards.">
    <ChildContent>
        <ul class="of-review-steps">
            @if (UnassignedRow is not null)
            {
                <li>Assign ownership for @UnassignedRow.TotalAssigned unassigned item(s).</li>
            }

            @if (HighPressureRows.Any())
            {
                <li>Review @HighPressureRows.Count high-pressure owner(s) first: @string.Join(", ", HighPressureRows.Select(x => x.Owner)).</li>
            }

            @if (TotalOverdueCount > 0)
            {
                <li>Follow up on @TotalOverdueCount overdue assigned item(s).</li>
            }

            @if (TotalHighPriorityCount > 0)
            {
                <li>Confirm owners and next steps for @TotalHighPriorityCount high/critical item(s).</li>
            }

            @if (!HighPressureRows.Any() && TotalOverdueCount == 0 && TotalHighPriorityCount == 0 && UnassignedRow is null)
            {
                <li>No urgent workload pressure found. Review next due dates and upcoming work.</li>
            }
        </ul>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Suggested Review Order" Subtitle="Recommended sequence for a workload or follow-up meeting.">
    <ChildContent>
        <ol class="of-review-steps">
            <li>Start with unassigned work so accountability is clear.</li>
            <li>Review owners with high pressure or multiple overdue items.</li>
            <li>Open overdue and high-priority records directly from the owner cards.</li>
            <li>Confirm next actions, status, due dates, and notes.</li>
            <li>Re-check Data Quality and Reports after updating key records.</li>
        </ol>
    </ChildContent>
</InfoPanel>

<FilterBar Title="Filter Workload">
    <ChildContent>
        <input class="of-input"
               placeholder="Search workload..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="of-select" @bind="pressureFilter">
            <option value="">All Pressure Levels</option>
            <option value="High">High Pressure</option>
            <option value="Medium">Medium Pressure</option>
            <option value="Low">Low Pressure</option>
        </select>

        <select class="of-select" @bind="ownerFilter">
            <option value="">All Owners</option>
            @foreach (var owner in OwnerOptions)
            {
                <option value="@owner">@owner</option>
            }
        </select>

        <select class="of-select" @bind="moduleFilter">
            <option value="">All Modules</option>
            @foreach (var module in ModuleOptions)
            {
                <option value="@module">@module</option>
            }
        </select>
    </ChildContent>

    <Actions>
        <a class="of-btn of-btn-secondary" href="/activity-log">Activity Log</a>
        <a class="of-btn of-btn-secondary" href="/corrective-actions">Actions</a>
    </Actions>
</FilterBar>

<TableCard Title="Owner Workload Summary"
           Subtitle="@($"Showing {FilteredWorkloadRows.Count} of {WorkloadRows.Count} owner workload group(s). {FilteredAssignedCount} assigned item(s) in the filtered view.")"
           IsEmpty="@(!FilteredWorkloadRows.Any())"
           EmptyTitle="No workload records found"
           EmptyMessage="No workload records match the current filters.">
    <table>
        <thead>
            <tr>
                <th>Owner</th>
                <th>Pressure</th>
                <th>Total</th>
                <th>Work Orders</th>
                <th>Corrective</th>
                <th>Intake</th>
                <th>Overdue</th>
                <th>High Priority</th>
                <th>Next Due</th>
                <th>Recommended Focus</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in FilteredWorkloadRows)
            {
                <tr>
                    <td><strong>@row.Owner</strong></td>
                    <td>
                        <span class="@GetPressureClass(row.PressureLevel)">
                            @row.PressureLevel
                        </span>
                    </td>
                    <td>@row.TotalAssigned</td>
                    <td>@row.OpenWorkOrders</td>
                    <td>@row.OpenCorrectiveActions</td>
                    <td>@row.OpenDocumentIntake</td>
                    <td>
                        @if (row.OverdueCount > 0)
                        {
                            <span class="of-badge of-badge-danger">@row.OverdueCount</span>
                        }
                        else
                        {
                            <span class="of-badge of-badge-success">0</span>
                        }
                    </td>
                    <td>
                        @if (row.HighPriorityCount > 0)
                        {
                            <span class="of-badge of-badge-warning">@row.HighPriorityCount</span>
                        }
                        else
                        {
                            <span class="of-badge of-badge-success">0</span>
                        }
                    </td>
                    <td>
                        @if (row.NextDueDate.HasValue)
                        {
                            @row.NextDueDate.Value.ToString("dd MMM yyyy")
                            <div class="of-muted-text">@GetDueTimingText(row.NextDueDate.Value)</div>
                        }
                        else
                        {
                            <span class="of-muted-text">No due items</span>
                        }
                    </td>
                    <td>@row.RecommendedFocus</td>
                </tr>
            }
        </tbody>
    </table>
</TableCard>

<InfoPanel Title="Owner Workload Cards" Subtitle="Open the highest priority records directly from each owner card.">
    <ChildContent>
        @if (!FilteredWorkloadRows.Any())
        {
            <EmptyState Title="No owner cards to show"
                        Message="Clear search or filters to show more owner groups."
                        Icon="👥" />
        }
        else
        {
            <div class="of-review-proof-grid">
                @foreach (var row in FilteredWorkloadRows)
                {
                    <div class="of-review-proof-card">
                        <strong>@row.Owner</strong>
                        <span>@GetOwnerSummary(row)</span>

                        <div class="of-link-row">
                            <span class="@GetPressureClass(row.PressureLevel)">
                                @row.PressureLevel
                            </span>

                            <span class="of-badge">Total @row.TotalAssigned</span>

                            @if (row.OverdueCount > 0)
                            {
                                <span class="of-badge of-badge-danger">Overdue @row.OverdueCount</span>
                            }

                            @if (row.HighPriorityCount > 0)
                            {
                                <span class="of-badge of-badge-warning">High @row.HighPriorityCount</span>
                            }
                        </div>

                        <div class="of-review-proof-card__detail">
                            <strong>Recommended focus</strong>
                            <span>@row.RecommendedFocus</span>
                        </div>

                        @if (!row.Items.Any())
                        {
                            <EmptyState Title="No active items assigned"
                                        Message="This owner currently has no open workload records."
                                        Icon="✅" />
                        }
                        else
                        {
                            <div class="of-mini-list">
                                @foreach (var item in row.Items.Take(10))
                                {
                                    <div class="of-mini-list-item">
                                        <div>
                                            <strong>@item.Reference — @item.Title</strong>
                                            <span>@item.ModuleName • @GetDueTimingText(item.DueDate)</span>
                                        </div>

                                        <div class="of-link-row">
                                            @if (item.IsOverdue)
                                            {
                                                <span class="of-badge of-badge-danger">Overdue</span>
                                            }

                                            @if (IsHighPriority(item.Priority))
                                            {
                                                <span class="of-badge of-badge-warning">@item.Priority</span>
                                            }
                                            else
                                            {
                                                <span class="of-badge">@item.Priority</span>
                                            }

                                            <a class="of-card-link" href="@item.Url">Open</a>
                                        </div>
                                    </div>
                                }

                                @if (row.Items.Count > 10)
                                {
                                    <p class="of-muted-text">
                                        @(row.Items.Count - 10) more item(s) hidden by card limit. Use filters or module pages for the full list.
                                    </p>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Review Notes" Icon="💡" Tone="info">
    <ul>
        <li>High-pressure owners should be reviewed before low-pressure owners.</li>
        <li>Unassigned work should be assigned before workload pressure is judged.</li>
        <li>Overdue and high-priority records should be opened directly from this page.</li>
        <li>After editing records, this page should reflect ownership, status, priority, and due-date changes.</li>
    </ul>
</GuidanceNote>

@code {
    private List<WorkOrder> workOrders = new();
    private List<CorrectiveAction> correctiveActions = new();
    private List<DocumentIntakeModel> documentIntakeItems = new();

    private string searchText = "";
    private string pressureFilter = "";
    private string ownerFilter = "";
    private string moduleFilter = "";

    private List<WorkloadRow> WorkloadRows
    {
        get
        {
            var workloadItems = new List<WorkloadItem>();

            workloadItems.AddRange(
                workOrders
                    .Where(x => !IsClosedStatus(x.Status))
                    .Select(x => new WorkloadItem(
                        Owner: string.IsNullOrWhiteSpace(x.Owner) ? "Unassigned" : x.Owner,
                        ModuleName: "Work Orders",
                        Reference: x.WorkOrderNumber,
                        Title: x.Title,
                        Priority: x.Priority,
                        DueDate: x.DueDate,
                        IsOverdue: x.IsOverdue,
                        Url: $"/work-orders/details/{x.Id}"
                    )));

            workloadItems.AddRange(
                correctiveActions
                    .Where(x => !IsClosedStatus(x.Status))
                    .Select(x => new WorkloadItem(
                        Owner: string.IsNullOrWhiteSpace(x.Owner) ? "Unassigned" : x.Owner,
                        ModuleName: "Corrective Actions",
                        Reference: $"CA-{x.Id}",
                        Title: x.Title,
                        Priority: x.Priority,
                        DueDate: x.DueDate,
                        IsOverdue: x.IsOverdue,
                        Url: $"/corrective-actions/edit/{x.Id}?returnUrl={Uri.EscapeDataString("/workload")}"
                    )));

            workloadItems.AddRange(
                documentIntakeItems
                    .Where(x => !x.IsCompleted)
                    .Select(x => new WorkloadItem(
                        Owner: string.IsNullOrWhiteSpace(x.AssignedTo) ? "Unassigned" : x.AssignedTo,
                        ModuleName: "Document Intake",
                        Reference: $"DI-{x.Id}",
                        Title: x.DocumentName,
                        Priority: x.Priority,
                        DueDate: x.DueDate,
                        IsOverdue: x.IsOverdue,
                        Url: $"/document-intake/edit/{x.Id}?returnUrl={Uri.EscapeDataString("/workload")}"
                    )));

            return workloadItems
                .GroupBy(x => x.Owner)
                .Select(group =>
                {
                    var items = group
                        .OrderByDescending(x => x.IsOverdue)
                        .ThenBy(x => x.DueDate)
                        .ThenByDescending(x => IsHighPriority(x.Priority))
                        .ThenBy(x => x.ModuleName)
                        .ToList();

                    return BuildWorkloadRow(group.Key, items);
                })
                .OrderByDescending(x => x.PressureSort)
                .ThenByDescending(x => x.OverdueCount)
                .ThenByDescending(x => x.HighPriorityCount)
                .ThenByDescending(x => x.TotalAssigned)
                .ThenBy(x => x.Owner)
                .ToList();
        }
    }

    private List<WorkloadRow> FilteredWorkloadRows
    {
        get
        {
            var query = WorkloadRows.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(row =>
                    Contains(row.Owner, searchText) ||
                    Contains(row.PressureLevel, searchText) ||
                    Contains(row.RecommendedFocus, searchText) ||
                    row.Items.Any(item =>
                        Contains(item.ModuleName, searchText) ||
                        Contains(item.Reference, searchText) ||
                        Contains(item.Title, searchText) ||
                        Contains(item.Priority, searchText)));
            }

            if (!string.IsNullOrWhiteSpace(pressureFilter))
            {
                query = query.Where(row => string.Equals(row.PressureLevel, pressureFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(ownerFilter))
            {
                query = query.Where(row => string.Equals(row.Owner, ownerFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(moduleFilter))
            {
                query = query
                    .Select(row =>
                    {
                        var filteredItems = row.Items
                            .Where(item => string.Equals(item.ModuleName, moduleFilter, StringComparison.OrdinalIgnoreCase))
                            .ToList();

                        return BuildWorkloadRow(row.Owner, filteredItems);
                    })
                    .Where(row => row.Items.Any());
            }

            return query.ToList();
        }
    }

    private int TotalAssignedCount => WorkloadRows.Sum(x => x.TotalAssigned);
    private int TotalOverdueCount => WorkloadRows.Sum(x => x.OverdueCount);
    private int TotalHighPriorityCount => WorkloadRows.Sum(x => x.HighPriorityCount);
    private int HighestLoadCount => WorkloadRows.Any() ? WorkloadRows.Max(x => x.TotalAssigned) : 0;

    private string HighestLoadOwner =>
        WorkloadRows
            .OrderByDescending(x => x.TotalAssigned)
            .ThenBy(x => x.Owner)
            .FirstOrDefault()?.Owner ?? "No assigned work";

    private int HighPressureOwnerCount => WorkloadRows.Count(x => x.PressureLevel == "High");
    private int FilteredAssignedCount => FilteredWorkloadRows.Sum(x => x.TotalAssigned);

    private string HighPressureTone => HighPressureOwnerCount > 0 ? "danger" : "success";
    private string WorkloadBadgeClass => HighPressureOwnerCount > 0 ? "of-badge-danger" : "of-badge-info";

    private List<WorkloadRow> HighPressureRows =>
        WorkloadRows
            .Where(x => x.PressureLevel == "High")
            .ToList();

    private WorkloadRow? UnassignedRow =>
        WorkloadRows
            .FirstOrDefault(x => x.Owner == "Unassigned");

    private List<string> OwnerOptions =>
        WorkloadRows
            .Select(x => x.Owner)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    private List<string> ModuleOptions =>
        WorkloadRows
            .SelectMany(x => x.Items)
            .Select(x => x.ModuleName)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        workOrders = await Db.WorkOrders.AsNoTracking().ToListAsync();
        correctiveActions = await Db.CorrectiveActions.AsNoTracking().ToListAsync();
        documentIntakeItems = await Db.DocumentIntakeItems.AsNoTracking().ToListAsync();
    }

    private static WorkloadRow BuildWorkloadRow(string owner, List<WorkloadItem> items)
    {
        var orderedItems = items
            .OrderByDescending(x => x.IsOverdue)
            .ThenBy(x => x.DueDate)
            .ThenByDescending(x => IsHighPriority(x.Priority))
            .ThenBy(x => x.ModuleName)
            .ToList();

        var openWorkOrders = orderedItems.Count(x => x.ModuleName == "Work Orders");
        var openCorrectiveActions = orderedItems.Count(x => x.ModuleName == "Corrective Actions");
        var openDocumentIntake = orderedItems.Count(x => x.ModuleName == "Document Intake");
        var overdueCount = orderedItems.Count(x => x.IsOverdue);
        var highPriorityCount = orderedItems.Count(x => IsHighPriority(x.Priority));
        var nextDueDate = orderedItems.Any() ? orderedItems.Min(x => x.DueDate) : (DateTime?)null;

        var pressureLevel = GetPressureLevel(
            totalAssigned: orderedItems.Count,
            overdueCount: overdueCount,
            highPriorityCount: highPriorityCount);

        var recommendedFocus = GetRecommendedFocus(
            owner: owner,
            totalAssigned: orderedItems.Count,
            overdueCount: overdueCount,
            highPriorityCount: highPriorityCount,
            nextDueDate: nextDueDate);

        return new WorkloadRow(
            Owner: owner,
            TotalAssigned: orderedItems.Count,
            OpenWorkOrders: openWorkOrders,
            OpenCorrectiveActions: openCorrectiveActions,
            OpenDocumentIntake: openDocumentIntake,
            OverdueCount: overdueCount,
            HighPriorityCount: highPriorityCount,
            NextDueDate: nextDueDate,
            PressureLevel: pressureLevel,
            RecommendedFocus: recommendedFocus,
            Items: orderedItems);
    }

    private static bool IsClosedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsHighPriority(string? priority)
    {
        return string.Equals(priority, "High", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(priority, "Critical", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetPressureLevel(int totalAssigned, int overdueCount, int highPriorityCount)
    {
        if (overdueCount >= 2 || highPriorityCount >= 3 || totalAssigned >= 8)
        {
            return "High";
        }

        if (overdueCount >= 1 || highPriorityCount >= 1 || totalAssigned >= 4)
        {
            return "Medium";
        }

        return "Low";
    }

    private static string GetRecommendedFocus(
        string owner,
        int totalAssigned,
        int overdueCount,
        int highPriorityCount,
        DateTime? nextDueDate)
    {
        if (owner == "Unassigned")
        {
            return "Assign ownership before reviewing workload pressure.";
        }

        if (overdueCount > 0 && highPriorityCount > 0)
        {
            return "Review overdue and high-priority work first.";
        }

        if (overdueCount > 0)
        {
            return "Review overdue work and update status, owner notes, or due dates.";
        }

        if (highPriorityCount > 0)
        {
            return "Confirm next actions for high-priority work.";
        }

        if (totalAssigned >= 6)
        {
            return "Review capacity and upcoming due dates.";
        }

        if (nextDueDate.HasValue)
        {
            return $"Next follow-up due {nextDueDate.Value:dd MMM yyyy}.";
        }

        return "No immediate follow-up pressure found.";
    }

    private static string GetOwnerSummary(WorkloadRow row)
    {
        return $"{row.OpenWorkOrders} work orders • {row.OpenCorrectiveActions} actions • {row.OpenDocumentIntake} intake";
    }

    private static string GetDueTimingText(DateTime dueDate)
    {
        var days = (dueDate.Date - DateTime.Today).Days;

        if (days < 0)
        {
            return $"{Math.Abs(days)} day(s) overdue";
        }

        if (days == 0)
        {
            return "Due today";
        }

        if (days == 1)
        {
            return "Due tomorrow";
        }

        return $"Due in {days} day(s)";
    }

    private static string GetPressureClass(string? pressure)
    {
        return pressure?.ToLowerInvariant() switch
        {
            "high" => "badge badge-danger",
            "medium" => "badge badge-warning",
            "low" => "badge badge-success",
            _ => "badge badge-muted"
        };
    }

    private static bool Contains(string? source, string search)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private sealed record WorkloadItem(
        string Owner,
        string ModuleName,
        string Reference,
        string Title,
        string Priority,
        DateTime DueDate,
        bool IsOverdue,
        string Url);

    private sealed record WorkloadRow(
        string Owner,
        int TotalAssigned,
        int OpenWorkOrders,
        int OpenCorrectiveActions,
        int OpenDocumentIntake,
        int OverdueCount,
        int HighPriorityCount,
        DateTime? NextDueDate,
        string PressureLevel,
        string RecommendedFocus,
        List<WorkloadItem> Items)
    {
        public int PressureSort => PressureLevel switch
        {
            "High" => 3,
            "Medium" => 2,
            "Low" => 1,
            _ => 0
        };
    }
}