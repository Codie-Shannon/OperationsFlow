@page "/corrective-actions/create"

@using Microsoft.AspNetCore.Components
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services

@inject OperationsFlowDbContext Db
@inject ActivityLogService ActivityLogService
@inject NavigationManager Navigation

<PageTitle>Create Corrective Action - OperationsFlow</PageTitle>

<div class="page-shell module-page corrective-action-create-page">
    <section class="module-header">
        <div>
            <p class="eyebrow dark">Operations</p>
            <h1>Create Corrective Action</h1>
            <p>
                Add a corrective or improvement action from an incident, audit, inspection,
                risk review, document review, training issue, or management follow-up.
            </p>
        </div>

        <div class="module-header-stat">
            <span>New Record</span>
            <strong>CA</strong>
        </div>
    </section>

    @if (IsPrefilled)
    {
        <section class="page-purpose-note">
            <strong>Source-linked action:</strong> this corrective action was pre-filled from
            <strong>@GetSourceDisplayName(correctiveAction.Source)</strong>.
            Review the source, title, owner, priority, due date, and notes before saving.
        </section>

        <section class="summary-grid">
            <div class="summary-panel">
                <div class="panel-header">
                    <div>
                        <h2>Source Context</h2>
                        <p>This action is being created from another OperationsFlow module.</p>
                    </div>

                    <span class="@GetSourceBadgeClass(correctiveAction.Source)">
                        @GetSourceDisplayName(correctiveAction.Source)
                    </span>
                </div>

                <div class="detail-grid">
                    <div>
                        <span>Source Module</span>
                        <strong>@GetSourceDisplayName(correctiveAction.Source)</strong>
                    </div>

                    <div>
                        <span>Suggested Owner</span>
                        <strong>@DisplayText(correctiveAction.Owner)</strong>
                    </div>

                    <div>
                        <span>Suggested Priority</span>
                        <strong>
                            <span class="@GetPriorityClass(correctiveAction.Priority)">
                                @DisplayText(correctiveAction.Priority)
                            </span>
                        </strong>
                    </div>

                    <div>
                        <span>Return After Save</span>
                        <strong>@GetReturnDestinationText()</strong>
                    </div>
                </div>
            </div>

            <div class="summary-panel">
                <div class="panel-header">
                    <div>
                        <h2>Review Before Saving</h2>
                        <p>Use this check to keep cross-module follow-up clear.</p>
                    </div>
                </div>

                <ul class="review-list">
                    <li>Confirm the title clearly describes the follow-up work.</li>
                    <li>Confirm the owner is the person responsible for the next action.</li>
                    <li>Confirm the priority matches the risk, compliance, or operational impact.</li>
                    <li>Confirm the notes include enough context to understand the source issue.</li>
                    <li>Save the action so it appears in Corrective Actions, Workload, Reminders, Reports, and Data Quality.</li>
                </ul>
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <section class="table-card corrective-action-create-card" style="padding: 1.35rem; overflow: visible;">
        <div class="form-grid corrective-action-create-grid" style="padding-top: 0.75rem; padding-left: 0.15rem; overflow: visible;">
            <div class="form-field full-width" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Title</label>
                <input class="form-control" @bind="correctiveAction.Title" />
            </div>

            <div class="form-field" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Source</label>
                <select class="form-select" @bind="correctiveAction.Source">
                    @foreach (var source in SourceOptions)
                    {
                        <option value="@source">@source</option>
                    }
                </select>

                <FormFieldGuide Title="Source guidance"
                                Text="The source explains where this corrective action came from. Source-linked actions should keep enough context in the notes so the follow-up is traceable." />
            </div>

            <div class="form-field" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Action Type</label>
                <select class="form-select" @bind="correctiveAction.ActionType">
                    @foreach (var actionType in ActionTypeOptions)
                    {
                        <option value="@actionType">@actionType</option>
                    }
                </select>
            </div>

            <div class="form-field" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Site</label>
                <select class="form-select" @bind="correctiveAction.Site">
                    @foreach (var site in SiteOptions)
                    {
                        <option value="@site">@site</option>
                    }
                </select>
            </div>

            <div class="form-field" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Department</label>
                <select class="form-select" @bind="correctiveAction.Department">
                    @foreach (var department in DepartmentOptions)
                    {
                        <option value="@department">@department</option>
                    }
                </select>
            </div>

            <div class="form-field" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Owner</label>
                <input class="form-control" @bind="correctiveAction.Owner" />

                <FormFieldGuide Title="Owner guidance"
                                Text="Assign one clear owner so follow-up responsibility appears correctly in workload, reminders, reports, and data quality checks." />
            </div>

            <div class="form-field" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Priority</label>
                <select class="form-select" @bind="correctiveAction.Priority">
                    @foreach (var priority in PriorityOptions)
                    {
                        <option value="@priority">@priority</option>
                    }
                </select>
            </div>

            <div class="form-field" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Status</label>
                <select class="form-select" @bind="correctiveAction.Status">
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
        </div>

        <StatusFlowGuide Title="Corrective action status flow"
                         Description="Use statuses consistently so overdue, completed, and active follow-up work stays clear."
                         Steps="CorrectiveActionStatusSteps" />

        <div class="form-grid form-grid-spaced" style="padding-left: 0.15rem; overflow: visible;">
            <div class="form-field" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Created Date</label>
                <input class="form-control" type="date" @bind="correctiveAction.CreatedDate" />
            </div>

            <div class="form-field" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Due Date</label>
                <input class="form-control" type="date" @bind="correctiveAction.DueDate" />

                <FormFieldGuide Title="Due date guidance"
                                Text="Use the next realistic follow-up date. Overdue actions appear in the Safety Meeting Pack, Compliance Calendar, Workload, Reports, and Data Quality." />
            </div>

            <div class="form-field full-width" style="overflow: visible;">
                <label style="display: block; line-height: 1.35; margin-bottom: 0.45rem; overflow: visible;">Notes</label>
                <textarea class="form-control" rows="10" @bind="correctiveAction.Notes"></textarea>

                <div class="guidance-card">
                    <div>
                        <strong>Corrective action note guidance</strong>
                        <p>
                            Good corrective action notes should explain the current follow-up state, not just repeat the title.
                        </p>

                        <ul>
                            <li>What source record or issue created this follow-up?</li>
                            <li>What needs to be reviewed or changed?</li>
                            <li>Who owns the next action?</li>
                            <li>What needs to happen before this can be closed?</li>
                            <li>If closing, what evidence or outcome confirms completion?</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <button class="btn btn-secondary" type="button" @onclick="Cancel">Cancel</button>
            <button class="btn btn-primary" type="button" @onclick="SaveCorrectiveAction">Save Corrective Action</button>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery] public string? Source { get; set; }
    [SupplyParameterFromQuery] public string? Title { get; set; }
    [SupplyParameterFromQuery] public string? Site { get; set; }
    [SupplyParameterFromQuery] public string? Department { get; set; }
    [SupplyParameterFromQuery] public string? Owner { get; set; }
    [SupplyParameterFromQuery] public string? Priority { get; set; }
    [SupplyParameterFromQuery] public string? ActionType { get; set; }
    [SupplyParameterFromQuery] public string? Notes { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private CorrectiveAction correctiveAction = new();
    private string errorMessage = "";

    private bool IsPrefilled =>
        !string.IsNullOrWhiteSpace(Source)
        || !string.IsNullOrWhiteSpace(Title)
        || !string.IsNullOrWhiteSpace(Site)
        || !string.IsNullOrWhiteSpace(Department)
        || !string.IsNullOrWhiteSpace(Owner)
        || !string.IsNullOrWhiteSpace(Priority)
        || !string.IsNullOrWhiteSpace(ActionType)
        || !string.IsNullOrWhiteSpace(Notes)
        || !string.IsNullOrWhiteSpace(ReturnUrl);

    private List<string> SourceOptions = new()
    {
        "Incident",
        "Inspection",
        "Internal Audit",
        "Risk Register",
        "Risk Review",
        "Document Control",
        "Document Review",
        "Training Compliance",
        "Hazard Report",
        "Quality Review",
        "Management Review",
        "Manual / Internal"
    };

    private List<string> ActionTypeOptions = new()
    {
        "Investigation",
        "Repair",
        "Process Review",
        "Document Update",
        "Checklist",
        "Training",
        "System Update",
        "Follow-up",
        "Improvement",
        "Containment"
    };

    private List<string> SiteOptions = new()
    {
        "Main Workshop",
        "Yard",
        "Admin Office",
        "Warehouse",
        "Dispatch Bay"
    };

    private List<string> DepartmentOptions = new()
    {
        "Operations",
        "Health & Safety",
        "Admin",
        "Maintenance",
        "Warehouse",
        "Dispatch",
        "Quality"
    };

    private List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private List<string> StatusOptions = new()
    {
        "Open",
        "In Progress",
        "Completed",
        "Closed"
    };

    private static readonly IReadOnlyList<StatusFlowGuide.StatusFlowStep> CorrectiveActionStatusSteps = new[]
    {
        new StatusFlowGuide.StatusFlowStep("Open", "Action has been raised but work has not started yet.", "badge badge-warning"),
        new StatusFlowGuide.StatusFlowStep("In Progress", "Owner is actively working through the follow-up.", "badge badge-info"),
        new StatusFlowGuide.StatusFlowStep("Completed", "Work is finished and should have a completed date.", "badge badge-success"),
        new StatusFlowGuide.StatusFlowStep("Closed", "Final review is complete and no further follow-up is needed.", "badge badge-success")
    };

    protected override void OnInitialized()
    {
        var source = UseAllowedOrDefault(Source, SourceOptions, "Incident");
        var title = UseOrDefault(Title, "");
        var site = UseAllowedOrDefault(Site, SiteOptions, "Main Workshop");
        var department = UseAllowedOrDefault(Department, DepartmentOptions, "Health & Safety");
        var owner = UseOrDefault(Owner, "");
        var actionType = UseAllowedOrDefault(ActionType, ActionTypeOptions, GetDefaultActionTypeForSource(source));
        var priority = UseAllowedOrDefault(Priority, PriorityOptions, "Medium");
        var notes = BuildSourceAwareNotes(source, Notes);

        correctiveAction = new CorrectiveAction
        {
            Title = title,
            Source = source,
            Site = site,
            Department = department,
            Owner = owner,
            ActionType = actionType,
            Priority = priority,
            Status = "Open",
            CreatedDate = DateTime.Today,
            DueDate = DateTime.Today.AddDays(14),
            CompletedDate = null,
            Notes = notes
        };
    }

    private async Task SaveCorrectiveAction()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(correctiveAction.Title))
        {
            errorMessage = "Please enter a title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Owner))
        {
            errorMessage = "Please enter an owner.";
            return;
        }

        if (correctiveAction.DueDate < correctiveAction.CreatedDate)
        {
            errorMessage = "Due date cannot be before created date.";
            return;
        }

        if (IsCompletedStatus(correctiveAction.Status))
        {
            correctiveAction.CompletedDate = DateTime.Today;
        }
        else
        {
            correctiveAction.CompletedDate = null;
        }

        Db.CorrectiveActions.Add(correctiveAction);
        await Db.SaveChangesAsync();

        await ActivityLogService.LogAsync(
            moduleName: "Corrective Actions",
            recordId: correctiveAction.Id,
            recordReference: $"CA-{correctiveAction.Id}",
            actionType: "Created",
            description: BuildCreatedActivityDescription()
        );

        BackToReturnPage();
    }

    private string BuildCreatedActivityDescription()
    {
        if (!IsPrefilled)
        {
            return $"Created corrective action CA-{correctiveAction.Id}: {correctiveAction.Title}.";
        }

        return $"Created corrective action CA-{correctiveAction.Id} from {GetSourceDisplayName(correctiveAction.Source)}: {correctiveAction.Title}.";
    }

    private string BuildSourceAwareNotes(string source, string? incomingNotes)
    {
        var cleanNotes = UseOrDefault(incomingNotes, "");

        if (!IsPrefilled)
        {
            return cleanNotes;
        }

        var sourceHeader = $"Source context: {GetSourceDisplayName(source)}";
        var returnText = string.IsNullOrWhiteSpace(ReturnUrl)
            ? "Return destination: Corrective Actions"
            : $"Return destination: {GetReturnDestinationText()}";

        if (string.IsNullOrWhiteSpace(cleanNotes))
        {
            return sourceHeader + Environment.NewLine
                + returnText + Environment.NewLine + Environment.NewLine
                + "Follow-up notes:" + Environment.NewLine
                + "- Confirm the source issue." + Environment.NewLine
                + "- Record the required action." + Environment.NewLine
                + "- Update the status when reviewed.";
        }

        if (cleanNotes.Contains("Source context:", StringComparison.OrdinalIgnoreCase))
        {
            return cleanNotes;
        }

        return sourceHeader + Environment.NewLine
            + returnText + Environment.NewLine + Environment.NewLine
            + cleanNotes;
    }

    private void Cancel()
    {
        BackToReturnPage();
    }

    private void BackToReturnPage()
    {
        var fallbackUrl = "/corrective-actions";

        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        if (!ReturnUrl.StartsWith("/"))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        Navigation.NavigateTo(ReturnUrl);
    }

    private string GetReturnDestinationText()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            return "Corrective Actions";
        }

        return ReturnUrl switch
        {
            "/risk-register" => "Risk Register",
            "/risks" => "Risk Register",
            "/documents" => "Documents",
            "/training" => "Training",
            "/safety-meeting-pack" => "Safety Meeting Pack",
            "/data-quality" => "Data Quality",
            "/reminders" => "Reminder Centre",
            "/workload" => "Workload",
            "/reports" => "Reports",
            _ => ReturnUrl
        };
    }

    private static string GetDefaultActionTypeForSource(string source)
    {
        return source switch
        {
            "Risk Register" => "Process Review",
            "Risk Review" => "Process Review",
            "Document Control" => "Document Update",
            "Document Review" => "Document Update",
            "Training Compliance" => "Training",
            "Incident" => "Investigation",
            "Inspection" => "Checklist",
            "Internal Audit" => "Process Review",
            _ => "Follow-up"
        };
    }

    private static string GetSourceDisplayName(string? source)
    {
        return source switch
        {
            "Risk Register" => "Risk Register",
            "Risk Review" => "Risk Register",
            "Document Control" => "Document Control",
            "Document Review" => "Document Control",
            "Training Compliance" => "Training Compliance",
            "Internal Audit" => "Internal Audit",
            "Manual / Internal" => "Manual / Internal",
            null or "" => "Manual / Internal",
            _ => source
        };
    }

    private static string GetSourceBadgeClass(string? source)
    {
        return source switch
        {
            "Risk Register" => "badge badge-danger",
            "Risk Review" => "badge badge-danger",
            "Document Control" => "badge badge-info",
            "Document Review" => "badge badge-info",
            "Training Compliance" => "badge badge-warning",
            "Incident" => "badge badge-danger",
            "Inspection" => "badge badge-warning",
            "Internal Audit" => "badge badge-info",
            _ => "badge badge-muted"
        };
    }

    private static string GetPriorityClass(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static string UseOrDefault(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string UseAllowedOrDefault(string? value, List<string> allowedValues, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        var matchingValue = allowedValues
            .FirstOrDefault(x => string.Equals(x, value, StringComparison.OrdinalIgnoreCase));

        return matchingValue ?? fallback;
    }

    private static bool IsCompletedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase);
    }
}