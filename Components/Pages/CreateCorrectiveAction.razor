@page "/corrective-actions/create"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@inject OperationsFlowDbContext Db
@inject ActivityLogService ActivityLogService
@inject NavigationManager Navigation

<PageTitle>Create Corrective Action - OperationsFlow</PageTitle>

<PageHero Eyebrow="Operations"
          Title="Create Corrective Action"
          Subtitle="Create a new owned follow-up action for incidents, audits, inspections, risks, training gaps, document reviews, or improvement work."
          BadgeText="New Action"
          BadgeClass="of-badge-warning">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/corrective-actions">Back to Actions</a>
        <a class="of-btn of-btn-secondary" href="/risk-register">Risk Register</a>
        <a class="of-btn of-btn-secondary" href="/training">Training</a>
        <a class="of-btn of-btn-secondary" href="/documents">Documents</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="✅">
    <p>
        Corrective Actions turn issues into owned follow-up work. Use this page to capture the action,
        source, owner, priority, status, due date, completion date, and supporting notes.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Record Type"
                Value="Action"
                Detail="Corrective or improvement follow-up"
                Icon="📋" />

    <MetricCard Title="Default Status"
                Value="@correctiveAction.Status"
                Detail="New actions start as open work"
                Icon="🟡"
                Tone="warning" />

    <MetricCard Title="Priority"
                Value="@correctiveAction.Priority"
                Detail="Adjust if the issue is urgent"
                Icon="⚡"
                Tone="@GetPriorityTone(correctiveAction.Priority)" />

    <MetricCard Title="Due Date"
                Value="@correctiveAction.DueDate.ToString("dd MMM")"
                Detail="@correctiveAction.DueDate.ToString("yyyy")"
                Icon="📅"
                Tone="info" />
</MetricGrid>

<InfoPanel Title="Corrective Action Workflow" Subtitle="What this record is expected to track.">
    <ChildContent>
        <div class="of-two-column-grid">
            <GuidanceNote Title="Record should answer" Icon="✅" Tone="success">
                <ul>
                    <li>What issue or improvement needs action?</li>
                    <li>Where did the action come from?</li>
                    <li>Who owns the next step?</li>
                    <li>How urgent is the work?</li>
                    <li>When is the follow-up due?</li>
                </ul>
            </GuidanceNote>

            <GuidanceNote Title="Source-linked examples" Icon="🔗" Tone="info">
                <ul>
                    <li>Risk Register item needing mitigation.</li>
                    <li>Training gap needing booking or renewal.</li>
                    <li>Document review needing update or approval.</li>
                    <li>Inspection issue needing repair or evidence.</li>
                    <li>Audit finding needing closure evidence.</li>
                </ul>
            </GuidanceNote>
        </div>
    </ChildContent>
</InfoPanel>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <GuidanceNote Title="Save blocked" Icon="⚠️" Tone="danger">
        <p>@errorMessage</p>
    </GuidanceNote>
}

<InfoPanel Title="New Corrective Action" Subtitle="Complete the fields below and save the action.">
    <ChildContent>
        <EditForm Model="correctiveAction" OnSubmit="SaveCorrectiveAction">
            <div class="of-form-grid">
                <div class="of-form-field of-form-field--wide">
                    <label for="title">Title</label>
                    <InputText id="title" class="of-input" @bind-Value="correctiveAction.Title" />
                </div>

                <div class="of-form-field">
                    <label for="source">Source</label>
                    <InputSelect id="source" class="of-select" @bind-Value="correctiveAction.Source">
                        @foreach (var source in SourceOptions)
                        {
                            <option value="@source">@source</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="site">Site</label>
                    <InputSelect id="site" class="of-select" @bind-Value="correctiveAction.Site">
                        @foreach (var site in SiteOptions)
                        {
                            <option value="@site">@site</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="department">Department</label>
                    <InputSelect id="department" class="of-select" @bind-Value="correctiveAction.Department">
                        @foreach (var department in DepartmentOptions)
                        {
                            <option value="@department">@department</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="owner">Owner</label>
                    <InputText id="owner" class="of-input" @bind-Value="correctiveAction.Owner" />
                </div>

                <div class="of-form-field">
                    <label for="actionType">Action Type</label>
                    <InputSelect id="actionType" class="of-select" @bind-Value="correctiveAction.ActionType">
                        @foreach (var actionType in ActionTypeOptions)
                        {
                            <option value="@actionType">@actionType</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="priority">Priority</label>
                    <InputSelect id="priority" class="of-select" @bind-Value="correctiveAction.Priority">
                        @foreach (var priority in PriorityOptions)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="status">Status</label>
                    <InputSelect id="status" class="of-select" @bind-Value="correctiveAction.Status">
                        @foreach (var status in StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>

                <div class="of-form-field">
                    <label for="dueDate">Due Date</label>
                    <InputDate id="dueDate" class="of-input" @bind-Value="correctiveAction.DueDate" />
                </div>

                <div class="of-form-field">
                    <label for="completedDate">Completed Date</label>
                    <InputDate id="completedDate" class="of-input" @bind-Value="correctiveAction.CompletedDate" />
                </div>

                <div class="of-form-field of-form-field--full">
                    <label for="notes">Notes</label>
                    <InputTextArea id="notes" class="of-textarea" @bind-Value="correctiveAction.Notes" />
                </div>
            </div>

            <div class="of-form-actions">
                <button type="button" class="of-btn of-btn-secondary" @onclick="Cancel">Cancel</button>
                <button type="submit" class="of-btn of-btn-primary">Save Corrective Action</button>
            </div>
        </EditForm>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="After Saving" Subtitle="This action becomes part of the wider workflow evidence.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Action Register</strong>
                <span>The saved action can be searched, filtered, opened, and edited.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Workload</strong>
                <span>The owner and due date feed workload pressure and follow-up visibility.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Reminders</strong>
                <span>Overdue and due-soon actions appear in reminder views.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Traceability</strong>
                <span>The Activity Log records that this corrective action was created.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Prototype Boundary" Icon="🧱" Tone="warning">
    <ul>
        <li>This page tracks corrective action workflow metadata in local SQLite.</li>
        <li>It does not yet enforce production approvals, signatures, or evidence attachment rules.</li>
        <li>It does not yet sync to Microsoft Lists, SharePoint, Teams, Outlook, or Power Automate.</li>
        <li>A production version would add permissions, notifications, audit retention, evidence files, and approval routing.</li>
    </ul>
</GuidanceNote>

@code {
    [SupplyParameterFromQuery(Name = "source")] public string? QuerySource { get; set; }
    [SupplyParameterFromQuery(Name = "title")] public string? QueryTitle { get; set; }
    [SupplyParameterFromQuery(Name = "site")] public string? QuerySite { get; set; }
    [SupplyParameterFromQuery(Name = "department")] public string? QueryDepartment { get; set; }
    [SupplyParameterFromQuery(Name = "owner")] public string? QueryOwner { get; set; }
    [SupplyParameterFromQuery(Name = "priority")] public string? QueryPriority { get; set; }
    [SupplyParameterFromQuery(Name = "notes")] public string? QueryNotes { get; set; }

    private CorrectiveAction correctiveAction = new();
    private string errorMessage = "";

    private readonly List<string> SourceOptions = new()
    {
        "Manual Entry",
        "Incident",
        "Audit",
        "Inspection",
        "Risk Register",
        "Training",
        "Document Control",
        "Work Order",
        "Management Review",
        "Improvement"
    };

    private readonly List<string> SiteOptions = new()
    {
        "Main Workshop",
        "Yard",
        "Admin Office",
        "Warehouse",
        "Dispatch Bay",
        "All Sites"
    };

    private readonly List<string> DepartmentOptions = new()
    {
        "Operations",
        "Health & Safety",
        "Admin",
        "Maintenance",
        "Warehouse",
        "Dispatch",
        "Quality",
        "Management"
    };

    private readonly List<string> ActionTypeOptions = new()
    {
        "Corrective Action",
        "Preventive Action",
        "Improvement",
        "Review",
        "Process Review",
        "Checklist",
        "Training",
        "Document Update",
        "Maintenance",
        "Repair",
        "Investigation",
        "System Update",
        "Evidence Required"
    };

    private readonly List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private readonly List<string> StatusOptions = new()
    {
        "Open",
        "In Progress",
        "Completed",
        "Closed"
    };

    protected override void OnInitialized()
    {
        correctiveAction = new CorrectiveAction
        {
            Title = string.IsNullOrWhiteSpace(QueryTitle) ? "" : QueryTitle,
            Source = NormalizeOption(QuerySource, SourceOptions, "Manual Entry"),
            Site = NormalizeOption(QuerySite, SiteOptions, "Main Workshop"),
            Department = NormalizeOption(QueryDepartment, DepartmentOptions, "Operations"),
            Owner = QueryOwner ?? "",
            ActionType = "Corrective Action",
            Priority = NormalizeOption(QueryPriority, PriorityOptions, "Medium"),
            Status = "Open",
            DueDate = DateTime.Today.AddDays(7),
            CompletedDate = null,
            Notes = QueryNotes ?? ""
        };
    }

    private async Task SaveCorrectiveAction()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(correctiveAction.Title))
        {
            errorMessage = "Please enter a title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Owner))
        {
            errorMessage = "Please enter an owner.";
            return;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Source))
        {
            errorMessage = "Please select or enter a source.";
            return;
        }

        if (IsCompletedStatus(correctiveAction.Status) && !correctiveAction.CompletedDate.HasValue)
        {
            correctiveAction.CompletedDate = DateTime.Today;
        }

        if (!IsCompletedStatus(correctiveAction.Status))
        {
            correctiveAction.CompletedDate = null;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Notes))
        {
            correctiveAction.Notes = BuildDefaultNotes();
        }

        Db.CorrectiveActions.Add(correctiveAction);
        await Db.SaveChangesAsync();

        await ActivityLogService.LogAsync(
            moduleName: "Corrective Actions",
            recordId: correctiveAction.Id,
            recordReference: correctiveAction.Title,
            actionType: "Created",
            description: BuildCreatedDescription());

        Navigation.NavigateTo("/corrective-actions");
    }

    private string BuildCreatedDescription()
    {
        return $"Created corrective action '{correctiveAction.Title}' from source '{correctiveAction.Source}'. Assigned to {correctiveAction.Owner}, priority {correctiveAction.Priority}, status {correctiveAction.Status}.";
    }

    private string BuildDefaultNotes()
    {
        return "Initial corrective action created."
            + Environment.NewLine + $"Source: {correctiveAction.Source}"
            + Environment.NewLine + $"Site: {correctiveAction.Site}"
            + Environment.NewLine + $"Department: {correctiveAction.Department}"
            + Environment.NewLine + $"Action Type: {correctiveAction.ActionType}"
            + Environment.NewLine + $"Owner: {correctiveAction.Owner}"
            + Environment.NewLine + "Next step: progress, review, complete, or close the action.";
    }

    private void Cancel()
    {
        Navigation.NavigateTo("/corrective-actions");
    }

    private static string NormalizeOption(string? value, List<string> options, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        var match = options.FirstOrDefault(x => string.Equals(x, value, StringComparison.OrdinalIgnoreCase));
        return match ?? value;
    }

    private static bool IsCompletedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetPriorityTone(string? priority)
    {
        return priority?.ToLowerInvariant() switch
        {
            "critical" => "danger",
            "high" => "warning",
            "medium" => "info",
            "low" => "default",
            _ => "default"
        };
    }
}