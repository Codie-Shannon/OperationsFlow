@page "/corrective-actions/create"
@using Microsoft.AspNetCore.Components
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@inject OperationsFlowDbContext Db
@inject ActivityLogService ActivityLogService
@inject NavigationManager Navigation

<PageTitle>Create Corrective Action - OperationsFlow</PageTitle>

<div class="page-shell module-page">

    <section class="module-header">
        <div>
            <p class="eyebrow dark">Operations</p>
            <h1>Create Corrective Action</h1>
            <p>
                Add a corrective or improvement action from an incident, audit,
                inspection, risk review, document review, training issue, or management follow-up.
            </p>
        </div>

        <div class="module-header-stat">
            <span>New Record</span>
            <strong>CA</strong>
        </div>
    </section>

    @if (IsPrefilled)
    {
        <section class="alert-card info-alert">
            This corrective action was pre-filled from another OperationsFlow module. Review the details before saving.
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <section class="alert-card danger-alert">
            @errorMessage
        </section>
    }

    <section class="form-card">
        <EditForm Model="correctiveAction" OnValidSubmit="SaveCorrectiveAction">
            <DataAnnotationsValidator />

            <div class="form-grid">

                <div class="form-field form-field-full">
                    <label>Title</label>
                    <InputText class="form-input" @bind-Value="correctiveAction.Title" />
                </div>

                <div class="form-field">
                    <label>Source</label>
                    <InputSelect class="form-input" @bind-Value="correctiveAction.Source">
                        @foreach (var source in SourceOptions)
                        {
                            <option value="@source">@source</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Action Type</label>
                    <InputSelect class="form-input" @bind-Value="correctiveAction.ActionType">
                        @foreach (var actionType in ActionTypeOptions)
                        {
                            <option value="@actionType">@actionType</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Site</label>
                    <InputSelect class="form-input" @bind-Value="correctiveAction.Site">
                        @foreach (var site in SiteOptions)
                        {
                            <option value="@site">@site</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Department</label>
                    <InputSelect class="form-input" @bind-Value="correctiveAction.Department">
                        @foreach (var department in DepartmentOptions)
                        {
                            <option value="@department">@department</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Owner</label>
                    <InputText class="form-input" @bind-Value="correctiveAction.Owner" />
                </div>

                <div class="form-field">
                    <label>Priority</label>
                    <InputSelect class="form-input" @bind-Value="correctiveAction.Priority">
                        @foreach (var priority in PriorityOptions)
                        {
                            <option value="@priority">@priority</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Status</label>
                    <InputSelect class="form-input" @bind-Value="correctiveAction.Status">
                        @foreach (var status in StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </InputSelect>
                </div>

                <div class="form-field">
                    <label>Created Date</label>
                    <InputDate class="form-input" @bind-Value="correctiveAction.CreatedDate" />
                </div>

                <div class="form-field">
                    <label>Due Date</label>
                    <InputDate class="form-input" @bind-Value="correctiveAction.DueDate" />
                </div>

                <div class="form-field form-field-full">
                    <label>Notes</label>
                    <InputTextArea class="form-input form-textarea" @bind-Value="correctiveAction.Notes" />
                </div>

            </div>

            <div class="form-actions">
                <button type="button" class="secondary-button" @onclick="Cancel">
                    Cancel
                </button>

                <button type="submit" class="primary-button">
                    Save Corrective Action
                </button>
            </div>
        </EditForm>
    </section>

</div>

@code {
    [SupplyParameterFromQuery]
    public string? Source { get; set; }

    [SupplyParameterFromQuery]
    public string? Title { get; set; }

    [SupplyParameterFromQuery]
    public string? Site { get; set; }

    [SupplyParameterFromQuery]
    public string? Department { get; set; }

    [SupplyParameterFromQuery]
    public string? Owner { get; set; }

    [SupplyParameterFromQuery]
    public string? Priority { get; set; }

    [SupplyParameterFromQuery]
    public string? ActionType { get; set; }

    [SupplyParameterFromQuery]
    public string? Notes { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private CorrectiveAction correctiveAction = new();
    private string errorMessage = "";

    private bool IsPrefilled =>
        !string.IsNullOrWhiteSpace(Source) ||
        !string.IsNullOrWhiteSpace(Title) ||
        !string.IsNullOrWhiteSpace(Site) ||
        !string.IsNullOrWhiteSpace(Department) ||
        !string.IsNullOrWhiteSpace(Owner) ||
        !string.IsNullOrWhiteSpace(Priority) ||
        !string.IsNullOrWhiteSpace(ActionType) ||
        !string.IsNullOrWhiteSpace(Notes);

    private List<string> SourceOptions = new()
    {
        "Incident",
        "Inspection",
        "Internal Audit",
        "Risk Review",
        "Document Review",
        "Training Compliance",
        "Hazard Report",
        "Quality Review",
        "Management Review",
        "Risk Register",
        "Document Control",
        "Training Compliance"
    };

    private List<string> ActionTypeOptions = new()
    {
        "Investigation",
        "Repair",
        "Process Review",
        "Document Update",
        "Checklist",
        "Training",
        "System Update",
        "Follow-up"
    };

    private List<string> SiteOptions = new()
    {
        "Main Workshop",
        "Yard",
        "Admin Office",
        "Warehouse",
        "Dispatch Bay"
    };

    private List<string> DepartmentOptions = new()
    {
        "Operations",
        "Health & Safety",
        "Admin",
        "Maintenance",
        "Warehouse",
        "Dispatch",
        "Quality"
    };

    private List<string> PriorityOptions = new()
    {
        "Low",
        "Medium",
        "High",
        "Critical"
    };

    private List<string> StatusOptions = new()
    {
        "Open",
        "In Progress",
        "Completed",
        "Closed"
    };

    protected override void OnInitialized()
    {
        correctiveAction = new CorrectiveAction
        {
            Title = UseOrDefault(Title, ""),
            Source = UseAllowedOrDefault(Source, SourceOptions, "Incident"),
            Site = UseAllowedOrDefault(Site, SiteOptions, "Main Workshop"),
            Department = UseAllowedOrDefault(Department, DepartmentOptions, "Health & Safety"),
            Owner = UseOrDefault(Owner, ""),
            ActionType = UseAllowedOrDefault(ActionType, ActionTypeOptions, "Investigation"),
            Priority = UseAllowedOrDefault(Priority, PriorityOptions, "Medium"),
            Status = "Open",
            CreatedDate = DateTime.Today,
            DueDate = DateTime.Today.AddDays(14),
            CompletedDate = null,
            Notes = UseOrDefault(Notes, "")
        };
    }

    private async Task SaveCorrectiveAction()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(correctiveAction.Title))
        {
            errorMessage = "Please enter a title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(correctiveAction.Owner))
        {
            errorMessage = "Please enter an owner.";
            return;
        }

        if (correctiveAction.DueDate < correctiveAction.CreatedDate)
        {
            errorMessage = "Due date cannot be before created date.";
            return;
        }

        if (IsCompletedStatus(correctiveAction.Status))
        {
            correctiveAction.CompletedDate = DateTime.Today;
        }
        else
        {
            correctiveAction.CompletedDate = null;
        }

        Db.CorrectiveActions.Add(correctiveAction);
        await Db.SaveChangesAsync();

        await ActivityLogService.LogAsync(
            moduleName: "Corrective Actions",
            recordId: correctiveAction.Id,
            recordReference: $"CA-{correctiveAction.Id}",
            actionType: "Created",
            description: BuildCreatedActivityDescription()
        );

        BackToReturnPage();
    }

    private void Cancel()
    {
        BackToReturnPage();
    }

    private void BackToReturnPage()
    {
        var fallbackUrl = "/corrective-actions";

        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        if (!ReturnUrl.StartsWith("/"))
        {
            Navigation.NavigateTo(fallbackUrl);
            return;
        }

        Navigation.NavigateTo(ReturnUrl);
    }

    private static string UseOrDefault(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string UseAllowedOrDefault(string? value, List<string> allowedValues, string fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        var matchingValue = allowedValues
            .FirstOrDefault(x => string.Equals(x, value, StringComparison.OrdinalIgnoreCase));

        return matchingValue ?? fallback;
    }

    private static bool IsCompletedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase);
    }

    private string BuildCreatedActivityDescription()
    {
        if (!IsPrefilled)
        {
            return $"Created corrective action CA-{correctiveAction.Id}: {correctiveAction.Title}.";
        }

        var sourceText = correctiveAction.Source switch
        {
            "Risk Register" => "Risk Register item",
            "Risk Review" => "Risk Register item",
            "Document Control" => "Document Control item",
            "Document Review" => "Document Control item",
            "Training Compliance" => "Training Compliance item",
            _ => $"{correctiveAction.Source} item"
        };

        return $"Created corrective action from {sourceText}: {correctiveAction.Title}.";
    }
}