@page "/risks"
@page "/risk-register"
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db

<PageTitle>Risk Register - OperationsFlow</PageTitle>

<PageHero Eyebrow="Compliance"
          Title="Risk Register"
          Subtitle="Track operational hazards, risk scoring, controls, owners, review dates, high-priority risk items, and source-linked corrective actions."
          BadgeText="@($"{HighCriticalCount} high / critical")"
          BadgeClass="of-badge-warning">
    <Actions>
        <a class="of-btn of-btn-primary" href="/corrective-actions/create">+ New Corrective Action</a>
        <a class="of-btn of-btn-secondary" href="/corrective-actions">Corrective Actions</a>
        <a class="of-btn of-btn-secondary" href="/reminders">Reminders</a>
        <a class="of-btn of-btn-secondary" href="/reports">Reports</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="⚠️">
    <p>
        Use this page to review workplace risks and turn risk issues into owned corrective actions.
        Risk actions are pre-filled with source context so the follow-up remains traceable from risk review
        through action ownership, reminders, reporting, and activity evidence.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Total Risks"
                Value="@TotalCount.ToString()"
                Detail="All risk register items"
                Icon="📋" />

    <MetricCard Title="High / Critical"
                Value="@HighCriticalCount.ToString()"
                Detail="Requires close monitoring"
                Icon="🚨"
                Tone="danger" />

    <MetricCard Title="Review Overdue"
                Value="@OverdueReviewCount.ToString()"
                Detail="Risk review date has passed"
                Icon="📅"
                Tone="warning" />

    <MetricCard Title="Controlled"
                Value="@ControlledCount.ToString()"
                Detail="Risks currently marked controlled"
                Icon="✅"
                Tone="success" />

    <MetricCard Title="Actionable"
                Value="@ActionableRiskCount.ToString()"
                Detail="High, critical, overdue, or weak-control risks"
                Icon="🔗"
                Tone="info" />
</MetricGrid>

<InfoPanel Title="Risk Follow-Up Focus" Subtitle="Recommended review order for safety/compliance follow-up.">
    <ChildContent>
        <ol class="of-review-steps">
            <li>Review overdue risk reviews first.</li>
            <li>Check critical and high risks with weak or outdated controls.</li>
            <li>Create corrective actions for risks needing ownership, controls, or follow-up.</li>
            <li>Confirm owner, priority, due date, and source context before saving the corrective action.</li>
            <li>Use Workload, Reminders, Data Quality, and Activity Log to track follow-up after the action is created.</li>
        </ol>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Risk → Corrective Action Link" Subtitle="What the Create Action button does.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Source</strong>
                <span>The corrective action source is set to Risk Register.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Context</strong>
                <span>Hazard, owner, risk level, score, controls, and review date are copied into the notes.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Return</strong>
                <span>After saving, the workflow returns back to the Risk Register.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Traceability</strong>
                <span>The created corrective action is logged as source-linked follow-up work.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<FilterBar Title="Filter Risk Register">
    <ChildContent>
        <input class="of-input"
               placeholder="Search risks..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="of-select" @bind="statusFilter">
            <option value="">All Statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>

        <select class="of-select" @bind="levelFilter">
            <option value="">All Risk Levels</option>
            <option value="Critical">Critical</option>
            <option value="High">High</option>
            <option value="Medium">Medium</option>
            <option value="Low">Low</option>
        </select>

        <select class="of-select" @bind="departmentFilter">
            <option value="">All Departments</option>
            @foreach (var department in DepartmentOptions)
            {
                <option value="@department">@department</option>
            }
        </select>
    </ChildContent>

    <Actions>
        <a class="of-btn of-btn-secondary" href="/data-quality">Data Quality</a>
        <a class="of-btn of-btn-secondary" href="/activity-log">Activity Log</a>
    </Actions>
</FilterBar>

@if (risks == null)
{
    <InfoPanel Title="Loading Risk Register" Subtitle="Loading risk records from the local SQLite database.">
        <p class="of-muted-text">Loading risk register...</p>
    </InfoPanel>
}
else
{
    <TableCard Title="Risk Register"
               Subtitle="@($"Showing {FilteredRisks.Count()} of {TotalCount} risk register item(s). {FilteredRisks.Count(IsActionableRisk)} are currently actionable.")"
               IsEmpty="@(!FilteredRisks.Any())"
               EmptyTitle="No risks found"
               EmptyMessage="No risk register items match the current search or filter selection.">
        <table>
            <thead>
                <tr>
                    <th>Risk</th>
                    <th>Hazard</th>
                    <th>Site</th>
                    <th>Department</th>
                    <th>Owner</th>
                    <th>Likely</th>
                    <th>Conseq.</th>
                    <th>Score</th>
                    <th>Level</th>
                    <th>Status</th>
                    <th>Review Date</th>
                    <th>Flag</th>
                    <th>Follow-Up</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredRisks)
                {
                    <tr>
                        <td><strong>@item.Title</strong></td>
                        <td>@item.Hazard</td>
                        <td>@item.Site</td>
                        <td>@item.Department</td>
                        <td>@DisplayText(item.Owner)</td>
                        <td>@item.Likelihood</td>
                        <td>@item.Consequence</td>
                        <td><strong>@item.RiskScore</strong></td>
                        <td>
                            <span class="@GetRiskLevelClass(item.RiskLevel)">
                                @item.RiskLevel
                            </span>
                        </td>
                        <td>
                            <span class="@GetStatusClass(item.Status)">
                                @item.Status
                            </span>
                        </td>
                        <td>@item.ReviewDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.IsReviewOverdue)
                            {
                                <span class="of-badge of-badge-danger">Review Overdue</span>
                            }
                            else if (item.RiskLevel == "Critical" || item.RiskLevel == "High")
                            {
                                <span class="of-badge of-badge-warning">Monitor</span>
                            }
                            else if (string.IsNullOrWhiteSpace(item.Controls))
                            {
                                <span class="of-badge of-badge-warning">Needs Controls</span>
                            }
                            else
                            {
                                <span class="of-badge of-badge-success">Controlled</span>
                            }
                        </td>
                        <td>
                            <a class="of-card-link" href="@BuildCorrectiveActionUrlFromRisk(item)">Create Action</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </TableCard>
}

<InfoPanel Title="Priority Risk Follow-Ups"
           Subtitle="High, critical, overdue, or weak-control risks that should be checked first.">
    <ChildContent>
        @if (!PriorityRisks.Any())
        {
            <EmptyState Title="No priority risk follow-ups"
                        Message="There are currently no high, critical, overdue, or weak-control risk review flags."
                        Icon="✅" />
        }
        else
        {
            <div class="of-review-proof-grid">
                @foreach (var item in PriorityRisks.Take(6))
                {
                    <div class="of-review-proof-card">
                        <strong>@item.Title</strong>
                        <span>@item.Hazard</span>
                        <span>@item.Site • @item.Department • @DisplayText(item.Owner) • Score @item.RiskScore</span>

                        <div class="of-link-row">
                            <span class="@GetRiskLevelClass(item.RiskLevel)">
                                @item.RiskLevel
                            </span>

                            @if (item.IsReviewOverdue)
                            {
                                <span class="of-badge of-badge-danger">Review Overdue</span>
                            }

                            @if (string.IsNullOrWhiteSpace(item.Controls))
                            {
                                <span class="of-badge of-badge-warning">Needs Controls</span>
                            }

                            <a class="of-card-link" href="@BuildCorrectiveActionUrlFromRisk(item)">Create Action</a>
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Missing / Weak Control Notes"
           Subtitle="Risk items that may need better control detail before management review.">
    <ChildContent>
        @if (!WeakControlRisks.Any())
        {
            <EmptyState Title="No weak control notes found"
                        Message="All checked risk records currently include control information."
                        Icon="✅" />
        }
        else
        {
            <div class="of-review-proof-grid">
                @foreach (var item in WeakControlRisks.Take(6))
                {
                    <div class="of-review-proof-card">
                        <strong>@item.Title</strong>
                        <span>@item.Hazard</span>
                        <span>@item.Site • @item.Department • @DisplayText(item.Owner)</span>

                        <div class="of-link-row">
                            <span class="of-badge of-badge-warning">Needs Controls</span>
                            <a class="of-card-link" href="@BuildCorrectiveActionUrlFromRisk(item)">Create Action</a>
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Review Notes" Icon="💡" Tone="info">
    <ul>
        <li>High, critical, overdue, or weak-control risks should be reviewed first.</li>
        <li>Create Action links should open a pre-filled corrective action with source set to Risk Register.</li>
        <li>Risk context should be copied into the corrective action notes for traceability.</li>
        <li>Follow-up corrective actions should then appear in Corrective Actions, Workload, Reminders, Reports, and Activity Log.</li>
        <li>This is local SQLite demo data; Microsoft 365 / SharePoint / Power Automate sync is a later stage.</li>
    </ul>
</GuidanceNote>

@code {
    private List<RiskItem>? risks;

    private string searchText = "";
    private string statusFilter = "";
    private string levelFilter = "";
    private string departmentFilter = "";

    private IEnumerable<RiskItem> FilteredRisks
    {
        get
        {
            if (risks == null)
            {
                return Enumerable.Empty<RiskItem>();
            }

            var query = risks.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.Title, searchText) ||
                    Contains(x.Hazard, searchText) ||
                    Contains(x.Site, searchText) ||
                    Contains(x.Department, searchText) ||
                    Contains(x.Owner, searchText) ||
                    Contains(x.Controls, searchText) ||
                    Contains(x.Status, searchText) ||
                    Contains(x.RiskLevel, searchText));
            }

            if (!string.IsNullOrWhiteSpace(statusFilter))
            {
                query = query.Where(x => string.Equals(x.Status, statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(levelFilter))
            {
                query = query.Where(x => string.Equals(x.RiskLevel, levelFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(departmentFilter))
            {
                query = query.Where(x => string.Equals(x.Department, departmentFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x => x.IsReviewOverdue)
                .ThenByDescending(x => x.RiskScore)
                .ThenBy(x => x.ReviewDate)
                .ThenBy(x => x.Title)
                .ToList();
        }
    }

    private int TotalCount => risks?.Count ?? 0;

    private int HighCriticalCount =>
        risks?.Count(x => x.RiskLevel == "High" || x.RiskLevel == "Critical") ?? 0;

    private int OverdueReviewCount =>
        risks?.Count(x => x.IsReviewOverdue) ?? 0;

    private int ControlledCount =>
        risks?.Count(x => string.Equals(x.Status, "Controlled", StringComparison.OrdinalIgnoreCase)) ?? 0;

    private int ActionableRiskCount =>
        risks?.Count(IsActionableRisk) ?? 0;

    private List<RiskItem> PriorityRisks =>
        risks?
            .Where(IsActionableRisk)
            .OrderByDescending(x => x.IsReviewOverdue)
            .ThenByDescending(x => x.RiskScore)
            .ThenBy(x => x.ReviewDate)
            .ToList() ?? new List<RiskItem>();

    private List<RiskItem> WeakControlRisks =>
        risks?
            .Where(x => string.IsNullOrWhiteSpace(x.Controls) || x.Controls.Length < 20)
            .OrderByDescending(x => x.RiskScore)
            .ThenBy(x => x.ReviewDate)
            .ToList() ?? new List<RiskItem>();

    private List<string> StatusOptions =>
        risks?
            .Select(x => x.Status)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> DepartmentOptions =>
        risks?
            .Select(x => x.Department)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    protected override async Task OnInitializedAsync()
    {
        risks = await Db.RiskItems
            .AsNoTracking()
            .ToListAsync();
    }

    private static string BuildCorrectiveActionUrlFromRisk(RiskItem item)
    {
        var priority = item.RiskLevel switch
        {
            "Critical" => "Critical",
            "High" => "High",
            "Medium" => "Medium",
            _ => "Low"
        };

        var title = $"Review risk: {item.Title}";

        var actionType = item.IsReviewOverdue
            ? "Process Review"
            : item.RiskLevel is "Critical" or "High"
                ? "Review"
                : "Improvement";

        var notes = "Created from Risk Register item."
            + Environment.NewLine + "Review current controls, confirm owner, and update follow-up status."
            + Environment.NewLine
            + Environment.NewLine + $"Risk: {item.Title}"
            + Environment.NewLine + $"Hazard: {item.Hazard}"
            + Environment.NewLine + $"Site: {item.Site}"
            + Environment.NewLine + $"Department: {item.Department}"
            + Environment.NewLine + $"Current Owner: {item.Owner}"
            + Environment.NewLine + $"Likelihood: {item.Likelihood}"
            + Environment.NewLine + $"Consequence: {item.Consequence}"
            + Environment.NewLine + $"Risk Level: {item.RiskLevel}"
            + Environment.NewLine + $"Risk Score: {item.RiskScore}"
            + Environment.NewLine + $"Status: {item.Status}"
            + Environment.NewLine + $"Controls: {DisplayText(item.Controls)}"
            + Environment.NewLine + $"Review Date: {item.ReviewDate:dd MMM yyyy}"
            + Environment.NewLine + $"Review Flag: {(item.IsReviewOverdue ? "Review overdue" : "Review not overdue")}"
            + Environment.NewLine
            + Environment.NewLine + "Suggested follow-up: confirm controls are still effective, record any required changes, and close the corrective action once the risk review has been completed.";

        return "/corrective-actions/create"
            + $"?source={Uri.EscapeDataString("Risk Register")}"
            + $"&title={Uri.EscapeDataString(title)}"
            + $"&site={Uri.EscapeDataString(item.Site)}"
            + $"&department={Uri.EscapeDataString(item.Department)}"
            + $"&owner={Uri.EscapeDataString(item.Owner)}"
            + $"&priority={Uri.EscapeDataString(priority)}"
            + $"&actionType={Uri.EscapeDataString(actionType)}"
            + $"&notes={Uri.EscapeDataString(notes)}"
            + $"&returnUrl={Uri.EscapeDataString("/risk-register")}";
    }

    private static bool IsActionableRisk(RiskItem item)
    {
        return item.IsReviewOverdue ||
               item.RiskLevel == "Critical" ||
               item.RiskLevel == "High" ||
               string.IsNullOrWhiteSpace(item.Controls);
    }

    private static bool Contains(string? source, string search)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static string GetRiskLevelClass(string? level)
    {
        return level?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "high" => "badge badge-warning",
            "medium" => "badge badge-info",
            "low" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "active" => "badge badge-warning",
            "open" => "badge badge-warning",
            "monitoring" => "badge badge-info",
            "controlled" => "badge badge-success",
            "closed" => "badge badge-success",
            _ => "badge badge-muted"
        };
    }
}