<PurposeNote Title="Purpose" Icon="💼">
    <p>
        OperationsFlow is a portfolio project that shows business-system thinking: capture work, assign ownership,
        manage follow-up, attach evidence, identify weak records, report pressure, and create a traceable review
        path. It is designed to look like a practical internal operations tool, not a generic dashboard.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Business Problem"
                Value="Scattered"
                Detail="Work hidden in emails, notes, spreadsheets, and conversations"
                Icon="🧩"
                Tone="warning" />

    <MetricCard Title="System Response"
                Value="Captured"
                Detail="Workflows, owners, due dates, statuses, notes, and evidence"
                Icon="📋"
                Tone="success" />

    <MetricCard Title="Management Value"
                Value="Visible"
                Detail="Reports, workload, reminders, data quality, and activity"
                Icon="📊"
