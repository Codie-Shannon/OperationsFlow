@page "/documents"
@page "/document-control"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@inject OperationsFlowDbContext Db

<PageTitle>Document Control - OperationsFlow</PageTitle>

<PageHero Eyebrow="Compliance"
          Title="Document Control"
          Subtitle="Track controlled documents, owners, versions, review dates, document status, upcoming compliance review work, and corrective action follow-up."
          BadgeText="@($"{DueSoonCount} due soon")"
          BadgeClass="of-badge-warning">
    <Actions>
        <a class="of-btn of-btn-primary" href="/corrective-actions/create">+ New Corrective Action</a>
        <a class="of-btn of-btn-secondary" href="/corrective-actions">Corrective Actions</a>
        <a class="of-btn of-btn-secondary" href="/reminders">Reminders</a>
        <a class="of-btn of-btn-secondary" href="/reports">Reports</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="📄">
    <p>
        Use this page to review controlled documents and turn overdue or upcoming document reviews into owned corrective actions.
        Document actions are pre-filled with source context so follow-up remains traceable through action ownership,
        reminders, reporting, and activity evidence.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Total Documents"
                Value="@TotalCount.ToString()"
                Detail="All controlled document records"
                Icon="📋" />

    <MetricCard Title="Due Soon"
                Value="@DueSoonCount.ToString()"
                Detail="Upcoming review dates"
                Icon="📅"
                Tone="warning" />

    <MetricCard Title="Overdue Reviews"
                Value="@OverdueReviewCount.ToString()"
                Detail="Review date has passed"
                Icon="🚨"
                Tone="danger" />

    <MetricCard Title="Current"
                Value="@CurrentCount.ToString()"
                Detail="Not overdue or due soon"
                Icon="✅"
                Tone="success" />

    <MetricCard Title="Actionable"
                Value="@ActionableDocumentCount.ToString()"
                Detail="Overdue or due-soon reviews"
                Icon="🔗"
                Tone="info" />
</MetricGrid>

<InfoPanel Title="Document Review Focus" Subtitle="Recommended review order for controlled documents.">
    <ChildContent>
        <ol class="of-review-steps">
            <li>Review overdue controlled documents first.</li>
            <li>Check documents due for review within the next 30 days.</li>
            <li>Create corrective actions for documents needing version updates, owner review, or formal follow-up.</li>
            <li>Confirm owner, priority, due date, and source context before saving the corrective action.</li>
            <li>Use Workload, Reminders, Reports, Data Quality, and Activity Log to track follow-up.</li>
        </ol>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Document → Corrective Action Link" Subtitle="What the Create Action button does.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Source</strong>
                <span>The corrective action source is set to Document Control.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Context</strong>
                <span>Document number, type, owner, status, version, and review dates are copied into the notes.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Return</strong>
                <span>After saving, the workflow returns back to Documents.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Traceability</strong>
                <span>The created corrective action is logged as source-linked follow-up work.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<FilterBar Title="Filter Document Control">
    <ChildContent>
        <input class="of-input"
               placeholder="Search documents..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="of-select" @bind="statusFilter">
            <option value="">All Statuses</option>
            @foreach (var status in StatusOptions)
            {
                <option value="@status">@status</option>
            }
        </select>

        <select class="of-select" @bind="typeFilter">
            <option value="">All Types</option>
            @foreach (var type in TypeOptions)
            {
                <option value="@type">@type</option>
            }
        </select>

        <select class="of-select" @bind="departmentFilter">
            <option value="">All Departments</option>
            @foreach (var department in DepartmentOptions)
            {
                <option value="@department">@department</option>
            }
        </select>
    </ChildContent>

    <Actions>
        <a class="of-btn of-btn-secondary" href="/data-quality">Data Quality</a>
        <a class="of-btn of-btn-secondary" href="/activity-log">Activity Log</a>
    </Actions>
</FilterBar>

@if (documents == null)
{
    <InfoPanel Title="Loading Controlled Documents" Subtitle="Loading document records from the local SQLite database.">
        <p class="of-muted-text">Loading documents...</p>
    </InfoPanel>
}
else
{
    <TableCard Title="Controlled Documents"
               Subtitle="@($"Showing {FilteredDocuments.Count()} of {TotalCount} document record(s). {FilteredDocuments.Count(IsActionableDocument)} are currently actionable.")"
               IsEmpty="@(!FilteredDocuments.Any())"
               EmptyTitle="No documents found"
               EmptyMessage="No controlled document records match the current search or filter selection.">
        <table>
            <thead>
                <tr>
                    <th>Document #</th>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Owner</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th>Version</th>
                    <th>Last Reviewed</th>
                    <th>Next Review</th>
                    <th>Flag</th>
                    <th>Follow-Up</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in FilteredDocuments)
                {
                    <tr>
                        <td><strong>@item.DocumentNumber</strong></td>
                        <td>@item.Title</td>
                        <td>@item.DocumentType</td>
                        <td>@DisplayText(item.Owner)</td>
                        <td>@item.Department</td>
                        <td>
                            <span class="@GetStatusClass(item.Status)">
                                @DisplayText(item.Status)
                            </span>
                        </td>
                        <td>@item.Version</td>
                        <td>@item.LastReviewedDate.ToString("dd MMM yyyy")</td>
                        <td>@item.NextReviewDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.IsReviewOverdue)
                            {
                                <span class="of-badge of-badge-danger">Review Overdue</span>
                            }
                            else if (item.IsDueSoon)
                            {
                                <span class="of-badge of-badge-warning">Due Soon</span>
                            }
                            else
                            {
                                <span class="of-badge of-badge-success">Current</span>
                            }
                        </td>
                        <td>
                            <a class="of-card-link" href="@BuildCorrectiveActionUrlFromDocument(item)">Create Action</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </TableCard>
}

<InfoPanel Title="Priority Document Reviews"
           Subtitle="Overdue or upcoming review records that should be checked first.">
    <ChildContent>
        @if (!PriorityDocuments.Any())
        {
            <EmptyState Title="No priority document reviews"
                        Message="There are currently no overdue or due-soon document review flags."
                        Icon="✅" />
        }
        else
        {
            <div class="of-review-proof-grid">
                @foreach (var item in PriorityDocuments.Take(6))
                {
                    <div class="of-review-proof-card">
                        <strong>@item.DocumentNumber — @item.Title</strong>
                        <span>@item.DocumentType • @item.Department</span>
                        <span>Owner @DisplayText(item.Owner) • Version @item.Version • Review @item.NextReviewDate.ToString("dd MMM yyyy")</span>

                        <div class="of-link-row">
                            @if (item.IsReviewOverdue)
                            {
                                <span class="of-badge of-badge-danger">Review Overdue</span>
                            }
                            else
                            {
                                <span class="of-badge of-badge-warning">Due Soon</span>
                            }

                            <a class="of-card-link" href="@BuildCorrectiveActionUrlFromDocument(item)">Create Action</a>
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Document Control Notes" Subtitle="How controlled document review work should be handled.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Review</strong>
                <span>Overdue and due-soon documents should be checked before management review.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Version</strong>
                <span>Corrective actions should explain whether a version or status update is required.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Owner</strong>
                <span>The document owner is used as the default corrective action owner.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Production Gap</strong>
                <span>A production version could link directly to SharePoint document libraries.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Review Notes" Icon="💡" Tone="info">
    <ul>
        <li>Overdue and due-soon document reviews should be checked first.</li>
        <li>Create Action links should open a pre-filled corrective action with source set to Document Control.</li>
        <li>Document context should be copied into the corrective action notes for traceability.</li>
        <li>Follow-up corrective actions should then appear in Corrective Actions, Workload, Reminders, Reports, and Activity Log.</li>
        <li>This is local SQLite demo data; SharePoint document library integration is a later stage.</li>
    </ul>
</GuidanceNote>

@code {
    private List<DocumentRecord>? documents;

    private string searchText = "";
    private string statusFilter = "";
    private string typeFilter = "";
    private string departmentFilter = "";

    private IEnumerable<DocumentRecord> FilteredDocuments
    {
        get
        {
            if (documents == null)
            {
                return Enumerable.Empty<DocumentRecord>();
            }

            var query = documents.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.DocumentNumber, searchText) ||
                    Contains(x.Title, searchText) ||
                    Contains(x.DocumentType, searchText) ||
                    Contains(x.Owner, searchText) ||
                    Contains(x.Department, searchText) ||
                    Contains(x.Status, searchText) ||
                    Contains(x.Version, searchText) ||
                    Contains(x.Notes, searchText));
            }

            if (!string.IsNullOrWhiteSpace(statusFilter))
            {
                query = query.Where(x => string.Equals(x.Status, statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(typeFilter))
            {
                query = query.Where(x => string.Equals(x.DocumentType, typeFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(departmentFilter))
            {
                query = query.Where(x => string.Equals(x.Department, departmentFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query
                .OrderByDescending(x => x.IsReviewOverdue)
                .ThenByDescending(x => x.IsDueSoon)
                .ThenBy(x => x.NextReviewDate)
                .ThenBy(x => x.Title)
                .ToList();
        }
    }

    private int TotalCount => documents?.Count ?? 0;
    private int DueSoonCount => documents?.Count(x => x.IsDueSoon) ?? 0;
    private int OverdueReviewCount => documents?.Count(x => x.IsReviewOverdue) ?? 0;
    private int CurrentCount => documents?.Count(x => !x.IsReviewOverdue && !x.IsDueSoon) ?? 0;
    private int ActionableDocumentCount => documents?.Count(IsActionableDocument) ?? 0;

    private List<DocumentRecord> PriorityDocuments =>
        documents?
            .Where(IsActionableDocument)
            .OrderByDescending(x => x.IsReviewOverdue)
            .ThenBy(x => x.NextReviewDate)
            .ThenBy(x => x.Title)
            .ToList() ?? new List<DocumentRecord>();

    private List<string> StatusOptions =>
        documents?
            .Select(x => x.Status)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> TypeOptions =>
        documents?
            .Select(x => x.DocumentType)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    private List<string> DepartmentOptions =>
        documents?
            .Select(x => x.Department)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList() ?? new List<string>();

    protected override async Task OnInitializedAsync()
    {
        documents = await Db.DocumentRecords
            .AsNoTracking()
            .ToListAsync();
    }

    private static string BuildCorrectiveActionUrlFromDocument(DocumentRecord item)
    {
        var priority = item.IsReviewOverdue ? "High" : item.IsDueSoon ? "Medium" : "Low";
        var title = $"Review document: {item.Title}";

        var notes = "Created from Document Control review issue."
            + Environment.NewLine + "Review the document version, confirm required changes, and update review status."
            + Environment.NewLine
            + Environment.NewLine + $"Document: {item.Title}"
            + Environment.NewLine + $"Document Number: {item.DocumentNumber}"
            + Environment.NewLine + $"Document Type: {item.DocumentType}"
            + Environment.NewLine + $"Department: {item.Department}"
            + Environment.NewLine + $"Owner: {item.Owner}"
            + Environment.NewLine + $"Status: {item.Status}"
            + Environment.NewLine + $"Version: {item.Version}"
            + Environment.NewLine + $"Last Reviewed: {item.LastReviewedDate:dd MMM yyyy}"
            + Environment.NewLine + $"Next Review Date: {item.NextReviewDate:dd MMM yyyy}"
            + Environment.NewLine + $"Review Flag: {(item.IsReviewOverdue ? "Review overdue" : item.IsDueSoon ? "Due soon" : "Current")}"
            + Environment.NewLine + $"Notes: {DisplayText(item.Notes)}"
            + Environment.NewLine
            + Environment.NewLine + "Suggested follow-up: review the controlled document, update version/status if needed, and close the corrective action once the review outcome is recorded.";

        return "/corrective-actions/create"
            + $"?source={Uri.EscapeDataString("Document Control")}"
            + $"&title={Uri.EscapeDataString(title)}"
            + $"&site={Uri.EscapeDataString("Admin Office")}"
            + $"&department={Uri.EscapeDataString(item.Department)}"
            + $"&owner={Uri.EscapeDataString(item.Owner)}"
            + $"&priority={Uri.EscapeDataString(priority)}"
            + $"&actionType={Uri.EscapeDataString("Document Update")}"
            + $"&notes={Uri.EscapeDataString(notes)}"
            + $"&returnUrl={Uri.EscapeDataString("/documents")}";
    }

    private static bool IsActionableDocument(DocumentRecord item)
    {
        return item.IsReviewOverdue || item.IsDueSoon;
    }

    private static bool Contains(string? source, string search)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "Not recorded" : value;
    }

    private static string GetStatusClass(string? status)
    {
        return status?.ToLowerInvariant() switch
        {
            "approved" => "badge badge-success",
            "current" => "badge badge-success",
            "active" => "badge badge-success",
            "draft" => "badge badge-info",
            "under review" => "badge badge-warning",
            "review required" => "badge badge-warning",
            "archived" => "badge badge-muted",
            _ => "badge badge-muted"
        };
    }
}