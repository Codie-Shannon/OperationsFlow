@page "/prototype-scope"

<PageTitle>Prototype Scope - OperationsFlow</PageTitle>

<div class="operations-dashboard prototype-scope-page">
    <PageIntro Eyebrow="Portfolio Review"
               Title="Prototype Scope"
               Subtitle="A clear explanation of what OperationsFlow is, what it currently proves, what is intentionally prototype-only, and what would be required for a production version.">
        <a class="btn btn-secondary" href="implementation-plan">Implementation Plan</a>
        <a class="btn btn-secondary" href="demo-guide">Demo Guide</a>
        <a class="btn btn-primary" href="reports">Reports</a>
    </PageIntro>

    <div class="page-purpose-note">
        <strong>Purpose:</strong> use this page to set expectations. OperationsFlow is a working business workflow prototype, not a finished production SaaS system. This page explains the current scope, evidence, and upgrade path.
    </div>

    <section class="kpi-grid">
        <div class="kpi-card">
            <span class="kpi-label">Project Type</span>
            <strong>Prototype</strong>
            <span class="kpi-note">Working portfolio system</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Stack</span>
            <strong>.NET</strong>
            <span class="kpi-note">Blazor / EF Core / SQLite</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Workflow Area</span>
            <strong>OSHE</strong>
            <span class="kpi-note">Safety, compliance, admin</span>
        </div>

        <div class="kpi-card">
            <span class="kpi-label">Production Path</span>
            <strong>M365</strong>
            <span class="kpi-note">SharePoint / Teams / Outlook</span>
        </div>
    </section>

    <section class="summary-grid prototype-scope-summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>What OperationsFlow Is</h2>
                    <p>The intended scope of the current build.</p>
                </div>
            </div>

            <p class="prototype-scope-copy">
                OperationsFlow is a working Blazor/.NET business workflow prototype designed to show how
                operational work, corrective actions, safety/compliance follow-up, risk reviews, training,
                controlled documents, document intake, reminders, reports, activity logging, workload, and
                data quality can be connected into one reviewable workflow system.
            </p>

            <ul class="action-list">
                <li>A portfolio-ready business systems project.</li>
                <li>A local working demo with realistic seeded records.</li>
                <li>A proof of workflow design, CRUD screens, reporting, traceability, and review views.</li>
                <li>A base that could be expanded into a production internal business system.</li>
            </ul>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>What It Is Not</h2>
                    <p>Important limits of the prototype.</p>
                </div>
            </div>

            <div class="prototype-warning-card">
                <span>Prototype boundary</span>
                <strong>Not production-ready yet</strong>
                <p>
                    This version does not yet include real user authentication, production hosting,
                    Microsoft 365 live integrations, secured document storage, automated tests,
                    deployment monitoring, or production backup procedures.
                </p>
            </div>

            <ul class="action-list">
                <li>Not a deployed live system.</li>
                <li>Not connected to real company data.</li>
                <li>Not a replacement for production SharePoint, Teams, Outlook, or ERP controls yet.</li>
                <li>Not pretending security, hosting, and integration work is already finished.</li>
            </ul>
        </div>
    </section>

    <section class="prototype-scope-grid">
        @foreach (var scopeCard in ScopeCards)
        {
            <article class="prototype-scope-card large">
                <div class="prototype-scope-card-header">
                    <span class="@scopeCard.BadgeClass">@scopeCard.Badge</span>
                    <h2>@scopeCard.Title</h2>
                </div>

                <p>@scopeCard.Description</p>

                <ul>
                    @foreach (var item in scopeCard.Items)
                    {
                        <li>@item</li>
                    }
                </ul>
            </article>
        }
    </section>

    <section class="report-card">
        <div class="panel-header">
            <div>
                <h2>Feature Scope Matrix</h2>
                <p>What exists now, what is demonstrated, and what would be added for a production system.</p>
            </div>
        </div>

        <table class="report-table prototype-scope-table">
            <thead>
                <tr>
                    <th>Area</th>
                    <th>Current Prototype</th>
                    <th>What It Proves</th>
                    <th>Production Upgrade</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ScopeMatrix)
                {
                    <tr>
                        <td><strong>@item.Area</strong></td>
                        <td><span class="@item.BadgeClass">@item.CurrentStatus</span></td>
                        <td>@item.Proof</td>
                        <td>@item.ProductionUpgrade</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Reviewer Talking Points</h2>
                    <p>How to explain the prototype in a demo or interview.</p>
                </div>
            </div>

            <ol class="demo-step-list prototype-talking-points">
                <li>
                    <strong>This is a workflow prototype, not just a dashboard.</strong>
                    <span>Records can be created, edited, reviewed, reported on, and traced through activity history.</span>
                </li>

                <li>
                    <strong>The value is in connected follow-up.</strong>
                    <span>Corrective actions, risks, training, documents, intake, workload, reminders, reports, and data quality all support the same review process.</span>
                </li>

                <li>
                    <strong>The demo data is intentionally realistic.</strong>
                    <span>It includes overdue items, high-priority records, owner pressure, document review issues, training expiry, and admin intake examples.</span>
                </li>

                <li>
                    <strong>The production path is clear.</strong>
                    <span>The implementation plan identifies authentication, roles, hosted database, SharePoint storage, Teams/Outlook notifications, tests, deployment, and monitoring.</span>
                </li>
            </ol>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Production Upgrade Path</h2>
                    <p>What should come after the current portfolio version.</p>
                </div>
            </div>

            <div class="production-upgrade-list">
                @foreach (var upgrade in UpgradePath)
                {
                    <article>
                        <span>@upgrade.Step</span>
                        <div>
                            <strong>@upgrade.Title</strong>
                            <p>@upgrade.Description</p>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>
</div>

