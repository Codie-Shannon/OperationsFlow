@page "/user-roles"
@rendermode InteractiveServer

@using OperationsFlow.Models
@using OperationsFlow.Services

@inject LocalIdentityService LocalIdentityService

<PageTitle>User Roles - OperationsFlow</PageTitle>

<div class="of-page">
    <PageHero Eyebrow="OPERATIONSFLOW / ACCESS CONTROL"
              Title="User Roles"
              Subtitle="SQL-backed local users, roles, permissions, and Microsoft OAuth2 account links. Microsoft proves identity; OperationsFlow local SQL remains the authorization source."
              BadgeText="Local SQL + Microsoft Links"
              BadgeClass="of-badge of-badge-success">
        <Actions>
            <a class="of-btn of-btn-secondary" href="/admin-settings">Admin Settings</a>
            <a class="of-btn of-btn-secondary" href="/technical-overview">Technical Overview</a>
            <a class="of-btn of-btn-secondary" href="/implementation-plan">Implementation Plan</a>
            <a class="of-btn of-btn-primary" href="/login">Login</a>
        </Actions>
    </PageHero>

    <PurposeNote Title="Purpose" Icon="👥">
        <p>
            This page shows how OperationsFlow controls access. Local SQL users own application roles and permissions.
            Microsoft OAuth2 accounts can be linked to those local users through ExternalLoginLinks.
        </p>
    </PurposeNote>

    <div class="of-metric-grid">
        <MetricCard Title="Users"
                    Value="@Users.Count.ToString()"
                    Subtitle="Local SQL user records"
                    Icon="👤" />

        <MetricCard Title="Roles"
                    Value="@RoleCountText"
                    Subtitle="Admin, Manager, Reviewer, Worker, ReadOnly"
                    Icon="🛡️" />

        <MetricCard Title="External Links"
                    Value="@ExternalLinks.Count.ToString()"
                    Subtitle="Microsoft OAuth2 links"
                    Icon="🔗" />

        <MetricCard Title="Authorization"
                    Value="Local SQL"
                    Subtitle="Roles and permissions remain local"
                    Icon="✅" />
    </div>

    <InfoPanel Title="Authentication and authorization split"
               Subtitle="This is the core Week 4 identity model."
               Tone="info">
        <ChildContent>
            <div class="of-two-column-grid">
                <div class="of-review-proof-card">
                    <span class="of-badge of-badge-info">Identity</span>
                    <h3>Microsoft OAuth2</h3>
                    <p>
                        Microsoft sign-in proves the person is a tenant user. The returned Microsoft identity is linked
                        to a local OperationsFlow user through ExternalLoginLinks.
                    </p>
                </div>

                <div class="of-review-proof-card">
                    <span class="of-badge of-badge-success">Authorization</span>
                    <h3>Local SQL roles</h3>
                    <p>
                        After sign-in, OperationsFlow loads the linked local user and applies local roles/permissions
                        such as Admin, Manager, Reviewer, Worker, and ReadOnly.
                    </p>
                </div>
            </div>
        </ChildContent>
    </InfoPanel>

    <TableCard Title="Local users"
               Subtitle="Local application users. Microsoft-linked users still load these local roles and permissions.">
        <ChildContent>
            @if (IsLoading)
            {
                <EmptyState Icon="⏳"
                            Title="Loading local users..."
                            Message="User and role data is loading." />
            }
            else if (Users.Count == 0)
            {
                <EmptyState Icon="👤"
                            Title="No users found"
                            Message="No local users are currently available." />
            }
            else
            {
                <div class="table-responsive">
                    <table class="of-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Local Email</th>
                                <th>Department</th>
                                <th>Job Title</th>
                                <th>Roles</th>
                                <th>Password</th>
                                <th>Status</th>
                                <th>External Links</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Users)
                            {
                                <tr>
                                    <td>
                                        <strong>@user.DisplayName</strong>
                                        <div class="helper-text">@user.UserName</div>
                                    </td>
                                    <td>@user.Email</td>
                                    <td>@user.Department</td>
                                    <td>@user.JobTitle</td>
                                    <td>
                                        <div class="of-badge-stack">
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="@LocalIdentityService.GetRoleBadgeClass(role)">@role</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (user.HasPassword)
                                        {
                                            <span class="of-badge of-badge-success">Hashed</span>
                                        }
                                        else
                                        {
                                            <span class="of-badge of-badge-danger">Missing</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="of-badge of-badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="of-badge of-badge-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.LinkedProviders.Any())
                                        {
                                            <div class="of-badge-stack">
                                                @foreach (var provider in user.LinkedProviders)
                                                {
                                                    <span class="of-badge of-badge-info">@($"{provider}-linked")</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="of-badge of-badge-muted">None</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </TableCard>

    <TableCard Title="Role permission matrix"
               Subtitle="These SQL-backed permissions control what each role can see or do.">
        <ChildContent>
            @if (IsLoading)
            {
                <EmptyState Icon="⏳"
                            Title="Loading permissions..."
                            Message="Permission matrix is loading." />
            }
            else if (PermissionMatrix.Count == 0)
            {
                <EmptyState Icon="🛡️"
                            Title="No permissions found"
                            Message="No permission matrix records are available." />
            }
            else
            {
                <div class="table-responsive">
                    <table class="of-table">
                        <thead>
                            <tr>
                                <th>Permission</th>
                                <th>Category</th>
                                <th>Admin</th>
                                <th>Manager</th>
                                <th>Reviewer</th>
                                <th>Worker</th>
                                <th>ReadOnly</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var permission in PermissionMatrix)
                            {
                                <tr>
                                    <td>
                                        <strong>@permission.PermissionName</strong>
                                        <div class="helper-text">@permission.PermissionKey</div>
                                    </td>
                                    <td>@permission.Category</td>
                                    <td>@AccessBadge(permission, "Admin")</td>
                                    <td>@AccessBadge(permission, "Manager")</td>
                                    <td>@AccessBadge(permission, "Reviewer")</td>
                                    <td>@AccessBadge(permission, "Worker")</td>
                                    <td>@AccessBadge(permission, "ReadOnly")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </TableCard>

    <TableCard Title="External login links"
               Subtitle="Runtime Microsoft OAuth2 links. These are read from the database, not hardcoded into the page.">
        <ChildContent>
            @if (IsLoading)
            {
                <EmptyState Icon="⏳"
                            Title="Loading external login links..."
                            Message="External login links are loading." />
            }
            else if (ExternalLinks.Count == 0)
            {
                <EmptyState Icon="🔗"
                            Title="No external links yet"
                            Message="Sign in with Microsoft to auto-link a tenant account to a local OperationsFlow user." />
            }
            else
            {
                <div class="table-responsive">
                    <table class="of-table">
                        <thead>
                            <tr>
                                <th>Local User</th>
                                <th>Provider</th>
                                <th>Provider Email</th>
                                <th>Provider User Id</th>
                                <th>Status</th>
                                <th>Last Login</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var link in ExternalLinks)
                            {
                                <tr>
                                    <td>@link.LocalUserDisplayName</td>
                                    <td><span class="of-badge of-badge-info">@link.Provider</span></td>
                                    <td>@link.ProviderEmail</td>
                                    <td>
                                        <span class="helper-text">@ShortProviderId(link.ProviderUserId)</span>
                                    </td>
                                    <td>
                                        @if (link.IsLinked)
                                        {
                                            <span class="of-badge of-badge-success">Linked</span>
                                        }
                                        else
                                        {
                                            <span class="of-badge of-badge-muted">Inactive</span>
                                        }
                                    </td>
                                    <td>@(link.LastLoginAt?.ToString("dd MMM yyyy HH:mm") ?? "Not recorded")</td>
                                    <td>@link.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ChildContent>
    </TableCard>

    <GuidanceNote Title="Week 4 result" Icon="✅" Tone="success">
        <p>
            OperationsFlow now proves local SQL authorization and Microsoft OAuth2 identity linking in the same pilot.
            The app can show both Local login and Microsoft-linked sign-in status while using the same role/permission matrix.
        </p>
    </GuidanceNote>
</div>

@code {
    private bool IsLoading { get; set; } = true;

    private List<LocalUserSummary> Users { get; set; } = new();

    private List<LocalRole> Roles { get; set; } = new();

    private List<LocalRolePermissionSummary> PermissionMatrix { get; set; } = new();

    private List<ExternalLoginLinkSummary> ExternalLinks { get; set; } = new();

    private string RoleCountText => Roles.Count.ToString();

    protected override async Task OnInitializedAsync()
    {
        Users = await LocalIdentityService.GetUserSummariesAsync();
        Roles = await LocalIdentityService.GetRolesAsync();
        PermissionMatrix = await LocalIdentityService.GetRolePermissionSummariesAsync();
        ExternalLinks = await LocalIdentityService.GetExternalLoginLinksAsync();
        IsLoading = false;
    }

    private RenderFragment AccessBadge(LocalRolePermissionSummary permission, string roleName)
    {
        return builder =>
        {
            var accessLevel = permission.AccessByRole.TryGetValue(roleName, out var value)
                ? value
                : "No";

            var cssClass = LocalIdentityService.GetBadgeClassForAccess(accessLevel);

            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", cssClass);
            builder.AddContent(2, accessLevel);
            builder.CloseElement();
        };
    }

    private static string ShortProviderId(string providerUserId)
    {
        if (string.IsNullOrWhiteSpace(providerUserId))
        {
            return "Not available";
        }

        return providerUserId.Length <= 12
            ? providerUserId
            : $"{providerUserId[..12]}...";
    }
}