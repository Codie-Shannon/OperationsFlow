    private static string GetPermissionBadgeClass(string permission)
    {
        return permission.ToLowerInvariant() switch
        {
            "full" => "badge badge-success",
            "approve" => "badge badge-info",
            "limited" => "badge badge-warning",
            "own" => "badge badge-info",
            "read" => "badge badge-muted",
            "no" => "badge badge-danger",
            _ => "badge badge-muted"
        };
    }

    private record RoleDefinition(
        string Number,
        string Category,
        string Name,
        string Description,
        string AccessFocus,
        IReadOnlyList<RolePermission> Permissions
