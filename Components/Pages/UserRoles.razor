<div class="of-two-column-grid">
    <InfoPanel Title="Week 4 authentication path"
               Subtitle="Authentication should be added cleanly without breaking local development."
               Tone="info">

        <ul class="of-mini-list">
            <li class="of-mini-list-item">
                <strong>Provider:</strong>
                <span>Microsoft Entra ID.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>App registration:</strong>
                <span>OperationsFlow registered in the target tenant.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Sign-in users:</strong>
                <span>Organisation users or selected test tenant users.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Role source:</strong>
                <span>Entra groups, app roles, or configuration-based role mapping.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Local fallback:</strong>
                <span>Optional development-only mode for testing without production login.</span>
            </li>
        </ul>
    </InfoPanel>

    <InfoPanel Title="Week 4 authorization path"
               Subtitle="Permissions should be enforced by policy, not hidden only in the UI."
               Tone="warning">

        <ul class="of-mini-list">
            <li class="of-mini-list-item">
                <strong>Policy-based checks:</strong>
                <span>Use authorization policies for protected actions.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Route protection:</strong>
                <span>Protect admin/config pages from non-admin users.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Action protection:</strong>
                <span>Block upload/delete/export/settings actions where the role is not allowed.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>SharePoint alignment:</strong>
                <span>App permissions and SharePoint library access should not conflict.</span>
            </li>
            <li class="of-mini-list-item">
                <strong>Audit:</strong>
                <span>Denied or sensitive actions should be traceable where useful.</span>
            </li>
        </ul>
    </InfoPanel>
</div>

