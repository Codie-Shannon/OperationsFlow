    private record RolePermission(
        string Title,
        string Description
    );

    private record PermissionMatrixItem(
        string Action,
        string Description,
        string Admin,
        string Manager,
        string Reviewer,
        string Owner,
        string Viewer
    );

    private record AccessFlowStep(
        string Number,
        string Title,
        string Description
    );

    private record SecurityNote(
        string Label,
        string Title,
        string Description
    );

    private record PageAccessItem(
        string Page,
        string PrimaryUsers,
        string BadgeClass,
        string AccessRule,
        string Reason
    );

    private record ProofItem(
        string Label,
        string Title,
        string Description
    );
}