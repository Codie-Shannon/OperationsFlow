@page "/user-roles"

<PageTitle>User Roles - OperationsFlow</PageTitle>

<PageHero Eyebrow="OPERATIONSFLOW / ACCESS CONTROL READINESS"
          Title="User Roles"
          Subtitle="OperationsFlow currently runs in local demo mode, but the Week 3 production foundation now defines the role and permission model needed for Week 4 Microsoft Entra ID authentication and policy enforcement."
          BadgeText="Role Ready"
          BadgeClass="of-badge of-badge-info">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/admin-settings">Admin Settings</a>
        <a class="of-btn of-btn-secondary" href="/technical-overview">Technical Overview</a>
        <a class="of-btn of-btn-secondary" href="/integration-overview">Integration Overview</a>
        <a class="of-btn of-btn-primary" href="/implementation-plan">Implementation Plan</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="🔐">
    <p>
        This page defines the production access model OperationsFlow will need before real rollout.
        Week 3 documents the role boundaries. Week 4 should connect these roles to Microsoft Entra ID, app roles, groups, and authorization policies.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Current Auth"
                Value="Local Demo"
                Detail="No production login or authorization enforcement is active yet."
                Icon="💻"
                Tone="info" />

    <MetricCard Title="Production Auth"
                Value="Entra ID"
                Detail="Week 4 target for Microsoft identity and role mapping."
                Icon="🔐"
                Tone="warning" />

    <MetricCard Title="Defined Roles"
                Value="5"
                Detail="Admin, Manager, Reviewer, Worker, and ReadOnly."
                Icon="👥"
                Tone="success" />

    <MetricCard Title="Permission Model"
                Value="Ready"
                Detail="Matrix prepared for Week 4 policy enforcement."
                Icon="✅"
                Tone="default" />
</MetricGrid>

<GuidanceNote Title="Current boundary" Icon="⚠️" Tone="warning">
    <p>
        These roles are currently a readiness model only. The local prototype does not yet enforce authentication,
        authorization policies, Microsoft Entra ID login, SharePoint permissions, or user/group membership checks.
        Week 4 should turn this model into real application policies.
    </p>
</GuidanceNote>

<InfoPanel Title="Role model"
           Subtitle="The role model is designed around real operational responsibility, not just generic admin/user access."
           Tone="default">

    <div class="of-review-proof-grid">
        <div class="of-review-proof-card">
            <span class="of-badge of-badge-danger">Admin</span>
            <h3>System administrator</h3>
            <p>
                Owns system configuration, storage provider setup, role mapping, user access, production settings, and support boundaries.
            </p>
        </div>

        <div class="of-review-proof-card">
            <span class="of-badge of-badge-warning">Manager</span>
            <h3>Operational manager</h3>
            <p>
                Reviews dashboards, reports, overdue work, data quality, evidence coverage, workload, and follow-up performance.
            </p>
        </div>

        <div class="of-review-proof-card">
            <span class="of-badge of-badge-info">Reviewer</span>
            <h3>Compliance / audit reviewer</h3>
            <p>
                Reviews evidence, document library records, activity logs, reports, and missing evidence issues without managing system settings.
            </p>
        </div>

        <div class="of-review-proof-card">
            <span class="of-badge of-badge-success">Worker</span>
            <h3>Assigned worker</h3>
            <p>
                Updates assigned work, records follow-up notes, adds evidence, and helps close workflow records with supporting proof.
            </p>
        </div>

        <div class="of-review-proof-card">
            <span class="of-badge of-badge-muted">ReadOnly</span>
            <h3>View-only user</h3>
            <p>
                Can view records, dashboards, and review pages, but cannot edit workflow records, upload files, delete files, export data, or change settings.
            </p>
        </div>
    </div>
</InfoPanel>

<TableCard Title="Role definitions"
           Subtitle="Each role has a clear purpose so Week 4 policies can be mapped cleanly.">

    <table class="table">
        <thead>
            <tr>
                <th>Role</th>
                <th>Main purpose</th>
                <th>Typical users</th>
                <th>Week 4 source</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><span class="of-badge of-badge-danger">Admin</span></td>
                <td>Manage system configuration, users, roles, provider settings, and production access boundaries.</td>
                <td>System owner, IT admin, business systems admin.</td>
                <td>Entra app role or admin group.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-warning">Manager</span></td>
                <td>Manage operational follow-up, reporting, data quality, workload, and business review actions.</td>
                <td>Operations manager, safety manager, department lead.</td>
                <td>Entra group or configured app role.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-info">Reviewer</span></td>
                <td>Review evidence, reports, data quality, activity history, and document traceability.</td>
                <td>Compliance reviewer, auditor, management reviewer, external reviewer.</td>
                <td>Entra group or reviewer app role.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-success">Worker</span></td>
                <td>Update assigned records, attach evidence, and complete follow-up work.</td>
                <td>Assigned staff, site workers, admin support, corrective action owners.</td>
                <td>Entra group, user assignment, or app role.</td>
            </tr>
            <tr>
                <td><span class="of-badge of-badge-muted">ReadOnly</span></td>
                <td>View records and dashboards without changing operational data.</td>
                <td>Observers, demo users, limited reviewers, read-only stakeholders.</td>
                <td>Fallback read-only group or default authenticated role.</td>
            </tr>
        </tbody>
    </table>
</TableCard>

