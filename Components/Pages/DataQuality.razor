@page "/data-quality"
@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using OperationsFlow.Services
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake

@inject OperationsFlowDbContext Db
@inject DocumentAttachmentService AttachmentService

<PageTitle>Data Quality - OperationsFlow</PageTitle>

<PageHero Eyebrow="System Health"
          Title="Data Quality Report"
          Subtitle="Identify missing owners, weak records, overdue work, expired compliance items, missing evidence, and data issues that need review before management reporting."
          BadgeText="@($"{TotalIssueCount} issues")"
          BadgeClass="@IssueBadgeClass">
    <Actions>
        <a class="of-btn of-btn-secondary" href="/reports">Reports</a>
        <a class="of-btn of-btn-secondary" href="/reminders">Reminders</a>
        <a class="of-btn of-btn-secondary" href="/workload">Workload</a>
        <a class="of-btn of-btn-secondary" href="/activity-log">Activity Log</a>
        <a class="of-btn of-btn-secondary" href="/document-library">Document Library</a>
    </Actions>
</PageHero>

<PurposeNote Title="Purpose" Icon="🧪">
    <p>
        Use this page to find weak or incomplete workflow records and jump directly to the page where each issue
        can be reviewed, updated, or turned into follow-up work. Week 3 adds evidence checks so overdue,
        high-priority, or review-needed work can be flagged if no supporting file has been attached.
    </p>
</PurposeNote>

<MetricGrid>
    <MetricCard Title="Total Issues"
                Value="@TotalIssueCount.ToString()"
                Detail="All prototype data quality flags"
                Icon="📋"
                Tone="@IssueTone" />

    <MetricCard Title="Critical Issues"
                Value="@CriticalIssueCount.ToString()"
                Detail="High-risk or overdue problems"
                Icon="🚨"
                Tone="danger" />

    <MetricCard Title="Warning Issues"
                Value="@WarningIssueCount.ToString()"
                Detail="Records needing review"
                Icon="⚠️"
                Tone="warning" />

    <MetricCard Title="Missing Evidence"
                Value="@MissingEvidenceIssueCount.ToString()"
                Detail="Priority records with no attached files"
                Icon="📎"
                Tone="@MissingEvidenceTone" />

    <MetricCard Title="Data Gaps"
                Value="@DataGapCount.ToString()"
                Detail="Missing owner, notes, controls, or dates"
                Icon="🧩"
                Tone="info" />

    <MetricCard Title="Action Links"
                Value="@ActionableIssueCount.ToString()"
                Detail="Issues with review links"
                Icon="🔗"
                Tone="success" />
</MetricGrid>

<InfoPanel Title="Evidence-Aware Data Quality" Subtitle="Week 3 now checks whether key workflow records have supporting files.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Work Orders</strong>
                <span>Overdue, high, or critical work orders should have supporting evidence or progress files.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Corrective Actions</strong>
                <span>Overdue, high, or critical actions should have close-out evidence, photos, notes, or documents.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Document Intake</strong>
                <span>Overdue or review-needed intake records should have the source document attached.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Production Path</strong>
                <span>Local evidence checks become SharePoint document-library checks in the Week 4 production version.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Module Issue Coverage" Subtitle="Current issue count by module.">
    <ChildContent>
        @if (!ModuleIssueCoverage.Any())
        {
            <EmptyState Title="No data quality issues found"
                        Message="All checked records currently pass the prototype data quality rules."
                        Icon="✅" />
        }
        else
        {
            <div class="of-review-proof-grid">
                @foreach (var module in ModuleIssueCoverage)
                {
                    <div class="of-review-proof-card">
                        <strong>@module.ModuleName</strong>
                        <span>@module.Count @Pluralise(module.Count, "issue", "issues")</span>

                        <div class="of-link-row">
                            <span class="@GetModuleSeverityClass(module.ModuleName)">
                                @module.Count
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</InfoPanel>

<FilterBar Title="Filter Data Quality Issues">
    <ChildContent>
        <input class="of-input"
               placeholder="Search data quality issues..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="of-select" @bind="severityFilter">
            <option value="">All Severities</option>
            <option value="Critical">Critical</option>
            <option value="Warning">Warning</option>
            <option value="Info">Info</option>
        </select>

        <select class="of-select" @bind="moduleFilter">
            <option value="">All Modules</option>
            @foreach (var module in ModuleOptions)
            {
                <option value="@module">@module</option>
            }
        </select>

        <select class="of-select" @bind="issueTypeFilter">
            <option value="">All Issue Types</option>
            <option value="Missing Evidence">Missing Evidence</option>
            <option value="Missing Information">Missing Information</option>
            <option value="Overdue Work">Overdue Work</option>
            <option value="Compliance">Compliance</option>
        </select>
    </ChildContent>

    <Actions>
        <a class="of-btn of-btn-secondary" href="/reports">Reports</a>
        <a class="of-btn of-btn-secondary" href="/activity-log">Activity Log</a>
        <a class="of-btn of-btn-secondary" href="/document-library">Document Library</a>
    </Actions>
</FilterBar>

<TableCard Title="Data Quality Issues"
           Subtitle="@($"Showing {FilteredIssueCount} of {TotalIssueCount} issue(s). {ActionableIssueCount} total issues have action links.")"
           IsEmpty="@(!FilteredIssues.Any())"
           EmptyTitle="No data quality issues match the current filters"
           EmptyMessage="Clear the search or filters to show more records.">
    <table>
        <thead>
            <tr>
                <th>Severity</th>
                <th>Type</th>
                <th>Module</th>
                <th>Reference</th>
                <th>Issue</th>
                <th>Owner</th>
                <th>Recommended Action</th>
                <th>Review</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var issue in FilteredIssues)
            {
                <tr>
                    <td>
                        <span class="@GetSeverityClass(issue.Severity)">
                            @issue.Severity
                        </span>
                    </td>
                    <td>
                        <span class="@GetIssueTypeClass(issue.IssueType)">
                            @issue.IssueType
                        </span>
                    </td>
                    <td>@issue.ModuleName</td>
                    <td><strong>@issue.Reference</strong></td>
                    <td>@issue.Issue</td>
                    <td>@issue.Owner</td>
                    <td>@issue.RecommendedAction</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                        {
                            <a class="of-card-link" href="@issue.ActionUrl">Open</a>
                        }
                        else
                        {
                            <span class="of-muted-text">Review</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</TableCard>

<InfoPanel Title="Missing Evidence" Subtitle="Priority workflow records that should have at least one file attached.">
    <Actions>
        <span class="of-badge of-badge-warning">@MissingEvidenceIssues.Count issues</span>
    </Actions>

    <ChildContent>
        @if (!MissingEvidenceIssues.Any())
        {
            <EmptyState Title="No missing evidence issues"
                        Message="Checked priority records currently have supporting files attached."
                        Icon="✅" />
        }
        else
        {
            <div class="of-review-proof-grid">
                @foreach (var issue in MissingEvidenceIssues.Take(8))
                {
                    <div class="of-review-proof-card">
                        <strong>@issue.Reference</strong>
                        <span>@issue.Issue</span>
                        <span>@issue.ModuleName • @issue.Owner</span>

                        <div class="of-link-row">
                            <span class="@GetSeverityClass(issue.Severity)">
                                @issue.Severity
                            </span>

                            @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                            {
                                <a class="of-card-link" href="@issue.ActionUrl">Open</a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Overdue Operational Work" Subtitle="Open work orders and corrective actions that are past due.">
    <Actions>
        <span class="of-badge of-badge-danger">@OverdueWorkIssues.Count issues</span>
    </Actions>

    <ChildContent>
        @if (!OverdueWorkIssues.Any())
        {
            <EmptyState Title="No overdue operational work issues"
                        Message="Open work orders and corrective actions currently have no overdue data quality flags."
                        Icon="✅" />
        }
        else
        {
            <div class="of-review-proof-grid">
                @foreach (var issue in OverdueWorkIssues.Take(6))
                {
                    <div class="of-review-proof-card">
                        <strong>@issue.Reference</strong>
                        <span>@issue.Issue</span>
                        <span>@issue.ModuleName • @issue.Owner</span>

                        <div class="of-link-row">
                            <span class="@GetSeverityClass(issue.Severity)">
                                @issue.Severity
                            </span>

                            @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                            {
                                <a class="of-card-link" href="@issue.ActionUrl">Open</a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</InfoPanel>

<InfoPanel Title="Compliance Problems" Subtitle="Expired training, overdue document reviews, and high-risk items.">
    <Actions>
        <span class="of-badge of-badge-warning">@ComplianceIssues.Count issues</span>
    </Actions>

    <ChildContent>
        @if (!ComplianceIssues.Any())
        {
            <EmptyState Title="No compliance data quality issues"
                        Message="Training, document, and risk records currently have no compliance flags."
                        Icon="✅" />
        }
        else
        {
            <div class="of-review-proof-grid">
                @foreach (var issue in ComplianceIssues.Take(6))
                {
                    <div class="of-review-proof-card">
                        <strong>@issue.Reference</strong>
                        <span>@issue.Issue</span>
                        <span>@issue.ModuleName • @issue.Owner</span>

                        <div class="of-link-row">
                            <span class="@GetSeverityClass(issue.Severity)">
                                @issue.Severity
                            </span>

                            @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                            {
                                <a class="of-card-link" href="@issue.ActionUrl">Open</a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </ChildContent>
</InfoPanel>

<div class="of-two-column-grid">
    <InfoPanel Title="Missing Information" Subtitle="Records missing owner, notes, controls, or completion details.">
        <Actions>
            <span class="of-badge of-badge-info">@MissingInformationIssues.Count issues</span>
        </Actions>

        <ChildContent>
            @if (!MissingInformationIssues.Any())
            {
                <EmptyState Title="No missing information issues"
                            Message="Checked records currently have the key fields needed for review."
                            Icon="✅" />
            }
            else
            {
                <div class="of-mini-list">
                    @foreach (var issue in MissingInformationIssues.Take(8))
                    {
                        <div class="of-mini-list-item">
                            <div>
                                <strong>@issue.Reference</strong>
                                <span>@issue.ModuleName • @issue.Issue</span>
                            </div>

                            <div class="of-link-row">
                                <span class="@GetSeverityClass(issue.Severity)">
                                    @issue.Severity
                                </span>

                                @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                                {
                                    <a class="of-card-link" href="@issue.ActionUrl">Open</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </ChildContent>
    </InfoPanel>

    <InfoPanel Title="Document Intake Issues" Subtitle="Incoming documents overdue, needing review, missing files, or missing processing information.">
        <Actions>
            <span class="of-badge of-badge-info">@DocumentIntakeIssues.Count issues</span>
        </Actions>

        <ChildContent>
            @if (!DocumentIntakeIssues.Any())
            {
                <EmptyState Title="No document intake issues"
                            Message="Incoming document processing records currently pass the prototype checks."
                            Icon="✅" />
            }
            else
            {
                <div class="of-mini-list">
                    @foreach (var issue in DocumentIntakeIssues.Take(8))
                    {
                        <div class="of-mini-list-item">
                            <div>
                                <strong>@issue.Reference</strong>
                                <span>@issue.Issue</span>
                            </div>

                            <div class="of-link-row">
                                <span class="@GetSeverityClass(issue.Severity)">
                                    @issue.Severity
                                </span>

                                @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                                {
                                    <a class="of-card-link" href="@issue.ActionUrl">Open</a>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </ChildContent>
    </InfoPanel>
</div>

<InfoPanel Title="Data Quality Rules" Subtitle="Prototype checks currently enforced on this page.">
    <ChildContent>
        <div class="of-review-proof-grid">
            <div class="of-review-proof-card">
                <strong>Ownership</strong>
                <span>Flags missing owners or assigned people on workflow records.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Overdue Work</strong>
                <span>Flags open work orders, actions, and intake records with due dates in the past.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Evidence</strong>
                <span>Flags overdue, high-priority, or review-needed records that have no attached files.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Compliance Dates</strong>
                <span>Flags expired training and overdue or due-soon document reviews.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Record Detail</strong>
                <span>Flags blank notes, missing controls, and missing completed dates on closed records.</span>
            </div>

            <div class="of-review-proof-card">
                <strong>Week 4 Ready</strong>
                <span>Evidence checks are provider-independent and can work with SharePoint storage later.</span>
            </div>
        </div>
    </ChildContent>
</InfoPanel>

<GuidanceNote Title="Review Notes" Icon="💡" Tone="info">
    <ul>
        <li>Critical issues should be opened before warning or info records.</li>
        <li>Missing owners weaken workload reporting and should be fixed early.</li>
        <li>Missing evidence weakens close-out, review, and management traceability.</li>
        <li>Blank notes reduce traceability, especially for completed or reviewed work.</li>
        <li>Data Quality should be checked before using Reports for portfolio screenshots or review meetings.</li>
        <li>In Week 4, local evidence checks can map to SharePoint document library files and metadata.</li>
    </ul>
</GuidanceNote>

@code {
    private List<WorkOrder> workOrders = new();
    private List<CorrectiveAction> correctiveActions = new();
    private List<DocumentRecord> documents = new();
    private List<RiskItem> risks = new();
    private List<TrainingRecord> trainingRecords = new();
    private List<DocumentIntakeModel> documentIntakeItems = new();
    private List<DocumentAttachment> attachments = new();

    private string searchText = "";
    private string severityFilter = "";
    private string moduleFilter = "";
    private string issueTypeFilter = "";

    private List<DataQualityIssue> AllIssues
    {
        get
        {
            var issues = new List<DataQualityIssue>();

            AddWorkOrderIssues(issues);
            AddCorrectiveActionIssues(issues);
            AddDocumentIssues(issues);
            AddRiskIssues(issues);
            AddTrainingIssues(issues);
            AddDocumentIntakeIssues(issues);
            AddEvidenceIssues(issues);

            return issues
                .OrderByDescending(x => x.SeveritySort)
                .ThenBy(x => x.IssueType)
                .ThenBy(x => x.ModuleName)
                .ThenBy(x => x.Reference)
                .ToList();
        }
    }

    private List<DataQualityIssue> FilteredIssues
    {
        get
        {
            var query = AllIssues.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.ModuleName, searchText) ||
                    Contains(x.Reference, searchText) ||
                    Contains(x.Issue, searchText) ||
                    Contains(x.Owner, searchText) ||
                    Contains(x.IssueType, searchText) ||
                    Contains(x.RecommendedAction, searchText));
            }

            if (!string.IsNullOrWhiteSpace(severityFilter))
            {
                query = query.Where(x => string.Equals(x.Severity, severityFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(moduleFilter))
            {
                query = query.Where(x => string.Equals(x.ModuleName, moduleFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(issueTypeFilter))
            {
                query = query.Where(x => string.Equals(x.IssueType, issueTypeFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private List<DataQualityIssue> OverdueWorkIssues =>
        AllIssues
            .Where(x =>
                x.IssueType == "Overdue Work" &&
                (x.ModuleName == "Work Orders" || x.ModuleName == "Corrective Actions"))
            .ToList();

    private List<DataQualityIssue> ComplianceIssues =>
        AllIssues
            .Where(x =>
                x.IssueType == "Compliance" ||
                x.ModuleName == "Document Control" ||
                x.ModuleName == "Risk Register" ||
                x.ModuleName == "Training")
            .ToList();

    private List<DataQualityIssue> MissingInformationIssues =>
        AllIssues
            .Where(x => x.IssueType == "Missing Information")
            .ToList();

    private List<DataQualityIssue> MissingEvidenceIssues =>
        AllIssues
            .Where(x => x.IssueType == "Missing Evidence")
            .ToList();

    private List<DataQualityIssue> DocumentIntakeIssues =>
        AllIssues
            .Where(x => x.ModuleName == "Document Intake")
            .ToList();

    private int TotalIssueCount => AllIssues.Count;
    private int FilteredIssueCount => FilteredIssues.Count;
    private int CriticalIssueCount => AllIssues.Count(x => x.Severity == "Critical");
    private int WarningIssueCount => AllIssues.Count(x => x.Severity == "Warning");
    private int MissingEvidenceIssueCount => MissingEvidenceIssues.Count;
    private int DataGapCount => MissingInformationIssues.Count;
    private int ActionableIssueCount => AllIssues.Count(x => !string.IsNullOrWhiteSpace(x.ActionUrl));

    private string MissingEvidenceTone =>
        MissingEvidenceIssueCount > 0 ? "warning" : "success";

    private string IssueTone =>
        CriticalIssueCount > 0 ? "danger" :
        WarningIssueCount > 0 ? "warning" :
        "success";

    private string IssueBadgeClass =>
        CriticalIssueCount > 0 ? "of-badge-danger" :
        WarningIssueCount > 0 ? "of-badge-warning" :
        "of-badge-success";

    private List<string> ModuleOptions =>
        AllIssues
            .Select(x => x.ModuleName)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    private List<ModuleIssueSummary> ModuleIssueCoverage =>
        AllIssues
            .GroupBy(x => x.ModuleName)
            .Select(x => new ModuleIssueSummary(x.Key, x.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.ModuleName)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        workOrders = await Db.WorkOrders.AsNoTracking().ToListAsync();
        correctiveActions = await Db.CorrectiveActions.AsNoTracking().ToListAsync();
        documents = await Db.DocumentRecords.AsNoTracking().ToListAsync();
        risks = await Db.RiskItems.AsNoTracking().ToListAsync();
        trainingRecords = await Db.TrainingRecords.AsNoTracking().ToListAsync();
        documentIntakeItems = await Db.DocumentIntakeItems.AsNoTracking().ToListAsync();
        attachments = await AttachmentService.GetAllActiveAsync();
    }

    private void AddWorkOrderIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in workOrders)
        {
            var reference = item.WorkOrderNumber;
            var actionUrl = $"/work-orders/details/{item.Id}";

            if (item.IsOverdue)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    IssueType: "Overdue Work",
                    ModuleName: "Work Orders",
                    Reference: reference,
                    Issue: $"Work order is overdue. Due date was {item.DueDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the work order, review progress, confirm the owner, update the due date/status, or close it if completed.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.Owner))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Missing Information",
                    ModuleName: "Work Orders",
                    Reference: reference,
                    Issue: "Work order is missing an owner.",
                    Owner: "Unassigned",
                    RecommendedAction: "Open the work order and assign an owner so responsibility is clear and workload reporting is accurate.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.Notes))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Info",
                    IssueType: "Missing Information",
                    ModuleName: "Work Orders",
                    Reference: reference,
                    Issue: "Work order has blank notes.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the work order and add notes explaining the current progress, blocker, decision, or expected next action.",
                    ActionUrl: actionUrl));
            }
        }
    }

    private void AddCorrectiveActionIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in correctiveActions)
        {
            var reference = $"CA-{item.Id}";
            var actionUrl = $"/corrective-actions/details/{item.Id}";

            if (item.IsOverdue)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    IssueType: "Overdue Work",
                    ModuleName: "Corrective Actions",
                    Reference: reference,
                    Issue: $"Corrective action is overdue. Due date was {item.DueDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the corrective action, review progress, update owner/status, attach close-out evidence, or close if completed.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.Owner))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Missing Information",
                    ModuleName: "Corrective Actions",
                    Reference: reference,
                    Issue: "Corrective action is missing an owner.",
                    Owner: "Unassigned",
                    RecommendedAction: "Open the corrective action and assign an owner so follow-up accountability is clear.",
                    ActionUrl: actionUrl));
            }

            if (IsClosedStatus(item.Status) && item.CompletedDate == null)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Missing Information",
                    ModuleName: "Corrective Actions",
                    Reference: reference,
                    Issue: "Corrective action is completed/closed without a completed date.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the corrective action and set the completed date for traceability, or reopen the action if follow-up is not complete.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.Notes))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Info",
                    IssueType: "Missing Information",
                    ModuleName: "Corrective Actions",
                    Reference: reference,
                    Issue: "Corrective action has blank notes.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the corrective action and add notes explaining the cause, follow-up decision, current blocker, or closure detail.",
                    ActionUrl: actionUrl));
            }
        }
    }

    private void AddDocumentIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in documents)
        {
            var reference = item.DocumentNumber;
            const string actionUrl = "/documents";

            if (item.IsReviewOverdue)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    IssueType: "Compliance",
                    ModuleName: "Document Control",
                    Reference: reference,
                    Issue: $"Document review is overdue. Review date was {item.NextReviewDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open Documents, review the document, update version/status, record the review outcome, or create a corrective action if follow-up is required.",
                    ActionUrl: actionUrl));
            }
            else if (item.IsDueSoon)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Compliance",
                    ModuleName: "Document Control",
                    Reference: reference,
                    Issue: $"Document review is due soon on {item.NextReviewDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open Documents, schedule the review, confirm the owner, and update the record before it becomes overdue.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.Owner))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Missing Information",
                    ModuleName: "Document Control",
                    Reference: reference,
                    Issue: "Document is missing an owner.",
                    Owner: "Unassigned",
                    RecommendedAction: "Open Documents and assign a document owner so future reviews have clear accountability.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.Notes))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Info",
                    IssueType: "Missing Information",
                    ModuleName: "Document Control",
                    Reference: reference,
                    Issue: "Document record has blank notes.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open Documents and add review notes, version context, or next-step detail.",
                    ActionUrl: actionUrl));
            }
        }
    }

    private void AddRiskIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in risks)
        {
            var reference = item.Title;
            const string actionUrl = "/risk-register";

            if (item.RiskLevel == "Critical" || item.RiskLevel == "High")
            {
                issues.Add(new DataQualityIssue(
                    Severity: item.RiskLevel == "Critical" ? "Critical" : "Warning",
                    IssueType: "Compliance",
                    ModuleName: "Risk Register",
                    Reference: reference,
                    Issue: $"{item.RiskLevel} risk requires monitoring. Risk score is {item.RiskScore}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the Risk Register, confirm controls are current, review the risk rating, and create a corrective action if follow-up is needed.",
                    ActionUrl: actionUrl));
            }

            if (item.IsReviewOverdue)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    IssueType: "Compliance",
                    ModuleName: "Risk Register",
                    Reference: reference,
                    Issue: $"Risk review is overdue. Review date was {item.ReviewDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the Risk Register, review the risk score, confirm controls, update the review date, and create a corrective action if required.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.Owner))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Missing Information",
                    ModuleName: "Risk Register",
                    Reference: reference,
                    Issue: "Risk item is missing an owner.",
                    Owner: "Unassigned",
                    RecommendedAction: "Open the Risk Register and assign a risk owner so responsibility is visible.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.Controls))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Missing Information",
                    ModuleName: "Risk Register",
                    Reference: reference,
                    Issue: "Risk item is missing controls.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the Risk Register and add or update controls so the risk treatment is clear and reviewable.",
                    ActionUrl: actionUrl));
            }
        }
    }

    private void AddTrainingIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in trainingRecords)
        {
            var reference = $"{item.StaffName} - {item.TrainingName}";
            const string actionUrl = "/training";

            if (item.IsExpired)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    IssueType: "Compliance",
                    ModuleName: "Training",
                    Reference: reference,
                    Issue: $"Training record is expired. Expiry date was {item.ExpiryDate:dd MMM yyyy}.",
                    Owner: item.StaffName,
                    RecommendedAction: "Open Training, confirm retraining requirements, book the refresher, or create a corrective action for follow-up.",
                    ActionUrl: actionUrl));
            }
            else if (item.IsExpiringSoon)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Compliance",
                    ModuleName: "Training",
                    Reference: reference,
                    Issue: $"Training expires soon on {item.ExpiryDate:dd MMM yyyy}.",
                    Owner: item.StaffName,
                    RecommendedAction: "Open Training, book renewal before expiry, and confirm the follow-up owner.",
                    ActionUrl: actionUrl));
            }

            if (item.IsRequired && string.IsNullOrWhiteSpace(item.StaffName))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Missing Information",
                    ModuleName: "Training",
                    Reference: reference,
                    Issue: "Required training record is missing a staff name.",
                    Owner: "Unassigned",
                    RecommendedAction: "Open Training and confirm which staff member owns the training requirement.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.Notes))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Info",
                    IssueType: "Missing Information",
                    ModuleName: "Training",
                    Reference: reference,
                    Issue: "Training record has blank notes.",
                    Owner: SafeOwner(item.StaffName),
                    RecommendedAction: "Open Training and add notes explaining renewal, provider, evidence, or follow-up detail.",
                    ActionUrl: actionUrl));
            }
        }
    }

    private void AddDocumentIntakeIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in documentIntakeItems)
        {
            var reference = $"DI-{item.Id}";
            var actionUrl = $"/document-intake/details/{item.Id}";

            if (item.IsOverdue)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    IssueType: "Overdue Work",
                    ModuleName: "Document Intake",
                    Reference: reference,
                    Issue: $"Document intake item is overdue. Due date was {item.DueDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.AssignedTo),
                    RecommendedAction: "Open the intake item, confirm the processing owner, attach the source document, update status, or complete/reject it.",
                    ActionUrl: actionUrl));
            }

            if (item.NeedsReview)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Compliance",
                    ModuleName: "Document Intake",
                    Reference: reference,
                    Issue: "Document intake item is waiting for manual review.",
                    Owner: SafeOwner(item.AssignedTo),
                    RecommendedAction: "Open the intake item, check the attached source document, confirm the required processing step, and update the status.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.AssignedTo))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Missing Information",
                    ModuleName: "Document Intake",
                    Reference: reference,
                    Issue: "Document intake item is missing an assigned person.",
                    Owner: "Unassigned",
                    RecommendedAction: "Open the intake item and assign it so responsibility is clear and workload reporting is accurate.",
                    ActionUrl: actionUrl));
            }

            if (IsCompletedIntakeStatus(item.Status) && item.CompletedDate == null)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    IssueType: "Missing Information",
                    ModuleName: "Document Intake",
                    Reference: reference,
                    Issue: "Document intake item is completed/rejected without a completed date.",
                    Owner: SafeOwner(item.AssignedTo),
                    RecommendedAction: "Open the intake item and set the completed date for traceability, or reopen it if not complete.",
                    ActionUrl: actionUrl));
            }

            if (string.IsNullOrWhiteSpace(item.Notes))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Info",
                    IssueType: "Missing Information",
                    ModuleName: "Document Intake",
                    Reference: reference,
                    Issue: "Document intake item has blank notes.",
                    Owner: SafeOwner(item.AssignedTo),
                    RecommendedAction: "Open the intake item and add notes explaining the document source, processing decision, blocker, or next action.",
                    ActionUrl: actionUrl));
            }
        }
    }

    private void AddEvidenceIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in workOrders)
        {
            var requiresEvidence =
                item.IsOverdue ||
                IsHighPriority(item.Priority);

            if (requiresEvidence && !HasAttachment("Work Orders", item.Id))
            {
                issues.Add(new DataQualityIssue(
                    Severity: item.IsOverdue ? "Critical" : "Warning",
                    IssueType: "Missing Evidence",
                    ModuleName: "Work Orders",
                    Reference: item.WorkOrderNumber,
                    Issue: "Priority work order has no attached evidence or supporting file.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the work order and upload photos, documents, notes, or supporting evidence before management review.",
                    ActionUrl: $"/work-orders/details/{item.Id}"));
            }
        }

        foreach (var item in correctiveActions)
        {
            var requiresEvidence =
                item.IsOverdue ||
                IsHighPriority(item.Priority) ||
                IsClosedStatus(item.Status);

            if (requiresEvidence && !HasAttachment("Corrective Actions", item.Id))
            {
                issues.Add(new DataQualityIssue(
                    Severity: item.IsOverdue ? "Critical" : "Warning",
                    IssueType: "Missing Evidence",
                    ModuleName: "Corrective Actions",
                    Reference: $"CA-{item.Id}",
                    Issue: "Corrective action has no attached evidence, close-out file, or supporting document.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the corrective action and upload close-out evidence, photos, forms, review notes, or supporting documentation.",
                    ActionUrl: $"/corrective-actions/details/{item.Id}"));
            }
        }

        foreach (var item in documentIntakeItems)
        {
            var requiresEvidence =
                item.IsOverdue ||
                item.NeedsReview ||
                IsHighPriority(item.Priority);

            if (requiresEvidence && !HasAttachment("Document Intake", item.Id))
            {
                issues.Add(new DataQualityIssue(
                    Severity: item.IsOverdue ? "Critical" : "Warning",
                    IssueType: "Missing Evidence",
                    ModuleName: "Document Intake",
                    Reference: $"DI-{item.Id}",
                    Issue: "Document intake record needs review or follow-up but has no source file attached.",
                    Owner: SafeOwner(item.AssignedTo),
                    RecommendedAction: "Open the document intake record and attach the source document, scan, email export, PDF, or processing evidence.",
                    ActionUrl: $"/document-intake/details/{item.Id}"));
            }
        }
    }

    private bool HasAttachment(string moduleName, int recordId)
    {
        return attachments.Any(x =>
            !x.IsDeleted &&
            x.RecordId == recordId &&
            string.Equals(x.ModuleName, moduleName, StringComparison.OrdinalIgnoreCase));
    }

    private string GetModuleSeverityClass(string moduleName)
    {
        var moduleIssues = AllIssues
            .Where(x => x.ModuleName == moduleName)
            .ToList();

        if (moduleIssues.Any(x => x.Severity == "Critical"))
        {
            return "of-badge of-badge-danger";
        }

        if (moduleIssues.Any(x => x.Severity == "Warning"))
        {
            return "of-badge of-badge-warning";
        }

        return "of-badge of-badge-info";
    }

    private static bool IsClosedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsCompletedIntakeStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsHighPriority(string? priority)
    {
        return string.Equals(priority, "High", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(priority, "Critical", StringComparison.OrdinalIgnoreCase);
    }

    private static string SafeOwner(string? owner)
    {
        return string.IsNullOrWhiteSpace(owner) ? "Unassigned" : owner;
    }

    private static bool Contains(string? source, string search)
    {
        return !string.IsNullOrWhiteSpace(source) &&
               source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetSeverityClass(string? severity)
    {
        return severity?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "warning" => "badge badge-warning",
            "info" => "badge badge-info",
            _ => "badge badge-muted"
        };
    }

    private static string GetIssueTypeClass(string? issueType)
    {
        return issueType?.ToLowerInvariant() switch
        {
            "missing evidence" => "badge badge-warning",
            "missing information" => "badge badge-info",
            "overdue work" => "badge badge-danger",
            "compliance" => "badge badge-warning",
            _ => "badge badge-muted"
        };
    }

    private static string Pluralise(int count, string singular, string plural)
    {
        return count == 1 ? singular : plural;
    }

    private sealed record DataQualityIssue(
        string Severity,
        string IssueType,
        string ModuleName,
        string Reference,
        string Issue,
        string Owner,
        string RecommendedAction,
        string ActionUrl)
    {
        public int SeveritySort => Severity switch
        {
            "Critical" => 3,
            "Warning" => 2,
            "Info" => 1,
            _ => 0
        };
    }

    private sealed record ModuleIssueSummary(string ModuleName, int Count);
}