@page "/data-quality"

@using Microsoft.EntityFrameworkCore
@using OperationsFlow.Data
@using OperationsFlow.Models
@using DocumentIntakeModel = OperationsFlow.Models.DocumentIntake

@inject OperationsFlowDbContext Db

<PageTitle>Data Quality - OperationsFlow</PageTitle>

<div class="page-shell module-page data-quality-page">
    <section class="module-header">
        <div>
            <p class="eyebrow dark">System Health</p>
            <h1>Data Quality Report</h1>
            <p>
                Identify missing owners, weak records, overdue items, expired compliance records,
                and data issues that need review before management reporting.
            </p>
        </div>

        <div class="module-header-stat">
            <span>Total Issues</span>
            <strong>@TotalIssueCount</strong>
        </div>
    </section>

    <section class="page-purpose-note">
        <strong>Purpose:</strong> use this page to find weak or incomplete workflow records and jump directly to the page
        where each issue can be reviewed, updated, or turned into follow-up work.
    </section>

    <section class="module-summary-grid">
        <article class="module-summary-card danger-card">
            <span>Critical Issues</span>
            <strong>@CriticalIssueCount</strong>
            <small>High-risk or overdue problems</small>
        </article>

        <article class="module-summary-card warning-card">
            <span>Warning Issues</span>
            <strong>@WarningIssueCount</strong>
            <small>Records needing review</small>
        </article>

        <article class="module-summary-card info-card">
            <span>Data Gaps</span>
            <strong>@DataGapCount</strong>
            <small>Missing owner, notes, controls, or dates</small>
        </article>

        <article class="module-summary-card">
            <span>Modules Checked</span>
            <strong>@ModuleOptions.Count</strong>
            <small>Operations and compliance data</small>
        </article>
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Actionable Data Quality</h2>
                    <p>Each issue now includes a review link so weak records can be opened directly.</p>
                </div>
            </div>

            <div class="review-note-grid">
                <div class="review-note-card">
                    <span>WORKFLOW</span>
                    <strong>Open the record</strong>
                    <p>Issues link to edit, details, or source module pages where the data can be reviewed.</p>
                </div>

                <div class="review-note-card">
                    <span>MANAGEMENT</span>
                    <strong>Reduce stale work</strong>
                    <p>Overdue, unassigned, blank-note, and missing-date issues become visible before review meetings.</p>
                </div>

                <div class="review-note-card">
                    <span>TRACEABILITY</span>
                    <strong>Supports follow-up</strong>
                    <p>Opening and fixing records can create activity history on key workflow pages.</p>
                </div>

                <div class="review-note-card">
                    <span>PROTOTYPE BOUNDARY</span>
                    <strong>Local demo data</strong>
                    <p>A production version would add permissions, audit rules, and approval checks.</p>
                </div>
            </div>
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Module Issue Coverage</h2>
                    <p>Current issue count by module.</p>
                </div>
            </div>

            @if (!ModuleIssueCoverage.Any())
            {
                <div class="empty-state">
                    <strong>No data quality issues found.</strong>
                    <p>All checked records currently pass the prototype data quality rules.</p>
                </div>
            }
            else
            {
                <div class="mini-metric-grid">
                    @foreach (var module in ModuleIssueCoverage)
                    {
                        <div class="mini-metric-card">
                            <span>@module.ModuleName</span>
                            <strong>@module.Count</strong>
                            <small>@Pluralise(module.Count, "issue", "issues")</small>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="module-toolbar">
        <input class="search-input"
               placeholder="Search issue, module, reference, owner, or action..."
               @bind="searchText"
               @bind:event="oninput" />

        <select class="filter-select" @bind="severityFilter">
            <option value="">All Severities</option>
            <option value="Critical">Critical</option>
            <option value="Warning">Warning</option>
            <option value="Info">Info</option>
        </select>

        <select class="filter-select" @bind="moduleFilter">
            <option value="">All Modules</option>
            @foreach (var module in ModuleOptions)
            {
                <option value="@module">@module</option>
            }
        </select>
    </section>

    <section class="table-card">
        <div class="table-card-header">
            <div>
                <h2>Data Quality Issues</h2>
                <p>Showing @FilteredIssueCount of @TotalIssueCount issues.</p>
            </div>

            <div class="activity-count-card">
                <span>Action Links</span>
                <strong>@ActionableIssueCount</strong>
            </div>
        </div>

        @if (!FilteredIssues.Any())
        {
            <div class="empty-state">
                <strong>No data quality issues match the current filters.</strong>
                <p>Clear the search or filters to show more records.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table data-quality-table">
                    <thead>
                        <tr>
                            <th>Severity</th>
                            <th>Module</th>
                            <th>Reference</th>
                            <th>Issue</th>
                            <th>Owner</th>
                            <th>Recommended Action</th>
                            <th>Review</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var issue in FilteredIssues)
                        {
                            <tr>
                                <td>
                                    <span class="@GetSeverityClass(issue.Severity)">
                                        @issue.Severity
                                    </span>
                                </td>
                                <td>@issue.ModuleName</td>
                                <td class="strong-cell">@issue.Reference</td>
                                <td>@issue.Issue</td>
                                <td>@issue.Owner</td>
                                <td>@issue.RecommendedAction</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                                    {
                                        <a class="btn btn-small btn-primary" href="@issue.ActionUrl">
                                            Open
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-muted">Review</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Overdue Operational Work</h2>
                    <p>Open work orders and corrective actions that are past due.</p>
                </div>

                <span class="badge badge-danger">@OverdueWorkIssues.Count issues</span>
            </div>

            @if (!OverdueWorkIssues.Any())
            {
                <div class="empty-state">
                    <strong>No overdue operational work issues.</strong>
                    <p>Open work orders and corrective actions currently have no overdue data quality flags.</p>
                </div>
            }
            else
            {
                <div class="issue-card-list">
                    @foreach (var issue in OverdueWorkIssues.Take(6))
                    {
                        <article class="issue-card">
                            <div>
                                <strong>@issue.Reference</strong>
                                <p>@issue.Issue</p>
                                <small>@issue.ModuleName • @issue.Owner</small>
                            </div>

                            <div class="issue-card-actions">
                                <span class="@GetSeverityClass(issue.Severity)">
                                    @issue.Severity
                                </span>

                                @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                                {
                                    <a class="btn btn-small btn-primary" href="@issue.ActionUrl">Open</a>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Compliance Problems</h2>
                    <p>Expired training, overdue document reviews, and high-risk items.</p>
                </div>

                <span class="badge badge-warning">@ComplianceIssues.Count issues</span>
            </div>

            @if (!ComplianceIssues.Any())
            {
                <div class="empty-state">
                    <strong>No compliance data quality issues.</strong>
                    <p>Training, document, and risk records currently have no compliance flags.</p>
                </div>
            }
            else
            {
                <div class="issue-card-list">
                    @foreach (var issue in ComplianceIssues.Take(6))
                    {
                        <article class="issue-card">
                            <div>
                                <strong>@issue.Reference</strong>
                                <p>@issue.Issue</p>
                                <small>@issue.ModuleName • @issue.Owner</small>
                            </div>

                            <div class="issue-card-actions">
                                <span class="@GetSeverityClass(issue.Severity)">
                                    @issue.Severity
                                </span>

                                @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                                {
                                    <a class="btn btn-small btn-primary" href="@issue.ActionUrl">Open</a>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="summary-grid">
        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Missing Information</h2>
                    <p>Records missing owner, notes, controls, or completion details.</p>
                </div>

                <span class="badge badge-info">@MissingInformationIssues.Count issues</span>
            </div>

            @if (!MissingInformationIssues.Any())
            {
                <div class="empty-state">
                    <strong>No missing information issues.</strong>
                    <p>Checked records currently have the key fields needed for review.</p>
                </div>
            }
            else
            {
                <div class="issue-card-list">
                    @foreach (var issue in MissingInformationIssues.Take(6))
                    {
                        <article class="issue-card">
                            <div>
                                <strong>@issue.Reference</strong>
                                <p>@issue.Issue</p>
                                <small>@issue.ModuleName • @issue.Owner</small>
                            </div>

                            <div class="issue-card-actions">
                                <span class="@GetSeverityClass(issue.Severity)">
                                    @issue.Severity
                                </span>

                                @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                                {
                                    <a class="btn btn-small btn-primary" href="@issue.ActionUrl">Open</a>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="summary-panel">
            <div class="panel-header">
                <div>
                    <h2>Document Intake Issues</h2>
                    <p>Incoming documents overdue, needing review, or missing processing information.</p>
                </div>

                <span class="badge badge-warning">@DocumentIntakeIssues.Count issues</span>
            </div>

            @if (!DocumentIntakeIssues.Any())
            {
                <div class="empty-state">
                    <strong>No document intake issues.</strong>
                    <p>Incoming document processing records currently pass the prototype checks.</p>
                </div>
            }
            else
            {
                <div class="issue-card-list">
                    @foreach (var issue in DocumentIntakeIssues.Take(6))
                    {
                        <article class="issue-card">
                            <div>
                                <strong>@issue.Reference</strong>
                                <p>@issue.Issue</p>
                                <small>@issue.ModuleName • @issue.Owner</small>
                            </div>

                            <div class="issue-card-actions">
                                <span class="@GetSeverityClass(issue.Severity)">
                                    @issue.Severity
                                </span>

                                @if (!string.IsNullOrWhiteSpace(issue.ActionUrl))
                                {
                                    <a class="btn btn-small btn-primary" href="@issue.ActionUrl">Open</a>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>
</div>

@code {
    private List<WorkOrder> workOrders = new();
    private List<CorrectiveAction> correctiveActions = new();
    private List<DocumentRecord> documents = new();
    private List<RiskItem> risks = new();
    private List<TrainingRecord> trainingRecords = new();
    private List<DocumentIntakeModel> documentIntakeItems = new();

    private string searchText = "";
    private string severityFilter = "";
    private string moduleFilter = "";

    private List<DataQualityIssue> AllIssues
    {
        get
        {
            var issues = new List<DataQualityIssue>();

            AddWorkOrderIssues(issues);
            AddCorrectiveActionIssues(issues);
            AddDocumentIssues(issues);
            AddRiskIssues(issues);
            AddTrainingIssues(issues);
            AddDocumentIntakeIssues(issues);

            return issues
                .OrderByDescending(x => x.SeveritySort)
                .ThenBy(x => x.ModuleName)
                .ThenBy(x => x.Reference)
                .ToList();
        }
    }

    private List<DataQualityIssue> FilteredIssues
    {
        get
        {
            var query = AllIssues.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                query = query.Where(x =>
                    Contains(x.ModuleName, searchText) ||
                    Contains(x.Reference, searchText) ||
                    Contains(x.Issue, searchText) ||
                    Contains(x.Owner, searchText) ||
                    Contains(x.RecommendedAction, searchText));
            }

            if (!string.IsNullOrWhiteSpace(severityFilter))
            {
                query = query.Where(x =>
                    string.Equals(x.Severity, severityFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(moduleFilter))
            {
                query = query.Where(x =>
                    string.Equals(x.ModuleName, moduleFilter, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private List<DataQualityIssue> OverdueWorkIssues =>
        AllIssues
            .Where(x =>
                (x.ModuleName == "Work Orders" || x.ModuleName == "Corrective Actions") &&
                Contains(x.Issue, "overdue"))
            .ToList();

    private List<DataQualityIssue> ComplianceIssues =>
        AllIssues
            .Where(x =>
                x.ModuleName == "Document Control" ||
                x.ModuleName == "Risk Register" ||
                x.ModuleName == "Training")
            .ToList();

    private List<DataQualityIssue> MissingInformationIssues =>
        AllIssues
            .Where(x =>
                Contains(x.Issue, "missing") ||
                Contains(x.Issue, "blank") ||
                Contains(x.Issue, "without"))
            .ToList();

    private List<DataQualityIssue> DocumentIntakeIssues =>
        AllIssues
            .Where(x => x.ModuleName == "Document Intake")
            .ToList();

    private int TotalIssueCount => AllIssues.Count;

    private int FilteredIssueCount => FilteredIssues.Count;

    private int CriticalIssueCount => AllIssues.Count(x => x.Severity == "Critical");

    private int WarningIssueCount => AllIssues.Count(x => x.Severity == "Warning");

    private int DataGapCount => MissingInformationIssues.Count;

    private int ActionableIssueCount => AllIssues.Count(x => !string.IsNullOrWhiteSpace(x.ActionUrl));

    private List<string> ModuleOptions =>
        AllIssues
            .Select(x => x.ModuleName)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

    private List<ModuleIssueSummary> ModuleIssueCoverage =>
        AllIssues
            .GroupBy(x => x.ModuleName)
            .Select(x => new ModuleIssueSummary(x.Key, x.Count()))
            .OrderByDescending(x => x.Count)
            .ThenBy(x => x.ModuleName)
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        workOrders = await Db.WorkOrders
            .AsNoTracking()
            .ToListAsync();

        correctiveActions = await Db.CorrectiveActions
            .AsNoTracking()
            .ToListAsync();

        documents = await Db.DocumentRecords
            .AsNoTracking()
            .ToListAsync();

        risks = await Db.RiskItems
            .AsNoTracking()
            .ToListAsync();

        trainingRecords = await Db.TrainingRecords
            .AsNoTracking()
            .ToListAsync();

        documentIntakeItems = await Db.DocumentIntakeItems
            .AsNoTracking()
            .ToListAsync();
    }

    private void AddWorkOrderIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in workOrders)
        {
            var reference = item.WorkOrderNumber;
            var actionUrl = $"/work-orders/details/{item.Id}";

            if (item.IsOverdue)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    ModuleName: "Work Orders",
                    Reference: reference,
                    Issue: $"Work order is overdue. Due date was {item.DueDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the work order, review progress, confirm the owner, update the due date/status, or close it if completed.",
                    ActionUrl: actionUrl
                ));
            }

            if (string.IsNullOrWhiteSpace(item.Owner))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    ModuleName: "Work Orders",
                    Reference: reference,
                    Issue: "Work order is missing an owner.",
                    Owner: "Unassigned",
                    RecommendedAction: "Open the work order and assign an owner so responsibility is clear and workload reporting is accurate.",
                    ActionUrl: actionUrl
                ));
            }

            if (string.IsNullOrWhiteSpace(item.Notes))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Info",
                    ModuleName: "Work Orders",
                    Reference: reference,
                    Issue: "Work order has blank notes.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the work order and add notes explaining the current progress, blocker, decision, or expected next action.",
                    ActionUrl: actionUrl
                ));
            }
        }
    }

    private void AddCorrectiveActionIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in correctiveActions)
        {
            var reference = $"CA-{item.Id}";
            var actionUrl = $"/corrective-actions/edit/{item.Id}";

            if (item.IsOverdue)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    ModuleName: "Corrective Actions",
                    Reference: reference,
                    Issue: $"Corrective action is overdue. Due date was {item.DueDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the corrective action, review progress, update owner/status, adjust the due date if required, or close if completed.",
                    ActionUrl: actionUrl
                ));
            }

            if (string.IsNullOrWhiteSpace(item.Owner))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    ModuleName: "Corrective Actions",
                    Reference: reference,
                    Issue: "Corrective action is missing an owner.",
                    Owner: "Unassigned",
                    RecommendedAction: "Open the corrective action and assign an owner so follow-up accountability is clear.",
                    ActionUrl: actionUrl
                ));
            }

            if (IsClosedStatus(item.Status) && item.CompletedDate == null)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    ModuleName: "Corrective Actions",
                    Reference: reference,
                    Issue: "Corrective action is completed/closed without a completed date.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the corrective action and set the completed date for traceability, or reopen the action if follow-up is not complete.",
                    ActionUrl: actionUrl
                ));
            }

            if (string.IsNullOrWhiteSpace(item.Notes))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Info",
                    ModuleName: "Corrective Actions",
                    Reference: reference,
                    Issue: "Corrective action has blank notes.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the corrective action and add notes explaining the cause, follow-up decision, current blocker, or closure detail.",
                    ActionUrl: actionUrl
                ));
            }
        }
    }

    private void AddDocumentIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in documents)
        {
            var reference = item.DocumentNumber;
            var actionUrl = "/documents";

            if (item.IsReviewOverdue)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    ModuleName: "Document Control",
                    Reference: reference,
                    Issue: $"Document review is overdue. Review date was {item.NextReviewDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open Documents, review the document, update version/status, record the review outcome, or create a corrective action if follow-up is required.",
                    ActionUrl: actionUrl
                ));
            }
            else if (item.IsDueSoon)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    ModuleName: "Document Control",
                    Reference: reference,
                    Issue: $"Document review is due soon on {item.NextReviewDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open Documents, schedule the review, confirm the owner, and update the record before it becomes overdue.",
                    ActionUrl: actionUrl
                ));
            }

            if (string.IsNullOrWhiteSpace(item.Owner))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    ModuleName: "Document Control",
                    Reference: reference,
                    Issue: "Document is missing an owner.",
                    Owner: "Unassigned",
                    RecommendedAction: "Open Documents and assign a document owner so future reviews have clear accountability.",
                    ActionUrl: actionUrl
                ));
            }
        }
    }

    private void AddRiskIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in risks)
        {
            var reference = item.Title;
            var actionUrl = "/risk-register";

            if (item.RiskLevel == "Critical" || item.RiskLevel == "High")
            {
                issues.Add(new DataQualityIssue(
                    Severity: item.RiskLevel == "Critical" ? "Critical" : "Warning",
                    ModuleName: "Risk Register",
                    Reference: reference,
                    Issue: $"{item.RiskLevel} risk requires monitoring. Risk score is {item.RiskScore}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the Risk Register, confirm controls are current, review the risk rating, and create a corrective action if follow-up is needed.",
                    ActionUrl: actionUrl
                ));
            }

            if (item.IsReviewOverdue)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    ModuleName: "Risk Register",
                    Reference: reference,
                    Issue: $"Risk review is overdue. Review date was {item.ReviewDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the Risk Register, review the risk score, confirm controls, update the review date, and create a corrective action if required.",
                    ActionUrl: actionUrl
                ));
            }

            if (string.IsNullOrWhiteSpace(item.Controls))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    ModuleName: "Risk Register",
                    Reference: reference,
                    Issue: "Risk item is missing controls.",
                    Owner: SafeOwner(item.Owner),
                    RecommendedAction: "Open the Risk Register and add or update controls so the risk treatment is clear and reviewable.",
                    ActionUrl: actionUrl
                ));
            }
        }
    }

    private void AddTrainingIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in trainingRecords)
        {
            var reference = $"{item.StaffName} - {item.TrainingName}";
            var actionUrl = "/training";

            if (item.IsExpired)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    ModuleName: "Training",
                    Reference: reference,
                    Issue: $"Training record is expired. Expiry date was {item.ExpiryDate:dd MMM yyyy}.",
                    Owner: item.StaffName,
                    RecommendedAction: "Open Training, confirm retraining requirements, book the refresher, or create a corrective action for follow-up.",
                    ActionUrl: actionUrl
                ));
            }
            else if (item.IsExpiringSoon)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    ModuleName: "Training",
                    Reference: reference,
                    Issue: $"Training expires soon on {item.ExpiryDate:dd MMM yyyy}.",
                    Owner: item.StaffName,
                    RecommendedAction: "Open Training, book renewal before expiry, and confirm the follow-up owner.",
                    ActionUrl: actionUrl
                ));
            }
        }
    }

    private void AddDocumentIntakeIssues(List<DataQualityIssue> issues)
    {
        foreach (var item in documentIntakeItems)
        {
            var reference = $"DI-{item.Id}";
            var actionUrl = $"/document-intake/edit/{item.Id}";

            if (item.IsOverdue)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Critical",
                    ModuleName: "Document Intake",
                    Reference: reference,
                    Issue: $"Document intake item is overdue. Due date was {item.DueDate:dd MMM yyyy}.",
                    Owner: SafeOwner(item.AssignedTo),
                    RecommendedAction: "Open the intake item, confirm the processing owner, update status, or complete/reject it.",
                    ActionUrl: actionUrl
                ));
            }

            if (item.NeedsReview)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    ModuleName: "Document Intake",
                    Reference: reference,
                    Issue: "Document intake item is waiting for manual review.",
                    Owner: SafeOwner(item.AssignedTo),
                    RecommendedAction: "Open the intake item, check the document, confirm the required processing step, and update the status.",
                    ActionUrl: actionUrl
                ));
            }

            if (string.IsNullOrWhiteSpace(item.AssignedTo))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    ModuleName: "Document Intake",
                    Reference: reference,
                    Issue: "Document intake item is missing an assigned person.",
                    Owner: "Unassigned",
                    RecommendedAction: "Open the intake item and assign it so responsibility is clear and workload reporting is accurate.",
                    ActionUrl: actionUrl
                ));
            }

            if (IsCompletedIntakeStatus(item.Status) && item.CompletedDate == null)
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Warning",
                    ModuleName: "Document Intake",
                    Reference: reference,
                    Issue: "Document intake item is completed/rejected without a completed date.",
                    Owner: SafeOwner(item.AssignedTo),
                    RecommendedAction: "Open the intake item and set the completed date for traceability, or reopen it if not complete.",
                    ActionUrl: actionUrl
                ));
            }

            if (string.IsNullOrWhiteSpace(item.Notes))
            {
                issues.Add(new DataQualityIssue(
                    Severity: "Info",
                    ModuleName: "Document Intake",
                    Reference: reference,
                    Issue: "Document intake item has blank notes.",
                    Owner: SafeOwner(item.AssignedTo),
                    RecommendedAction: "Open the intake item and add notes explaining the document source, processing decision, blocker, or next action.",
                    ActionUrl: actionUrl
                ));
            }
        }
    }

    private static bool IsClosedStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsCompletedIntakeStatus(string? status)
    {
        return string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Rejected", StringComparison.OrdinalIgnoreCase);
    }

    private static string SafeOwner(string? owner)
    {
        return string.IsNullOrWhiteSpace(owner) ? "Unassigned" : owner;
    }

    private static bool Contains(string? source, string search)
    {
        if (string.IsNullOrWhiteSpace(source))
        {
            return false;
        }

        return source.Contains(search, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetSeverityClass(string? severity)
    {
        return severity?.ToLowerInvariant() switch
        {
            "critical" => "badge badge-danger",
            "warning" => "badge badge-warning",
            "info" => "badge badge-info",
            _ => "badge badge-muted"
        };
    }

    private static string Pluralise(int count, string singular, string plural)
    {
        return count == 1 ? singular : plural;
    }

    private sealed record DataQualityIssue(
        string Severity,
        string ModuleName,
        string Reference,
        string Issue,
        string Owner,
        string RecommendedAction,
        string ActionUrl)
    {
        public int SeveritySort => Severity switch
        {
            "Critical" => 3,
            "Warning" => 2,
            "Info" => 1,
            _ => 0
        };
    }

    private sealed record ModuleIssueSummary(string ModuleName, int Count);
}